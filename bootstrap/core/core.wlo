# The core module: the Willow runtime, written in L0 over the intrinsic layer
# described in agents/bootstrap.md §5. Stage 0 compiles this module into every
# program. Only this module may use intrinsics. bootstrap/core/API.md lists the
# functions stage 0 calls.

extern def write(fd: cint, buf: ptr, count: int) -> int
extern def exit(status: cint)
extern def memcpy(dest: ptr, src: ptr, count: int) -> ptr
extern def memcmp(a: ptr, b: ptr, count: int) -> cint
extern def snprintf(buf: ptr, size: int, format: ptr, ...) -> cint
extern def signal(sig: cint, handler: ptr) -> ptr
extern def strlen(s: ptr) -> int
extern def open(path: ptr, flags: cint, ...) -> cint
extern def read(fd: cint, buf: ptr, count: int) -> int
extern def close(fd: cint) -> cint
extern def strerror(code: cint) -> ptr
extern def access(path: ptr, mode: cint) -> cint
extern def realpath(path: ptr, resolved: ptr) -> ptr
extern def posix_spawnp(pid: ptr, file: ptr, actions: ptr, attributes: ptr, argv: ptr, envp: ptr) -> cint
extern def posix_spawnattr_init(attributes: ptr) -> cint
extern def posix_spawnattr_destroy(attributes: ptr) -> cint
extern def posix_spawnattr_setflags(attributes: ptr, flags: cint) -> cint
extern def posix_spawnattr_setsigdefault(attributes: ptr, signals: ptr) -> cint
extern def sigemptyset(signals: ptr) -> cint
extern def sigaddset(signals: ptr, sig: cint) -> cint
extern def waitpid(pid: cint, status: ptr, options: cint) -> cint
extern def dlsym(handle: ptr, name: ptr) -> ptr
extern def _NSGetEnviron() -> ptr
extern def __errno_location() -> ptr
extern def __error() -> ptr
extern def strtod(s: ptr, end: ptr) -> float
extern def fmod(x: float, y: float) -> float
extern def floor(x: float) -> float
extern def copysign(x: float, y: float) -> float

extern def GC_gcollect()
extern def GC_get_my_stackbottom(base: ptr) -> ptr
extern def GC_set_stackbottom(thread: ptr, base: ptr)
extern def GC_alloc_lock()
extern def GC_alloc_unlock()
extern def GC_add_roots(low: ptr, high: ptr)
extern def GC_remove_roots(low: ptr, high: ptr)

# Offsets are shared with the switch assembly and stage 1's core helpers.
# State is 0 (new), 1 (running), 2 (suspended), or 3 (finished).
class CoroutineContext:
    sp: ptr
    stack: ptr
    bottom: ptr
    entry: ptr
    argument: word
    value: word
    caller: CoroutineContext | None
    pending: ptr
    error: ptr
    state: int

def coroutine_context() -> CoroutineContext:
    current = coroutine_current()
    if current is None:
        null = __ptr(__word(0))
        bottom = __alloc(8)
        GC_get_my_stackbottom(bottom)
        current = CoroutineContext(null, null, bottom, null, __word(0), __word(0), None, null, null, 1)
        coroutine_set_current(current)
    return current

def coroutine_create(entry: ptr, argument: word) -> CoroutineContext:
    if not coroutine_available():
        fail("RuntimeError", "coroutines require stage 1 on arm64")
    coroutine_context()
    stack_size = 262144
    stack = __alloc(stack_size)
    top = __offset(stack, stack_size - __int(__word(stack)) % 16)
    bottom = __alloc(8)
    __store8(bottom, 0, __word(top))
    sp = __offset(top, -160)
    __store8(sp, 88, __word(coroutine_start_address()))
    null = __ptr(__word(0))
    return CoroutineContext(sp, stack, bottom, entry, argument, __word(0), None, null, null, 0)

def coroutine_finished(coroutine: CoroutineContext) -> bool:
    return coroutine.state == 3

def coroutine_resume(coroutine: CoroutineContext) -> word:
    if coroutine.state == 1:
        fail("RuntimeError", "cannot resume a running coroutine")
    if coroutine.state == 3:
        return __word(0)
    caller = coroutine_context()
    coroutine.caller = caller
    coroutine.state = 1
    coroutine_switch(caller, coroutine)
    value = coroutine.value
    coroutine.value = __word(0)
    if coroutine.state == 3:
        null = __ptr(__word(0))
        coroutine.sp = null
        coroutine.stack = null
        coroutine.bottom = null
        coroutine.entry = null
        coroutine.argument = __word(0)
    error = coroutine.error
    coroutine.error = __ptr(__word(0))
    coroutine_set_pending(error)
    return value

def coroutine_yield(value: word):
    current = coroutine_context()
    caller = current.caller
    if caller is None:
        fail("RuntimeError", "cannot yield outside a coroutine")
        return
    current.value = value
    current.state = 2
    current.caller = None
    coroutine_switch(current, caller)

# Called after the outgoing registers and SP are saved, before changing SP.
# The native stack needs explicit roots while a heap stack is active.
def coroutine_prepare(current: CoroutineContext, resumed: CoroutineContext):
    if __addr_is_null(current.stack):
        GC_add_roots(current.sp, __ptr(__load8(current.bottom, 0)))
    coroutine_set_current(resumed)
    GC_alloc_lock()
    GC_set_stackbottom(__ptr(__word(0)), resumed.bottom)
    GC_alloc_unlock()

def coroutine_start():
    current = coroutine_context()
    current.error = coroutine_invoke(current.entry, current.argument)
    current.state = 3
    current.value = __word(0)
    caller = current.caller
    assert caller is not None, "coroutine has no caller"
    current.caller = None
    coroutine_switch(current, caller)
    exit(1)

# Stage 1 replaces these bodies; stage 0 links core without switch assembly.
def coroutine_available() -> bool:
    return False

def coroutine_current() -> CoroutineContext | None:
    fail("RuntimeError", "coroutines require stage 1 on arm64")
    return None

def coroutine_set_current(current: CoroutineContext):
    fail("RuntimeError", "coroutines require stage 1 on arm64")

def coroutine_set_pending(pending: ptr):
    fail("RuntimeError", "coroutines require stage 1 on arm64")

def coroutine_start_address() -> ptr:
    fail("RuntimeError", "coroutines require stage 1 on arm64")
    return __ptr(__word(0))

def coroutine_invoke(entry: ptr, argument: word) -> ptr:
    fail("RuntimeError", "coroutines require stage 1 on arm64")
    return __ptr(__word(0))

def coroutine_switch(current: CoroutineContext, resumed: CoroutineContext):
    fail("RuntimeError", "coroutines require stage 1 on arm64")

# Called by the program entry before main. Writing to a closed pipe must fail
# the write instead of raising SIGPIPE (spec §10); SIGPIPE is 13 and SIG_IGN
# is 1 on both Linux and Darwin.
def init():
    signal(13, __ptr(__word(1)))

# Failing to write stdout or stderr ends the program with status 1 (spec §10).
def write_all(fd: int, buf: ptr, count: int):
    done = 0
    while done < count:
        written = write(fd, __offset(buf, done), count - done)
        if written < 0:
            exit(1)
        done = done + written

def write_str(fd: int, s: str):
    write_all(fd, str_bytes(s), str_size(s))

# Reports a fatal L0 failure (agents/bootstrap.md §3). Stage 1 compiles its
# own body instead, which raises the exception through `failure`.
def fail(class_name: str, message: str):
    write_str(2, "error: ")
    write_str(2, class_name)
    write_str(2, ": ")
    write_str(2, message)
    write_str(2, "\n")
    exit(1)

# Exceptions, which only programs compiled by stage 1 raise (API.md).

# A new exception of the built-in class named `class_name`, whose descriptor
# is in the array `descriptors`.
def failure(descriptors: ptr, class_name: str, message: str) -> ptr:
    i = 0
    descriptor = __ptr(__load8(descriptors, 0))
    while not str_eq(__str(__load8(descriptor, 0)), class_name):
        i = i + 1
        descriptor = __ptr(__load8(descriptors, i * 8))
    e = object_new(descriptor, 3)
    __store8(e, 24, __word(message))
    return e

# Starts the frames of `e`, raised by a raise statement.
def raised(e: ptr, function: str, path: str, line: int, col: int):
    __store8(e, 8, __word(0))
    __store8(e, 16, __word(0))
    trace(e, function, path, line, col)

# Adds the frame of `function` at `path`, `line`, and `col` to `e`. The first
# frame's location is the exception's.
def trace(e: ptr, function: str, path: str, line: int, col: int):
    if e == aio_cancel():
        return
    # A task-start frame ends the original traceback, even when re-observed.
    frames = __ptr(__load8(e, 16))
    if not __addr_is_null(frames) and str_find(__str(__word(frames)), "\n  in task started at ") >= 0:
        return
    where = path + ":" + int_to_str(line) + ":" + int_to_str(col)
    if __addr_is_null(__ptr(__load8(e, 8))):
        __store8(e, 8, __word(where))
    if __addr_is_null(__ptr(__load8(e, 16))):
        __store8(e, 16, __word("\n  in " + function + " at " + where))
    else:
        __store8(e, 16, __word(__str(__load8(e, 16)) + "\n  called from " + function + " at " + where))

# Writes the report of `e`, which propagated out of main (spec §13).
def report(e: ptr):
    name = __str(__load8(header(e), 0))
    message = __str(__load8(e, 24))
    write_str(2, __str(__load8(e, 8)) + ": error: " + name + ": " + message + __str(__load8(e, 16)) + "\n")

def print_str(s: str):
    write_str(1, s)
    write_str(1, "\n")

def eprint_str(s: str):
    write_str(2, s)
    write_str(2, "\n")

def print_int(n: int):
    print_str(int_to_str(n))

def print_bool(b: bool):
    print_str(bool_to_str(b))

def int_to_str(n: int) -> str:
    # 21 bytes hold the longest int and the zero byte snprintf writes.
    s = __alloc_atomic(16 + 21)
    length = snprintf(__offset(s, 16), 21, str_bytes("%lld"), n)
    __store8(s, 0, __word(__type(str)))
    __store8(s, 8, __word(length))
    return __str(__word(s))

def bool_to_str(b: bool) -> str:
    if b:
        return "True"
    return "False"

# A string is a header word pointing at the str descriptor, the byte length,
# the UTF-8 bytes, and a zero byte so the bytes can be passed to libc. Strings
# are always valid UTF-8, so a code point starts at every byte that is not a
# continuation byte (128 through 191), and a valid needle can only match at a
# code point boundary.

def str_size(s: str) -> int:
    return __int(__load8(__ptr(__word(s)), 8))

def str_bytes(s: str) -> ptr:
    return __offset(__ptr(__word(s)), 16)

def str_byte(s: str, i: int) -> int:
    return __load1(str_bytes(s), i)

# A string of `length` bytes whose contents the caller fills in.
def str_alloc(length: int) -> ptr:
    s = __alloc_atomic(17 + length)
    __store8(s, 0, __word(__type(str)))
    __store8(s, 8, __word(length))
    __store1(s, 16 + length, 0)
    return s

# The string holding bytes `start` up to `stop` of `s`.
def str_sub(s: str, start: int, stop: int) -> str:
    result = str_alloc(stop - start)
    memcpy(__offset(result, 16), __offset(str_bytes(s), start), stop - start)
    return __str(__word(result))

def is_continuation(b: int) -> bool:
    return b >= 128 and b < 192

# The number of bytes in the code point whose first byte is `b`.
def char_size(b: int) -> int:
    if b < 128:
        return 1
    elif b < 224:
        return 2
    elif b < 240:
        return 3
    return 4

# The number of code points in bytes `start` up to `stop` of `s`.
def count_chars(s: str, start: int, stop: int) -> int:
    count = 0
    i = start
    while i < stop:
        if not is_continuation(str_byte(s, i)):
            count = count + 1
        i = i + 1
    return count

# The byte offset `count` code points after byte offset `at`, which stays
# within `s`.
def advance(s: str, at: int, count: int) -> int:
    while count > 0:
        at = at + char_size(str_byte(s, at))
        count = count - 1
    return at

# The first byte offset at or after `start` where `sub` occurs, or -1.
def find_bytes(s: str, sub: str, start: int) -> int:
    last = str_size(s) - str_size(sub)
    i = start
    while i <= last:
        if memcmp(__offset(str_bytes(s), i), str_bytes(sub), str_size(sub)) == 0:
            return i
        i = i + 1
    return -1

def bytes_equal_at(s: str, at: int, sub: str) -> bool:
    if at < 0 or at + str_size(sub) > str_size(s):
        return False
    return memcmp(__offset(str_bytes(s), at), str_bytes(sub), str_size(sub)) == 0

# Space, tab, LF, VT, FF, and CR (spec §7).
def is_space(b: int) -> bool:
    return b == 32 or (b >= 9 and b <= 13)

def is_digit(b: int) -> bool:
    return b >= 48 and b <= 57

def is_alpha(b: int) -> bool:
    return (b >= 97 and b <= 122) or (b >= 65 and b <= 90)

# `index` made non-negative by adding `length` once, as spec §7 says, then
# clamped to the sequence.
def clamp(index: int, length: int) -> int:
    if index < 0:
        index = index + length
        if index < 0:
            return 0
    if index > length:
        return length
    return index

def str_concat(a: str, b: str) -> str:
    a_size = str_size(a)
    b_size = str_size(b)
    s = str_alloc(a_size + b_size)
    memcpy(__offset(s, 16), str_bytes(a), a_size)
    memcpy(__offset(s, 16 + a_size), str_bytes(b), b_size)
    return __str(__word(s))

def str_eq(a: str, b: str) -> bool:
    if str_size(a) != str_size(b):
        return False
    return memcmp(str_bytes(a), str_bytes(b), str_size(a)) == 0

# Negative when a sorts before b, zero when they are equal, and positive
# otherwise. Byte order is code point order in UTF-8.
def str_compare(a: str, b: str) -> int:
    a_size = str_size(a)
    b_size = str_size(b)
    i = 0
    while i < a_size and i < b_size:
        difference = str_byte(a, i) - str_byte(b, i)
        if difference != 0:
            return difference
        i = i + 1
    return a_size - b_size

def str_len(s: str) -> int:
    return count_chars(s, 0, str_size(s))

def str_char_at(s: str, at: int) -> str:
    return str_sub(s, at, at + char_size(str_byte(s, at)))

def str_index(s: str, i: int) -> str:
    length = str_len(s)
    if i < 0:
        i = i + length
    if i < 0 or i >= length:
        fail("IndexError", "string index out of range")
    return str_char_at(s, advance(s, 0, i))

def str_slice(s: str, start: int, stop: int) -> str:
    length = str_len(s)
    start = clamp(start, length)
    stop = clamp(stop, length)
    if stop <= start:
        return ""
    first = advance(s, 0, start)
    return str_sub(s, first, advance(s, first, stop - start))

def str_contains(s: str, sub: str) -> bool:
    return find_bytes(s, sub, 0) >= 0

def str_find(s: str, sub: str) -> int:
    at = find_bytes(s, sub, 0)
    if at < 0:
        return -1
    return count_chars(s, 0, at)

def str_startswith(s: str, prefix: str) -> bool:
    return bytes_equal_at(s, 0, prefix)

def str_endswith(s: str, suffix: str) -> bool:
    return bytes_equal_at(s, str_size(s) - str_size(suffix), suffix)

# An empty `old` matches before every code point and at the end, as in Python.
def str_replace(s: str, old: str, new: str) -> str:
    result = ""
    start = 0
    if str_size(old) == 0:
        while start < str_size(s):
            result = result + new + str_char_at(s, start)
            start = start + char_size(str_byte(s, start))
        return result + new
    at = find_bytes(s, old, 0)
    while at >= 0:
        result = result + str_sub(s, start, at) + new
        start = at + str_size(old)
        at = find_bytes(s, old, start)
    return result + str_sub(s, start, str_size(s))

def str_strip(s: str) -> str:
    start = 0
    stop = str_size(s)
    while start < stop and is_space(str_byte(s, start)):
        start = start + 1
    while stop > start and is_space(str_byte(s, stop - 1)):
        stop = stop - 1
    return str_sub(s, start, stop)

def str_removeprefix(s: str, prefix: str) -> str:
    if str_startswith(s, prefix):
        return str_sub(s, str_size(prefix), str_size(s))
    return s

def str_removesuffix(s: str, suffix: str) -> str:
    if str_endswith(s, suffix):
        return str_sub(s, 0, str_size(s) - str_size(suffix))
    return s

# The classification methods are ASCII only, and false for the empty string.

def str_isdigit(s: str) -> bool:
    if str_size(s) == 0:
        return False
    i = 0
    while i < str_size(s):
        if not is_digit(str_byte(s, i)):
            return False
        i = i + 1
    return True

def str_isalpha(s: str) -> bool:
    if str_size(s) == 0:
        return False
    i = 0
    while i < str_size(s):
        if not is_alpha(str_byte(s, i)):
            return False
        i = i + 1
    return True

def str_isalnum(s: str) -> bool:
    if str_size(s) == 0:
        return False
    i = 0
    while i < str_size(s):
        b = str_byte(s, i)
        if not (is_alpha(b) or is_digit(b)):
            return False
        i = i + 1
    return True

def str_isspace(s: str) -> bool:
    if str_size(s) == 0:
        return False
    i = 0
    while i < str_size(s):
        if not is_space(str_byte(s, i)):
            return False
        i = i + 1
    return True

# A string of `count` copies of the ASCII byte `b`.
def repeat_byte(b: int, count: int) -> str:
    s = str_alloc(count)
    i = 0
    while i < count:
        __store1(s, 16 + i, b)
        i = i + 1
    return __str(__word(s))

def str_ljust(s: str, width: int) -> str:
    length = str_len(s)
    if width <= length:
        return s
    return s + repeat_byte(32, width - length)

def str_rjust(s: str, width: int) -> str:
    length = str_len(s)
    if width <= length:
        return s
    return repeat_byte(32, width - length) + s

def pad(s: str, width: int, align: str) -> str:
    padding = width - str_len(s)
    if padding <= 0:
        return s
    if align == "<":
        return s + repeat_byte(32, padding)
    if align == "^":
        left = padding // 2
        return repeat_byte(32, left) + s + repeat_byte(32, padding - left)
    return repeat_byte(32, padding) + s

def format_union(value: ptr, width: int, align: str) -> str:
    if align == "":
        align = ">"
        if is_instance(value, __type(str)):
            align = "<"
    return pad(union_to_str(value), width, align)

# As in Python: with a separator, the pieces between its occurrences, and
# otherwise the runs of non-whitespace, ignoring whitespace at either end. At
# most `maxsplit` splits are made, from the left, and the rest of the string
# is the last piece. A negative `maxsplit` places no limit; there are never
# more splits than bytes, so the byte count stands in for it.
def str_split(s: str, sep: str | None, maxsplit: int) -> ptr:
    if maxsplit < 0:
        maxsplit = str_size(s)
    if sep is None:
        return split_whitespace(s, maxsplit)
    if str_size(sep) == 0:
        fail("ValueError", "empty separator")
    parts = list_new(0)
    start = 0
    at = find_bytes(s, sep, 0)
    while at >= 0 and maxsplit != 0:
        list_append(parts, __word(str_sub(s, start, at)))
        start = at + str_size(sep)
        maxsplit = maxsplit - 1
        at = find_bytes(s, sep, start)
    list_append(parts, __word(str_sub(s, start, str_size(s))))
    return parts

# After the last split, the remainder keeps its trailing whitespace.
def split_whitespace(s: str, maxsplit: int) -> ptr:
    parts = list_new(0)
    size = str_size(s)
    i = skip_spaces(s, 0)
    while i < size and maxsplit != 0:
        start = i
        while i < size and not is_space(str_byte(s, i)):
            i = i + 1
        list_append(parts, __word(str_sub(s, start, i)))
        maxsplit = maxsplit - 1
        i = skip_spaces(s, i)
    if i < size:
        list_append(parts, __word(str_sub(s, i, size)))
    return parts

def skip_spaces(s: str, i: int) -> int:
    while i < str_size(s) and is_space(str_byte(s, i)):
        i = i + 1
    return i

def str_join(sep: str, items: ptr) -> str:
    count = list_len(items)
    if count == 0:
        return ""
    size = str_size(sep) * (count - 1)
    i = 0
    while i < count:
        size = size + str_size(__str(list_get(items, i)))
        i = i + 1
    s = str_alloc(size)
    at = 16
    i = 0
    while i < count:
        if i > 0:
            memcpy(__offset(s, at), str_bytes(sep), str_size(sep))
            at = at + str_size(sep)
        item = __str(list_get(items, i))
        memcpy(__offset(s, at), str_bytes(item), str_size(item))
        at = at + str_size(item)
        i = i + 1
    return __str(__word(s))

# Decodes the code point from its UTF-8 bytes: the lead byte keeps its low
# 7, 5, 4, or 3 bits and each continuation byte adds 6 more.
def str_ord(s: str) -> int:
    if str_len(s) != 1:
        fail("ValueError", "expected one character")
    size = str_size(s)
    lead = str_byte(s, 0)
    if size == 1:
        return lead
    elif size == 2:
        code = lead - 192
    elif size == 3:
        code = lead - 224
    else:
        code = lead - 240
    i = 1
    while i < size:
        code = code * 64 + str_byte(s, i) - 128
        i = i + 1
    return code

# Encodes the code point as UTF-8: the lead byte carries the high bits and
# each continuation byte, filled from the end, carries 6 more.
def str_chr(n: int) -> str:
    if n < 0 or n > 1114111 or (n >= 55296 and n <= 57343):
        fail("ValueError", "invalid code point")
    if n < 128:
        return repeat_byte(n, 1)
    if n < 2048:
        size = 2
        lead = 192 + n // 64
    elif n < 65536:
        size = 3
        lead = 224 + n // 4096
    else:
        size = 4
        lead = 240 + n // 262144
    s = str_alloc(size)
    __store1(s, 16, lead)
    i = size - 1
    rest = n
    while i > 0:
        __store1(s, 16 + i, 128 + rest % 64)
        rest = rest // 64
        i = i - 1
    return __str(__word(s))

# Bytes share strings' length, data, and trailing zero layout. Only newly
# allocated strings may be retagged; strings held by callers stay strings.
def bytes_tag(s: str) -> ptr:
    data = __ptr(__word(s))
    __store8(data, 0, __word(__type(bytes)))
    return data

def bytes_new(values: ptr) -> ptr:
    size = list_len(values)
    data = str_alloc(size)
    i = 0
    while i < size:
        value = __int(list_get(values, i))
        if value < 0 or value > 255:
            fail("ValueError", "bytes must be in range(0, 256)")
        __store1(data, 16 + i, value)
        i = i + 1
    return bytes_tag(__str(__word(data)))

def str_encode(s: str) -> ptr:
    return bytes_tag(str_sub(s, 0, str_size(s)))

def bytes_decode(data: ptr) -> str:
    return str_from_bytes(__offset(data, 16), str_size(__str(__word(data))))

def bytes_concat(a: ptr, b: ptr) -> ptr:
    return bytes_tag(str_concat(__str(__word(a)), __str(__word(b))))

def bytes_index(data: ptr, i: int) -> int:
    size = str_size(__str(__word(data)))
    if i < 0:
        i = i + size
    if i < 0 or i >= size:
        fail("IndexError", "index out of range")
    return __load1(data, 16 + i)

def bytes_slice(data: ptr, start: int, stop: int) -> ptr:
    s = __str(__word(data))
    start = clamp(start, str_size(s))
    stop = clamp(stop, str_size(s))
    if stop < start:
        stop = start
    return bytes_tag(str_sub(s, start, stop))

def bytes_find(data: ptr, sub: ptr) -> int:
    return find_bytes(__str(__word(data)), __str(__word(sub)), 0)

def bytes_startswith(data: ptr, prefix: ptr) -> bool:
    return str_startswith(__str(__word(data)), __str(__word(prefix)))

def bytes_endswith(data: ptr, suffix: ptr) -> bool:
    return str_endswith(__str(__word(data)), __str(__word(suffix)))

def bytes_contains(data: ptr, value: int) -> bool:
    s = __str(__word(data))
    i = 0
    while i < str_size(s):
        if str_byte(s, i) == value:
            return True
        i = i + 1
    return False

def bytes_split(data: ptr, sep: ptr, maxsplit: int) -> ptr:
    parts = str_split(__str(__word(data)), __str(__word(sep)), maxsplit)
    i = 0
    while i < list_len(parts):
        bytes_tag(__str(list_get(parts, i)))
        i = i + 1
    return parts

def bytes_hex(data: ptr) -> str:
    s = __str(__word(data))
    digits = "0123456789abcdef"
    text = str_alloc(str_size(s) * 2)
    i = 0
    while i < str_size(s):
        b = str_byte(s, i)
        __store1(text, 16 + i * 2, str_byte(digits, b // 16))
        __store1(text, 17 + i * 2, str_byte(digits, b % 16))
        i = i + 1
    return __str(__word(text))

def hex_digit(b: int) -> int:
    if b >= 48 and b <= 57:
        return b - 48
    if b >= 65 and b <= 70:
        return b - 65 + 10
    if b >= 97 and b <= 102:
        return b - 97 + 10
    return -1

def bytes_fromhex(text: str) -> ptr:
    data = str_alloc(str_size(text) // 2)
    size = 0
    i = skip_spaces(text, 0)
    while i < str_size(text):
        if i + 1 == str_size(text):
            fail("ValueError", "invalid hex string")
        high = hex_digit(str_byte(text, i))
        low = hex_digit(str_byte(text, i + 1))
        if high < 0 or low < 0:
            fail("ValueError", "invalid hex string")
        __store1(data, 16 + size, high * 16 + low)
        size = size + 1
        i = skip_spaces(text, i + 2)
    __store8(data, 8, __word(size))
    __store1(data, 16 + size, 0)
    return bytes_tag(__str(__word(data)))

# A list is a header word pointing at the list descriptor, the length, the
# capacity, and a pointer to an array of `capacity` slots. Slots may hold
# pointers, so the array is scanned memory.

def list_slots(xs: ptr) -> ptr:
    return __ptr(__load8(xs, 24))

def list_capacity(xs: ptr) -> int:
    return __int(__load8(xs, 16))

def set_list_len(xs: ptr, length: int):
    __store8(xs, 8, __word(length))

def list_new(capacity: int) -> ptr:
    if capacity < 4:
        capacity = 4
    xs = __alloc(32)
    __store8(xs, 0, __word(__type(list)))
    __store8(xs, 8, __word(0))
    __store8(xs, 16, __word(capacity))
    __store8(xs, 24, __word(__alloc(capacity * 8)))
    return xs

def list_len(xs: ptr) -> int:
    return __int(__load8(xs, 8))

# `i` made non-negative by adding the length once, which must then be a valid
# index (spec §7).
def list_index(xs: ptr, i: int) -> int:
    if i < 0:
        i = i + list_len(xs)
    if i < 0 or i >= list_len(xs):
        fail("IndexError", "list index out of range")
    return i

def list_get(xs: ptr, i: int) -> word:
    return __load8(list_slots(xs), list_index(xs, i) * 8)

def list_set(xs: ptr, i: int, value: word):
    __store8(list_slots(xs), list_index(xs, i) * 8, value)

def list_append(xs: ptr, value: word):
    length = list_len(xs)
    if length == list_capacity(xs):
        slots = __alloc(length * 2 * 8)
        memcpy(slots, list_slots(xs), length * 8)
        __store8(xs, 16, __word(length * 2))
        __store8(xs, 24, __word(slots))
    __store8(list_slots(xs), length * 8, value)
    set_list_len(xs, length + 1)

def list_pop(xs: ptr) -> word:
    length = list_len(xs)
    if length == 0:
        fail("IndexError", "pop from empty list")
    value = __load8(list_slots(xs), (length - 1) * 8)
    # Clear the slot so the collector does not keep its value alive.
    __store8(list_slots(xs), (length - 1) * 8, __word(0))
    set_list_len(xs, length - 1)
    return value

# Copying `items` first makes `xs.extend(xs)` append the original elements
# once (spec §7).
def list_extend(xs: ptr, items: ptr):
    copy = list_slice(items, 0, list_len(items))
    i = 0
    while i < list_len(copy):
        list_append(xs, list_get(copy, i))
        i = i + 1

def list_reverse(xs: ptr):
    low = 0
    high = list_len(xs) - 1
    while low < high:
        value = list_get(xs, low)
        list_set(xs, low, list_get(xs, high))
        list_set(xs, high, value)
        low = low + 1
        high = high - 1

def list_slice(xs: ptr, start: int, stop: int) -> ptr:
    start = clamp(start, list_len(xs))
    stop = clamp(stop, list_len(xs))
    if stop < start:
        stop = start
    result = list_new(stop - start)
    memcpy(list_slots(result), __offset(list_slots(xs), start * 8), (stop - start) * 8)
    set_list_len(result, stop - start)
    return result

# Equality of two slots by the equality kinds in API.md.
def slots_equal(a: word, b: word, kind: int) -> bool:
    if kind == 1:
        return __float(a) == __float(b)
    if kind == 2:
        return str_eq(__str(a), __str(b))
    if kind == 3:
        return union_eq(__ptr(a), __ptr(b))
    if kind == 4:
        return tuple_eq(__ptr(a), __ptr(b))
    return __int(a) == __int(b)

def list_contains(xs: ptr, value: word, kind: int) -> bool:
    i = 0
    while i < list_len(xs):
        if slots_equal(list_get(xs, i), value, kind):
            return True
        i = i + 1
    return False

# The order of two sort keys of equality kind `kind`, neither holding NaN:
# negative when a sorts before b, zero when they are equal, and positive
# otherwise. A tuple's own kinds describe its positions.
def slots_order(a: word, b: word, kind: int) -> int:
    if kind == 1:
        x = __float(a)
        y = __float(b)
        if x < y:
            return -1
        if x > y:
            return 1
        return 0
    if kind == 2:
        return str_compare(__str(a), __str(b))
    if kind == 4:
        left = __ptr(a)
        kinds = __ptr(__load8(left, 16))
        i = 0
        while i < tuple_len(left):
            order = slots_order(tuple_get(left, i), tuple_get(__ptr(b), i), __int(__load8(kinds, i * 8)))
            if order != 0:
                return order
            i = i + 1
        return 0
    if __int(a) < __int(b):
        return -1
    if __int(a) > __int(b):
        return 1
    return 0

def slot_has_nan(value: word, kind: int) -> bool:
    if kind == 1:
        return __float(value) != __float(value)
    if kind == 4:
        t = __ptr(value)
        kinds = __ptr(__load8(t, 16))
        i = 0
        while i < tuple_len(t):
            if slot_has_nan(tuple_get(t, i), __int(__load8(kinds, i * 8))):
                return True
            i = i + 1
    return False

# Whether `xs` differs in length or in any slot from `snapshot`, its copy
# from before a sort ran the key function.
def list_changed(xs: ptr, snapshot: ptr) -> bool:
    if list_len(xs) != list_len(snapshot):
        return True
    i = 0
    while i < list_len(xs):
        if __int(list_get(xs, i)) != __int(list_get(snapshot, i)):
            return True
        i = i + 1
    return False

# Sorts `xs` in place by `keys`, which holds a sort key of equality kind
# `kind` for each element and may be `xs` itself. The merge sort is stable,
# and `reverse` swaps only the comparison, so equal keys keep their order
# either way. A NaN key fails before anything moves.
def list_sort(xs: ptr, keys: ptr, kind: int, reverse: bool):
    n = list_len(keys)
    i = 0
    while i < n:
        if slot_has_nan(list_get(keys, i), kind):
            fail("ValueError", "cannot sort NaN")
            return
        i = i + 1
    order = __alloc_atomic(n * 8)
    spare = __alloc_atomic(n * 8)
    i = 0
    while i < n:
        __store8(order, i * 8, __word(i))
        i = i + 1
    width = 1
    while width < n:
        start = 0
        while start < n:
            merge_runs(order, spare, keys, kind, reverse, start, width)
            start = start + 2 * width
        swap = order
        order = spare
        spare = swap
        width = width * 2
    values = list_slice(xs, 0, n)
    i = 0
    while i < n:
        list_set(xs, i, list_get(values, __int(__load8(order, i * 8))))
        i = i + 1

# Merges the run of `width` indexes at `start` in `source` with the run
# after it into `target`, taking from the second run only when its key
# sorts strictly first.
def merge_runs(source: ptr, target: ptr, keys: ptr, kind: int, reverse: bool, start: int, width: int):
    n = list_len(keys)
    middle = start + width
    if middle > n:
        middle = n
    stop = middle + width
    if stop > n:
        stop = n
    left = start
    right = middle
    at = start
    while at < stop:
        from_right = left == middle
        if not from_right and right < stop:
            order = slots_order(list_get(keys, __int(__load8(source, right * 8))), list_get(keys, __int(__load8(source, left * 8))), kind)
            from_right = order < 0 and not reverse or order > 0 and reverse
        if from_right:
            __store8(target, at * 8, __load8(source, right * 8))
            right = right + 1
        else:
            __store8(target, at * 8, __load8(source, left * 8))
            left = left + 1
        at = at + 1

# UTF-8 validation for text from outside the program. A code point is one to
# four bytes; the ranges for the second byte rule out overlong forms,
# surrogates, and values above U+10FFFF.

# The size of the valid UTF-8 code point at byte `i` of the `size` bytes at
# `p`, or 0 if none starts there.
def utf8_char_size(p: ptr, i: int, size: int) -> int:
    lead = __load1(p, i)
    low = 128
    high = 191
    if lead < 128:
        return 1
    elif lead < 194:
        return 0
    elif lead < 224:
        count = 2
    elif lead < 240:
        count = 3
        if lead == 224:
            low = 160
        elif lead == 237:
            high = 159
    elif lead < 245:
        count = 4
        if lead == 240:
            low = 144
        elif lead == 244:
            high = 143
    else:
        return 0
    if i + count > size:
        return 0
    second = __load1(p, i + 1)
    if second < low or second > high:
        return 0
    j = 2
    while j < count:
        if not is_continuation(__load1(p, i + j)):
            return 0
        j = j + 1
    return count

def utf8_valid(p: ptr, size: int) -> bool:
    i = 0
    while i < size:
        count = utf8_char_size(p, i, size)
        if count == 0:
            return False
        i = i + count
    return True

# A new string holding a copy of the `size` bytes at `p`, which must be valid
# UTF-8.
def str_from_bytes(p: ptr, size: int) -> str:
    if not utf8_valid(p, size):
        fail("ValueError", "invalid UTF-8")
    s = str_alloc(size)
    memcpy(__offset(s, 16), p, size)
    return __str(__word(s))

def input_line() -> str | None:
    capacity = 128
    size = 0
    buf = __alloc_atomic(capacity)
    count = read(0, buf, 1)
    while count != 0:
        if count < 0:
            fail("OSError", "cannot read input: " + os_reason())
        if __load1(buf, size) == 10:
            if size > 0 and __load1(buf, size - 1) == 13:
                size = size - 1
            return str_from_bytes(buf, size)
        size = size + 1
        if size == capacity:
            larger = __alloc_atomic(capacity * 2)
            memcpy(larger, buf, size)
            buf = larger
            capacity = capacity * 2
        count = read(0, __offset(buf, size), 1)
    if size == 0:
        return None
    return str_from_bytes(buf, size)

def sys_args(argc: int, argv: ptr) -> ptr:
    args = list_new(argc)
    i = 1
    while i < argc:
        arg = __ptr(__load8(argv, i * 8))
        list_append(args, __word(str_from_bytes(arg, strlen(arg))))
        i = i + 1
    return args

# Output is unbuffered, so there is nothing to flush.
def sys_exit(status: int):
    if status < 0 or status > 255:
        fail("ValueError", "exit status out of range")
    exit(status)

# The path's bytes, which libc reads up to the string's trailing zero byte.
def path_bytes(path: str) -> ptr:
    if strlen(str_bytes(path)) != str_size(path):
        fail("ValueError", "path contains a NUL character")
    return str_bytes(path)

# libc reaches the calling thread's errno through a function whose name
# depends on the system. Stage 0 emits only the branch for the target, so the
# other function is never linked.
def errno() -> int:
    if __os == "darwin":
        return __load4(__error(), 0)
    else:
        return __load4(__errno_location(), 0)

# The strerror text for the current errno. It is read before anything else
# runs, since allocating may change errno.
def os_reason() -> str:
    text = strerror(errno())
    return str_from_bytes(text, strlen(text))

# Reports `cannot <action> <path>: <reason>` as a fatal OSError.
def fail_os(action: str, path: str):
    reason = os_reason()
    fail("OSError", "cannot " + action + " " + path + ": " + reason)

# open flags. O_RDONLY is 0 on both systems.
def write_flags() -> int:
    # O_WRONLY | O_CREAT | O_TRUNC
    if __os == "linux":
        return 1 + 64 + 512
    return 1 + 512 + 1024

def fs_read_file(path: str) -> str:
    fd = open(path_bytes(path), 0)
    if fd < 0:
        fail_os("read", path)
    capacity = 4096
    size = 0
    buf = __alloc_atomic(capacity)
    count = read(fd, buf, capacity)
    while count != 0:
        if count < 0:
            fail_os("read", path)
        size = size + count
        if size == capacity:
            larger = __alloc_atomic(capacity * 2)
            memcpy(larger, buf, size)
            buf = larger
            capacity = capacity * 2
        count = read(fd, __offset(buf, size), capacity - size)
    close(fd)
    return str_from_bytes(buf, size)

def fs_write_file(path: str, text: str):
    # 438 is mode 0666, which the umask then restricts.
    fd = open(path_bytes(path), write_flags(), 438)
    if fd < 0:
        fail_os("write", path)
    done = 0
    while done < str_size(text):
        written = write(fd, __offset(str_bytes(text), done), str_size(text) - done)
        if written < 0:
            fail_os("write", path)
        done = done + written
    if close(fd) < 0:
        fail_os("write", path)

# ENOENT and ENOTDIR are 2 and 20 on both systems. access with F_OK, 0,
# fails as stat would.
def fs_exists(path: str) -> bool:
    if access(path_bytes(path), 0) == 0:
        return True
    code = errno()
    if code != 2 and code != 20:
        fail_os("stat", path)
    return False

# PATH_MAX is 4096 on Linux and 1024 on macOS, so 4096 bytes hold any result.
def fs_realpath(path: str) -> str:
    buf = __alloc_atomic(4096)
    if __addr_is_null(realpath(path_bytes(path), buf)):
        fail_os("resolve", path)
    return str_from_bytes(buf, strlen(buf))

# The process's environment, a C array of strings. L0 cannot name the C
# variable environ, so Darwin's accessor function or, on Linux, dlsym with
# RTLD_DEFAULT, 0, finds it. glibc has dlsym in libc itself since 2.34.
def environment() -> ptr:
    if __os == "darwin":
        return __ptr(__load8(_NSGetEnviron(), 0))
    else:
        return __ptr(__load8(dlsym(__ptr(__word(0)), str_bytes("environ")), 0))

# The target's operating system, for stage 1's driver.
def os() -> str:
    return __os

# Runs args[0], found in PATH, with the remaining arguments, without a shell,
# and returns its exit status, or 128 plus the signal number if a signal ended
# it. The child inherits stdin, stdout, stderr, and the environment.
def run(args: list[str]) -> int:
    if len(args) == 0 or args[0] == "":
        fail("ValueError", "args must contain a nonempty executable name")
    argv = __alloc((len(args) + 1) * 8)
    i = 0
    for arg in args:
        if strlen(str_bytes(arg)) != str_size(arg):
            fail("ValueError", "argument contains a NUL character")
        __store8(argv, i * 8, __word(str_bytes(arg)))
        i = i + 1
    __store8(argv, i * 8, __word(0))
    # posix_spawnattr_t is 336 bytes in glibc and a pointer on Darwin, and
    # sigset_t 128 bytes and 4. init ignores SIGPIPE, which a child would
    # inherit, so the child gets SIGPIPE's default action back through
    # POSIX_SPAWN_SETSIGDEF, 4. SIGPIPE is 13 on both systems.
    attributes = __alloc_atomic(512)
    signals = __alloc_atomic(128)
    posix_spawnattr_init(attributes)
    sigemptyset(signals)
    sigaddset(signals, 13)
    posix_spawnattr_setsigdefault(attributes, signals)
    posix_spawnattr_setflags(attributes, 4)
    pid = __alloc_atomic(8)
    code = posix_spawnp(pid, str_bytes(args[0]), __ptr(__word(0)), attributes, argv, environment())
    posix_spawnattr_destroy(attributes)
    if code != 0:
        reason = strerror(code)
        fail("OSError", "cannot run " + args[0] + ": " + str_from_bytes(reason, strlen(reason)))
    status = __alloc_atomic(8)
    # EINTR is 4 on both systems.
    while waitpid(__load4(pid, 0), status, 0) < 0:
        if errno() != 4:
            fail_os("wait for", args[0])
    # The low 7 bits of a wait status are 0 for a normal exit, whose code is
    # the next 8 bits, and otherwise the signal number; without WUNTRACED no
    # child is reported as stopped.
    value = __load4(status, 0)
    if value % 128 == 0:
        return value // 256 % 256
    return 128 + value % 128

# An optional sign and one or more decimal digits (spec §6). The magnitude is
# checked before each step so it never leaves the int range, which is
# symmetric, so both signs share the limit 9223372036854775807. The first
# byte of an empty string is its trailing zero byte.
def str_to_int(s: str) -> int:
    size = str_size(s)
    negative = str_byte(s, 0) == 45
    i = 0
    if negative or str_byte(s, 0) == 43:
        i = 1
    if i == size:
        fail("ValueError", "cannot convert str to int")
    value = 0
    while i < size:
        b = str_byte(s, i)
        if not is_digit(b):
            fail("ValueError", "cannot convert str to int")
        digit = b - 48
        if value > 922337203685477580 or (value == 922337203685477580 and digit > 7):
            fail("ValueError", "cannot convert str to int")
        value = value * 10 + digit
        i = i + 1
    if negative:
        return -value
    return value

# An enum's descriptor holds its name and then one str per member, in
# declaration order.
def enum_to_str(descriptor: ptr, ordinal: int) -> str:
    return __str(__load8(descriptor, 8 + ordinal * 8))

# A box is a header word and a payload word. Only scalars are boxed, and the
# header points at static data, so the collector need not scan a box.
def box(descriptor: ptr, value: word) -> ptr:
    b = __alloc_atomic(16)
    __store8(b, 0, __word(descriptor))
    __store8(b, 8, value)
    return b

def unbox(value: ptr) -> word:
    return __load8(value, 8)

def is_instance(value: ptr, descriptor: ptr) -> bool:
    return not __addr_is_null(value) and __ptr(__load8(value, 0)) == descriptor

# __alloc returns zeroed memory, so the fields start as zero.
def object_new(descriptor: ptr, fields: int) -> ptr:
    object = __alloc(8 + fields * 8)
    __store8(object, 0, __word(descriptor))
    return object

# Positions keep their static representation. The equality kinds describe
# those slots so union equality can compare tuples without static types.
def tuple_new(length: int, kinds: ptr) -> ptr:
    value = __alloc(24 + length * 8)
    __store8(value, 0, __word(__type(tuple)))
    __store8(value, 8, __word(length))
    __store8(value, 16, __word(kinds))
    return value

def tuple_len(value: ptr) -> int:
    return __int(__load8(value, 8))

def tuple_get(value: ptr, position: int) -> word:
    return __load8(value, 24 + position * 8)

def tuple_set(value: ptr, position: int, item: word):
    __store8(value, 24 + position * 8, item)

def tuple_eq(a: ptr, b: ptr) -> bool:
    if tuple_len(a) != tuple_len(b):
        return False
    a_kinds = __ptr(__load8(a, 16))
    b_kinds = __ptr(__load8(b, 16))
    i = 0
    while i < tuple_len(a):
        left = tuple_get(a, i)
        right = tuple_get(b, i)
        a_kind = __int(__load8(a_kinds, i * 8))
        b_kind = __int(__load8(b_kinds, i * 8))
        if a_kind == b_kind:
            equal = slots_equal(left, right, a_kind)
        else:
            # Only references and None widen without changing their slots.
            equal = union_eq(__ptr(left), __ptr(right))
        if not equal:
            return False
        i = i + 1
    return True

# A dict keeps its entries in insertion order in an array of three slots per
# entry: the key, the value, and 1 while the entry is live. Removing a key
# clears its entry and marks it dead. A hash index of entry numbers, -1 when
# empty, finds keys by linear probing. Growing compacts the entries and
# rebuilds the index, which keeps at least twice as many slots as there are
# entries, so it never fills. Entry numbers change only when the version
# does, so iteration by entry number stays valid until it fails.
#
# The object is the header, the key kind, the number of live keys, the
# version, the entries array, the number of entries used, the entries
# capacity, the index array, and the index size.

def dict_slot(d: ptr, field: int) -> int:
    return __int(__load8(d, field * 8))

def set_dict_slot(d: ptr, field: int, value: int):
    __store8(d, field * 8, __word(value))

def dict_entries(d: ptr) -> ptr:
    return __ptr(__load8(d, 32))

def dict_index(d: ptr) -> ptr:
    return __ptr(__load8(d, 56))

def dict_new(key_kind: int) -> ptr:
    d = __alloc(72)
    __store8(d, 0, __word(__type(dict)))
    set_dict_slot(d, 1, key_kind)
    dict_allocate(d, 8)
    return d

# Gives `d` an empty entries array of `capacity` and an index for it.
def dict_allocate(d: ptr, capacity: int):
    __store8(d, 32, __word(__alloc(capacity * 24)))
    set_dict_slot(d, 5, 0)
    set_dict_slot(d, 6, capacity)
    size = capacity * 2
    index = __alloc_atomic(size * 8)
    i = 0
    while i < size:
        __store8(index, i * 8, __word(-1))
        i = i + 1
    __store8(d, 56, __word(index))
    set_dict_slot(d, 8, size)

def dict_len(d: ptr) -> int:
    return dict_slot(d, 2)

def dict_version(d: ptr) -> int:
    return dict_slot(d, 3)

def entry_live(d: ptr, entry: int) -> bool:
    return __int(__load8(dict_entries(d), entry * 24 + 16)) == 1

def dict_key_at(d: ptr, entry: int) -> word:
    return __load8(dict_entries(d), entry * 24)

def dict_value_at(d: ptr, entry: int) -> word:
    return __load8(dict_entries(d), entry * 24 + 8)

# A string hash kept below 2^31 at every step, so it never overflows.
def str_hash(s: str) -> int:
    h = 0
    i = 0
    while i < str_size(s):
        h = (h * 31 + str_byte(s, i)) % 2147483647
        i = i + 1
    return h

# The index slot where the search for `key` starts.
def dict_home(d: ptr, key: word) -> int:
    if dict_slot(d, 1) == 2:
        return str_hash(__str(key)) % dict_slot(d, 8)
    return __int(key) % dict_slot(d, 8)

def dict_find(d: ptr, key: word) -> int:
    size = dict_slot(d, 8)
    slot = dict_home(d, key)
    entry = __int(__load8(dict_index(d), slot * 8))
    while entry != -1:
        if entry_live(d, entry) and slots_equal(dict_key_at(d, entry), key, dict_slot(d, 1)):
            return entry
        slot = (slot + 1) % size
        entry = __int(__load8(dict_index(d), slot * 8))
    return -1

# Appends a live entry, which the caller has made room for, and indexes it.
def dict_append(d: ptr, key: word, value: word):
    entry = dict_slot(d, 5)
    entries = dict_entries(d)
    __store8(entries, entry * 24, key)
    __store8(entries, entry * 24 + 8, value)
    __store8(entries, entry * 24 + 16, __word(1))
    set_dict_slot(d, 5, entry + 1)
    slot = dict_home(d, key)
    while __int(__load8(dict_index(d), slot * 8)) != -1:
        slot = (slot + 1) % dict_slot(d, 8)
    __store8(dict_index(d), slot * 8, __word(entry))

# Rebuilds `d` with room for twice its live keys, dropping dead entries.
def dict_grow(d: ptr):
    entries = dict_entries(d)
    used = dict_slot(d, 5)
    dict_allocate(d, dict_len(d) * 2 + 8)
    entry = 0
    while entry < used:
        if __int(__load8(entries, entry * 24 + 16)) == 1:
            dict_append(d, __load8(entries, entry * 24), __load8(entries, entry * 24 + 8))
        entry = entry + 1

# Replacing the value of an existing key keeps its position and the version.
def dict_set(d: ptr, key: word, value: word):
    entry = dict_find(d, key)
    if entry >= 0:
        __store8(dict_entries(d), entry * 24 + 8, value)
        return
    if dict_slot(d, 5) == dict_slot(d, 6):
        dict_grow(d)
    dict_append(d, key, value)
    set_dict_slot(d, 2, dict_len(d) + 1)
    set_dict_slot(d, 3, dict_version(d) + 1)

def dict_get(d: ptr, key: word) -> word:
    entry = dict_find(d, key)
    if entry < 0:
        fail("KeyError", "key not found")
    return dict_value_at(d, entry)

def dict_contains(d: ptr, key: word) -> bool:
    return dict_find(d, key) >= 0

# The dead entry stays in the index so later probes pass over it. Clearing
# its key and value lets the collector free them.
def dict_pop(d: ptr, key: word) -> word:
    entry = dict_find(d, key)
    if entry < 0:
        fail("KeyError", "key not found")
    value = dict_value_at(d, entry)
    entries = dict_entries(d)
    __store8(entries, entry * 24, __word(0))
    __store8(entries, entry * 24 + 8, __word(0))
    __store8(entries, entry * 24 + 16, __word(0))
    set_dict_slot(d, 2, dict_len(d) - 1)
    set_dict_slot(d, 3, dict_version(d) + 1)
    return value

def dict_next(d: ptr, entry: int, version: int) -> int:
    if dict_version(d) != version:
        fail("RuntimeError", "dictionary changed size during iteration")
    while entry < dict_slot(d, 5):
        if entry_live(d, entry):
            return entry
        entry = entry + 1
    return -1

# Core's own tests cannot use intrinsics, so they pass collection elements
# through these.

def int_word(n: int) -> word:
    return __word(n)

def word_int(w: word) -> int:
    return __int(w)

def str_word(s: str) -> word:
    return __word(s)

def word_str(w: word) -> str:
    return __str(w)

# The largest float, which is finite.
def float_max() -> float:
    return 1.7976931348623157e308

# 2^63 is out of range, and so is -2^63 because the int range is symmetric.
# Every float strictly between them truncates into range.
def float_to_int(x: float) -> int:
    if x != x or x >= 9223372036854775808.0 or x <= -9223372036854775808.0:
        fail("ValueError", "cannot convert float to int")
    return __dtosi(x)

# The remainder and floor quotient follow CPython's float_rem and
# float_divmod, so results match Python, including signed zeros and
# infinities.

def float_mod(a: float, b: float) -> float:
    if b == 0.0:
        fail("ZeroDivisionError", "division by zero")
    mod = fmod(a, b)
    if mod == 0.0:
        return copysign(0.0, b)
    if (b < 0.0) != (mod < 0.0):
        return mod + b
    return mod

def float_floordiv(a: float, b: float) -> float:
    if b == 0.0:
        fail("ZeroDivisionError", "division by zero")
    mod = fmod(a, b)
    quotient = (a - mod) / b
    if mod != 0.0 and (b < 0.0) != (mod < 0.0):
        quotient = quotient - 1.0
    if quotient == 0.0:
        return copysign(0.0, a / b)
    result = floor(quotient)
    if quotient - result > 0.5:
        return result + 1.0
    return result

# `x` written by snprintf with `format`, which converts one float.
def format_float(format: str, x: float) -> str:
    buf = __alloc_atomic(32)
    snprintf(buf, 32, str_bytes(format), x)
    return str_from_bytes(buf, strlen(buf))

def format_fixed(x: float, precision: int) -> str:
    if x != x or x > float_max() or x < -float_max():
        return float_to_str(x)
    size = 330 + precision
    result = str_alloc(size)
    length = snprintf(__offset(result, 16), size, str_bytes("%." + int_to_str(precision) + "f"), x)
    __store8(result, 8, __word(length))
    return __str(__word(result))

def str_to_float_unchecked(s: str) -> float:
    return strtod(str_bytes(s), __ptr(__word(0)))

# Python's repr: the shortest decimal that reads back as `x` (spec §7). The
# search starts at one significant digit rather than the 15 that suffice for
# normal floats, because subnormals such as 5e-324 have fewer. At a power of
# two the gap below `x` is half the gap above, so the nearest decimal of a
# length may miss while the next one up in magnitude reads back; repr picks
# that one. 17 digits always read back.
def float_to_str(x: float) -> str:
    if x != x:
        return "nan"
    if x > float_max():
        return "inf"
    if x < -float_max():
        return "-inf"
    precision = 0
    while precision < 16:
        text = format_float("%." + int_to_str(precision) + "e", x)
        if str_to_float_unchecked(text) == x:
            return repr_text(text)
        up = next_decimal(text)
        if str_to_float_unchecked(up) == x:
            return repr_text(up)
        precision = precision + 1
    return repr_text(format_float("%.16e", x))

# The decimal after `text` in magnitude with the same number of significant
# digits, in the same `[-]d.ddde[+-]X` form.
def next_decimal(text: str) -> str:
    sign = ""
    if str_startswith(text, "-"):
        sign = "-"
        text = str_removeprefix(text, "-")
    e = str_find(text, "e")
    exponent = str_to_int(str_slice(text, e + 1, str_len(text)))
    digits = str_replace(str_slice(text, 0, e), ".", "")
    count = str_size(digits)
    i = count - 1
    while i >= 0:
        b = str_byte(digits, i)
        if b != 57:
            digits = str_sub(digits, 0, i) + repeat_byte(b + 1, 1) + repeat_byte(48, count - i - 1)
            return sign + mantissa_text(digits) + "e" + int_to_str(exponent)
        i = i - 1
    # All nines, so the result is 1 followed by zeros, one power of ten up.
    return sign + mantissa_text("1" + repeat_byte(48, count - 1)) + "e" + int_to_str(exponent + 1)

# `d.ddd` from the digits `dddd`.
def mantissa_text(digits: str) -> str:
    if str_size(digits) == 1:
        return digits
    return str_sub(digits, 0, 1) + "." + str_sub(digits, 1, str_size(digits))

# Rewrites snprintf's `[-]d.ddde[+-]XX` the way repr writes it: fixed notation
# when the decimal exponent is from -4 through 15, with at least one digit
# after the point, and otherwise `d.ddde[+-]XX` without trailing zeros.
def repr_text(text: str) -> str:
    sign = ""
    if str_startswith(text, "-"):
        sign = "-"
        text = str_removeprefix(text, "-")
    e = str_find(text, "e")
    exponent = str_to_int(str_slice(text, e + 1, str_len(text)))
    digits = without_trailing_zeros(str_replace(str_slice(text, 0, e), ".", ""))
    count = str_size(digits)
    if exponent < -4 or exponent >= 16:
        return sign + scientific(digits, exponent)
    if exponent < 0:
        return sign + "0." + repeat_byte(48, -1 - exponent) + digits
    if count <= exponent + 1:
        return sign + digits + repeat_byte(48, exponent + 1 - count) + ".0"
    return sign + str_sub(digits, 0, exponent + 1) + "." + str_sub(digits, exponent + 1, count)

# `digits` without trailing zeros, keeping at least one digit.
def without_trailing_zeros(digits: str) -> str:
    stop = str_size(digits)
    while stop > 1:
        if str_byte(digits, stop - 1) != 48:
            return str_sub(digits, 0, stop)
        stop = stop - 1
    return str_sub(digits, 0, 1)

def scientific(digits: str, exponent: int) -> str:
    text = mantissa_text(digits)
    if exponent < 0:
        text = text + "e-"
        exponent = -exponent
    else:
        text = text + "e+"
    if exponent < 10:
        text = text + "0"
    return text + int_to_str(exponent)

def ascii_lower(s: str) -> str:
    result = str_alloc(str_size(s))
    i = 0
    while i < str_size(s):
        b = str_byte(s, i)
        if b >= 65 and b <= 90:
            b = b + 32
        __store1(result, 16 + i, b)
        i = i + 1
    return __str(__word(result))

# The first index at or after `i` that does not hold a digit. Reading the
# byte at the string's size is safe: it is the trailing zero byte.
def skip_digits(s: str, i: int) -> int:
    while is_digit(str_byte(s, i)):
        i = i + 1
    return i

# Digits with an optional fraction and exponent, as in `7`, `2.5`, `.5`,
# `5.`, and `1e-3`, with at least one digit before the exponent.
def is_decimal(s: str) -> bool:
    i = skip_digits(s, 0)
    count = i
    if str_byte(s, i) == 46:
        stop = skip_digits(s, i + 1)
        count = count + stop - i - 1
        i = stop
    if count == 0:
        return False
    b = str_byte(s, i)
    if b != 101 and b != 69:
        return i == str_size(s)
    i = i + 1
    b = str_byte(s, i)
    if b == 43 or b == 45:
        i = i + 1
    if not is_digit(str_byte(s, i)):
        return False
    return skip_digits(s, i) == str_size(s)

# An optional sign and then a decimal number or `inf`, `infinity`, or `nan`
# in any case (spec §6). strtod reads exactly that text, and also forms such
# as hexadecimal that this check rejects first.
def str_to_float(s: str) -> float:
    rest = s
    if str_startswith(s, "+"):
        rest = str_removeprefix(s, "+")
    elif str_startswith(s, "-"):
        rest = str_removeprefix(s, "-")
    word = ascii_lower(rest)
    if word == "inf" or word == "infinity" or word == "nan":
        return str_to_float_unchecked(s)
    if not is_decimal(rest):
        fail("ValueError", "cannot convert str to float")
    return str_to_float_unchecked(s)

# A union value is 0 for None, a str as itself, and any other printable scalar
# as a box, so its header tells which member it holds. Comparable tuples
# retain their own header and position representations.

def header(value: ptr) -> ptr:
    return __ptr(__load8(value, 0))

def union_eq(a: ptr, b: ptr) -> bool:
    if __addr_is_null(a) or __addr_is_null(b):
        return __addr_is_null(a) and __addr_is_null(b)
    if header(a) != header(b):
        return False
    if header(a) == __type(str) or header(a) == __type(bytes):
        return str_eq(__str(__word(a)), __str(__word(b)))
    if header(a) == __type(float):
        return __float(unbox(a)) == __float(unbox(b))
    if header(a) == __type(tuple):
        return tuple_eq(a, b)
    return __int(unbox(a)) == __int(unbox(b))

def union_to_str(value: ptr) -> str:
    if __addr_is_null(value):
        return "None"
    kind = header(value)
    if kind == __type(str):
        return __str(__word(value))
    if kind == __type(int):
        return int_to_str(__int(unbox(value)))
    if kind == __type(float):
        return float_to_str(__float(unbox(value)))
    if kind == __type(bool):
        return bool_to_str(__bool(unbox(value)))
    return enum_to_str(kind, __int(unbox(value)))

# Iterator state keeps raw slots; emitted adapters supply static conversions.
# source, cursor, exhausted, dictionary version, range stop, range step,
# second zip iterator, and enumerate's count-overflow flag.
def iterator_state(source: ptr, version: int) -> ptr:
    state = __alloc(64)
    __store8(state, 0, __word(source))
    __store8(state, 8, __word(0))
    __store8(state, 16, __word(False))
    __store8(state, 24, __word(version))
    __store8(state, 32, __word(0))
    __store8(state, 40, __word(0))
    __store8(state, 48, __word(0))
    __store8(state, 56, __word(False))
    return state

def iterator_source(state: ptr) -> ptr:
    return __ptr(__load8(state, 0))

def iterator_cursor(state: ptr) -> int:
    return __int(__load8(state, 8))

def iterator_set_cursor(state: ptr, cursor: int):
    __store8(state, 8, __word(cursor))

def iterator_exhaust(state: ptr):
    __store8(state, 16, __word(True))
    fail("StopIteration", "")

def iterator_check(state: ptr):
    if __bool(__load8(state, 16)):
        fail("StopIteration", "")

def iterator_list_next(state: ptr) -> word:
    iterator_check(state)
    source = iterator_source(state)
    cursor = iterator_cursor(state)
    if cursor >= list_len(source):
        iterator_exhaust(state)
    iterator_set_cursor(state, cursor + 1)
    return list_get(source, cursor)

def iterator_tuple_next(state: ptr) -> word:
    iterator_check(state)
    source = iterator_source(state)
    cursor = iterator_cursor(state)
    if cursor >= tuple_len(source):
        iterator_exhaust(state)
    iterator_set_cursor(state, cursor + 1)
    return tuple_get(source, cursor)

def iterator_str_next(state: ptr) -> str:
    iterator_check(state)
    source = __str(__word(iterator_source(state)))
    cursor = iterator_cursor(state)
    if cursor >= str_size(source):
        iterator_exhaust(state)
    value = str_char_at(source, cursor)
    iterator_set_cursor(state, cursor + str_size(value))
    return value

def iterator_bytes_next(state: ptr) -> int:
    iterator_check(state)
    source = __str(__word(iterator_source(state)))
    cursor = iterator_cursor(state)
    if cursor >= str_size(source):
        iterator_exhaust(state)
    iterator_set_cursor(state, cursor + 1)
    return str_byte(source, cursor)

def iterator_dict_next(state: ptr) -> int:
    iterator_check(state)
    source = iterator_source(state)
    entry = dict_next(source, iterator_cursor(state), __int(__load8(state, 24)))
    if entry < 0:
        iterator_exhaust(state)
    iterator_set_cursor(state, entry + 1)
    return entry

def range_new(first: int, stop: int, step: int) -> ptr:
    if step == 0:
        fail("ValueError", "range step must not be zero")
    value = __alloc(24)
    __store8(value, 0, __word(first))
    __store8(value, 8, __word(stop))
    __store8(value, 16, __word(step))
    return value

def range_iter(value: ptr) -> ptr:
    state = iterator_state(value, 0)
    iterator_set_cursor(state, __int(__load8(value, 0)))
    __store8(state, 32, __load8(value, 8))
    __store8(state, 40, __load8(value, 16))
    return state

def iterator_range_next(state: ptr) -> int:
    iterator_check(state)
    current = iterator_cursor(state)
    stop = __int(__load8(state, 32))
    step = __int(__load8(state, 40))
    if (step > 0 and current >= stop) or (step < 0 and current <= stop):
        iterator_exhaust(state)
    if (step > 0 and current > 0 and step > 9223372036854775807 - current) or (step < 0 and current < 0 and step < -9223372036854775807 - current):
        __store8(state, 16, __word(True))
    else:
        iterator_set_cursor(state, current + step)
    return current

def iterator_zip_state(left: ptr, right: ptr) -> ptr:
    state = iterator_state(left, 0)
    __store8(state, 48, __word(right))
    return state

def iterator_right(state: ptr) -> ptr:
    return __ptr(__load8(state, 48))

def iterator_enumerate_state(source: ptr, start: int) -> ptr:
    state = iterator_state(source, 0)
    iterator_set_cursor(state, start)
    return state

# A terminal count is valid; overflow matters only after producing another item.
def iterator_enumerate_count(state: ptr) -> int:
    if __bool(__load8(state, 56)):
        fail("OverflowError", "integer overflow")
    count = iterator_cursor(state)
    if count == 9223372036854775807:
        __store8(state, 56, __word(True))
    else:
        iterator_set_cursor(state, count + 1)
    return count

def float_abs(x: float) -> float:
    return copysign(x, 1.0)

def float_round(x: float) -> int:
    if x != x or x >= 9223372036854775808.0 or x <= -9223372036854775808.0:
        fail("ValueError", "cannot round float to int")
    lower = floor(x)
    part = x - lower
    if part > 0.5 or (part == 0.5 and fmod(lower, 2.0) != 0.0):
        lower = lower + 1.0
    if lower >= 9223372036854775808.0 or lower <= -9223372036854775808.0:
        fail("ValueError", "cannot round float to int")
    return __dtosi(lower)

# Async calls hold a body closure; only scheduled tasks allocate stacks.
def async_coroutine(body: ptr) -> ptr:
    fail("RuntimeError", "coroutines require stage 1 on arm64")
    return __ptr(__word(0))

def async_invoke(body: ptr) -> word:
    fail("RuntimeError", "coroutines require stage 1 on arm64")
    return __word(0)

def async_consume(coroutine: ptr) -> ptr:
    if __bool(__load8(coroutine, 16)):
        fail("RuntimeError", "coroutine was already awaited or started")
        return __ptr(__word(0))
    body = __ptr(__load8(coroutine, 8))
    __store8(coroutine, 16, __word(True))
    __store8(coroutine, 8, __word(0))
    return body

def async_await(coroutine: ptr) -> word:
    return async_invoke(async_consume(coroutine))

class AioTask:
    context: CoroutineContext | None
    body: ptr
    result: word
    error: ptr
    wait: int
    # 0 running, 1 done, 2 failed, 3 cancelled.
    state: int
    scope: AioGroup | None
    group: AioGroup | None
    waiters: list[AioWait]
    interruptible: bool
    location: str

class AioGroup:
    # 0 inactive, 1 active (including joining), 2 exited.
    state: int
    parent: AioGroup | None
    count: int
    cancelled: bool
    failure: ptr
    joiner: AioTask | None
    join_wait: int

class AioWait:
    task: AioTask
    id: int
    granted: bool = False

class AioSemaphore:
    value: int
    maximum: int
    waiters: list[AioWait]

class AioTimer:
    at: float
    task: AioTask
    wait: int

class AioLoop:
    current: AioTask | None
    ready: list[AioTask]
    timers: list[AioTimer]
    last_wait: int
    waiting: dict[int, AioTask]

def aio_loop() -> AioLoop:
    fail("RuntimeError", "coroutines require stage 1 on arm64")
    return AioLoop(None, [], [], 0, {})

def aio_set_loop(loop: AioLoop | None):
    fail("RuntimeError", "coroutines require stage 1 on arm64")

def aio_task_address() -> ptr:
    fail("RuntimeError", "coroutines require stage 1 on arm64")
    return __ptr(__word(0))

def aio_sleep_address() -> ptr:
    fail("RuntimeError", "coroutines require stage 1 on arm64")
    return __ptr(__word(0))

# Captures a task's failure instead of unwinding the scheduler.
def aio_resume(task: AioTask):
    fail("RuntimeError", "coroutines require stage 1 on arm64")

def aio_task_run(argument: word):
    task = aio_loop().current
    assert task is not None, "no running task"
    task.result = async_invoke(task.body)

extern def clock_gettime(clock: cint, stamp: ptr) -> cint
extern def poll(fds: ptr, count: int, timeout: cint) -> cint

def aio_now() -> float:
    clock = 1
    if __os == "darwin":
        clock = 6
    stamp = __alloc_atomic(16)
    if clock_gettime(clock, stamp) != 0:
        eprint_str("error: cannot read monotonic clock: " + os_reason())
        exit(1)
    return float(__int(__load8(stamp, 0))) + float(__int(__load8(stamp, 8))) / 1000000000.0

def aio_before(a: AioTimer, b: AioTimer) -> bool:
    return a.at < b.at or a.at == b.at and a.wait < b.wait

def aio_push_timer(loop: AioLoop, timer: AioTimer):
    heap = loop.timers
    i = len(heap)
    heap.append(timer)
    while i > 0:
        parent = (i - 1) // 2
        if not aio_before(heap[i], heap[parent]):
            break
        other = heap[parent]
        heap[parent] = heap[i]
        heap[i] = other
        i = parent

def aio_pop_timer(loop: AioLoop) -> AioTimer:
    heap = loop.timers
    top = heap[0]
    last = heap.pop()
    n = len(heap)
    if n > 0:
        heap[0] = last
        i = 0
        while True:
            child = i * 2 + 1
            if child >= n:
                break
            if child + 1 < n and aio_before(heap[child + 1], heap[child]):
                child = child + 1
            if not aio_before(heap[child], heap[i]):
                break
            other = heap[child]
            heap[child] = heap[i]
            heap[i] = other
            i = child
    return top

def aio_wake(loop: AioLoop, task: AioTask, wait: int):
    if task.wait == wait:
        task.wait = 0
        loop.waiting.pop(wait)
        loop.ready.append(task)

# Polling between ready batches prevents timers from being starved.
def aio_poll(loop: AioLoop):
    timers = loop.timers
    while len(timers) > 0 and timers[0].task.wait != timers[0].wait:
        aio_pop_timer(loop)
    if len(loop.ready) == 0 and len(timers) == 0:
        eprint_str("error: deadlock: all tasks are waiting")
        exit(1)
    timeout = 0
    if len(loop.ready) == 0:
        milliseconds = (timers[0].at - aio_now()) * 1000.0
        if milliseconds >= 2147483647.0:
            timeout = 2147483647
        elif milliseconds > 0.0:
            timeout = __dtosi(milliseconds)
            if float(timeout) < milliseconds:
                timeout = timeout + 1
    if poll(__ptr(__word(0)), 0, timeout) < 0 and errno() != 4:
        eprint_str("error: cannot poll: " + os_reason())
        exit(1)
    now = aio_now()
    while len(timers) > 0 and timers[0].at <= now:
        timer = aio_pop_timer(loop)
        aio_wake(loop, timer.task, timer.wait)

def aio_run(body: ptr) -> word:
    loop = AioLoop(None, [], [], 0, {})
    aio_set_loop(loop)
    root = aio_spawn(async_consume(body), None, "")
    while True:
        batch = loop.ready
        loop.ready = []
        for task in batch:
            loop.current = task
            aio_resume(task)
            context = task.context
            assert context is not None, "task without context"
            if coroutine_finished(context):
                aio_finish(task)
        loop.current = None
        if root.state != 0:
            break
        aio_poll(loop)
    aio_set_loop(None)
    coroutine_set_pending(root.error)
    return root.result

def aio_sleep_coroutine(seconds: float, path: str, line: int, col: int) -> ptr:
    body = object_new(__ptr(__word(0)), 5)
    __store8(body, 8, __word(aio_sleep_address()))
    __store8(body, 16, __word(seconds))
    __store8(body, 24, __word(path))
    __store8(body, 32, __word(line))
    __store8(body, 40, __word(col))
    return async_coroutine(body)

def aio_sleep_body(body: ptr) -> word:
    seconds = __float(__load8(body, 16))
    if not (seconds >= 0.0 and seconds <= 1.7976931348623157e308):
        fail_at("ValueError", "sleep length must be finite and nonnegative", __str(__load8(body, 24)), __int(__load8(body, 32)), __int(__load8(body, 40)))
        return __word(0)
    aio_checkpoint()
    loop = aio_loop()
    task = aio_current()
    wait = aio_wait(True)
    aio_push_timer(loop, AioTimer(aio_now() + seconds, task, wait))
    coroutine_yield(__word(0))
    aio_checkpoint()
    return __word(0)

# Some deferred library operations report their creation site while the frames
# describe the task that eventually ran them.
def fail_at(class_name: str, message: str, path: str, line: int, col: int):
    fail(class_name, message)

def locate(e: ptr, path: str, line: int, col: int):
    __store8(e, 8, __word(path + ":" + int_to_str(line) + ":" + int_to_str(col)))


def aio_cancel() -> ptr:
    return __ptr(__word(0))

def aio_current() -> AioTask:
    task = aio_loop().current
    assert task is not None, "no running task"
    return task

def aio_scope() -> AioGroup | None:
    return aio_current().scope

def aio_set_scope(scope: AioGroup | None):
    task = aio_current()
    task.scope = scope

def aio_pending(task: AioTask) -> bool:
    group = task.scope
    while group is not None:
        if group.cancelled:
            return True
        group = group.parent
    return False

def aio_checkpoint():
    if aio_pending(aio_current()):
        coroutine_set_pending(aio_cancel())

def aio_exception(error: ptr) -> ptr:
    if error == aio_cancel():
        return __ptr(__word(0))
    return error

def aio_wait(interruptible: bool) -> int:
    loop = aio_loop()
    task = aio_current()
    loop.last_wait = loop.last_wait + 1
    task.wait = loop.last_wait
    task.interruptible = interruptible
    loop.waiting[task.wait] = task
    return task.wait

def aio_request(group: AioGroup):
    if group.cancelled:
        return
    group.cancelled = True
    loop = aio_loop()
    woken: list[AioTask] = []
    for id in loop.waiting:
        task = loop.waiting[id]
        if task.interruptible and aio_pending(task):
            woken.append(task)
    for task in woken:
        aio_wake(loop, task, task.wait)

def aio_spawn(body: ptr, group: AioGroup | None, location: str) -> AioTask:
    task = AioTask(None, body, __word(0), __ptr(__word(0)), 0, 0, group, group, [], False, location)
    task.context = coroutine_create(aio_task_address(), __word(0))
    aio_loop().ready.append(task)
    return task

def aio_finish(task: AioTask):
    if __addr_is_null(task.error):
        task.state = 1
    elif task.error == aio_cancel():
        task.state = 3
    else:
        task.state = 2
        if task.location != "":
            frames = ""
            saved_frames = __ptr(__load8(task.error, 16))
            if not __addr_is_null(saved_frames):
                frames = __str(__word(saved_frames))
            if str_find(frames, "\n  in task started at ") < 0:
                __store8(task.error, 16, __word(frames + "\n  in task started at " + task.location))
    task.body = __ptr(__word(0))
    loop = aio_loop()
    group = task.group
    if group is not None:
        group.count = group.count - 1
        if task.state == 2 and __addr_is_null(group.failure):
            group.failure = task.error
            aio_request(group)
        joiner = group.joiner
        if group.count == 0 and joiner is not None:
            aio_wake(loop, joiner, group.join_wait)
    for waiter in task.waiters:
        aio_wake(loop, waiter.task, waiter.id)
    task.waiters = []

def aio_outcome(task: AioTask) -> word:
    if task.state == 1:
        return task.result
    if task.state == 2:
        coroutine_set_pending(task.error)
        return __word(0)
    fail("RuntimeError", "task was cancelled")
    return __word(0)

def aio_task_result(task: AioTask) -> word:
    if task.state == 0:
        fail("RuntimeError", "task is not finished")
        return __word(0)
    return aio_outcome(task)

def aio_await_task(task: AioTask) -> word:
    aio_checkpoint()
    while task.state == 0:
        id = aio_wait(True)
        task.waiters.append(AioWait(aio_current(), id))
        coroutine_yield(__word(0))
        aio_checkpoint()
    return aio_outcome(task)

def aio_task_group() -> AioGroup:
    return AioGroup(0, None, 0, False, __ptr(__word(0)), None, 0)

def aio_group_enter(group: AioGroup):
    if group.state != 0:
        fail("RuntimeError", "task group was already entered")
        return
    task = aio_current()
    group.state = 1
    group.parent = task.scope
    task.scope = group

def aio_group_exit(group: AioGroup, error: ptr) -> ptr:
    task = aio_current()
    task.scope = group.parent
    if not __addr_is_null(error) and error != aio_cancel() and __addr_is_null(group.failure):
        group.failure = error
        aio_request(group)
    while group.count > 0:
        id = aio_wait(False)
        group.joiner = task
        group.join_wait = id
        coroutine_yield(__word(0))
    group.state = 2
    group.joiner = None
    if not __addr_is_null(group.failure):
        return group.failure
    if aio_pending(task):
        return aio_cancel()
    return __ptr(__word(0))

def aio_group_start(group: AioGroup, coroutine: ptr, path: str, line: int, col: int) -> AioTask:
    if group.state != 1 or group.cancelled:
        fail("RuntimeError", "task group is not accepting tasks")
        return AioTask(None, __ptr(__word(0)), __word(0), __ptr(__word(0)), 0, 0, None, None, [], False, "")
    body = async_consume(coroutine)
    group.count = group.count + 1
    return aio_spawn(body, group, path + ":" + int_to_str(line) + ":" + int_to_str(col))

def aio_group_cancel(group: AioGroup):
    if group.state != 1:
        fail("RuntimeError", "task group is not active")
        return
    aio_request(group)

def aio_semaphore(value: int) -> AioSemaphore:
    if value <= 0:
        fail("ValueError", "semaphore value must be positive")
    return AioSemaphore(value, value, [])

def aio_give_permit(semaphore: AioSemaphore):
    while len(semaphore.waiters) > 0:
        waiter = semaphore.waiters[0]
        semaphore.waiters = semaphore.waiters[1:]
        if waiter.task.wait == waiter.id:
            waiter.granted = True
            aio_wake(aio_loop(), waiter.task, waiter.id)
            return
    semaphore.value = semaphore.value + 1

def aio_semaphore_acquire(semaphore: AioSemaphore) -> ptr:
    fail("RuntimeError", "coroutines require stage 1 on arm64")
    return __ptr(__word(0))

def aio_semaphore_body(body: ptr) -> word:
    fail("RuntimeError", "coroutines require stage 1 on arm64")
    return __word(0)

def aio_semaphore_wait(semaphore: AioSemaphore):
    aio_checkpoint()
    if semaphore.value > 0:
        semaphore.value = semaphore.value - 1
        return
    task = aio_current()
    waiter = AioWait(task, aio_wait(True))
    semaphore.waiters.append(waiter)
    coroutine_yield(__word(0))
    if waiter.granted:
        if aio_pending(task):
            aio_give_permit(semaphore)
            coroutine_set_pending(aio_cancel())
        return
    kept: list[AioWait] = []
    for queued in semaphore.waiters:
        if queued.id != waiter.id:
            kept.append(queued)
    semaphore.waiters = kept
    aio_checkpoint()

def aio_semaphore_release(semaphore: AioSemaphore):
    if semaphore.value == semaphore.maximum:
        fail("ValueError", "semaphore released too many times")
        return
    aio_give_permit(semaphore)
