# Checks the bodies of a bound program's functions, the counterpart of
# compiler/check.lua for the part of L0 that stage 1 compiles so far, and
# annotates the tree for the emitter: each checked expression's `ty` and
# `expected`, and the type of each parameter's and local's symbol. Errors have
# the Lua checker's wording, and checking stops at the first one. A construct
# outside that part is reported as not supported yet.

import ast
import bind
import diagnostic
import stdlib
import types

class Checker:
    module: ast.Module
    function: ast.FunctionDecl
    result: types.Type
    error: diagnostic.Diagnostic | None

    def fail(self, line: int, col: int, message: str):
        if self.error is None:
            self.error = diagnostic.Diagnostic(self.module.path, line, col, message)

    def failed(self) -> bool:
        return self.error is not None

    # Reports a construct that stage 1 does not compile yet, and gives it the
    # type None so checking can unwind.
    def unsupported(self, line: int, col: int, what: str) -> types.Type:
        self.fail(line, col, f"stage 1 does not support {what} yet")
        return none()

    # Records that `expr`, of type `actual`, is used where `expected` is.
    def expect(self, expr: ast.Expr, expected: types.Type, actual: types.Type):
        if self.failed():
            return
        if not types.assignable(expected, actual):
            self.fail(expr.line, expr.col, f"expected {types.display(expected)}, received {types.display(actual)}")
            return
        if not types.same(expected, actual) and (is_union(expected) or is_union(actual)):
            self.unsupported(expr.line, expr.col, "unions")
            return
        expr.expected = expected

    def check_against(self, expr: ast.Expr, state: dict[int, types.Type], expected: types.Type):
        self.expect(expr, expected, self.check_expr(expr, state))

    def check_arity(self, expr: ast.Expr, name: str, count: int, received: int):
        if received != count:
            self.fail(expr.line, expr.col, f"'{name}' expects {arguments(count)}, received {received}")

    # Statements

    # Checks `body`, updating `state`, the type of each definitely assigned
    # symbol by id. Returns whether the block transfers control, so that what
    # follows it cannot run.
    def check_block(self, body: list[ast.Stmt], state: dict[int, types.Type]) -> bool:
        transfers = False
        for statement in body:
            if self.failed():
                return transfers
            if transfers:
                self.fail(statement.line, statement.col, "unreachable statement")
                return transfers
            transfers = self.check_stmt(statement, state)
        return transfers

    def check_stmt(self, statement: ast.Stmt, state: dict[int, types.Type]) -> bool:
        node = statement.node
        line = statement.line
        col = statement.col
        if isinstance(node, ast.Assign):
            self.check_assign(statement, node, state)
        elif isinstance(node, ast.CallStmt):
            self.check_expr(node.call, state)
        elif isinstance(node, ast.If):
            return self.check_if(node, state)
        elif isinstance(node, ast.While):
            self.check_while(node, state)
        elif isinstance(node, ast.Return):
            self.check_return(statement, node, state)
            return True
        elif isinstance(node, ast.IndexAssign):
            self.unsupported(line, col, "index assignment")
        elif isinstance(node, ast.FieldAssign):
            self.unsupported(line, col, "field assignment")
        elif isinstance(node, ast.For):
            self.unsupported(line, col, "for loops")
        elif isinstance(node, ast.Assert):
            self.unsupported(line, col, "assert")
        elif isinstance(node, ast.SimpleStatement):
            if node == ast.SimpleStatement.BREAK:
                self.unsupported(line, col, "break")
            elif node == ast.SimpleStatement.CONTINUE:
                self.unsupported(line, col, "continue")
        else:
            self.unsupported(line, col, "this statement")
        return False

    def check_assign(self, statement: ast.Stmt, node: ast.Assign, state: dict[int, types.Type]):
        symbol = node.symbol
        assert symbol is not None, "assignment without a symbol"
        value_type = self.check_expr(node.value, state)
        declared = node.declared
        if declared is not None:
            if symbol.is_param:
                self.fail(statement.line, statement.col, f"cannot annotate parameter '{node.name}'")
            # Statements are checked in source order, so a type means an
            # earlier assignment.
            if symbol.ty is not None:
                self.fail(statement.line, statement.col, f"only the first assignment to '{node.name}' can have an annotation")
            symbol.ty = declared
        ty = symbol.ty
        if ty is not None:
            self.expect(node.value, ty, value_type)
            state[symbol.id] = ty
        else:
            symbol.ty = value_type
            state[symbol.id] = value_type

    def check_if(self, node: ast.If, state: dict[int, types.Type]) -> bool:
        self.check_against(node.condition, state, types.prim("bool"))
        body_state = copy(state)
        body_transfers = self.check_block(node.body, body_state)
        else_state = copy(state)
        else_transfers = self.check_block(node.else_body, else_state)
        if body_transfers and else_transfers:
            return True
        if body_transfers:
            replace(state, else_state)
        elif else_transfers:
            replace(state, body_state)
        else:
            replace(state, join(body_state, else_state))
        return False

    def check_while(self, node: ast.While, state: dict[int, types.Type]):
        self.check_against(node.condition, state, types.prim("bool"))
        # The body may run zero times, so its assignments are not definite
        # after the loop.
        self.check_block(node.body, copy(state))

    def check_return(self, statement: ast.Stmt, node: ast.Return, state: dict[int, types.Type]):
        value = node.value
        if value is not None:
            self.check_against(value, state, self.result)
        elif not types.assignable(self.result, none()):
            self.fail(statement.line, statement.col, f"expected {types.display(self.result)}, received None")

    # Expressions

    # Checks `expr` and records its type.
    def check_expr(self, expr: ast.Expr, state: dict[int, types.Type]) -> types.Type:
        if self.failed():
            return none()
        ty = self.check_node(expr, state)
        expr.ty = ty
        return ty

    def check_node(self, expr: ast.Expr, state: dict[int, types.Type]) -> types.Type:
        node = expr.node
        line = expr.line
        col = expr.col
        if isinstance(node, ast.Int):
            return types.prim("int")
        elif isinstance(node, ast.String):
            return types.prim("str")
        elif isinstance(node, ast.Constant):
            if node == ast.Constant.NONE:
                return none()
            return types.prim("bool")
        elif isinstance(node, ast.Name):
            return self.check_name(expr, node, state)
        elif isinstance(node, ast.Binary):
            return self.check_binary(expr, node, state)
        elif isinstance(node, ast.Call):
            return self.check_call(expr, node, state)
        elif isinstance(node, ast.TypeOf):
            return types.prim("ptr")
        elif isinstance(node, ast.Float):
            return types.prim("float")
        elif isinstance(node, ast.FString):
            return self.unsupported(line, col, "f-strings")
        elif isinstance(node, ast.EnumMember):
            return self.unsupported(line, col, "enums")
        elif isinstance(node, ast.MethodCall):
            return self.unsupported(line, col, "method calls")
        elif isinstance(node, ast.Field):
            return self.unsupported(line, col, "fields")
        elif isinstance(node, ast.Index):
            return self.unsupported(line, col, "indexing")
        elif isinstance(node, ast.Slice):
            return self.unsupported(line, col, "slicing")
        elif isinstance(node, ast.Unary):
            return self.check_unary(expr, node, state)
        elif isinstance(node, ast.Is):
            return self.unsupported(line, col, "'is'")
        elif isinstance(node, ast.IsInstance):
            return self.unsupported(line, col, "isinstance")
        elif isinstance(node, ast.ListDisplay):
            return self.unsupported(line, col, "lists")
        elif isinstance(node, ast.DictDisplay):
            return self.unsupported(line, col, "dicts")
        return self.unsupported(line, col, "this expression")

    def check_name(self, expr: ast.Expr, node: ast.Name, state: dict[int, types.Type]) -> types.Type:
        symbol = node.symbol
        if symbol is None:
            # `__os` in core, the only name the binder leaves without one.
            return types.prim("str")
        ty = state.get(symbol.id)
        if ty is None:
            self.fail(expr.line, expr.col, f"variable '{node.name}' may be used before assignment")
            return none()
        return ty

    def check_unary(self, expr: ast.Expr, node: ast.Unary, state: dict[int, types.Type]) -> types.Type:
        operand = self.check_expr(node.operand, state)
        if self.failed():
            return none()
        kind = types.kind(operand)
        if node.op in ["+", "-"] and kind in ["int", "float"] or node.op == "not" and kind == "bool":
            return operand
        self.fail(expr.line, expr.col, f"operator '{node.op}' cannot be applied to {types.display(operand)}")
        return none()

    def check_binary(self, expr: ast.Expr, node: ast.Binary, state: dict[int, types.Type]) -> types.Type:
        op = node.op
        left = self.check_expr(node.left, state)
        right = self.check_expr(node.right, state)
        if self.failed():
            return none()
        pair = types.kind(left) + " " + types.kind(right)
        ty: types.Type | None = None
        supported = False
        if op == "==" or op == "!=":
            if types.comparable(left) and types.comparable(right) and (types.assignable(left, right) or types.assignable(right, left)):
                ty = types.prim("bool")
            elif pair == "ptr ptr" and self.module.name == "core":
                ty = types.prim("bool")
            supported = pair in ["int int", "float float", "bool bool", "str str", "ptr ptr"]
        elif op in ["<", "<=", ">", ">="]:
            if types.ordered(left, right):
                ty = types.prim("bool")
            supported = pair in ["int int", "float float"]
        elif op in ["+", "-", "*", "/", "//", "%"]:
            ty = arithmetic_type(op, pair)
            supported = pair in ["int int", "float float"] or op == "+" and pair == "str str"
        elif op == "and" or op == "or":
            if pair == "bool bool":
                ty = types.prim("bool")
                supported = True
        if ty is None:
            self.fail(expr.line, expr.col, f"operator '{op}' cannot be applied to {types.display(left)} and {types.display(right)}")
            return none()
        if not supported:
            return self.unsupported(expr.line, expr.col, f"operator '{op}' on {types.display(left)} and {types.display(right)}")
        return ty

    # Calls

    def check_call(self, expr: ast.Expr, node: ast.Call, state: dict[int, types.Type]) -> types.Type:
        if len(node.keywords) > 0:
            return self.unsupported(expr.line, expr.col, "keyword arguments")
        target = node.target
        if isinstance(target, ast.FunctionDecl):
            return self.check_function_call(expr, node, target, state)
        if isinstance(target, stdlib.Builtin):
            return self.check_builtin(expr, node, target, state)
        return self.unsupported(expr.line, expr.col, "constructors")

    # A call of a built-in function, a host module's function, or an
    # intrinsic, by the name it is written with.
    def check_builtin(self, expr: ast.Expr, node: ast.Call, target: stdlib.Builtin, state: dict[int, types.Type]) -> types.Type:
        name = node.name
        line = expr.line
        col = expr.col
        if name.startswith("__"):
            return self.check_intrinsic(expr, node, target, state)
        elif name == "print":
            return self.check_print(expr, node, state)
        elif name == "len":
            return self.unsupported(line, col, "'len'")
        elif name == "str":
            return self.check_conversion(expr, node, state)
        elif name == "int":
            return self.check_conversion(expr, node, state)
        elif name == "float":
            return self.check_conversion(expr, node, state)
        elif name == "range":
            return self.unsupported(line, col, "'range'")
        elif name == "ord":
            return self.unsupported(line, col, "'ord'")
        elif name == "chr":
            return self.unsupported(line, col, "'chr'")
        elif name == "sys.args":
            return self.unsupported(line, col, "'sys.args'")
        elif name == "sys.exit":
            return self.unsupported(line, col, "'sys.exit'")
        elif name == "sys.eprint":
            return self.unsupported(line, col, "'sys.eprint'")
        elif name == "fs.read_file":
            return self.unsupported(line, col, "'fs.read_file'")
        elif name == "fs.write_file":
            return self.unsupported(line, col, "'fs.write_file'")
        elif name == "fs.exists":
            return self.unsupported(line, col, "'fs.exists'")
        elif name == "fs.realpath":
            return self.unsupported(line, col, "'fs.realpath'")
        # Not in L0.
        return self.unsupported(line, col, f"'{name}'")

    # A call of a program's or core's function, or of an extern function,
    # whose variadic arguments are ints, floats, or ptrs.
    def check_function_call(self, expr: ast.Expr, node: ast.Call, target: ast.FunctionDecl, state: dict[int, types.Type]) -> types.Type:
        record = target.record
        assert record is not None, f"function {target.name} has no signature"
        if len(record.typevars) > 0:
            return self.unsupported(expr.line, expr.col, "generic functions")
        params = record.params
        if not target.variadic or len(node.args) < len(params):
            self.check_arity(expr, node.name, len(params), len(node.args))
        for i in range(len(node.args)):
            arg = node.args[i]
            if i < len(params):
                self.check_against(arg, state, params[i].ty)
            else:
                ty = self.check_expr(arg, state)
                if not self.failed() and types.kind(ty) not in ["int", "float", "ptr"]:
                    self.fail(arg.line, arg.col, "variadic arguments must be int, float, or ptr")
        return record.result

    def check_print(self, expr: ast.Expr, node: ast.Call, state: dict[int, types.Type]) -> types.Type:
        self.check_arity(expr, "print", 1, len(node.args))
        if self.failed():
            return none()
        arg = node.args[0]
        ty = self.check_expr(arg, state)
        if self.failed():
            return none()
        if not types.printable(ty):
            self.fail(arg.line, arg.col, f"cannot print a value of type {types.display(ty)}")
        elif types.kind(ty) not in ["int", "float", "bool", "str", "None"]:
            self.unsupported(arg.line, arg.col, f"printing {types.display(ty)}")
        return none()

    def check_conversion(self, expr: ast.Expr, node: ast.Call, state: dict[int, types.Type]) -> types.Type:
        name = node.name
        self.check_arity(expr, name, 1, len(node.args))
        if self.failed():
            return none()
        arg = node.args[0]
        ty = self.check_expr(arg, state)
        if self.failed():
            return none()
        kind = types.kind(ty)
        if name == "str":
            if not types.printable(ty):
                self.fail(arg.line, arg.col, f"cannot convert a value of type {types.display(ty)} to str")
            elif kind not in ["int", "float", "bool", "str", "None"]:
                self.unsupported(arg.line, arg.col, f"converting {types.display(ty)} to str")
        elif name == "int" and kind not in ["float", "str"] or name == "float" and kind not in ["int", "str"]:
            self.fail(arg.line, arg.col, f"cannot convert a value of type {types.display(ty)} to {name}")
        return types.prim(name)

    # The intrinsics only core calls (agents/bootstrap.md §5). `__word`
    # takes a slot of any kind but word, which reinterprets as itself.
    def check_intrinsic(self, expr: ast.Expr, node: ast.Call, target: stdlib.Builtin, state: dict[int, types.Type]) -> types.Type:
        self.check_arity(expr, target.name, len(target.params), len(node.args))
        for i in range(len(node.args)):
            arg = node.args[i]
            param = target.params[i].ty
            if param is not None:
                self.check_against(arg, state, param)
            else:
                ty = self.check_expr(arg, state)
                if not self.failed() and types.kind(ty) in ["word", "None"]:
                    self.fail(arg.line, arg.col, f"cannot convert a value of type {types.display(ty)} to word")
        result = target.result
        assert result is not None, f"intrinsic {target.name} has no result"
        return result

# Checks the body of `function`, of `module`, and returns the first error.
def check_function(module: ast.Module, function: ast.FunctionDecl) -> diagnostic.Diagnostic | None:
    record = function.record
    assert record is not None, f"function {function.name} has no signature"
    checker = Checker(module, function, record.result, None)
    if function.owner is not None:
        checker.unsupported(function.line, function.col, "methods")
        return checker.error
    state: dict[int, types.Type] = {}
    for i in range(len(function.params)):
        symbol = function.params[i].symbol
        assert symbol is not None, "parameter without a symbol"
        symbol.ty = record.params[i].ty
        state[symbol.id] = record.params[i].ty
    transfers = checker.check_block(function.body, state)
    if not checker.failed() and not transfers and not types.assignable(record.result, none()):
        name = "function '" + function.name
        owner = function.owner
        if isinstance(owner, ast.ClassDecl):
            name = "method '" + owner.name + "." + function.name
        checker.fail(function.line, function.col, f"{name}' must return a value on every path")
    return checker.error

# Checks every function of the modules other than core, in order, and
# returns the first error. Core's functions are checked as the emitter
# reaches them.
def check_program(modules: list[ast.Module]) -> diagnostic.Diagnostic | None:
    for module in modules:
        if module.name != "core":
            for function in bind.functions(module):
                error = check_function(module, function)
                if error is not None:
                    return error
    return None

def none() -> types.Type:
    return types.prim("None")

def is_union(t: types.Type) -> bool:
    return isinstance(types.expand(t), types.UnionType)

def arguments(count: int) -> str:
    if count == 1:
        return "1 argument"
    return f"{count} arguments"

# The result of arithmetic operator `op` on operands whose kinds are `pair`,
# as "int int", or None when it does not apply.
def arithmetic_type(op: str, pair: str) -> types.Type | None:
    if pair == "int int":
        if op == "/":
            return types.prim("float")
        return types.prim("int")
    if pair == "float float":
        return types.prim("float")
    if op == "+" and pair == "str str":
        return types.prim("str")
    if op == "+" and pair == "bytes bytes":
        return types.prim("bytes")
    return None

def copy(state: dict[int, types.Type]) -> dict[int, types.Type]:
    result: dict[int, types.Type] = {}
    for id in state:
        result[id] = state[id]
    return result

def replace(state: dict[int, types.Type], result: dict[int, types.Type]):
    for id in copy(state):
        state.pop(id)
    for id in result:
        state[id] = result[id]

# The symbols assigned in both states. Without narrowing, a symbol has its
# declared type in both.
def join(a: dict[int, types.Type], b: dict[int, types.Type]) -> dict[int, types.Type]:
    result: dict[int, types.Type] = {}
    for id in a:
        if id in b:
            result[id] = a[id]
    return result
