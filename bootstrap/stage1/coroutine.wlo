# Low-level core helpers and target assembly for stackful coroutines.

def function(name: str) -> str:
    if name == "coroutine_available":
        return "\n".join([
            "function l $W.core.coroutine_available() {",
            "@start",
            "    %available =w call $W.coroutine.available()",
            "    %result =l extuw %available",
            "    ret %result",
            "}",
        ])
    if name == "coroutine_current":
        return "\n".join([
            "function l $W.core.coroutine_current() {",
            "@start",
            "    %current =l loadl $W.coroutine.current",
            "    ret %current",
            "}",
        ])
    if name == "coroutine_set_current":
        return "\n".join([
            "function $W.core.coroutine_set_current(l %current) {",
            "@start",
            "    storel %current, $W.coroutine.current",
            "    ret",
            "}",
        ])
    if name == "coroutine_set_pending":
        return "\n".join([
            "function $W.core.coroutine_set_pending(l %pending) {",
            "@start",
            "    storel %pending, $W.pending",
            "    ret",
            "}",
        ])
    if name == "coroutine_start_address":
        return "\n".join([
            "function l $W.core.coroutine_start_address() {",
            "@start",
            "    ret $W.core.coroutine_start",
            "}",
        ])
    if name == "coroutine_invoke":
        return "\n".join([
            "function l $W.core.coroutine_invoke(l %entry, l %argument) {",
            "@start",
            "    call %entry(l %argument)",
            "    %pending =l loadl $W.pending",
            "    storel 0, $W.pending",
            "    ret %pending",
            "}",
        ])
    if name == "coroutine_switch":
        return "\n".join([
            "function $W.core.coroutine_switch(l %current, l %resumed) {",
            "@start",
            "    %pending.address =l add %current, 64",
            "    %pending =l loadl $W.pending",
            "    storel %pending, %pending.address",
            "    storel 0, $W.pending",
            "    call $W.coroutine.switch(l %current, l %resumed)",
            "    %stack.address =l add %current, 16",
            "    %stack =l loadl %stack.address",
            "    jnz %stack, @restore, @native",
            "@native",
            "    %sp.address =l add %current, 8",
            "    %sp =l loadl %sp.address",
            "    %bottom.address =l add %current, 24",
            "    %base =l loadl %bottom.address",
            "    %bottom =l loadl %base",
            "    call $GC_remove_roots(l %sp, l %bottom)",
            "    jmp @restore",
            "@restore",
            "    %saved =l loadl %pending.address",
            "    storel 0, %pending.address",
            "    storel %saved, $W.pending",
            "    ret",
            "}",
        ])
    return ""

def data() -> str:
    return "data $W.coroutine.current = { l 0 }"

def assembly(target: str) -> str:
    prefix = ""
    if target.endswith("_apple"):
        prefix = "_"
    switch = prefix + "W.coroutine.switch"
    available = prefix + "W.coroutine.available"
    prepare = prefix + "W.core.coroutine_prepare"
    text = ".text\n.p2align 2\n.globl " + available + "\n" + available + ":\n"
    if target in ["arm64", "arm64_apple"]:
        text = text + "    mov w0, #1\n    ret\n"
        text = text + ".p2align 2\n.globl " + switch + "\n" + switch + ":\n"
        text = text + arm64(prepare)
    else:
        assert target in ["amd64_sysv", "amd64_apple"], "unsupported coroutine target"
        text = text + "    xor %eax, %eax\n    ret\n"
        text = text + ".globl " + switch + "\n" + switch + ":\n    ud2\n"
    if not target.endswith("_apple"):
        text = text + ".section .note.GNU-stack,\"\",@progbits\n"
    return text

# A switch is a normal call: the ABI makes the caller spill volatile values.
# Keeping the preserved registers on the outgoing stack makes them GC roots.
def arm64(prepare: str) -> str:
    return "\n".join([
        "    sub sp, sp, #160",
        "    stp x19, x20, [sp, #0]",
        "    stp x21, x22, [sp, #16]",
        "    stp x23, x24, [sp, #32]",
        "    stp x25, x26, [sp, #48]",
        "    stp x27, x28, [sp, #64]",
        "    stp x29, x30, [sp, #80]",
        "    stp d8, d9, [sp, #96]",
        "    stp d10, d11, [sp, #112]",
        "    stp d12, d13, [sp, #128]",
        "    stp d14, d15, [sp, #144]",
        "    mov x9, sp",
        "    str x9, [x0, #8]",
        "    mov x19, x1",
        "    bl " + prepare,
        "    ldr x9, [x19, #8]",
        "    mov sp, x9",
        "    ldp x19, x20, [sp, #0]",
        "    ldp x21, x22, [sp, #16]",
        "    ldp x23, x24, [sp, #32]",
        "    ldp x25, x26, [sp, #48]",
        "    ldp x27, x28, [sp, #64]",
        "    ldp x29, x30, [sp, #80]",
        "    ldp d8, d9, [sp, #96]",
        "    ldp d10, d11, [sp, #112]",
        "    ldp d12, d13, [sp, #128]",
        "    ldp d14, d15, [sp, #144]",
        "    add sp, sp, #160",
        "    ret",
        "",
    ])
