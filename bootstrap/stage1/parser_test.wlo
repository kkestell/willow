# Checks the parser's trees and diagnostics, mostly the cases of
# tests/unit/parser_test.lua. Prints each mismatch and exits with status 1 if
# there was one.

import ast
import diagnostic
import lexer
import parser
import show
import sys

# The tree of `source` as show writes it, or its first error as
# "line:col: message".
def parse(source: str) -> ast.Module | str:
    lexed = lexer.lex("test.wlo", source)
    if isinstance(lexed, diagnostic.Diagnostic):
        return f"{lexed.line}:{lexed.col}: {lexed.message}"
    parsed = parser.parse("test.wlo", lexed, false)
    if isinstance(parsed, diagnostic.Diagnostic):
        return f"{parsed.line}:{parsed.col}: {parsed.message}"
    return parsed

def module(source: str) -> str:
    parsed = parse(source)
    if isinstance(parsed, str):
        return parsed
    return show.Printer(false).module(parsed)

# Wraps statements in `main`, indenting each line one level.
def in_main(statements: str) -> str:
    lines: list[str] = []
    for line in statements.split("\n"):
        lines.append("    " + line)
    return "def main():\n" + "\n".join(lines) + "\n"

# The body of `main` with `statements`.
def body(statements: str) -> str:
    parsed = parse(in_main(statements))
    if isinstance(parsed, str):
        return parsed
    main = parsed.declarations[0]
    if isinstance(main, ast.FunctionDecl):
        return show.Printer(false).block(main.body)
    return "not a function"

# The value of `x = text` in `main`.
def expr(text: str) -> str:
    parsed = parse(in_main("x = " + text))
    if isinstance(parsed, str):
        return parsed
    main = parsed.declarations[0]
    if isinstance(main, ast.FunctionDecl):
        assign = main.body[0].node
        if isinstance(assign, ast.Assign):
            return show.Printer(false).expr(assign.value)
    return "not an assignment"

def check(what: str, source: str, actual: str, expected: str) -> bool:
    if actual == expected:
        return true
    print(f"FAIL {what} {source}")
    print(f"  expected: {expected}")
    print(f"  actual:   {actual}")
    return false

def main():
    modules = [
        ["def f():\n    pass\n\ndef g(a: int, b: bool,\n      c: str, d: none,) -> int:\n    return a\n", "def f() -> none { pass }\ndef g(a: int, b: bool, c: str, d: none) -> int { return a }"],
        ["def f(x) -> int:\n    return x\n", "1:8: expected ':', found ')'"],
        ["def f(x: list):\n    pass\n", "1:14: expected '[', found ')'"],
        ["def f(x: 1):\n    pass\n", "1:10: expected a type, found integer"],
        ["x = 1\n", "1:1: only function, class, protocol, enum, and type declarations are allowed at file scope"],
        ["from os import path\n", "1:1: 'from' is not supported"],
        ["    def f():\n        pass\n", "1:5: only function, class, protocol, enum, and type declarations are allowed at file scope"],
        ["def f():\n", "2:1: expected an indented block, found end of file"],
        ["def f(g: (int, str) -> bool, h: () -> int):\n    pass\n", "def f(g: ((int, str) -> bool), h: (() -> int)) -> none { pass }"],
        ["def f(g: (int) -> str | none, h: ((int) -> str) | none, i: (int), j: tuple[() -> int, int]):\n    pass\n", "def f(g: ((int) -> str | none), h: ((int) -> str) | none, i: int, j: tuple[(() -> int), int]) -> none { pass }"],
        ["def f(g: (int) -> (str) -> bool, h: ((int) -> int) -> int):\n    pass\n", "def f(g: ((int) -> ((str) -> bool)), h: ((((int) -> int)) -> int)) -> none { pass }"],
        ["def f(g: (int, str)):\n    pass\n", "1:20: expected '->', found ')'"],
        ["def f(x: Iterable[int], y: ContextManager[str]) -> Generator[Iterator[int]]:\n    pass\n", "def f(x: Iterable[int], y: ContextManager[str]) -> Generator[Iterator[int]] { pass }"],
        ["def f(a: int, *, b: int = 1, c: str):\n    pass\n", "def f(a: int, *b: int = 1, *c: str) -> none { pass }"],
        ["def f(*, a: int, *, b: int):\n    pass\n", "1:18: only one '*' is allowed in a parameter list"],
        ["def f(*args: int):\n    pass\n", "1:8: variadic parameters are not supported"],
        ["def f(a: int, *):\n    pass\n", "1:15: '*' must be followed by a keyword-only parameter"],
        ["def f(*):\n    pass\n", "1:7: '*' must be followed by a keyword-only parameter"],
        ["def f(a: int = 1, b: int, *, c: int):\n    pass\n", "1:19: parameter 'b' without a default follows one with a default"],
        ["def f(x: int | none) -> str | none:\n    y: bool | none = none\n    return none\n", "def f(x: int | none) -> str | none { y: bool | none = none; return none }"],
        ["def f(x: int | ):\n    pass\n", "1:16: expected a type, found ')'"],
        ["import shapes\ntype Json = none | bool | list[Json] | dict[str, Json]\ntype S = shapes.Shape\n", "import shapes\ntype Json = none | bool | list[Json] | dict[str, Json]\ntype S = shapes.Shape"],
        ["type T: int\n", "1:7: expected '=', found ':'"],
        ["def f():\n    type T = int\n", "2:5: expected a statement, found 'type'"],
        ["def f(x: tuple[int, str | none], y: tuple[()]) -> tuple[int]:\n    pass\n", "def f(x: tuple[int, str | none], y: tuple[]) -> tuple[int] { pass }"],
        ["def f(x: tuple[]):\n    pass\n", "1:16: expected a type, found ']'"],
        ["import geometry\nimport app.util.text\ndef f(p: geometry.Point) -> list[app.util.Rec] | none:\n    return none\n", "import geometry\nimport app.util.text\ndef f(p: geometry.Point) -> list[app.util.Rec] | none { return none }"],
        ["def f():\n    pass\nimport x\n", "3:1: imports must come before declarations"],
        ["import a.\n", "1:10: expected a module name, found end of line"],
        ["class Node:\n    value: int\n    next: Node | none\n", "class Node { value: int; next: Node | none }"],
        ["class A:\n    pass\n", "2:5: class bodies hold only field and method declarations"],
        ["class A:\n    x = 1\n", "2:5: class bodies hold only field and method declarations"],
        ["class A:\n    x: int\n    return\n", "3:5: class bodies hold only field and method declarations"],
        ["class C:\n    n: int\n    def get(self) -> int:\n        return self.n\n    def add(self, k: int = 1):\n        self.n = self.n + k\nclass Only:\n    def f(self,):\n        pass\n", "class C { n: int; def get(self) -> int { return self.n }; def add(self, k: int = 1) -> none { self.n = (self.n + k) } }\nclass Only { def f(self) -> none { pass } }"],
        ["class A:\n    def f(x: int):\n        pass\n", "2:11: method 'f' must take 'self' as its first parameter"],
        ["class A:\n    def f():\n        pass\n", "2:11: method 'f' must take 'self' as its first parameter"],
        ["class A:\n    def f(self: A):\n        pass\n", "2:15: 'self' cannot have an annotation"],
        ["class A:\n    def f(self):\n        pass\n    x: int\n", "4:5: fields must come before methods"],
        ["class E(Exception):\n    line: int\nclass F(Exception):\n    pass\n", "class E { message: str; line: int }\nclass F { message: str }"],
        ["class E(Base):\n    pass\n", "1:9: the base of a class must be 'Exception'"],
        ["class E(Exception):\n    message: str\n", "2:5: exception class cannot declare field 'message'"],
        ["class E(Exception):\n    x: int\n    pass\n", "3:5: class bodies hold only field and method declarations"],
        ["protocol P[T]:\n    def read(self, size: int) -> T\n    async def close(self)\n", "protocol P[T] { def read(self, size: int) -> T; async def close(self) -> none }"],
        ["protocol P:\n    x: int\n", "2:5: protocols hold only method signatures"],
        ["protocol P:\n    def f(self) -> int:\n        return 1\n", "2:23: protocol methods have no bodies"],
        ["protocol P:\n    def f[T](self, x: T) -> T\n", "2:11: protocol methods cannot be generic"],
        ["def f(a: int, b: int = -1, c: float = +2.5, d: float = -0.0, e: str = 'x', g: int | none = none, h: bool = true):\n    pass\nclass P:\n    x: int\n    y: int = 0\n", "def f(a: int, b: int = -1, c: float = 2.5, d: float = -0.0, e: str = \"x\", g: int | none = none, h: bool = true) -> none { pass }\nclass P { x: int; y: int = 0 }"],
        ["def f(a: E = E.A, b: m.E = m.E.B):\n    pass\n", "def f(a: E = E.A, b: m.E = m.E.B) -> none { pass }"],
        ["def f(a: tuple[()] = (), b: tuple[int] = (1,), c: tuple[E, int] = (E.A, -1)):\n    pass\n", "def f(a: tuple[] = tuple(), b: tuple[int] = tuple(1), c: tuple[E, int] = tuple(E.A, -1)) -> none { pass }"],
        ["def f(a: int = (1)):\n    pass\n", "1:18: expected ',', found ')'"],
        ["def f(a: int = f()):\n    pass\n", "1:16: a default must be a literal or an enum member"],
        ["def f(a: int = -true):\n    pass\n", "1:16: a default must be a literal or an enum member"],
        ["def f(a: int = f'a'):\n    pass\n", "1:16: a default must be a literal or an enum member"],
        ["class P:\n    x: int = 1\n    y: int\n", "3:5: field 'y' without a default follows one with a default"],
        ["def f[T, U: io.File](x: T) -> U:\n    pass\ntype Pair[K, V] = tuple[K, V]\nclass Box[T]:\n    value: T\n\n    def map[V](self, v: V) -> V:\n        return v\n", "def f[T, U: io.File](x: T) -> U { pass }\ntype Pair[K, V] = tuple[K, V]\nclass Box[T] { value: T; def map[V](self, v: V) -> V { return v } }"],
        ["async def f() -> int:\n    return 1\n\nclass C:\n    async def m(self):\n        pass\n", "async def f() -> int { return 1 }\nclass C { async def m(self) -> none { pass } }"],
        ["enum Mode:\n    AUTO\n    NEVER\n", "enum Mode { AUTO; NEVER }"],
        ["enum Mode:\n    AUTO = 1\n", "2:5: enum bodies hold only member names"],
        ["def f(enum: int):\n    pass\n", "1:7: expected a parameter name, found 'enum'"],
        # Core's C functions, with stage 0's syntax and diagnostics.
        ["extern def write(fd: cint, buf: ptr, count: int) -> int\nextern def exit(status: cint)\nextern def snprintf(buf: ptr, size: int, format: ptr, ...) -> cint\n", "extern def write(fd: cint, buf: ptr, count: int) -> int\nextern def exit(status: cint) -> none\nextern def snprintf(buf: ptr, size: int, format: ptr, ...) -> cint"],
        ["extern def f(x: int):\n    pass\n", "1:21: expected end of line, found ':'"],
        ["extern def f(..., x: int)\n", "1:17: expected ')', found ','"],
        ["extern def f(x: int = 1)\n", "1:21: expected ',' or ')', found '='"],
        ["extern def f(. . .)\n", "1:14: expected a parameter name, found '.'"],
        ["def f(...):\n    pass\n", "1:7: expected a parameter name, found '.'"],
        ["def extern(extern: int) -> int:\n    return extern\n", "def extern(extern: int) -> int { return extern }"],
    ]
    bodies = [
        ["x = 1\ny: int = x + 2\nf(x, y)\nif x == 1:\n    return\nwhile y > 0:\n    pass\n    break\n    continue\nreturn f(y)", "{ x = 1; y: int = (x + 2); f(x, y); if (x == 1) { return }; while (y > 0) { pass; break; continue }; return f(y) }"],
        ["if a:\n    pass\nelse if b:\n    pass\nelse if c:\n    pass\nelse:\n    pass", "{ if a { pass } else { if b { pass } else { if c { pass } else { pass } } } }"],
        ["if a:\n    pass\nelse if b:\n    pass", "{ if a { pass } else { if b { pass } } }"],
        ["elif = 1", "{ elif = 1 }"],
        ["if a: pass", "2:11: expected end of line, found 'pass'"],
        ["if a:\n# nothing\nx = 1", "4:5: expected an indented block, found 'x'"],
        ["x + 1", "2:7: only calls and await expressions can be used as statements"],
        ["x", "2:5: only calls and await expressions can be used as statements"],
        ["f() == 1", "2:9: only calls and await expressions can be used as statements"],
        ["a = b = 1", "2:11: chained assignment is not supported"],
        ["a += 1", "2:7: unsupported operator '+='"],
        ["f(a := 1)", "2:9: unsupported operator ':='"],
        ["x: int", "2:11: annotated assignment needs an initializer"],
        ["f() = 1", "2:9: cannot assign to this expression"],
        ["Iterator = 1", "2:5: expected a statement, found 'Iterator'"],
        ["a, b = t\n(a, (b, c)) = t\ne, = t", "{ <a, b> = t; <a, <b, c>> = t; <e> = t }"],
        ["for k, (x, y) in items:\n    pass\nfor (x) in items:\n    pass", "{ for <k, <x, y>> in items { pass }; for x in items { pass } }"],
        ["a, a = t", "2:8: duplicate target 'a'"],
        ["for k, (x, k) in items:\n    pass", "2:16: duplicate target 'k'"],
        ["*a, b = t", "2:5: starred targets are not supported"],
        ["a, *b = t", "2:8: starred targets are not supported"],
        ["a, f() = t", "2:8: cannot assign to this expression"],
        ["a, b = b, a", "2:13: expected end of line, found ','"],
        ["tuple = 1", "2:5: expected a statement, found 'tuple'"],
        ["x = isinstance(y, none)", "2:23: expected a class name, found 'none'"],
        ["x = isinstance(y)", "2:21: expected ',', found ')'"],
        ["x = isinstance(y, list[int])", "2:27: expected ')', found '['"],
        ["x = a is 3", "2:14: expected 'none', found integer"],
        ["x = a is none == b", "2:19: comparison chains are not supported"],
        ["x = a == b is none", "2:16: comparison chains are not supported"],
        ["x = a | b", "2:11: unsupported operator '|'"],
        ["x = a == b | c", "2:16: unsupported operator '|'"],
        ["x = a is none | b", "2:19: unsupported operator '|'"],
        ["x = [1, 2}", "2:14: expected ',' or ']', found '}'"],
        ["xs[i] = v + 1\nxs.append(2)\np.x = p.x + 1", "{ xs[i] = (v + 1); xs.append(2); p.x = (p.x + 1) }"],
        ["xs[0]: int = 1", "2:10: only a name can have an annotation"],
        ["p.x: int = 1", "2:8: only a name can have an annotation"],
        ["xs[0]", "2:7: only calls and await expressions can be used as statements"],
        ["raise E('x')\nraise", "{ raise E(\"x\"); raise }"],
        ["raise E() from e", "2:15: 'raise ... from' is not supported"],
        ["try:\n    f()\nexcept E as e:\n    g(e)\nexcept m.F:\n    pass\nfinally:\n    h()", "{ try { f() } except E as e { g(e) } except m.F { pass } finally { h() } }"],
        ["try:\n    pass", "4:1: expected 'except' or 'finally', found dedent"],
        ["try:\n    pass\nexcept:\n    pass", "4:5: bare 'except' is not supported"],
        ["try:\n    pass\nexcept (E, F):\n    pass", "4:12: exception class lists are not supported"],
        ["try:\n    pass\nexcept* E:\n    pass", "4:5: 'except*' is not supported"],
        ["try:\n    pass\nexcept E:\n    pass\nelse:\n    pass", "6:5: 'else' clause on 'try' is not supported"],
        ["x = a in b in c", "2:16: comparison chains are not supported"],
        ["x = a == b not in c", "2:16: comparison chains are not supported"],
        ["for k pass", "2:11: expected 'in', found 'pass'"],
        ["x = f'{1 +}'", "2:15: expected an expression, found '}'"],
        ["x = f'{a b}'", "2:14: expected '}', found 'b'"],
        ["x: float = 2.5\nfloat(1)\nx = int", "{ x: float = 2.5; float(1); x = int }"],
        ["int = 1", "2:5: cannot assign to 'int'"],
        ["x = a == not b", "2:14: expected an expression, found 'not'"],
        ["x = 0 <= y < 10", "2:16: comparison chains are not supported"],
        ["(f)(x)\nf(x)(y)\nf(1, g(2), 's',)", "{ (f)(x); (f(x))(y); f(1, g(2), \"s\") }"],
        ["f(1,\n  2)\nx = (a +\n        b)", "{ f(1, 2); x = (a + b) }"],
        ["f(1", "3:1: expected ',' or ')', found end of file"],
        ["x = a[1:2:3]", "2:14: slice steps are not supported"],
        ["a[1:2] = x", "2:12: cannot assign to this expression"],
        ["f(a=1, 2)", "2:12: positional argument follows keyword argument"],
        ["assert x\nassert x == 1, 'm'", "{ assert x; assert (x == 1), \"m\" }"],
        ["assert", "2:11: expected an expression, found end of line"],
        ["xs[i] = 1", "{ xs[i] = 1 }"],
        ["xs[i | j] = 1", "2:10: unsupported operator '|'"],
        ["nonlocal a, b", "{ nonlocal a, b }"],
        ["x = (a=1) => a", "2:11: expected ',' or ')', found '='"],
        ["def g(x: int) -> int:\n    return x\ny = g(1)", "{ def g(x: int) -> int { return x }; y = g(1) }"],
        ["with a as x, b as (y, z):\n    pass\nwith f():\n    pass", "{ with a as x, b as <y, z> { pass }; with f() { pass } }"],
        ["with a as (x, x):\n    pass", "2:19: duplicate target 'x'"],
        ["yield x + 1", "{ yield (x + 1) }"],
        ["yield", "2:10: expected an expression, found end of line"],
        ["async def g():\n    pass\nawait f()", "{ async def g() -> none { pass }; (await f()) }"],
        ["x = await -c", "2:15: expected an expression, found '-'"],
        ["x = await await c", "2:15: expected an expression, found 'await'"],
        ["async with aio.task_group() as g:\n    pass\nasync with g:\n    pass", "{ async with aio.task_group() as g { pass }; async with g { pass } }"],
        ["async with g as (a, b):\n    pass", "2:21: expected a name, found '('"],
        ["del x", "2:5: 'del' is not supported"],
    ]
    exprs = [
        ["a or b and not c == d + e * -f", "(a or (b and (not (c == (d + (e * (- f)))))))"],
        ["a - b - c", "((a - b) - c)"],
        ["not not true", "(not (not true))"],
        ["a * b / c // d % e + f - g", "((((((a * b) / c) // d) % e) + f) - g)"],
        ["()", "tuple()"],
        ["(1,)", "tuple(1)"],
        ["(1, a + b,)", "tuple(1, (a + b))"],
        ["(1)", "1"],
        ["isinstance(x, tuple)", "isinstance(x, tuple)"],
        ["isinstance(x, list) and isinstance(y, Point,)", "(isinstance(x, list) and isinstance(y, Point))"],
        ["not isinstance(f(x), a.b.C)", "(not isinstance(f(x), a.b.C))"],
        ["not x is none", "(not (x is none))"],
        ["x is not none and x + 1 is none", "((x is not none) and ((x + 1) is none))"],
        ["[1, [2, 3,], []]", "[1, [2, 3], []]"],
        ["{\n    'a': 1,\n    2: {},\n}", "{\"a\": 1, 2: {}}"],
        ["rows[0].pop()", "rows[0].pop()"],
        ["-xs[0]", "(- xs[0])"],
        ["text.strip().split(',')", "text.strip().split(\",\")"],
        ["items[0](1)", "(items[0])(1)"],
        ["xs.f(1)(2)", "(xs.f(1))(2)"],
        ["a.b.c", "a.b.c"],
        ["a in b and c not in d", "((a in b) and (c not in d))"],
        ["f\"a{b}c{x + 1}\"", "f[\"a\", b, \"c\", (x + 1)]"],
        ["f\"\"", "f[]"],
        ["f\"{a b}\"", "2:14: expected '}', found 'b'"],
        ["float(1) / 0.5", "(float(1) / 0.5)"],
        ["a == (not b)", "(a == (not b))"],
        ["a[:]", "a[:]"],
        ["a[:-1]", "a[:(- 1)]"],
        ["a[i:j][0]", "a[i:j][0]"],
        ["sorted(xs, reverse=true)", "sorted(xs, reverse=true)"],
        ["first[int](xs)", "first[int](xs)"],
        ["first[list[int], str | none](xs)", "first[list[int], str | none](xs)"],
        ["util.first[int](xs)", "util.first[int](xs)"],
        ["xs[0](1)", "(xs[0])(1)"],
        ["first[int]", "first[int]"],
        ["(x, y) => x + y", "((x, y) => (x + y))"],
        ["() => 1", "(() => 1)"],
        ["(x,) => x", "((x) => x)"],
        ["(x) => () => x", "((x) => (() => x))"],
        ["((x) => x)(1)", "(((x) => x))(1)"],
        ["(x) => x + 1 * 2 == 3 or false", "((x) => (((x + (1 * 2)) == 3) or false))"],
        ["lambda", "lambda"],
        ["f((x) => x, 1)", "f(((x) => x), 1)"],
        ["-await c.m(1)", "(- (await c.m(1)))"],
        ["await f() + 1", "((await f()) + 1)"],
        ["__type(str) == __type(dict)", "(__type(str) == __type(dict))"],
        ["__word(__type(list))", "__word(__type(list))"],
        ["__type(Box)", "__type(Box)"],
        ["__type(list[int])", "2:20: expected ')', found '['"],
        ["__type", "__type"],
    ]
    ok = true
    for pair in modules:
        if not check("module", pair[0], module(pair[0]), pair[1]):
            ok = false
    for pair in bodies:
        if not check("body", pair[0], body(pair[0]), pair[1]):
            ok = false
    for pair in exprs:
        if not check("expr", pair[0], expr(pair[0]), pair[1]):
            ok = false
    # Positions that diagnostics in later passes rely on.
    positions = [
        ["def f():\n    pass\n\ndef g(a: int, b: bool,\n      c: str) -> int:\n    return a\n", "def f@1:5() -> none@1:5 { pass@2:5 }\ndef g@4:5(a@4:7: int@4:10, b@4:15: bool@4:18, c@5:7: str@5:10) -> int@5:18 { return a@6:12@6:5 }"],
        ["def f():\n    x = a + b + c\n", "def f@1:5() -> none@1:5 { x = ((a@2:9 + b@2:13)@2:11 + c@2:17)@2:15@2:5 }"],
        ["def f():\n    if a:\n        pass\n    else if b:\n        pass\n", "def f@1:5() -> none@1:5 { if a@2:8 { pass@3:9 } else { if b@4:13 { pass@5:9 }@4:10 }@2:5 }"],
    ]
    for pair in positions:
        parsed = parse(pair[0])
        actual = ""
        if isinstance(parsed, str):
            actual = parsed
        else:
            actual = show.Printer(true).module(parsed)
        if not check("positions", pair[0], actual, pair[1]):
            ok = false
    if not ok:
        sys.exit(1)
    print("parser tests passed")
