# The stage 1 compiler's driver, which behaves as willow0's does.
#
# Usage: willow1 build FILE.wlo -o OUTPUT
#        willow1 compile FILE.wlo -o OUTPUT.ssa
#
# Core is compiled into every program. Its text and the standard library's
# are compiled into willow1 (see loader.wlo).

import ast
import bind
import check
import core
import coroutine
import diagnostic
import emit
import fs
import loader
import sys

def usage():
    sys.eprint("usage: willow1 build FILE.wlo -o OUTPUT\n       willow1 compile FILE.wlo -o OUTPUT.ssa")
    sys.exit(2)

def fail(message: str):
    sys.eprint(message)
    sys.exit(1)

def report(error: diagnostic.Diagnostic):
    fail(error.format())

def main():
    var args = sys.args()
    if len(args) != 4 or args[0] not in ["build", "compile"] or args[2] != "-o":
        usage()
    var il = compile(args[1])
    if args[0] == "compile":
        fs.write_file(args[3], il)
    else:
        build(il, args[3])

# The IL of the program whose entry file is at `path`.
def compile(path: str) -> str:
    if not fs.exists(path):
        fail(f"willow1: {path}: No such file or directory")
    var name = loader.entry_name(path)
    if not loader.is_identifier(name) or name == "core":
        fail(f"willow1: {path}: '{name}' cannot be a module name")
    var sources = loader.load(path, fs.read_file(path), loader.file_roots(path), true)
    if sources is diagnostic.Diagnostic:
        report(sources)
        return ""
    var error = bind.bind(sources, false)
    if error is not none:
        report(error)
    var modules: list[ast.Module] = []
    for source in sources:
        modules.append(source.tree)
    error = check.check_program(modules)
    if error is not none:
        report(error)
    var emitter = emit.emitter(modules, core.os())
    for module in modules:
        for function in bind.functions(module):
            emitter.function(function)
    return emitter.finish(modules[0], false)

# Assembles `il` with qbe and links it with libgc into the executable
# `output`. The intermediate files sit next to `output`, since L0 cannot make
# a temporary directory.
def build(il: str, output: str):
    var ssa = output + ".ssa"
    var asm = output + ".s"
    var scratch = output + ".tmp"
    fs.write_file(ssa, il)
    var target = qbe_target(scratch)
    var ok = core.run(["qbe", "-t", target, "-o", asm, ssa]) == 0
    var message = "willow1: qbe failed"
    if ok:
        fs.write_file(asm, fs.read_file(asm) + coroutine.assembly(target))
        var command = ["cc", "-o", output, asm]
        command.extend(gc_flags(scratch))
        command.append("-lm")
        ok = core.run(command) == 0
        message = "willow1: cc failed"
    remove([ssa, asm, scratch])
    if not ok:
        fail(message)

# The QBE target for the host, whose architecture `uname -m` names.
def qbe_target(scratch: str) -> str:
    var os = core.os()
    var arch = shell_output("uname -m", scratch).strip()
    if arch == "aarch64" or arch == "arm64":
        if os == "darwin":
            return "arm64_apple"
        return "arm64"
    if arch == "x86_64" and os == "linux":
        return "amd64_sysv"
    fail(f"willow1: unsupported host {os} {arch}")
    return ""

# The compiler flags that link libgc.
def gc_flags(scratch: str) -> list[str]:
    var flags = shell_output("pkg-config --cflags --libs bdw-gc 2>/dev/null", scratch)
    if flags == "":
        return ["-lgc"]
    return flags.split()

# The standard output of shell `command`, or "" if it fails, by way of the
# file `scratch`; core.run cannot capture output.
def shell_output(command: str, scratch: str) -> str:
    if core.run(["sh", "-c", command + " >\"$1\"", "sh", scratch]) != 0:
        return ""
    return fs.read_file(scratch)

def remove(paths: list[str]):
    var command = ["rm", "-f"]
    command.extend(paths)
    core.run(command)
