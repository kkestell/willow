# Lexes each file named on the command line and writes the first error in
# each to stderr. With --tokens first, writes every token to stdout instead.
# Exits with status 1 if any file has an error.

import diagnostic
import fs
import lexer
import sys

def main():
    args = sys.args()
    show_tokens = len(args) > 0 and args[0] == "--tokens"
    if show_tokens:
        args = args[1:]
    failed = False
    for path in args:
        result = lexer.lex(path, fs.read_file(path))
        if isinstance(result, diagnostic.Diagnostic):
            sys.eprint(result.format())
            failed = True
        elif show_tokens:
            for token in result:
                print(f"{path}:{token.line}:{token.col}: {token.kind} {token.text}")
    if failed:
        sys.exit(1)
