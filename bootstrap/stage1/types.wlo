# The types of the full language as the binder and checker see them, the
# counterpart of compiler/types.lua.
#
# A type is one of the classes in `Type`. Declared classes, protocols, enums,
# and functions appear in types through the records Class, Protocol, Enum,
# and Function, which the binder creates when it declares a name and fills in
# as it resolves the declaration. L0 has no object identity, so types compare
# those records by content: classes, protocols, and enums by type_name and
# `library`, which together are unique because they are declared only at
# file scope and a module name is unique among the program's modules and
# among the library's, and functions and
# type parameters by an `id` the binder gives each declaration. A nested
# function's type_name is not unique: redefining one in the same function
# makes a second function that is not the same type, though both display
# alike. L0 has no module variables, so `prim` makes a scalar type whenever
# one is needed; scalars compare by name.

import ast

type Type = Prim | ListType | DictType | TupleType | ClassType | ProtocolType | EnumType | CallableType | FunctionType | TypeVar | UnionType | Lazy

# int, float, bool, str, bytes, or none.
class Prim:
    name: str

class ListType:
    element: Type

class DictType:
    key: Type
    value: Type

class TupleType:
    elements: list[Type]

# A class, or with `args` a generic class's specialization. Specializations
# compare by their arguments, so they are invariant.
class ClassType:
    decl: Class
    args: list[Type]

# A protocol, or with `args` a generic protocol's specialization.
class ProtocolType:
    decl: Protocol
    args: list[Type]

class EnumType:
    decl: Enum

# `(A, B) -> R`: a function taking exactly those positional arguments,
# compared by structure.
class CallableType:
    params: list[Type]
    result: Type

# A declared function as a value, which keeps its whole call signature. A
# `bound` method keeps its receiver, so calls skip its `self`; a generic
# `receiver` specializes the signature and is part of the type's identity.
class FunctionType:
    fn: Function
    bound: bool
    receiver: ClassType | ProtocolType | none

# A type parameter as its declaration's body sees it, with no operations
# beyond storing, passing, and returning, and those of its bound. `id` is
# unique among type parameters: the binder gives each declared one an id,
# and the standard library's have negative ids.
class TypeVar:
    id: int
    name: str
    bound: Type | none

# A union of at least two members, none of them a union. A union that an
# alias names is displayed by `alias`, which is empty otherwise.
class UnionType:
    members: list[Type]
    alias: str

# A list element or dict value, which the binder fills in once every alias
# is resolved, so that an alias may refer to itself there. As in
# compiler/bind.lua, every one is lazy and `name` is its source text, which
# is how it displays. The binder gives each an `id`, which stands in for the
# object identity Lua compares when it reuses a generic alias's
# specialization.
class Lazy:
    name: str
    target: Type | none
    id: int = 0

# A class, an exception class, or a standard library native type. A native
# type has no fields that other modules see. Its methods lower to helpers
# named after `prefix`, or, when `prefix` is "", it is a class a library
# module declares, ordinary inside that module. `library` marks a
# declaration of core or the standard library, whose module names a
# program's own modules may reuse; it tells apart declarations with the same
# type_name, as Protocol's and Enum's does.
class Class:
    name: str
    type_name: str
    typevars: list[TypeVar]
    fields: list[Field]
    methods: list[Function]
    exception: bool
    native: bool
    prefix: str
    library: bool = false

class Field:
    name: str
    ty: Type
    default: ast.Expr | none

class Protocol:
    name: str
    type_name: str
    typevars: list[TypeVar]
    methods: list[Function]
    library: bool = false

class Enum:
    name: str
    type_name: str
    members: list[str]
    library: bool = false

# A function or method. `id` is the binder's id of its declaration, unique
# among functions; the standard library's functions have id 0, since native
# and standard protocol methods never become values. A method's first
# parameter is `self`, and its type_name is the class's followed by its name.
class Function:
    id: int
    name: str
    type_name: str
    typevars: list[TypeVar]
    params: list[Param]
    result: Type

# A built-in method's parameter that has no name is positional-only.
class Param:
    name: str
    ty: Type
    default: ast.Expr | none
    keyword_only: bool

# The signature of a method of some type, after `self`, with the type's
# arguments substituted. `generic[i]` and `result_generic` tell whether the
# declared type of parameter `i` and of the result mention a type parameter.
class Method:
    params: list[Param]
    generic: list[bool]
    result: Type
    result_generic: bool

def prim(name: str) -> Prim:
    return Prim(name)

def union(parts: list[Type]) -> Type:
    return named_union(parts, "")

# The union of `parts`, which may be unions themselves, displayed as `alias`
# when it is not empty; one member is returned as it is.
def named_union(parts: list[Type], alias: str) -> Type:
    var flat: list[Type] = []
    for part in parts:
        flat.extend(members(part))
    if len(flat) == 1:
        return flat[0]
    return UnionType(flat, alias)

def optional(t: Type) -> Type:
    return union([t, prim("none")])

# A class's type as its own body sees it: specialized by its own type
# parameters when it is generic.
def class_self(decl: Class) -> ClassType:
    return ClassType(decl, var_types(decl.typevars))

def protocol_self(decl: Protocol) -> ProtocolType:
    return ProtocolType(decl, var_types(decl.typevars))

def var_types(vars: list[TypeVar]) -> list[Type]:
    var result: list[Type] = []
    for v in vars:
        result.append(v)
    return result

def var_key(v: TypeVar) -> str:
    return str(v.id)

# The kind of `t` as compiler/types.lua names it: a scalar's name, or list,
# dict, tuple, record, protocol, enum, callable, function, typevar, union, or
# lazy.
def kind(t: Type) -> str:
    if t is Prim:
        return t.name
    if t is ListType:
        return "list"
    if t is DictType:
        return "dict"
    if t is TupleType:
        return "tuple"
    if t is ClassType:
        return "record"
    if t is ProtocolType:
        return "protocol"
    if t is EnumType:
        return "enum"
    if t is CallableType:
        return "callable"
    if t is FunctionType:
        return "function"
    if t is TypeVar:
        return "typevar"
    if t is UnionType:
        return "union"
    return "lazy"

# The text diagnostics give `t`.
def display(t: Type) -> str:
    if t is Prim:
        return t.name
    if t is ListType:
        return f"list[{display(t.element)}]"
    if t is DictType:
        return f"dict[{display(t.key)}, {display(t.value)}]"
    if t is TupleType:
        if len(t.elements) == 0:
            return "tuple[]"
        return "tuple[" + join(t.elements, ", ") + "]"
    if t is ClassType:
        return specialized(t.decl.type_name, t.args)
    if t is ProtocolType:
        return specialized(t.decl.type_name, t.args)
    if t is EnumType:
        return t.decl.type_name
    if t is CallableType:
        return "(" + join(t.params, ", ") + ") -> " + display(t.result)
    if t is FunctionType:
        var receiver = t.receiver
        if t.bound and receiver is not none:
            return "function " + display(receiver) + "." + t.fn.name
        return "function " + t.fn.type_name
    if t is TypeVar:
        return t.name
    if t is UnionType:
        if t.alias != "":
            return t.alias
        var names: list[str] = []
        for m in t.members:
            # A callable's result would otherwise absorb the members after it.
            if m is CallableType:
                names.append("(" + display(m) + ")")
            else:
                names.append(display(m))
        return " | ".join(names)
    return t.name

def join(parts: list[Type], separator: str) -> str:
    var names: list[str] = []
    for part in parts:
        names.append(display(part))
    return separator.join(names)

def specialized(type_name: str, args: list[Type]) -> str:
    if len(args) == 0:
        return type_name
    return type_name + "[" + join(args, ", ") + "]"

# The type a Lazy stands for, or `t` itself.
def expand(t: Type) -> Type:
    if t is Lazy:
        var target = t.target
        assert target is not none, f"alias {t.name} is used before it is resolved"
        return target
    return t

def members(t: Type) -> list[Type]:
    if t is UnionType:
        return t.members
    return [t]

def has(t: Type, kind_name: str) -> bool:
    for m in members(t):
        if kind(m) == kind_name:
            return true
    return false

def is_optional(t: Type) -> bool:
    return t is UnionType and has(t, "none")

def printable(t: Type) -> bool:
    for m in members(t):
        if kind(m) not in ["int", "float", "bool", "str", "none", "enum"]:
            return false
    return true

# Whether `==` applies: every member is a scalar, or a tuple whose positions
# are comparable.
def comparable(t: Type) -> bool:
    for m in members(t):
        if m is TupleType:
            for element in m.elements:
                if not comparable(element):
                    return false
        else if kind(m) not in ["int", "float", "bool", "str", "none", "bytes", "enum"]:
            return false
    return true

# Whether `<` and the other orderings apply: both are the same ordered scalar
# type, or tuples of equal arity whose positions are ordered.
def ordered(a: Type, b: Type) -> bool:
    if a is TupleType and b is TupleType:
        if len(a.elements) == len(b.elements):
            for i in range(len(a.elements)):
                if not ordered(a.elements[i], b.elements[i]):
                    return false
            return true
    return a is Prim and b is Prim and a.name == b.name and a.name in ["int", "float", "str"]

# In a type with both int and float members, floats are boxed at run time so
# that they differ from ints.
def boxed(t: Type) -> bool:
    return has(t, "int") and has(t, "float")

# Dictionary keys are ints, strs, or members of one enum.
def is_key(t: Type) -> bool:
    return kind(t) in ["int", "str", "enum"]

# Union members are matched by kind, or by declaration for classes,
# protocols, enums, functions, and type parameters.
def key(t: Type) -> str:
    t = expand(t)
    if t is ClassType:
        return "record " + identity(t.decl.type_name, t.decl.library)
    if t is ProtocolType:
        return "protocol " + identity(t.decl.type_name, t.decl.library)
    if t is EnumType:
        return "enum " + identity(t.decl.type_name, t.decl.library)
    if t is FunctionType:
        return "function " + str(t.fn.id)
    if t is TypeVar:
        return "typevar " + var_key(t)
    return kind(t)

# A text that tells declarations apart by their type_name and `library`.
def identity(type_name: str, library: bool) -> str:
    if library:
        return "library " + type_name
    return type_name

def same_class(a: Class, b: Class) -> bool:
    return a.type_name == b.type_name and a.library == b.library

def same_protocol(a: Protocol, b: Protocol) -> bool:
    return a.type_name == b.type_name and a.library == b.library

def same_enum(a: Enum, b: Enum) -> bool:
    return a.type_name == b.type_name and a.library == b.library

def same(a: Type, b: Type) -> bool:
    return same_in(a, b, [])

# `assumed` holds the pairs of lazy types already being compared, by id, so
# recursive aliases terminate.
def same_in(a: Type, b: Type, assumed: list[str]) -> bool:
    if a is Lazy and b is Lazy:
        var pair = f"{a.id} = {b.id}"
        if pair in assumed:
            return true
        assumed.append(pair)
    a = expand(a)
    b = expand(b)
    if a is Prim:
        return b is Prim and a.name == b.name
    if a is ListType:
        return b is ListType and same_in(a.element, b.element, assumed)
    if a is DictType:
        return b is DictType and same_in(a.key, b.key, assumed) and same_in(a.value, b.value, assumed)
    if a is TupleType:
        return b is TupleType and all_same(a.elements, b.elements, assumed)
    if a is ClassType:
        return b is ClassType and same_class(a.decl, b.decl) and all_same(a.args, b.args, assumed)
    if a is ProtocolType:
        return b is ProtocolType and same_protocol(a.decl, b.decl) and all_same(a.args, b.args, assumed)
    if a is EnumType:
        return b is EnumType and same_enum(a.decl, b.decl)
    if a is CallableType:
        return b is CallableType and all_same(a.params, b.params, assumed) and same_in(a.result, b.result, assumed)
    if a is FunctionType:
        if b is not FunctionType:
            return false
        if a.fn.id != b.fn.id or a.bound != b.bound:
            return false
        var ra = a.receiver
        var rb = b.receiver
        if ra is none or rb is none:
            return ra is none and rb is none
        return same_in(ra, rb, assumed)
    if a is TypeVar:
        return b is TypeVar and var_key(a) == var_key(b)
    if a is UnionType:
        if b is not UnionType or len(a.members) != len(b.members):
            return false
        for m in a.members:
            var found = false
            for n in b.members:
                if key(m) == key(n):
                    found = same_in(m, n, assumed)
                    break
            if not found:
                return false
        return true
    return false

def all_same(xs: list[Type], ys: list[Type], assumed: list[str]) -> bool:
    if len(xs) != len(ys):
        return false
    for i in range(len(xs)):
        if not same_in(xs[i], ys[i], assumed):
            return false
    return true

# The substitution a specialization gives its declaration's type parameters,
# keyed by var_key.
def record_map(t: ClassType | ProtocolType) -> dict[str, Type]:
    if t is ClassType:
        return bind_vars(t.decl.typevars, t.args)
    return bind_vars(t.decl.typevars, t.args)

def bind_vars(vars: list[TypeVar], args: list[Type]) -> dict[str, Type]:
    var bindings: dict[str, Type] = {}
    for i in range(len(args)):
        bindings[var_key(vars[i])] = args[i]
    return bindings

# The parameters a call through function type `t` binds.
def function_params(t: FunctionType) -> list[Param]:
    var receiver = t.receiver
    if receiver is not none:
        var signature = method(receiver, t.fn.name)
        if signature is not none:
            return signature.params
    if t.bound:
        return t.fn.params[1:]
    return t.fn.params

def function_result(t: FunctionType) -> Type:
    var receiver = t.receiver
    if receiver is not none:
        var signature = method(receiver, t.fn.name)
        if signature is not none:
            return signature.result
    return t.fn.result

# The signature of method `name` on `t`, a class, native type, or protocol,
# with `t`'s type arguments substituted, or none. A declared generic method
# has no single signature, so it is left out; a helper's is not, and its
# types are not substituted. Built-in collections, strings, and bytes have
# an `iter` method.
def method(t: Type, name: str) -> Method | none:
    var fns: list[Function]
    var native: bool
    if t is ClassType:
        fns = t.decl.methods
        native = t.decl.native and t.decl.prefix != ""
    else if t is ProtocolType:
        fns = t.decl.methods
        native = false
    else:
        if name != "iter":
            return none
        var item = iteration_item(t)
        if item is none:
            return none
        return Method([], [], iterator(item), true)
    var bindings = record_map(t)
    for fn in fns:
        if fn.name == name and (native or len(fn.typevars) == 0):
            var params: list[Param] = []
            var generic: list[bool] = []
            for param in fn.params[1:]:
                var ty = param.ty
                if not native:
                    ty = substitute(ty, bindings)
                params.append(Param(param.name, ty, param.default, param.keyword_only))
                generic.append(mentions(param.ty))
            var result = fn.result
            if not native:
                result = substitute(result, bindings)
            return Method(params, generic, result, mentions(fn.result))
    return none

# The index of the parameter of method signature `have` that serves each
# parameter of protocol method `want`, matched by position and name or, for
# a keyword-only parameter, by name, or none when the parameters do not line
# up. Every parameter of `have` left unmatched has a default.
def match_params(want: Method, have: Method) -> list[int] | none:
    var indexes: list[int] = []
    var used: list[bool] = []
    for h in have.params:
        used.append(false)
    for i in range(len(want.params)):
        var param = want.params[i]
        var index = -1
        for j in range(len(have.params)):
            if have.params[j].name == param.name:
                index = j
        if index < 0:
            return none
        var h = have.params[index]
        if not param.keyword_only and (index != i or h.keyword_only):
            return none
        if param.default is not none and h.default is none:
            return none
        indexes.append(index)
        used[index] = true
    for j in range(len(have.params)):
        if not used[j] and have.params[j].default is none:
            return none
    return indexes

def tuple_member(t: Type) -> TupleType | none:
    for m in members(t):
        if m is TupleType:
            return m
    return none

def callable_member(t: Type) -> CallableType | none:
    for m in members(t):
        if m is CallableType:
            return m
    return none

# Whether a value of `source` changes representation to serve `target`, or
# the other way around: a float boxed or unboxed, including in tuple
# positions, tuple items copied for a protocol, and callable parameters and
# results.
def converts(source: Type, target: Type) -> bool:
    source = expand(source)
    target = expand(target)
    if boxed(target) != boxed(source):
        var unboxed = target
        if boxed(target):
            unboxed = source
        if has(unboxed, "float"):
            return true
    var from_tuple = tuple_member(source)
    var to_tuple = tuple_member(target)
    if from_tuple is not none and to_tuple is not none:
        for i in range(len(from_tuple.elements)):
            if converts(from_tuple.elements[i], to_tuple.elements[i]):
                return true
    else if from_tuple is not none and has(target, "protocol") or to_tuple is not none and has(source, "protocol"):
        # A tuple serving a protocol holds its items in the item type's
        # representation.
        var held = from_tuple
        if held is none:
            held = to_tuple
        assert held is not none
        var items_type = items(held)
        if items_type is not str:
            for element in held.elements:
                if converts(element, items_type):
                    return true
    var from_callable = callable_member(source)
    var to_callable = callable_member(target)
    if from_callable is not none and to_callable is not none:
        for i in range(len(to_callable.params)):
            if converts(to_callable.params[i], from_callable.params[i]):
                return true
        return converts(from_callable.result, to_callable.result)
    return false

# Whether `t` holds a float whose representation a conversion could change.
def has_float(t: Type) -> bool:
    t = expand(t)
    if t is Prim:
        return t.name == "float"
    var parts: list[Type] = []
    if t is UnionType:
        parts = t.members
    else if t is TupleType:
        parts = t.elements
    else if t is CallableType:
        if has_float(t.result):
            return true
        parts = t.params
    for part in parts:
        if has_float(part):
            return true
    return false

# Whether a protocol converter can carry values between a protocol method's
# position of type `want` and the matching position `have` of the method
# that serves it; each is generic when its declared type mentions a type
# parameter. A converter is built from declared types, so it converts only
# where neither is generic. A value reached through another protocol uses
# its own type's converter, so between protocols nothing may convert, and a
# position generic only in `want` cannot hold a float that converter may
# have changed.
def representable(want: Type, have: Type, want_generic: bool, have_generic: bool, between: bool) -> bool:
    if between:
        return not converts(have, want) and not (want_generic and not have_generic and has_float(have))
    return not ((want_generic or have_generic) and converts(have, want))

# The items a built-in value of type `t` yields when iterated, or none: list
# elements, dictionary keys, one-code-point strings, octets, or tuple items.
def iteration_item(t: Type) -> Type | none:
    t = expand(t)
    if t is ListType:
        return expand(t.element)
    if t is DictType:
        return t.key
    if t is Prim and t.name == "str":
        return prim("str")
    if t is Prim and t.name == "bytes":
        return prim("int")
    if t is TupleType:
        var item = items(t)
        if item is str:
            return none
        return item
    return none

# The standard `Iterator[T]` protocol, which built-in values' `iter` methods
# return.
def iterator_protocol() -> Protocol:
    var t = TypeVar(-1, "T", none)
    var decl = Protocol("Iterator", "Iterator", [t], [])
    var self_type = protocol_self(decl)
    var receiver = Param("self", self_type, none, false)
    decl.methods.append(Function(0, "iter", "Iterator.iter", [], [receiver], self_type))
    decl.methods.append(Function(0, "next", "Iterator.next", [], [receiver], t))
    return decl

def iterator(item: Type) -> ProtocolType:
    return ProtocolType(iterator_protocol(), [item])

# Whether method signature `have` accepts every call protocol method `want`
# permits, by position and by keyword, and returns a result `want` accepts.
# `between` is true when `have` is a protocol's method.
def compatible(want: Method | none, have: Method | none, between: bool, assuming: list[str]) -> bool:
    if want is none or have is none:
        return false
    var indexes = match_params(want, have)
    if indexes is none:
        return false
    for i in range(len(want.params)):
        var param = want.params[i]
        var h = have.params[indexes[i]]
        if not assignable_in(h.ty, param.ty, assuming):
            return false
        if not representable(param.ty, h.ty, want.generic[i], have.generic[indexes[i]], between):
            return false
    if not assignable_in(want.result, have.result, assuming):
        return false
    return representable(want.result, have.result, want.result_generic, have.result_generic, between)

# Whether `source` provides every method of protocol `target` compatibly.
# `assuming` holds the protocol and source pairs being checked, by display
# text, which are assumed to hold so that self-referential protocols
# terminate.
def satisfies(target: ProtocolType, source: Type, assuming: list[str]) -> bool:
    var pair = display(target) + " <- " + display(source)
    if pair in assuming:
        return true
    assuming.append(pair)
    var ok = true
    for fn in target.decl.methods:
        if ok:
            var want = method(target, fn.name)
            var have = method(source, fn.name)
            ok = compatible(want, have, (source is ProtocolType), assuming)
    assuming.pop()
    return ok

def is_exception(t: Type) -> bool:
    return t is ClassType and t.decl.exception

# Whether a value of `source`, a function or callable, can serve callable
# `target`: it accepts the target's positional arguments, any parameters
# past them have defaults, and its result fits the target's.
def serves(target: CallableType, source: Type, assuming: list[str]) -> bool:
    var params: list[Type] = []
    var result: Type
    if source is FunctionType:
        result = function_result(source)
        var declared = function_params(source)
        for i in range(len(declared)):
            var param = declared[i]
            if i < len(target.params) and param.keyword_only:
                return false
            if i >= len(target.params) and param.default is none:
                return false
            params.append(param.ty)
    else if source is CallableType:
        if len(source.params) != len(target.params):
            return false
        result = source.result
        params = source.params
    else:
        return false
    if len(params) < len(target.params):
        return false
    for i in range(len(target.params)):
        if not assignable_in(params[i], target.params[i], assuming):
            return false
    return assignable_in(target.result, result, assuming)

def assignable(target: Type, source: Type) -> bool:
    return assignable_in(target, source, [])

def assignable_in(target: Type, source: Type, assuming: list[str]) -> bool:
    target = expand(target)
    source = expand(source)
    if source is UnionType:
        for m in source.members:
            if not assignable_in(target, m, assuming):
                return false
        return true
    if target is UnionType:
        for m in target.members:
            if assignable_in(m, source, assuming):
                return true
        return false
    if target is CallableType:
        return same(target, source) or serves(target, source, assuming)
    if target is TupleType and source is TupleType:
        if len(target.elements) == len(source.elements):
            for i in range(len(target.elements)):
                if not assignable_in(target.elements[i], source.elements[i], assuming):
                    return false
            return true
    if same(target, source):
        return true
    if target is ClassType and target.decl.type_name == "Exception":
        if target.decl.exception and is_exception(source):
            return true
    if target is ProtocolType:
        var holds = kind(source) in ["record", "protocol"] or iteration_item(source) is not none
        if holds and satisfies(target, source, assuming):
            return true
    # A bounded type parameter serves wherever its bound does.
    if source is TypeVar:
        var bound = source.bound
        return bound is not none and assignable_in(target, bound, assuming)
    return false

# `t` with only the members in `kept`, a subset of its members in order, or
# `t` itself, keeping an alias's name, when it keeps them all.
def subset(t: Type, kept: list[Type]) -> Type:
    if len(kept) == len(members(t)):
        return t
    return union(kept)

# Open types do not fix their set of runtime classes.
def is_open(t: Type) -> bool:
    t = expand(t)
    return t is ProtocolType or t is TypeVar

# Whether every runtime class covered by `source` is covered by `target`.
# Type arguments and callable signatures do not affect runtime classes.
def covers(target: Type, source: Type) -> bool:
    target = expand(target)
    source = expand(source)
    if is_open(target) or is_open(source):
        return false
    if target is ClassType:
        if target.decl.type_name == "Exception":
            return is_exception(source)
        return source is ClassType and same_class(target.decl, source.decl)
    if target is EnumType:
        return source is EnumType and same_enum(target.decl, source.decl)
    var left = kind(target)
    var right = kind(source)
    if left == "function":
        left = "callable"
    if right == "function":
        right = "callable"
    return left == right

def overlaps(a: Type, b: Type) -> bool:
    if is_open(a) or is_open(b):
        return kind(a) != "none" and kind(b) != "none"
    return covers(a, b) or covers(b, a)

# The message for adding member `m` to a union with `parts`, or "".
def conflict(parts: list[Type], m: Type) -> str:
    for other in parts:
        if (is_open(other) and kind(m) != "none") or (is_open(m) and kind(other) != "none"):
            return "an open type can be in a union only with none"
        if overlaps(other, m):
            return "union members " + display(other) + " and " + display(m) + " overlap"
    return ""

# The type `for` gives the items of tuple `t`: the union of its position
# types without duplicate or subsumed members, or none when it has no
# positions. When that union is not a valid type, the reason instead.
def items(t: TupleType) -> Type | str:
    var kept: list[Type] = []
    for element in t.elements:
        for m in members(element):
            var subsumed = false
            for other in kept:
                if assignable(other, m):
                    subsumed = true
            if not subsumed:
                var rest: list[Type] = []
                for other in kept:
                    if not assignable(m, other):
                        rest.append(other)
                rest.append(m)
                kept = rest
    if len(kept) == 0:
        return prim("none")
    for i in range(1, len(kept)):
        var message = conflict(kept[:i], kept[i])
        if message != "":
            return message
    return union(kept)

# The error for type argument `arg` of type parameter `v` that does not
# satisfy its bound, or "".
def unsatisfied(v: TypeVar, arg: Type) -> str:
    var bound = v.bound
    if bound is none:
        return ""
    # A value of a type parameter reaches its bound's methods unconverted.
    if assignable(bound, arg) and not converts(arg, bound):
        return ""
    return f"type argument {display(arg)} does not satisfy the bound {display(bound)} of '{v.name}'"

# Whether `t` mentions a type parameter.
def mentions(t: Type) -> bool:
    return has_typevar(t, [], [], false)

# Whether `t` mentions one of the type parameters `vars`.
def mentions_any(t: Type, vars: list[TypeVar]) -> bool:
    var keys: list[str] = []
    for v in vars:
        keys.append(var_key(v))
    return has_typevar(t, [], keys, true)

# `seen` holds the ids of the lazy types already entered, which stops at
# recursive ones; when `only` is true, just the type parameters in `keys`
# count.
def has_typevar(t: Type, seen: list[int], keys: list[str], only: bool) -> bool:
    if t is Lazy:
        if t.id in seen:
            return false
        seen.append(t.id)
    t = expand(t)
    if t is TypeVar:
        return not only or var_key(t) in keys
    for part in parts_of(t):
        if has_typevar(part, seen, keys, only):
            return true
    return false

# The types `t` is made of, as substitution sees them; a dict key cannot
# mention a type parameter. A bound method with a receiver has the result of
# its specialized signature.
def parts_of(t: Type) -> list[Type]:
    var parts: list[Type] = []
    if t is FunctionType:
        if t.receiver is not none:
            parts.append(function_result(t))
    else if t is ListType:
        parts.append(t.element)
    else if t is DictType:
        parts.append(t.value)
    else if t is TupleType:
        parts.extend(t.elements)
    else if t is CallableType:
        parts.extend(t.params)
        parts.append(t.result)
    else if t is ClassType:
        parts.extend(t.args)
    else if t is ProtocolType:
        parts.extend(t.args)
    else if t is UnionType:
        parts.extend(t.members)
    return parts

# `t` with each type parameter that `bindings` names, by var_key, replaced by
# its type argument. Unions flatten and drop members they already hold.
def substitute(t: Type, bindings: dict[str, Type]) -> Type:
    t = expand(t)
    if not mentions(t):
        return t
    if t is TypeVar:
        return bindings.get(var_key(t), t)
    if t is ListType:
        return ListType(substitute(t.element, bindings))
    if t is DictType:
        return DictType(t.key, substitute(t.value, bindings))
    if t is TupleType:
        return TupleType(substitute_all(t.elements, bindings))
    if t is CallableType:
        return CallableType(substitute_all(t.params, bindings), substitute(t.result, bindings))
    if t is ClassType:
        return ClassType(t.decl, substitute_all(t.args, bindings))
    if t is ProtocolType:
        return ProtocolType(t.decl, substitute_all(t.args, bindings))
    if t is UnionType:
        var kept: list[Type] = []
        for member in t.members:
            for m in members(substitute(member, bindings)):
                var held = false
                for other in kept:
                    if same(other, m):
                        held = true
                if not held:
                    kept.append(m)
        return union(kept)
    return t

def substitute_all(parts: list[Type], bindings: dict[str, Type]) -> list[Type]:
    var result: list[Type] = []
    for part in parts:
        result.append(substitute(part, bindings))
    return result
