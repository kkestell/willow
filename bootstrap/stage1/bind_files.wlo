# Loads and binds the program whose entry file is each path named on the
# command line, and writes the first error in each to stderr as
# "ENTRY: DIAGNOSTIC", where the diagnostic names files relative to the entry
# file's directory, as a compiler run from that directory would. An entry
# whose file name begins with `test_` is a test file, which needs no `main`.
# With --signatures first, writes the types the binder gave each module's
# functions, methods, fields, and aliases to stdout. Exits with status 1 if
# any program has an error.

import bind
import diagnostic
import loader
import sys

def main():
    var args = sys.args()
    var signatures = len(args) > 0 and args[0] == "--signatures"
    if signatures:
        args = args[1:]
    var failed = false
    for path in args:
        var root = loader.directory_of(path)
        var test = path[len(root):].startswith("test_")
        var error: diagnostic.Diagnostic | none = none
        var result = loader.load(path, false)
        if result is diagnostic.Diagnostic:
            error = result
        else:
            error = bind.bind(result, test)
            if error is none and signatures:
                for source in result:
                    for line in bind.signatures(source.tree):
                        print(f"{source.name}: {line}")
        if error is not none:
            # Paths in messages, such as a missing module's, start with the
            # directory too.
            var message = error.message
            if root != "":
                message = message.replace(root, "")
            var relative = diagnostic.Diagnostic(error.path.removeprefix(root), error.line, error.col, message)
            sys.eprint(f"{path}: {relative.format()}")
            failed = true
    if failed:
        sys.exit(1)
