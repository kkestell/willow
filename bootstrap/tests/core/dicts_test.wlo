import core

def main():
    var d = core.dict_new(0)
    core.dict_set(d, core.int_word(10), core.int_word(1))
    core.dict_set(d, core.int_word(-3), core.int_word(2))
    core.dict_set(d, core.int_word(7), core.int_word(3))
    assert core.dict_len(d) == 3
    assert core.word_int(core.dict_get(d, core.int_word(-3))) == 2
    assert core.dict_contains(d, core.int_word(7))
    assert not core.dict_contains(d, core.int_word(8))
    assert core.dict_find(d, core.int_word(8)) == -1

    # Replacing a value keeps the entry's position and the version; removing
    # a key and inserting it again moves it to the end.
    var version = core.dict_version(d)
    core.dict_set(d, core.int_word(10), core.int_word(4))
    assert core.dict_version(d) == version
    assert core.word_int(core.dict_pop(d, core.int_word(-3))) == 2
    assert core.dict_version(d) != version
    core.dict_set(d, core.int_word(-3), core.int_word(5))
    var order = ""
    version = core.dict_version(d)
    var entry = core.dict_next(d, 0, version)
    while entry != -1:
        var key = core.word_int(core.dict_key_at(d, entry))
        var value = core.word_int(core.dict_value_at(d, entry))
        order = order + core.int_to_str(key) + "=" + core.int_to_str(value) + " "
        entry = core.dict_next(d, entry + 1, version)
    assert order == "10=4 7=3 -3=5 "

    # Keys compare by contents, and growing keeps insertion order.
    var s = core.dict_new(2)
    var i = 0
    while i < 100:
        core.dict_set(s, core.str_word("k" + core.int_to_str(i)), core.int_word(i))
        i = i + 1
    i = 0
    while i < 100:
        if i % 2 == 0:
            core.dict_pop(s, core.str_word("k" + core.int_to_str(i)))
        i = i + 1
    assert core.dict_len(s) == 50
    assert core.word_int(core.dict_get(s, core.str_word("k99"))) == 99
    assert not core.dict_contains(s, core.str_word("k98"))
    entry = core.dict_next(s, 0, core.dict_version(s))
    assert core.word_str(core.dict_key_at(s, entry)) == "k1"
    core.dict_set(s, core.str_word(""), core.int_word(-1))
    assert core.word_int(core.dict_get(s, core.str_word(""))) == -1

    # Many string keys force several grows, and every one keeps its value.
    var many = core.dict_new(2)
    i = 0
    while i < 5000:
        core.dict_set(many, core.str_word("key_" + core.int_to_str(i)), core.int_word(i))
        i = i + 1
    assert core.dict_len(many) == 5000
    i = 0
    while i < 5000:
        assert core.word_int(core.dict_get(many, core.str_word("key_" + core.int_to_str(i)))) == i
        i = i + 1
    assert not core.dict_contains(many, core.str_word("key_5000"))

    # Removing a string key and inserting it again moves it to the end.
    core.dict_pop(many, core.str_word("key_17"))
    assert not core.dict_contains(many, core.str_word("key_17"))
    core.dict_set(many, core.str_word("key_17"), core.int_word(-17))
    assert core.word_int(core.dict_get(many, core.str_word("key_17"))) == -17
    version = core.dict_version(many)
    entry = core.dict_next(many, 0, version)
    while core.word_str(core.dict_key_at(many, entry)) != "key_17":
        entry = core.dict_next(many, entry + 1, version)
    assert core.dict_next(many, entry + 1, version) == -1

    # Negative int keys are found.
    var big = core.dict_new(0)
    core.dict_set(big, core.int_word(-9223372036854775807), core.int_word(1))
    core.dict_set(big, core.int_word(-1), core.int_word(2))
    assert core.word_int(core.dict_get(big, core.int_word(-9223372036854775807))) == 1
    assert core.word_int(core.dict_get(big, core.int_word(-1))) == 2

    # A string equal by contents but a different object is found.
    var fresh = "ke" + "y_17"
    assert core.word_int(core.dict_get(many, core.str_word(fresh))) == -17

    # A zero hash is still cacheable, for both literals and allocated strings.
    var empty = core.str_sub("x", 0, 0)
    assert core.str_hash("") == 0
    assert core.str_hash("") == 0
    assert core.str_hash(empty) == 0
    assert core.str_hash(empty) == 0
    core.dict_set(s, core.str_word(empty), core.int_word(42))
    assert core.word_int(core.dict_get(s, core.str_word(""))) == 42

    # Caching preserves the existing hashes and the contents of shared keys.
    assert core.str_hash("foo_9999") == 955942781
    assert core.str_hash("foo_9999") == 955942781
    var shared = "é🙂"
    var alias = shared
    var equal = core.str_concat("é", "🙂")
    var other = core.dict_new(2)
    core.dict_set(s, core.str_word(shared), core.int_word(11))
    core.dict_set(other, core.str_word(alias), core.int_word(22))
    assert core.str_hash(shared) == 80726473
    assert core.str_hash(equal) == 80726473
    assert core.str_hash(alias) == 80726473
    assert core.word_int(core.dict_get(s, core.str_word(equal))) == 11
    assert core.word_int(core.dict_get(other, core.str_word(equal))) == 22
    assert core.bytes_decode(core.str_encode(shared)) == "é🙂"
    assert shared == "é🙂" and alias == shared
    assert core.str_size(shared) == 6
    assert core.str_len(shared) == 2
