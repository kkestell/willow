# Core's own tests import core, call its functions directly, and may use
# intrinsics to inspect representations. A test passes by printing nothing and
# exiting with status 0.
import core

def main():
    assert core.str_concat("ab", "c") == "abc"
    assert core.str_compare("a", "b") < 0
    assert core.str_compare("b", "a") > 0
    assert core.str_compare("ab", "ab") == 0
    assert core.int_to_str(-42) == "-42"
    # A literal has the same layout as a heap string: header, length, bytes.
    s = __ptr(__word("abc"))
    assert __int(__load8(s, 0)) == __int(__word(__type(str)))
    assert __int(__load8(s, 8)) == 3
