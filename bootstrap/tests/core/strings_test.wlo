# Core's own tests import core and call its functions directly. They cannot
# use intrinsics; a representation worth testing gets a core function. A test
# passes by printing nothing and exiting with status 0.
import core

def main():
    assert core.str_concat("ab", "c") == "abc"
    assert core.str_compare("a", "b") < 0
    assert core.str_compare("b", "a") > 0
    assert core.str_compare("ab", "ab") == 0
    assert core.int_to_str(-42) == "-42"

    assert core.str_chr(65) == "A"
    assert core.str_chr(233) == "é"
    assert core.str_chr(8364) == "€"
    assert core.str_chr(128512) == "😀"
    # The last code point of each UTF-8 length and the first of the next.
    assert core.str_ord(core.str_chr(127)) == 127
    assert core.str_ord(core.str_chr(128)) == 128
    assert core.str_ord(core.str_chr(2047)) == 2047
    assert core.str_ord(core.str_chr(2048)) == 2048
    assert core.str_ord(core.str_chr(65535)) == 65535
    assert core.str_ord(core.str_chr(65536)) == 65536
    assert core.str_ord(core.str_chr(1114111)) == 1114111

    assert core.str_join("|", core.str_split("a,b,,c", ",", -1)) == "a|b||c"
    assert core.str_join("|", core.str_split("one::two", "::", -1)) == "one|two"
    assert core.str_join("|", core.str_split("a,b,c", ",", 1)) == "a|b,c"
    assert core.str_join("|", core.str_split("a,b,c", ",", 0)) == "a,b,c"
    assert core.str_join("|", core.str_split("a,b,c", ",", -9223372036854775807)) == "a|b|c"
    assert core.list_len(core.str_split("", ",", -1)) == 1
    # Without a separator, runs of ASCII whitespace split and the ends are
    # ignored; U+00A0 is not whitespace here.
    assert core.str_join("|", core.str_split(" \t a  b\nc d ", None, -1)) == "a|b|c d"
    assert core.str_join("|", core.str_split(" a b  c ", None, 1)) == "a|b  c "
    assert core.str_join("|", core.str_split(" a b ", None, -9223372036854775807)) == "a|b"
    assert core.list_len(core.str_split(" \t\n", None, -1)) == 0

    # Case mapping through the generated tables: a 4-byte code point, the
    # code points a step-2 run skips, both ends of a table, and a full
    # mapping to three code points.
    assert core.str_lower("\U00010400") == "\U00010428"
    assert core.str_upper("\U00010428") == "\U00010400"
    assert core.str_lower("Āā") == "āā"
    assert core.str_upper("Āā") == "ĀĀ"
    assert core.str_upper("\x00é") == "\x00É"
    assert core.str_lower("\U0001E921\U0001F642") == "\U0001E943\U0001F642"
    assert core.str_upper("ﬃx") == "FFIX"
