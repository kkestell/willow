import core

def main():
    inf = 1e308 * 10.0
    nan = inf - inf

    assert core.float_to_str(0.1 + 0.2) == "0.30000000000000004"
    assert core.float_to_str(1.0 / 3.0) == "0.3333333333333333"
    assert core.float_to_str(100.0) == "100.0"
    assert core.float_to_str(1e15) == "1000000000000000.0"
    assert core.float_to_str(1e16) == "1e+16"
    assert core.float_to_str(0.0001) == "0.0001"
    assert core.float_to_str(0.00001) == "1e-05"
    assert core.float_to_str(-1.5e-7) == "-1.5e-07"
    assert core.float_to_str(1.7976931348623157e308) == "1.7976931348623157e+308"
    assert core.float_to_str(-0.0) == "-0.0"
    assert core.float_to_str(inf) == "inf"
    assert core.float_to_str(-inf) == "-inf"
    assert core.float_to_str(nan) == "nan"
    # Subnormal, and a power of two where the nearest 16-digit decimal does
    # not read back.
    assert core.float_to_str(5e-324) == "5e-324"
    assert core.float_to_str(7.120236347223045e-307) == "7.120236347223045e-307"

    assert core.str_to_float("2.5") == 2.5
    assert core.str_to_float(".5") == 0.5
    assert core.str_to_float("5.") == 5.0
    assert core.str_to_float("-1e-3") == -0.001
    assert core.str_to_float("+7") == 7.0
    assert core.str_to_float("1e400") == inf
    assert core.str_to_float("-Infinity") == -inf
    assert core.str_to_float("iNf") == inf
    nan_text = core.str_to_float("NaN")
    assert nan_text != nan_text

    assert core.float_to_int(-2.5) == -2
    assert core.float_to_int(3.99) == 3
    assert core.float_to_int(9.223372036854775e18) == 9223372036854774784
    assert core.float_to_int(-9.223372036854775e18) == -9223372036854774784

    assert core.float_floordiv(-7.5, 2.0) == -4.0
    assert core.float_floordiv(7.0, -2.0) == -4.0
    assert core.float_floordiv(-1.0, inf) == -1.0
    assert core.float_mod(5.0, -3.0) == -1.0
    assert core.float_mod(-5.0, 3.0) == 1.0
    assert core.float_to_str(core.float_mod(-0.0, 3.0)) == "0.0"
    assert core.float_to_str(core.float_mod(0.0, -3.0)) == "-0.0"
    assert core.float_to_str(core.float_floordiv(-0.0, 3.0)) == "-0.0"
