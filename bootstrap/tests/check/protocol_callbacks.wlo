protocol Reader:
    def get() -> int | none

class Source:
    value: int

    def get() -> int:
        return self.value

def read(value: Reader) -> int | none:
    return value.get()

def source(value: int) -> Source:
    return Source(value)

def number(value: int) -> int:
    return value

type Narrow = Source | ((int) -> int) | none
type Wide = Reader | ((int) -> int | none) | none

def widen(value: Narrow) -> Wide:
    return value

def main():
    callback: (Source) -> int | none = read
    print(callback(Source(7)))
    factory: (int) -> Reader = source
    print(factory(8).get())
    widen(number)
    widen(Source(9))
    widen(none)
    print("converted")
