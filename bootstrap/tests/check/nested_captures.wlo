# Captures pass through a function that does not use them, and nonlocal
# rebinds across two levels.
def outer() -> () -> int:
    total = 0

    def middle() -> () -> int:
        def inner() -> int:
            nonlocal total
            total = total + 1
            return total
        return inner

    step = middle()
    step()
    return step

class Holder:
    f: ((int) -> int | float) | none

def half(x: int | float) -> float:
    if isinstance(x, int):
        return float(x) / 2.0
    return x / 2.0

def main():
    f = outer()
    print(f())
    print(f())
    # A function in an optional callable field is adapted to its types.
    h = Holder(none)
    print(h.f is none)
    g: ((int) -> float) | none = half
    h.f = g
    call = h.f
    if call is not none:
        print(call(3))
