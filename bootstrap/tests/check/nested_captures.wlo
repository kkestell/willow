# Captures pass through a function that does not use them, and assignments
# rebinds across two levels.
def outer() -> () -> int:
    var total = 0

    def middle() -> () -> int:
        def inner() -> int:

            total = total + 1
            return total
        return inner

    var step = middle()
    step()
    return step

class Holder:
    f: ((int) -> int | float) | none

def half(x: int | float) -> float:
    if x is int:
        return float(x) / 2.0
    return x / 2.0

def main():
    var f = outer()
    print(f())
    print(f())
    # A function in an optional callable field is adapted to its types.
    var h = Holder(none)
    print(h.f is none)
    var g: ((int) -> float) | none = half
    h.f = g
    var call = h.f
    if call is not none:
        print(call(3))
