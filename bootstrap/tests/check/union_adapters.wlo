# A union whose callable and tuple members both convert.
type Narrow = ((int) -> int) | tuple[(int) -> int, int]
type Wide = ((int) -> int | None) | tuple[(int) -> int | None, int | None]

def double(x: int) -> int:
    return x * 2

def widen(value: Narrow) -> Wide:
    return value

def show(value: Wide):
    if isinstance(value, tuple):
        print(value[0](3))
        print(value[1])
    else:
        print(value(4))

def main():
    show(widen((double, 5)))
    show(widen(double))
