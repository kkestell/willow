import fs
import subprocess
import sys

class Checks:
    compiler: str
    directory: str

    def reject(self, source: str, expected: str):
        fs.write_file(fs.join(self.directory, "case.wlo"), source)
        result = subprocess.run([self.compiler, "check", "case.wlo"], cwd=self.directory, capture_output=True)
        assert result.returncode == 1
        assert result.stdout == bytes([])
        error = result.stderr
        assert error is not None
        assert error.decode() == "case.wlo:" + expected + "\n", error.decode()

    def build(self, source: str) -> str:
        fs.write_file(fs.join(self.directory, "case.wlo"), source)
        output = fs.join(self.directory, "program")
        result = subprocess.run([self.compiler, "build", "case.wlo", "-o", output], cwd=self.directory, capture_output=True)
        error = result.stderr
        assert error is not None
        assert result.returncode == 0, error.decode()
        return output

    def enter(self) -> Checks:
        return self

    def exit(self, error: Exception | None):
        for name in fs.listdir(self.directory):
            fs.remove(fs.join(self.directory, name))
        fs.rmdir(self.directory)

def checker() -> Checks:
    compiler = sys.getenv("WILLOW0")
    assert compiler is not None, "WILLOW0 must name the compiler being tested"
    return Checks(compiler, fs.temp_dir())
