class Flags:
    calls: int = 0

    def iter(self) -> Flags:
        return self

    def next(self) -> bool:
        self.calls = self.calls + 1
        if self.calls > 1:
            raise ValueError("too far")
        return True

def main():
    assert abs(-7) == 7
    assert abs(-2.5) == 2.5
    assert str(abs(-0.0)) == "0.0"
    assert round(0.5) == 0
    assert round(1.5) == 2
    assert round(2.5) == 2
    assert round(-1.5) == -2
    assert round(-2.5) == -2
    assert round(-0.4) == 0
    assert str(min(-0.0, 0.0)) == "-0.0"
    assert str(max(-0.0, 0.0)) == "-0.0"
    assert min((1, "b"), (1, "a"))[1] == "a"
    assert max([(1, 2), (2, 1)]) == (2, 1)
    empty: list[int] = []
    assert sum(empty) == 0
    floats: list[float] = []
    assert str(sum(floats)) == "0.0"
    assert sum([0.5, 0.25]) == 0.75
    flags: list[bool] = []
    assert all(flags)
    assert not any(flags)
    source = Flags()
    assert any(source)
    assert source.calls == 1
    for value in [float("nan"), float("inf"), -float("inf")]:
        try:
            round(value)
            assert False
        except ValueError as error:
            assert error.message == "cannot round float to int"
    try:
        min(empty)
        assert False
    except ValueError as error:
        assert error.message == "min() of an empty iterable"
    try:
        max(empty)
        assert False
    except ValueError as error:
        assert error.message == "max() of an empty iterable"
    try:
        min((0, (float("nan"),)), (1, (0.0,)))
        assert False
    except ValueError as error:
        assert error.message == "cannot compare NaN"
    try:
        max([float("nan")])
        assert False
    except ValueError as error:
        assert error.message == "cannot compare NaN"
    total: (list[int]) -> int = sum
    assert total([2, 3]) == 5
    numbered = enumerate([1])
    assert next(numbered) == (0, 1)
    for attempt in range(2):
        try:
            next(numbered)
            assert False
        except StopIteration as stop:
            assert stop.message == ""
    left = iter([1, 2])
    right = iter([3])
    joined = zip(left, right)
    assert next(joined) == (1, 3)
    for attempt in range(2):
        try:
            next(joined)
            assert False
        except StopIteration as stop:
            assert stop.message == ""
