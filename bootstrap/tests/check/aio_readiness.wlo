import aio

async def receive(connection: aio.Connection, count: int):
    var received = 0
    while received < count:
        var data = await connection.recv(min(65536, count - received), timeout=5.0)
        assert len(data) > 0
        received = received + len(data)

async def receive_closed(connection: aio.Connection, finished: list[bool]):
    try:
        await connection.recv(1)
    except ValueError as error:
        assert error.message == "I/O operation on closed connection"
        finished.append(true)

async def stalled_send(connection: aio.Connection, data: bytes):
    await connection.sendall(data)

async def fractional() -> float:
    return 1.25

async def main():
    var fraction: aio.Task[float]
    async with aio.task_group() as group:
        fraction = group.start(fractional())
    assert fraction.result() == 1.25
    assert await fraction == 1.25
    var data = "x".encode()
    for i in range(23):
        data = data + data
    with aio.listen("127.0.0.1", 0) as listener:
        async with aio.task_group() as group:
            group.start(listener.accept())
            await aio.sleep(0.0)
            var rejected = false
            try:
                await listener.accept()
            except RuntimeError as error:
                assert error.message == "accept is already in progress"
                rejected = true
            assert rejected
            group.cancel()
        var client: aio.Connection
        var server: aio.Connection
        with await aio.connect("127.0.0.1", listener.local_port()) as client_item:
            client = client_item
            with await listener.accept() as server_item:
                server = server_item
                async with aio.task_group() as group:
                    group.start(client.sendall(data, timeout=5.0))
                    group.start(server.sendall(data, timeout=5.0))
                    group.start(receive(client, len(data)))
                    group.start(receive(server, len(data)))
                async with aio.task_group() as group:
                    group.start(server.recv(1))
                    await aio.sleep(0.0)
                    group.cancel()
                await client.sendall("r".encode())
                assert await server.recv(1) == "r".encode()

        client = await aio.connect("127.0.0.1", listener.local_port())
        server = await listener.accept()
        var finished: list[bool] = []
        async with aio.task_group() as group:
            group.start(receive_closed(server, finished))
            await aio.sleep(0.0)
            server.close()
            # A new connection can reuse the closed server's descriptor.
            with await aio.connect("127.0.0.1", listener.local_port()) as replacement:
                with await listener.accept() as peer:
                    await replacement.sendall("new".encode())
                    assert await peer.recv(3) == "new".encode()
        assert len(finished) == 1 and finished[0]
        client.close()

        with await aio.connect("127.0.0.1", listener.local_port()) as client_item:
            client = client_item
            with await listener.accept() as server_item:
                server = server_item
                async with aio.task_group() as group:
                    group.start(stalled_send(server, data))
                    await aio.sleep(0.01)
                    var rejected = false
                    try:
                        await server.sendall(bytes([]))
                    except RuntimeError as error:
                        assert error.message == "sendall is already in progress"
                        rejected = true
                    assert rejected
                    server.enter()
                    group.cancel()
                var broken = false
                try:
                    server.enter()
                except ValueError as failure:
                    assert failure.message == "connection is unusable after a failed send"
                    broken = true
                assert broken
