def main():
    maximum = 9223372036854775807
    minimum = -9223372036854775807
    assert abs(minimum) == maximum
    assert sum([maximum - 1, 1]) == maximum
    assert sum([minimum + 1, -1]) == minimum
    for values in [(maximum, 1), (minimum, -1)]:
        try:
            sum(values)
            assert False
        except OverflowError as error:
            assert error.message == "integer overflow"
    terminal = enumerate([1], maximum)
    assert next(terminal) == (maximum, 1)
    try:
        next(terminal)
        assert False
    except StopIteration as stop:
        assert stop.message == ""
    overflow = enumerate([1, 2], maximum)
    assert next(overflow) == (maximum, 1)
    try:
        next(overflow)
        assert False
    except OverflowError as error:
        assert error.message == "integer overflow"
    assert list(range(maximum - 1, maximum, 2))[0] == maximum - 1
    assert list(range(minimum + 1, minimum, -2))[0] == minimum + 1
    extremes = list(range(minimum, maximum, maximum))
    assert len(extremes) == 2
    assert extremes[0] == minimum
    assert extremes[1] == 0
    assert round(9223372036854774784.0) == 9223372036854774784
    assert round(-9223372036854774784.0) == -9223372036854774784
    for value in [9223372036854775808.0, -9223372036854775808.0]:
        try:
            round(value)
            assert False
        except ValueError as invalid:
            assert invalid.message == "cannot round float to int"
