import core
import io

def main():
    path = "io_files.tmp"
    long = "x".ljust(4095) + "é"
    try:
        with io.open(path, "w") as target:
            target.write_text("one\r\n\n" + long + "\n")
            target.write(bytes([255, 10]))
            target.flush()
            try:
                target.read(1)
                assert false
            except ValueError as error:
                assert error.message == "file is not open for reading"
        target.close()
        with io.open(path, "a") as target:
            target.write_text("last\r")

        source = io.open(path)
        alias = source
        try:
            one = iter(source)
            two = iter(source)
            assert next(one) == "one"
            assert source.read(1) == bytes([10])
            assert next(two) == long
            try:
                next(one)
                assert false
            except ValueError as error:
                assert error.message == "invalid UTF-8"
            assert source.readline() == "last\r"
            assert source.readline() is none
            assert len(source.read(1)) == 0
            try:
                next(two)
                assert false
            except StopIteration:
                pass
        finally:
            source.close()
        for operation in ["read", "flush", "enter", "iter"]:
            try:
                if operation == "read":
                    alias.readline()
                else if operation == "flush":
                    alias.flush()
                else if operation == "enter":
                    alias.enter()
                else:
                    next(one)
                assert false
            except ValueError as error:
                assert error.message == "I/O operation on closed file"
    finally:
        assert core.run(["rm", "-f", path]) == 0

    for operation in ["size", "mode", "close", "enter", "open", "nul", "missing"]:
        try:
            if operation == "size":
                io.stdin().read(0)
            else if operation == "mode":
                io.stdin().write(bytes([]))
            else if operation == "close":
                io.stdout().close()
            else if operation == "enter":
                with io.stderr():
                    assert false
            else if operation == "open":
                io.open(path, "x")
            else if operation == "nul":
                io.open("bad\x00path")
            else:
                io.open(path)
            assert false
        except ValueError as error:
            if operation == "size":
                assert error.message == "read size must be positive"
            else if operation == "mode":
                assert error.message == "file is not open for writing"
            else if operation == "close" or operation == "enter":
                assert error.message == "cannot close a standard stream"
            else if operation == "open":
                assert error.message == "invalid mode 'x'"
            else:
                assert error.message == "path contains a NUL character"
        except OSError as os_error:
            assert operation == "missing"
            assert os_error.message == "cannot open io_files.tmp: No such file or directory"
