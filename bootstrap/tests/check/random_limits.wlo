import random

def main():
    var maximum = 9223372036854775807
    var first = random.generator(maximum)
    var second = random.generator(-maximum)
    assert first.random() != second.random()
    var negative = false
    var positive = false
    for i in range(32):
        var value = first.randint(-maximum, maximum)
        negative = negative or value < 0
        positive = positive or value > 0
        assert first.randint(-maximum, -maximum + 1) <= -maximum + 1
        assert first.randint(maximum - 1, maximum) >= maximum - 1
    assert negative and positive
    assert first.randint(-maximum, -maximum) == -maximum
    assert first.randint(maximum, maximum) == maximum
    print("random limits passed")
