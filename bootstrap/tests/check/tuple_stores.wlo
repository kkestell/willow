enum Side:
    LEFT
    RIGHT

class Box:
    value: tuple[float | none, bool | str, Side | none, tuple[int | none]]

def main():
    var raw = (2.5, true, Side.RIGHT, (4,))
    var box = Box(raw)
    assert box.value[0] == 2.5
    assert box.value[1] == true
    assert box.value[2] == Side.RIGHT
    assert box.value[3][0] == 4
    box.value = (none, "x", none, (none,))
    assert box.value[0] is none
    box.value = raw
    var xs: list[tuple[float | none, bool | str, Side | none, tuple[int | none]]] = [raw]
    xs.append(raw)
    xs[0] = raw
    assert xs.pop() == box.value
    var d: dict[str, tuple[float | none, bool | str, Side | none, tuple[int | none]] | none] = {"x": raw}
    d["y"] = raw
    var found = d.get("x")
    assert found is not none
    assert found == box.value
    for found_item in [raw]:
        found = found_item
        assert found == box.value
    var original = ([1], 2.5)
    var widened: tuple[list[int], float | none] = original
    original[0].append(3)
    assert widened[0][1] == 3
    var flag: bool | none = none
    var side: Side | none = none
    var number: float | none = none
    var nested: tuple[int]
    number, flag, side, nested = raw
    assert number + 1.0 == 3.5
    assert flag
    assert side == Side.RIGHT
    assert nested[0] == 4
    var optional: tuple[int | none] = (none,)
    for item in ((4,), optional):
        assert item[0] == 4 or item[0] is none
