def ints(xs: list[int]) -> str:
    var texts: list[str] = []
    for x in xs:
        texts.append(str(x))
    return " ".join(texts)

def floats(xs: list[float]) -> str:
    var texts: list[str] = []
    for x in xs:
        texts.append(str(x))
    return " ".join(texts)

def main():
    print(" ".join(sorted({"b": 1, "a": 2, "c": 3})))
    print(" ".join(sorted("cab")))
    print(ints(sorted(bytes([3, 1, 2]))))
    print(ints(sorted((3, 1, 2))))
    print(ints(sorted(range(5, 0, -2))))
    print(" ".join(sorted(["é", "z", "Z", "a"])))
    print(floats(sorted([0.0, -0.0, float("inf"), -1.5])))

    # Runs of several merge passes, with equal values in both directions.
    var big = [17, 3, 9, 1, 12, 5, 8, 20, 2, 11, 6, 14, 0, 19, 4, 7, 15, 10, 13]
    big.sort()
    print(ints(big))
    var pairs = [(1, "a"), (0, "b"), (1, "c"), (0, "d")]
    for n, name in sorted(pairs, reverse=true):
        print(f"{n} {name}")
    var nested = [((2, "x"), 1), ((1, "z"), 2), ((1, "y"), 3)]
    nested.sort()
    for key, n in nested:
        print(f"{key[0]} {key[1]} {n}")

    # NaN in a nested tuple position stops the sort before anything moves.
    var with_nan = [(2, (1.0, "a")), (1, (float("nan"), "b"))]
    try:
        with_nan.sort()
    except ValueError as error:
        print(error.message)
    print(with_nan[0][0])
