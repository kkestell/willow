def main():
    d = {"one": 1}
    for pair in d.items():
        assert pair == ("one", 1)
    nested = {"two": (2, 2.5)}
    for key, (n, f) in nested.items():
        assert key == "two"
        assert n == 2
        assert f == 2.5
    held: tuple[str, int | none] | none = none
    for held in d.items():
        assert held[0] == "one"
        assert held[1] == 1
    for n, f in nested.values():
        assert n == 2
        assert f == 2.5
