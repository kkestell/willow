import keyword_defaults.settings

def main():
    var Mode = 42
    var options = keyword_defaults.settings.Options()
    assert options.mode == keyword_defaults.settings.Mode.ON
    assert str(options.number) == "2.5"
    assert str(options.zero) == "-0.0"
    assert options.choose() == keyword_defaults.settings.Mode.OFF
    assert options.choose(mode=keyword_defaults.settings.Mode.ON) == keyword_defaults.settings.Mode.ON
    assert keyword_defaults.settings.choose() == keyword_defaults.settings.Mode.ON
    assert keyword_defaults.settings.choose(mode=none) is none
    assert keyword_defaults.settings.choose(mode=keyword_defaults.settings.Mode.OFF) == keyword_defaults.settings.Mode.OFF
    var other = keyword_defaults.settings.Options(mode=none, number=-1)
    assert other.mode is none
    assert str(other.number) == "-1"
