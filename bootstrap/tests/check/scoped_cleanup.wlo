class Manager:
    name: str
    log: list[str]
    fail_enter: bool = false
    fail_exit: bool = false

    def enter(value: int = 3) -> tuple[str, int]:
        self.log.append("enter " + self.name)
        if self.fail_enter:
            raise ValueError("entry")
        return (self.name, value)

    def exit(error: Exception | none, extra: int = 0):
        if error is none:
            self.log.append("exit " + self.name)
        else:
            self.log.append("exit " + self.name + ": " + error.message)
        if self.fail_exit:
            raise RuntimeError("exit")

def returning(manager: ContextManager[tuple[str, int | none]]) -> int:
    with manager as (name, value):
        assert name == "return"
        assert value is not none
        return value

def replaced(manager: Manager) -> int:
    with manager:
        return 1

def bounded[T: ContextManager[tuple[str, int]]](manager: T) -> str:
    with manager as (name, value):
        return name

def main():
    log: list[str] = []
    assert returning(Manager("return", log)) == 3
    assert ",".join(log) == "enter return,exit return"
    log = []
    assert bounded(Manager("bounded", log)) == "bounded"
    assert ",".join(log) == "enter bounded,exit bounded"
    log = []
    with Manager("a", log) as (name, value), Manager("b", log):
        assert value == 3
    assert name == "a"
    assert ",".join(log) == "enter a,enter b,exit b,exit a"
    log = []
    try:
        with Manager("a", log), Manager("b", log, true):
            pass
    except ValueError:
        pass
    assert ",".join(log) == "enter a,enter b,exit a: entry"
    log = []
    try:
        with Manager("a", log), Manager("b", log, false, true):
            raise ValueError("body")
    except RuntimeError as error:
        assert error.message == "exit"
    assert ",".join(log) == "enter a,enter b,exit b: body,exit a: exit"
    log = []
    try:
        replaced(Manager("return", log, false, true))
        assert false
    except RuntimeError:
        pass
    assert ",".join(log) == "enter return,exit return"
    log = []
    saved = Manager("original", log)
    with saved:
        saved = Manager("replacement", log)
    assert ",".join(log) == "enter original,exit original"
    log = []
    for n in range(3):
        with Manager(str(n), log):
            try:
                if n == 0:
                    continue
                break
            finally:
                log.append("finally")
    assert ",".join(log) == "enter 0,finally,exit 0,enter 1,finally,exit 1"
