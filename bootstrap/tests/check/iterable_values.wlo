class Broken:
    def iter() -> Iterator[int]:
        raise StopIteration("creation")

class Failing:
    count: int = 0

    def iter(unused: int = 0) -> Failing:
        return self

    def next(value: int = 7) -> int:
        self.count = self.count + 1
        if self.count == 1:
            return value
        raise ValueError("advance")

class PairSource[T]:
    values: list[T]

    def iter() -> Iterator[T]:
        return iter(self.values)

class Factory[T: Iterator[int]]:
    value: T

    def iter() -> T:
        return self.value

def wrap[T: Iterator[int]](iterator: T) -> Iterator[tuple[int, int]]:
    return enumerate(Factory(iterator))

def bounded_optional[T: Iterable[int | none]](source: T) -> int | none:
    for item in source:
        return item
    return none

def pairs[T](source: Iterable[T]) -> Iterator[tuple[T, T]]:
    return zip(source, source)

def numbered[T](source: Iterable[T]) -> Iterator[tuple[int, T]]:
    return enumerate(source, 4)

def take(source: Iterable[tuple[float, int | none]]) -> tuple[float, int | none]:
    return next(iter(source))

def main():
    try:
        for n in Broken():
            pass
    except StopIteration as stop:
        assert stop.message == "creation"
    var value = bounded_optional([7])
    assert value is not none
    assert value == 7
    assert next(wrap(Failing())) == (0, 7)
    var failure = Failing()
    assert next(failure) == 7
    try:
        for n in failure:
            pass
    except ValueError as error:
        assert error.message == "advance"
    assert take(((1.5, 2),)) == (1.5, 2)
    var mixed = iter((1.5, 2))
    assert next(mixed) is float
    assert next(mixed) is int
    var values = PairSource([(2.5, 3)])
    assert next(pairs(values)) == ((2.5, 3), (2.5, 3))
    assert next(numbered(values)) == (4, (2.5, 3))
    var convert: (list[int]) -> Iterator[int] = iter
    var advance: (Iterator[int]) -> int = next
    assert advance(convert([9])) == 9
    var items: list[int | none] = [none]
    items.extend([3])
    assert items[1] == 3
    var collected = [1, 2]
    collected.extend(collected)
    assert len(collected) == 4
    var before = len(collected)
    try:
        collected.extend(Failing())
    except ValueError:
        pass
    assert len(collected) == before
    var values_by_key = {"a": 1, "b": 2}
    assert list(values_by_key.keys())[0] == "a"
    assert list(values_by_key.values())[1] == 2
    assert list(values_by_key.items())[1] == ("b", 2)
    var view = values_by_key.items()
    values_by_key["c"] = 3
    try:
        next(view)
    except RuntimeError as mutation:
        assert mutation.message == "dictionary changed size during iteration"
