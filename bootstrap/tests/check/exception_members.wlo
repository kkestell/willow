protocol Reader:
    def read() -> int

class Src:
    def read() -> int:
        return 1

class Trouble(Exception):
    pass

def describe(value: Src | Exception | none) -> str:
    if value is Exception:
        return value.message
    if value is none:
        return "none"
    return str(value.read())

def is_error(value: Exception | str | none) -> bool:
    return value is Exception

def main():
    print(describe(ValueError("bad")))
    print(describe(Trouble("custom")))
    print(describe(Src()))
    print(describe(none))
    print(is_error(Exception("base")))
    print(is_error(ValueError("builtin")))
    print(is_error(Trouble("custom")))
    print(is_error("text"))
    print(is_error(none))
