protocol Reader:
    def read(self) -> int

class Src:
    def read(self) -> int:
        return 1

class Trouble(Exception):
    pass

def widen(value: Src | Exception | none) -> Reader | Exception | none:
    return value

def describe(value: Reader | Exception | none) -> str:
    if isinstance(value, Exception):
        return value.message
    if value is none:
        return "none"
    return str(value.read())

def is_error(value: Exception | str | none) -> bool:
    return isinstance(value, Exception)

def main():
    print(describe(widen(ValueError("bad"))))
    print(describe(widen(Trouble("custom"))))
    print(describe(widen(Src())))
    print(describe(widen(none)))
    print(is_error(Exception("base")))
    print(is_error(ValueError("builtin")))
    print(is_error(Trouble("custom")))
    print(is_error("text"))
    print(is_error(none))
