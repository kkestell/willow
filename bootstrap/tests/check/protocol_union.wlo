protocol Reader:
    def read() -> int

protocol TaggedReader:
    def read() -> int
    def tag() -> str

class Source:
    n: int

    def read() -> int:
        return self.n

    def tag() -> str:
        return "source"

def widen(value: TaggedReader | none) -> Reader | none:
    return value

def describe(value: Reader | none) -> str:
    if value is none:
        return "none"
    return "reader " + str(value.read())

def main():
    var values: list[Reader | none] = [Source(1), none]
    for value in values:
        print(describe(value))
    print(describe(widen(Source(3))))
    print(describe(widen(none)))
