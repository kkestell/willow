type Nested = tuple[tuple[str | none] | str | none] | none

def equal(a: tuple[str | none], b: tuple[str | none]) -> bool:
    return a == b

def equal_nested(a: Nested, b: Nested) -> bool:
    return a == b

def contains(value: Nested, values: list[Nested]) -> bool:
    return value in values

def main():
    raw = ("a",)
    assert not equal(raw, (none,))
    assert not equal((none,), raw)
    assert equal(raw, ("a",))
    nothing = (none,)
    assert equal(nothing, (none,))
    nested = (raw,)
    assert not equal_nested(nested, (none,))
    assert not equal_nested((none,), nested)
    assert equal_nested(nested, (("a",),))
    assert not equal_nested(("a",), nested)
    assert contains(nested, [(none,), nested])
    assert contains((("a",),), [nested])
    assert not contains(nested, [((none,),)])
    assert not contains((none,), [nested])
