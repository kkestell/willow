import core
import fs

def main():
    var root = fs.temp_dir()
    fs.mkdir(fs.join(root, "real/sub"), parents=true)
    var source = fs.join(root, "real/inside")
    fs.write_file(source, "original")
    assert core.run(["ln", "-s", "real", fs.join(root, "link")]) == 0
    assert core.run(["ln", "-s", "missing", fs.join(root, "dangling")]) == 0
    assert core.run(["ln", "-s", "..", fs.join(root, "real/up")]) == 0
    assert core.run(["ln", source, fs.join(root, "hard")]) == 0
    assert fs.stat(fs.join(root, "link")).kind == "directory"
    assert fs.stat(fs.join(root, "link"), follow_symlinks=false).kind == "symlink"
    assert not fs.exists(fs.join(root, "dangling"))
    assert len(fs.glob(fs.join(root, "dangling"))) == 1
    try:
        fs.copy_file(source, fs.join(root, "hard"))
        assert false
    except OSError as error:
        assert error.message.endswith("they are the same file")
    assert fs.read_file(source) == "original"

    var tree = fs.walk(root)
    var path, directories, files = next(tree)
    assert path == root
    assert ",".join(directories) == "real"
    assert ",".join(files) == "dangling,hard,link"
    directories.pop()
    files.append("unused")
    var visited: list[str] = []
    for path_item, directories_item, files_item in tree:
        path = path_item
        directories = directories_item
        files = files_item
        visited.append(path[len(root):])
    assert ",".join(visited) == "/real,/real/sub"
    var missing = fs.walk(fs.join(root, "missing"))
    try:
        next(missing)
        assert false
    except OSError as error:
        assert error.message.startswith("cannot list ")

    fs.write_file(fs.join(root, "a\\z"), "backslash")
    assert len(fs.glob(fs.join(root, "a\\*"))) == 1
    fs.write_file(fs.join(root, "é"), "accent")
    fs.write_file(fs.join(root, "😀"), "emoji")
    assert len(fs.glob(fs.join(root, "?"))) == 2
    assert len(fs.glob(fs.join(root, "??"))) == 0
    assert len(fs.glob(fs.join(root, "[é😀]"))) == 2
    assert len(fs.glob(fs.join(root, "[à-ê]"))) == 1
    assert len(fs.glob(fs.join(root, "[!é]"))) == 1
    var info = fs.Stat("file", 3, 2.0)
    info.kind = "other"
    assert info.kind == "other" and info.size == 3
    var paths: list[str] = []
    for path_item, directories_item, files_item in fs.walk(root):
        path = path_item
        directories = directories_item
        files = files_item
        paths.append(path)
        for name in files:
            fs.remove(fs.join(path, name))
    for i in range(len(paths) - 1, -1, -1):
        fs.rmdir(paths[i])
    print("fs entries passed")
