class Row:
    name: str
    score: int

    def rank(row: Row) -> int:
        return self.score - row.score

def names(xs: list[Row]) -> str:
    texts: list[str] = []
    for x in xs:
        texts.append(f"{x.name}:{x.score}")
    return " ".join(texts)

def ints(xs: list[int]) -> str:
    texts: list[str] = []
    for x in xs:
        texts.append(str(x))
    return " ".join(texts)

def by_name(row: Row) -> str:
    return row.name

def main():
    data = [Row("cy", 2), Row("ada", 3), Row("bob", 2), Row("dee", 1)]
    print(names(sorted(data, key=(row) => row.score)))
    print(names(sorted(data, reverse=true, key=(row) => row.score)))
    print(names(sorted(data, key=(row) => (row.score, row.name))))
    print(names(sorted(data, key=by_name)))
    print(names(sorted(data, key=Row("", 10).rank)))
    words = ["bb", "a", "ccc"]
    words.sort(key=len)
    print(" ".join(words))
    print(ints(sorted([-3, 2, -1], key=abs)))

    # Each key is computed once, in input order.
    def logged(row: Row) -> str:
        print("key " + row.name)
        return row.name
    data.sort(key=logged)
    print(names(data))

    # A key's own effects stay, but the list is not reordered.
    xs = [3, 1, 2]
    def growing(x: int) -> int:
        xs.append(0)
        return x
    try:
        xs.sort(key=growing)
    except RuntimeError as error:
        print(error.message)
    print(ints(xs))

    def failing(row: Row) -> int:
        if row.name == "cy":
            raise ValueError("bad key")
        return row.score
    try:
        data.sort(key=failing)
    except ValueError as failure:
        print(failure.message)
    print(names(data))
    try:
        data.sort(key=(row) => (row.score, float("nan")))
    except ValueError as again:
        print(again.message)
    print(names(data))
