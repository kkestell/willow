import coverage_support.compiler

def main():
    with coverage_support.compiler.checker() as compiler:
        cases = [
            ("def main():\n\tpass\n", "2:1: error: tabs are not allowed outside strings and comments"),
            ("def main():\n  pass\n", "2:3: error: indentation must be a multiple of four spaces"),
            ("def main():\n    x = 1\ry = 2\n", "2:10: error: bare carriage return; line endings must be LF or CRLF"),
            ("def main():\n    x = 007\n", "2:9: error: integer literal has leading zeros"),
            ("def main():\n    x = 0x1F\n", "2:9: error: invalid number literal '0x1F'"),
            ("def main():\n    x = '\\uD800'\n", "2:10: error: escape '\\uD800' is not a valid code point"),
            ("def main():\n    x = f\"{a#}\"\n", "2:13: error: f-string fields cannot contain '#'"),
            ("def main():\n    x = 0 <= y < 10\n", "2:16: error: comparison chains are not supported"),
            ("def main():\n    f(a=1, 2)\n", "2:12: error: positional argument follows keyword argument"),
            ("def f(a: int = 1, b: int):\n    pass\ndef main():\n    pass\n", "1:19: error: parameter 'b' without a default follows one with a default"),
            ("class A:\n    def f(x: int):\n        pass\ndef main():\n    pass\n", "2:11: error: method 'f' must take 'self' as its first parameter"),
            ("def main():\n    a, a = (1, 2)\n", "2:8: error: duplicate target 'a'"),
            ("def main():\n    try:\n        pass\n    except Exception:\n        pass\n    else:\n        pass\n", "6:5: error: 'else' clause on 'try' is not supported"),
        ]
        for source, expected in cases:
            compiler.reject(source, expected)
        compiler.reject("def main():\n    x = 'é' + missing\n", "2:15: error: unknown name 'missing'")
