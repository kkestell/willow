import core
import io

def main():
    var pipe = core.process_pipe()
    var path = "/dev/fd/" + str(pipe[1])
    with io.open(path, "w") as output:
        core.close(pipe[0])
        core.close(pipe[1])
        var caught = false
        try:
            output.write_text("hello")
        except OSError as error:
            assert error.message == "cannot write " + path + ": Broken pipe"
            caught = true
        assert caught
