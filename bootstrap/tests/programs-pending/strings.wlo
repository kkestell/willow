def show(items: list[str]):
    print("[" + "|".join(items) + "]")

def main():
    text = "café"
    print(len(text))
    print(text[0])
    print(text[-1])
    print("ab" + "cd")
    print("é" in text)
    print("x" not in text)
    print("apple" < "banana")
    print("a" < "B")
    print("b" >= "b")
    print("abc" == "ab" + "c")
    for c in "hé!":
        print(c)
    print(ord("é"))
    print(chr(8364))
    print(ord(chr(65)))
    print("café!".find("!"))
    print("banana".find("na"))
    print("banana".find("x"))
    print("main.wlo".startswith("main"))
    print("main.wlo".endswith(".lua"))
    print("aaa".replace("a", "bb"))
    print("a-b-c".replace("-", ""))
    print("[" + " \t pad \n".strip() + "]")
    show("a,b,,c".split(","))
    show("one::two".split("::"))
    show("none".split(","))
    print(", ".join(["x", "y", "z"]))
    print("-".join([]))
    print("test_main".removeprefix("test_"))
    print("main".removeprefix("test_"))
    print("main.wlo".removesuffix(".wlo"))
    print("0123".isdigit())
    print("12a".isdigit())
    print("".isdigit())
    print("abcXYZ".isalpha())
    print("café".isalpha())
    print("abc123".isalnum())
    print("a b".isalnum())
    print(" \t\n".isspace())
    print("".isspace())
    print("[" + "ab".ljust(5) + "]")
    print("[" + "ab".rjust(5) + "]")
    print("[" + "abcdef".rjust(3) + "]")
    print("[" + "é".ljust(3) + "]")
    print("tab\there")
    print('quote "inside"')
    print("\x41é\U0001F600")
