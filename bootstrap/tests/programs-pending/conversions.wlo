def main():
    print(str(42))
    print(str(-7) + "!")
    print(str(True))
    print(str(None))
    print(str(2.5))
    print(int("123"))
    print(int("-0042"))
    print(int("+7"))
    print(int(-2.5))
    print(int(3.99))
    print(float(3))
    print(float(-0))
    print(float("2.5"))
    print(float(".5"))
    print(float("5."))
    print(float("1e-3"))
    print(float("-INF"))
    print(float("Infinity"))
    print(float("nan"))
    print(float("1e400"))
    print(0.1 + 0.2)
    print(1.0 / 3.0)
    print(7 / 2)
    print(100.0)
    print(1e15)
    print(1e16)
    print(0.0001)
    print(0.00001)
    print(-0.0)
    print(123456789.125)
    print(7 // -2)
    print(7 % -2)
    print(-7 // 2)
    print(-7.5 // 2.0)
    print(5.0 % -3.0)
