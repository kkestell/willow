class Mode:
    value: int = 0o007

def main():
    print(0xAbCd)
    print(0o755)
    print(0b101010)
    print(0x7fffffffffffffff)
    print(0o777777777777777777777)
    print(0b111111111111111111111111111111111111111111111111111111111111111)
    print(-0x2a)
    print(Mode().value)
    print(~0)
    print(~-1)
    print(~-9223372036854775807)
    print(0b1100 & 0b1010)
    print(0b1100 | 0b1010)
    print(0b1100 ^ 0b1010)
    print(-7 & 3)
    print(-7 | 3)
    print(-7 ^ 3)
    print(1 | 2 ^ 3 & 4 << 1 + 1)
    print(8 >> 1 + 1)
    print(1 << 3 << 1)
    print(~1 + 3)
    print(6 & 3 == 2)
    print(2 == 6 & 3)
    var items = [10, 20, 30, 40]
    var i = 1
    var j = 2
    print(items[i | j])
    items[i | j] = 99
    print(items[3])
    print(1 << 62)
    print(-1 << 62)
    print(-3 >> 1)
    print(5 << 0)
    print(-5 >> 0)
    print(9223372036854775807 >> 62)
    print(-9223372036854775807 >> 62)
    print(9223372036854775807 >> 63)
    print(-9223372036854775807 >> 63)
    print(1 >> 64)
    print(-1 >> 64)
    print(1 >> 9223372036854775807)
    print(-1 >> 9223372036854775807)
    print(0 << 63)
    print(0 << 64)
    print(0 << 9223372036854775807)
