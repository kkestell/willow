class Circle:
    radius: float

class Square:
    side: float

class Node:
    value: int
    next: Node | none

type Shape = Circle | Square
type Value = int | float | str | bool | none

def area(shape: Shape) -> float:
    if shape is Circle:
        return 3.0 * shape.radius * shape.radius
    return shape.side * shape.side

def describe(value: Value) -> str:
    if value is none:
        return "nothing"
    else if value is bool:
        if value:
            return "yes"
        return "no"
    else if value is int:
        return "int " + str(value + 1)
    else if value is float:
        return "float " + str(value * 2.0)
    else:
        return "str " + value

def length(text: str | none) -> int:
    if text is not none and len(text) > 2:
        return len(text)
    if text is none or text == "":
        return 0
    return -len(text)

def positive(value: int | none) -> bool:
    if not (value is none or value <= 0):
        return value > 0
    return false

def sum_nodes(head: Node | none) -> int:
    total = 0
    node = head
    while node is not none:
        total = total + node.value
        node = node.next
    return total

def same(a: int | float, b: int | float) -> bool:
    return a == b

def first_word(text: str | none) -> str:
    assert text is not none
    return text.split(" ")[0]

def main():
    print(area(Circle(1.0)))
    print(area(Square(2.5)))
    print(describe(none))
    print(describe(true))
    print(describe(41))
    print(describe(1.25))
    print(describe("hi"))
    print(length("abcd"))
    print(length(none))
    print(length("ab"))
    print(length(""))
    print(positive(3))
    print(positive(-3))
    print(positive(none))
    print(sum_nodes(Node(1, Node(2, Node(3, none)))))
    print(sum_nodes(none))
    print(first_word("hello there"))

    value: int | str = 5
    value = value + 1
    print(value)
    value = "six"
    print(value + "!")

    maybe: int | none = none
    print(maybe)
    maybe = 7
    print(maybe)
    print(maybe == 7)
    print(same(1, 1.0))
    print(same(1, 1))
    print(same(2.5, 2.5))
    mixed: list[int | str] = [1, "two"]
    print(mixed[0])
    print(mixed[1])
    print("two" in mixed)
    item = mixed[0]
    if item is int:
        print(item * 10)
    print(f"{maybe} {item}")
