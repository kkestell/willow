def describe(value: int | float | str | bool | none) -> str:
    if value is none:
        return "nothing"
    else if value is bool:
        if value:
            return "yes"
        return "no"
    else if value is int:
        return "int " + describe_int(value + 1)
    else if value is float:
        if value * 2.0 == 2.5:
            return "float 2.5"
        return "float"
    else:
        return "str " + value

def describe_int(n: int) -> str:
    if n == 42:
        return "42"
    return "other"

def length(text: str | none) -> int:
    if text is not none and text != "":
        return 1
    if text is none or text == "":
        return 0
    return -1

def positive(value: int | none) -> bool:
    if not (value is none or value <= 0):
        return value > 0
    return false

def first(a: int | none, b: int | none) -> int:
    if a is not none:
        return a
    assert b is not none, "both None"
    return b

def maybe(flag: bool) -> str | none:
    if flag:
        return "some"
    return none

def main():
    print(describe(none))
    print(describe(true))
    print(describe(41))
    print(describe(1.25))
    print(describe("hi"))
    print(length("abcd"))
    print(length(none))
    print(positive(3))
    print(positive(-3))
    print(positive(none))
    print(first(none, 7))
    print(first(5, none))
    var value: int | str = 5
    value = value + 1
    print(value)
    value = "six"
    print(value + "!")
    var found = maybe(true)
    if found is not none:
        print(found)
    print(maybe(false) is none)
    var count: int | none = none
    var i = 0
    while i < 3:
        if count is none:
            count = 0
        count = count + i
        i = i + 1
    if count is not none:
        print(count)
