def main():
    var key: int | str = "before"
    var d = {1: 10, 2: 20, 3: 30}
    for key_item, value in d.items():
        key = key_item
        if key == 2:
            continue
        print(key + value)
        if key == 3:
            break
    print(key)

    var maybe: dict[int, int | none] = {1: 10, 2: none}
    for index, item in maybe.items():
        if index == 1:
            item = 11
        print(item)
