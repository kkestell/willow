# int / int is correctly rounded even when an operand exceeds 2^53, where
# converting each operand to a float first would round twice.
def main():
    print(9007199254740993 / 3)
    print(9007199254740993 / 9007199254740995)
    print(3 / 9007199254740993)
    print(16136050164986714 / 348031207480648929)
    print(-3600473477457 / 553603913622637519)
    print(-48667239542318632 / 232261253582665778)
    print(-568767451297 / (-102576148128992730))
    print(82510616696564638 / 23142831919683350)
    print(0 / (-5))
    print(-7 / 2)
    print(9223372036854775807 / (-1))
    print(1 / 9223372036854775807)
    print(-9223372036854775807 / (-9223372036854775807))
