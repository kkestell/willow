def show(values: list[int]):
    text = "["
    for v in values:
        if text != "[":
            text = text + ", "
        text = text + str(v)
    print(text + "]")

def main():
    text = "café"
    print(text[1:3])
    print(text[:2])
    print(text[2:])
    print(text[-2:])
    print(text[:-1])
    print(text[:])
    print("[" + text[3:1] + "]")
    print("[" + text[10:] + "]")
    print(text[-10:2])
    print(text[1:100])
    print("[" + ""[0:0] + "]")

    items = [10, 20, 30, 40]
    show(items[1:3])
    show(items[:-2])
    show(items[-3:])
    show(items[2:2])
    show(items[-100:100])
    copy = items[:]
    copy[0] = 99
    copy.append(50)
    show(items)
    show(copy)

    nested = [[1], [2]]
    part = nested[:1]
    part[0].append(5)
    show(nested[0])
