def total(values: list[int]) -> int:
    var result = 0
    for v in values:
        result = result + v
    return result

def show(values: list[int]):
    var text = "["
    for v in values:
        if text != "[":
            text = text + ", "
        text = text + str(v)
    print(text + "]")

def fill(values: list[int], count: int):
    for i in range(count):
        values.append(i * i)

def main():
    var items = [10, 20, 30]
    print(len(items))
    print(items[0])
    print(items[-1])
    items[-1] = 40
    items[0] = items[0] + 1
    show(items)
    items.append(50)
    print(items.pop())
    show(items)
    items.extend([7, 8])
    show(items)
    items.extend(items)
    show(items)
    items.reverse()
    show(items)
    print(20 in items)
    print(99 not in items)
    print(total(items))

    var shared = items
    shared.append(1)
    print(len(items))

    var empty: list[int] = []
    print(len(empty))
    fill(empty, 4)
    show(empty)

    var grow = [1, 2]
    for v in grow:
        if v < 4:
            grow.append(v + 2)
    show(grow)

    var names: list[str] = []
    names.append("ada")
    names.append("alan")
    print(names[1])

    var grid = [[1, 2], [3]]
    grid[1].append(4)
    grid.append([])
    print(len(grid))
    show(grid[1])

    var maybe: list[int | none] = [1, none, 3]
    print(maybe[1])
    print(none in maybe)

    var counted: list[int] = []
    var i = -1
    for i_item in range(3):
        i = i_item
        counted.append(i)
    for i_item in range(10, 4, -3):
        i = i_item
        counted.append(i)
    for i_item in range(5, 5):
        i = i_item
        counted.append(i)
    show(counted)
    print(i)
