def pick(n: int) -> int | str | bool | none:
    if n == 0:
        return none
    if n == 1:
        return n
    if n == 2:
        return "two"
    return n > 5

def show(v: int | str | bool | none) -> str:
    if v is none:
        return "none"
    if v is int:
        return "int"
    if v is str:
        return v
    if v:
        return "true"
    return "false"

def keep(x: int | float | none) -> int | float | none:
    return x

def main():
    i = 0
    while i < 7:
        print(show(pick(i)))
        i = i + 1
    x = keep(2.5)
    if x is float:
        print(x * 2.0 == 5.0)
    y = keep(-9223372036854775807)
    if y is int:
        print(y)
    print(keep(none) is none)
    total = 0
    n: int | none = 0
    while n is not none:
        total = total + n
        if n == 4:
            n = none
        else:
            n = n + 1
    print(total)
