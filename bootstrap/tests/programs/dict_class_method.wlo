enum Key:
    FIRST

class Counter:
    value: int

    def get() -> int:
        return self.value

    def pop() -> int:
        self.value = self.value - 1
        return self.value

def main():
    counters = {Key.FIRST: Counter(3)}
    print(counters[Key.FIRST].pop())
    print(counters[Key.FIRST].get())
