def num(flag: int) -> int | float | bool | str | None:
    if flag == 0:
        return 1
    if flag == 1:
        return 1.0
    if flag == 2:
        return True
    if flag == 3:
        return "1"
    if flag == 4:
        return None
    if flag == 5:
        return 0.0
    if flag == 6:
        return -0.0
    if flag == 7:
        return 1e308 * 10.0 - 1e308 * 10.0
    if flag == 8:
        return False
    if flag == 9:
        return 0
    if flag == 10:
        return 2.5e-7
    return "héllo"

def main():
    i = 0
    while i < 12:
        print(num(i))
        j = 0
        line = ""
        while j < 12:
            if num(i) == num(j):
                line = line + "="
            else:
                line = line + "."
            j = j + 1
        print(line)
        i = i + 1
    maybe: int | None = None
    print(maybe == None)
    print(maybe != None)
    maybe = 7
    print(maybe == 7)
    print(7 != maybe)
    text: str | None = "a"
    print(text == "a")
    print(text)
