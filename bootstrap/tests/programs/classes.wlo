class Counter:
    name: str
    count: int = 0
    step: int = 1

    def add(amount: int) -> int:
        self.count = self.count + amount * self.step
        return self.count

    def bump() -> int:
        return self.add(1)

    def label() -> str:
        return f"{self.name}={self.count}"

class Stack:
    items: list[int]
    parent: Stack | none

    def push(value: int):
        self.items.append(value)

    def depth() -> int:
        parent = self.parent
        if parent is none:
            return 1
        return parent.depth() + 1

class Token:
    text: str
    line: int
    value: float | none = none

def reset(counter: Counter):
    counter.count = 0

def make_token(text: str) -> Token:
    return Token(text, 1)

def main():
    counter = Counter("hits")
    print(counter.label())
    counter.bump()
    print(counter.add(5))
    print(counter.label())
    fast = Counter("fast", 10, 3)
    fast.bump()
    print(fast.label())
    alias = fast
    alias.name = "alias"
    print(fast.name)
    reset(fast)
    print(fast.count)

    root = Stack([], none)
    child = Stack([1, 2], root)
    grandchild = Stack([], child)
    grandchild.push(7)
    print(grandchild.depth())
    print(len(grandchild.items))
    print(child.items[-1])

    token = make_token("x")
    print(token.text)
    print(token.value)
    token.value = 2.5
    value = token.value
    if value is not none:
        print(value * 2.0)
    tokens = [token, Token("y", 2, none)]
    tokens[1].line = 3
    print(tokens[1].line)
