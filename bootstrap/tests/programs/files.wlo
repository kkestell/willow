import fs

# L0 has no way to remove a file, so the file stays next to this test and
# .gitignore lists it.
def main():
    var path = "files.tmp"
    fs.write_file(path, "first line\nsecond line\n")
    var text = fs.read_file(path)
    print(len(text))
    for line in text.split("\n"):
        print("[" + line + "]")
    fs.write_file(path, "café\r\n")
    text = fs.read_file(path)
    print(len(text))
    print(text.endswith("\r\n"))
    fs.write_file(path, "")
    print(len(fs.read_file(path)))
