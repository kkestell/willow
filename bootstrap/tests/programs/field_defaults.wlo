enum Kind:
    PLAIN
    FANCY

class Options:
    name: str = "out"
    level: int = -2
    ratio: float = +0.5
    verbose: bool = true
    limit: int | none = 3
    kind: Kind | none = none

    def describe() -> str:
        return self.name + " " + str(self.level) + " " + str(self.limit) + " " + str(self.kind)

def main():
    var options = Options()
    print(options.describe())
    print(options.ratio)
    print(options.verbose)
    options.limit = none
    options.kind = Kind.FANCY
    print(options.describe())
    var kind = options.kind
    if kind is Kind:
        print(kind == Kind.FANCY)
    var other = Options("other", 7)
    print(other.describe())
