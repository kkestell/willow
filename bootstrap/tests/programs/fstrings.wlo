enum Level:
    LOW
    HIGH

def label(name: str) -> str:
    print("label " + name)
    return name

def main():
    var name = "Ada"
    var count = 3
    var ratio = 0.5
    var flag = false
    var missing: str | none = none
    var level = Level.HIGH
    print(f"{name} has {len(name)} letters")
    print(f"{count} {ratio} {flag} {missing} {level}")
    print(f"{count + 1}{count * 2}")
    print(f"{{literal}} {{{count}}}")
    print(f"")
    print(f"plain")
    print(f'{name + "!"}')
    print(f"{name[1:3]}")
    var scores = {"ada": 36}
    print(f"{scores['ada']}")
    print(f"{label('a')}-{label('b')}")
    print(f"{1e16} {-0.0} {1.0 / 3.0}")
    print(f"""multi
{name}""")
    print(f"{'é'}{'😀'}")
