import aio
import time

async def fetch(url: str) -> bytes:
    return "x".encode()

async def retry[T](attempt: Coroutine[T], tries: int) -> T:   # natural first draft
    delay = 0.1
    while True:
        try:
            return await attempt          # 2nd iteration: RuntimeError, coroutine consumed (l.2208)
        except OSError:
            tries = tries - 1
            if tries == 0:
                raise
            time.sleep(delay)             # compiles; blocks every task (l.2177)
            delay = delay * 2.0

async def retry2[T](attempt: () -> Coroutine[T], tries: int) -> T:  # correct form
    delay = 0.1
    while True:
        try:
            return await attempt()
        except OSError:
            tries = tries - 1
            if tries == 0:
                raise
            await aio.sleep(delay)
            delay = delay * 2.0

async def main() -> None:
    print(len(await retry(fetch("a"), 3)))
    print(len(await retry2(lambda: fetch("a"), 3)))
