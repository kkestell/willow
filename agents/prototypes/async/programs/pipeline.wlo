# Producer/consumer: impossible without a queue; best effort is polling.
import aio

class Buffer:
    items: list[str]
    done: bool

async def producer(buffer: Buffer) -> None:
    for line in ["a", "b", "c"]:
        while len(buffer.items) >= 2:   # backpressure by polling
            await aio.sleep(0.01)
        buffer.items.append(line)
    buffer.done = True

async def consumer(buffer: Buffer) -> None:
    while True:
        if len(buffer.items) > 0:
            print(buffer.items.pop(0))
        elif buffer.done:
            return
        else:
            await aio.sleep(0.01)       # without aio.sleep there is no way to wait at all

async def main() -> None:
    buffer = Buffer([], False)
    async with aio.task_group() as group:
        group.start(producer(buffer))
        group.start(consumer(buffer))
