import aio

class Holder:
    task: Task[int] | None

async def waiter(holder: Holder) -> int:
    task = holder.task
    if task is not None:
        return await task               # awaits itself: no ready task, no I/O, no timer
    return 0

async def main() -> None:
    holder = Holder(None)
    async with aio.task_group() as group:
        holder.task = group.start(waiter(holder))
