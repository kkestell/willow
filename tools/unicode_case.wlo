# Regenerates core's case tables from the Unicode 17.0 character database.
# Download UnicodeData.txt, SpecialCasing.txt, and DerivedCoreProperties.txt
# from https://www.unicode.org/Public/17.0.0/ucd/ into one directory, then run:
# build/willow run tools/unicode_case.wlo DIRECTORY bootstrap/core/core.wlo

import fs
import sys

def number(text: str) -> int:
    var value = 0
    for digit in text:
        var n = "0123456789ABCDEF".find(digit)
        assert n is not none, "invalid hexadecimal code point"
        value = value * 16 + n
    return value

def hex(code: int) -> str:
    var text = ""
    for i in range(6):
        text = "0123456789ABCDEF"[code % 16] + text
        code = code // 16
    assert code == 0, "code point exceeds six hexadecimal digits"
    return text

def runs(mapping: dict[int, int]) -> list[str]:
    var codes = sorted(mapping)
    var records: list[str] = []
    var i = 0
    while i < len(codes):
        var first = codes[i]
        var delta = mapping[first] - first
        var step = 0
        var j = i
        while j + 1 < len(codes):
            var gap = codes[j + 1] - codes[j]
            if mapping[codes[j + 1]] - codes[j + 1] != delta or gap > 2 or (step != 0 and gap != step):
                break
            step = gap
            j = j + 1
        if step == 0:
            step = 1
        records.append(hex(first) + " " + hex(codes[j]) + " " + str(step) + " " + hex(first + delta))
        i = j + 1
    return records

def full(lines: list[str], field: int, simple: dict[int, int]) -> list[str]:
    var records: list[str] = []
    for line in lines:
        var fields = line.split("#")[0].split(";")
        if len(fields) != 5 or fields[4].strip() != "":
            continue
        var code = number(fields[0].strip())
        var codes: list[int] = []
        for value in fields[field].strip().split(" "):
            if value != "":
                codes.append(number(value))
        if len(codes) == 1 and codes[0] == simple.get(code, code):
            continue
        assert len(codes) <= 3, "a full mapping longer than three code points"
        while len(codes) < 3:
            codes.append(0)
        fields = [hex(code)]
        for c in codes:
            fields.append(hex(c))
        records.append(" ".join(fields))
    return sorted(records)

def property(lines: list[str], name: str) -> list[str]:
    var records: list[str] = []
    for line in lines:
        var fields = line.split("#")[0].split(";")
        if len(fields) < 2 or fields[1].strip() != name:
            continue
        var bounds = fields[0].strip().split("..")
        records.append(hex(number(bounds[0])) + " " + hex(number(bounds[-1])))
    return records

def main():
    var args = sys.args()
    if len(args) != 2:
        sys.eprint("usage: unicode_case.wlo DIRECTORY CORE")
        sys.exit(1)
    var directory = args[0]
    var core = args[1]
    var lower: dict[int, int] = {}
    var upper: dict[int, int] = {}
    for line in fs.read_file(fs.join(directory, "UnicodeData.txt")).split("\n"):
        if line == "":
            continue
        var fields = line.split(";")
        var code = number(fields[0])
        if fields[12] != "":
            upper[code] = number(fields[12])
        if fields[13] != "":
            lower[code] = number(fields[13])
    var special = fs.read_file(fs.join(directory, "SpecialCasing.txt")).split("\n")
    var properties = fs.read_file(fs.join(directory, "DerivedCoreProperties.txt")).split("\n")
    var tables = {
        "lower_runs": runs(lower),
        "upper_runs": runs(upper),
        "lower_full": full(special, 1, lower),
        "upper_full": full(special, 3, upper),
        "cased": property(properties, "Cased"),
        "case_ignorable": property(properties, "Case_Ignorable"),
    }
    var begin = "# Case tables generated by tools/unicode_case.wlo from Unicode 17.0."
    var end = "# End of the generated case tables."
    var block = [
        begin,
        "# Runs are first, last, step, and the mapping of first; full mappings are a",
        "# code point and the up to three code points it maps to, 0 for none; ranges",
        "# are first and last. Do not edit by hand.",
    ]
    for name, records in tables.items():
        block.extend(["", "def case_" + name + "() -> str:", '    return """' + "\n".join(records) + '\n"""'])
    block.extend(["", end])
    var source = fs.read_file(core)
    var start = source.find(begin)
    assert start is not none, "core has no case table block"
    var stop = source.find(end)
    assert stop is not none and stop >= start, "core has no case table end"
    fs.write_file(core, source[:start] + "\n".join(block) + source[stop + len(end):])
