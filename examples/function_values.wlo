# Function values: functions, lambdas, and bound methods can be stored, passed,
# and returned as values of callable types such as `(int) -> int`.

def double(n: int) -> int:
    return n * 2

def apply_all(functions: list[(int) -> int], value: int) -> list[int]:
    results: list[int] = []
    for f in functions:
        results.append(f(value))
    return results

def compose(f: (int) -> int, g: (int) -> int) -> (int) -> int:
    return (n) => g(f(n))

class Greeter:
    greeting: str

    def greet(self, name: str) -> str:
        return f"{self.greeting}, {name}"

def main():
    increment: (int) -> int = (n) => n + 1
    for result in apply_all([double, increment, compose(double, increment)], 5):
        print(result)

    # A bound method keeps its object.
    hello = Greeter("Hello").greet
    print(hello("Ada"))

    names = ["grace", "Ada", "alan"]
    print(", ".join(sorted(names, key=(name) => name.lower())))

    operations: dict[str, (int) -> int] = {"double": double, "square": (n) => n * n}
    print(operations["square"](4))
