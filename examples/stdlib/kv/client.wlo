# Sends JSON requests to the key-value server and prints each reply:
# willow run client.wlo <port> <request>...

import framing
import json
import net
import sys

def main() -> None:
    args = sys.args()
    if len(args) < 2:
        sys.eprint("usage: client <port> <request>...")
        sys.exit(2)
    with framing.channel(net.connect("127.0.0.1", int(args[0]), timeout=5.0)) as channel:
        for request in args[1:]:
            channel.send(json.parse(request))
            print(json.dump(channel.receive(timeout=5.0)))
