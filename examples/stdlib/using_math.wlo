import math

def main():
    var width = 3.0
    var height = 4.0
    print(math.sqrt(width * width + height * height))
    print(math.pow(2.0, 8.0))
    print(math.floor(2.7))
    print(math.ceil(2.7))

    var radius = 1.0
    print(math.tau * radius)
    # Trigonometric functions take radians.
    print(math.sin(0.0))
    print(math.cos(0.0))
    print(math.isfinite(math.pi))
    print(math.isnan(math.sqrt(-1.0)))
