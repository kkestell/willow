# Prints a receipt. Run the tests with `willow test examples/cart`.

import cart

def cents(amount: int) -> str:
    rest = str(amount % 100)
    if len(rest) == 1:
        rest = "0" + rest
    return f"{amount // 100}.{rest}"

def main() -> None:
    order = cart.Cart([])
    cart.add(order, "tea", 450, quantity=2)
    cart.add(order, "scone", 325)
    cart.apply_discount(order, percent=10)
    for item in order.items:
        print(f"{item.name:<10}{item.quantity:>3d}{cents(item.price * item.quantity):>9}")
    print(f"{'discount':<13}{str(order.discount) + '%':>9}")
    print(f"{'total':<13}{cents(cart.total(order)):>9}")
