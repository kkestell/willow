import aio

class Stock:
    counts: dict[str, int]

    def add(self, item: str, quantity: int):
        if quantity <= 0:
            raise ValueError("quantity must be positive")
        current = self.counts.get(item)
        if current is none:
            current = 0
        self.counts[item] = current + quantity

    def count(self, item: str) -> int:
        current = self.counts.get(item)
        if current is none:
            return 0
        return current

    async def restock(self, item: str, quantity: int, delay: float):
        await aio.sleep(delay)
        self.add(item, quantity)
