# Fibonacci numbers computed two ways: by the recursive definition and by a
# loop that keeps the last two values.

def fib_recursive(n: int) -> int:
    if n < 2:
        return n
    return fib_recursive(n - 1) + fib_recursive(n - 2)

def fib_loop(n: int) -> int:
    if n == 0:
        return 0
    previous = 0
    current = 1
    for _ in range(1, n):
        next_value = previous + current
        previous = current
        current = next_value
    return current

def main() -> None:
    for n in range(11):
        print(fib_loop(n))
    print(fib_recursive(20) == fib_loop(20))    # True
    # The largest Fibonacci number in Willow's integer range.
    print(fib_loop(78))                         # 8944394323791464
    try:
        print(fib_loop(79))
    except OverflowError as error:
        print(error.message)                    # integer overflow
