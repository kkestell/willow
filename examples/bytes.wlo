# Bytes: immutable sequences of octets, made by encoding text or from a list of
# integers.

def main():
    var data = "café".encode()
    print(len(data))
    print(data[-1])
    print(data[:3].decode())
    print(data == "café".encode())

    var greeting = bytes([72, 105]) + bytes([33])
    print(greeting.decode())

    var total = 0
    for octet in data:
        total = total + octet
    print(total)

    try:
        print(bytes([255, 254]).decode())
    except ValueError as error:
        print(error.message)
