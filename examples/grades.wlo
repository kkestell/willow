# Turns scores into letter grades and flags the ones that need a retake.

def letter(score: int) -> str:
    if score >= 90:
        return "A"
    elif score >= 80:
        return "B"
    elif score >= 70:
        return "C"
    elif score >= 60:
        return "D"
    else:
        return "F"

def passed(score: int) -> bool:
    return letter(score) != "F"

def report(name: str, score: int) -> None:
    print(name + ": " + letter(score))
    if not passed(score):
        print(name + " needs a retake")

def main() -> None:
    report("Ada", 97)
    report("Grace", 85)
    report("Linus", 72)
    report("Barbara", 58)
