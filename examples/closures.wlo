# Closures: nested functions and lambdas capture variables from the enclosing
# lexical scopes, sharing reads and writes to each binding.

def counter() -> () -> int:
    var count = 0

    def increment() -> int:
        count = count + 1
        return count

    return increment

def multiplier(factor: int) -> (int) -> int:
    return (n) => n * factor

def main():
    var tick = counter()
    tick()
    tick()
    print(tick())

    # Each call to `counter` creates a separate `count`.
    var other = counter()
    print(other())

    var triple = multiplier(3)
    print(triple(7))

    # A closure shares the variable, so it sees later assignments.
    var message = "before"

    def show() -> str:
        return message

    message = "after"
    print(show())
