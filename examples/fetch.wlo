# Downloads a URL to a file without leaving partial output behind:
# willow run fetch.wlo <url> <path>

import http
import sys

def main() -> None:
    args = sys.args()
    if len(args) != 2:
        sys.eprint("usage: fetch <url> <path>")
        sys.exit(2)
    try:
        result = http.download(args[0], args[1], timeout=10.0)
    except OSError as error:
        sys.eprint(error.message)
        sys.exit(1)
    except TimeoutError as timeout:
        sys.eprint(timeout.message)
        sys.exit(1)
    if result.status < 200 or result.status > 299:
        print(f"HTTP {result.status} from {result.url}; {args[1]} left unchanged")
        sys.exit(1)
    print(f"saved {result.bytes_written} bytes from {result.url} to {args[1]}")
