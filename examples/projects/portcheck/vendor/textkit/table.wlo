# Plain-text tables with each column padded to its widest cell.

def render(headers: list[str], rows: list[list[str]]) -> str:
    widths: list[int] = []
    for header in headers:
        widths.append(len(header))
    for row in rows:
        for i in range(len(row)):
            if len(row[i]) > widths[i]:
                widths[i] = len(row[i])
    lines = [_line(headers, widths)]
    for row in rows:
        lines.append(_line(row, widths))
    return "\n".join(lines)

def _line(cells: list[str], widths: list[int]) -> str:
    parts: list[str] = []
    for i in range(len(cells)):
        parts.append(cells[i].ljust(widths[i]))
    return "  ".join(parts).strip()
