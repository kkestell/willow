import net
import portcheck.probe

def test_parse_target() -> None:
    target = portcheck.probe.parse_target("example.com:443")
    assert target.host == "example.com" and target.port == 443
    six = portcheck.probe.parse_target("[::1]:8080")
    assert six.host == "::1" and six.port == 8080
    for text in ["example.com", ":80", "host:", "host:http", "host:70000"]:
        try:
            portcheck.probe.parse_target(text)
            assert False, "accepted " + text
        except ValueError:
            pass

def test_open_port() -> None:
    with net.listen("127.0.0.1", 0) as listener:
        target = portcheck.probe.Target("127.0.0.1", listener.local_port())
        result = portcheck.probe.check(target, 2.0)
        assert result.open, result.detail

def test_closed_port() -> None:
    with net.listen("127.0.0.1", 0) as listener:
        port = listener.local_port()
    result = portcheck.probe.check(portcheck.probe.Target("127.0.0.1", port), 2.0)
    assert not result.open
    assert result.detail.startswith("cannot connect to 127.0.0.1:"), result.detail
