def count_words(words: list[str]) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in words:
        if word in counts:
            counts[word] = counts[word] + 1
        else:
            counts[word] = 1
    return counts

def squares(limit: int) -> list[int]:
    result: list[int] = []
    for i in range(1, limit + 1):
        result.append(i * i)
    return result

def show(values: list[int]) -> str:
    parts: list[str] = []
    for value in values:
        parts.append(str(value))
    return "[" + ", ".join(parts) + "]"

def main() -> None:
    counts = count_words("the cat saw the dog".split(" "))
    for word in counts:
        print(f"{word}: {counts[word]}")    # the: 2, cat: 1, saw: 1, dog: 1
    print(counts.get("bird"))               # None
    print(counts.pop("the"))                # 2
    print("the" not in counts)              # True
    try:
        print(counts["the"])
    except KeyError as missing:
        print(missing.message)              # key not found

    values = squares(5)
    print(show(values))                     # [1, 4, 9, 16, 25]
    print(values[-1])                       # 25
    print(show(values[1:3]))                # [4, 9]
    values.append(-8)
    values.sort()
    print(show(values))                     # [-8, 1, 4, 9, 16, 25]
    print(values.pop())                     # 25
    print(show(sorted(values, reverse=True)))   # [16, 9, 4, 1, -8]
    print(9 in values)                      # True

    empty: list[int] = []
    try:
        empty.pop()
    except IndexError as underflow:
        print(underflow.message)            # pop from empty list
