def count_words(words: list[str]) -> dict[str, int]:
    counts: dict[str, int] = {}
    for word in words:
        if word in counts:
            counts[word] = counts[word] + 1
        else:
            counts[word] = 1
    return counts

def squares(limit: int) -> list[int]:
    result: list[int] = []
    for i in range(1, limit + 1):
        result.append(i * i)
    return result

def main() -> None:
    counts = count_words(["the", "cat", "saw", "the", "dog"])
    for word in counts:
        print(word)
        print(counts[word])
    print(counts.get("bird"))
    values = squares(5)
    print(len(values))
    print(values[len(values) - 1])
    total = 0
    for value in values:
        total = total + value
    print(total)
