# Runs a command with a time limit while a background helper runs, reports the
# command's status and output, then stops the helper:
# willow run wrap.wlo <seconds> <command> [args...]

import subprocess
import sys

def describe(name: str, data: bytes | None) -> None:
    if data is None or len(data) == 0:
        print(f"{name}: (empty)")
        return
    try:
        print(f"{name}: {data.decode().strip()}")
    except ValueError:
        print(f"{name}: {len(data)} bytes, not UTF-8")

def main() -> None:
    args = sys.args()
    if len(args) < 2:
        sys.eprint("usage: wrap <seconds> <command> [args...]")
        sys.exit(2)
    status = 0
    helper = subprocess.spawn(["sleep", "60"])
    try:
        result = subprocess.run(args[1:], capture_output=True, timeout=float(args[0]))
        print(f"status {result.returncode}")
        describe("stdout", result.stdout)
        describe("stderr", result.stderr)
        if result.returncode != 0:
            status = 1
    except TimeoutError as timeout:
        print(f"timed out: {timeout.message}")
        status = 1
    except OSError as error:
        print(f"failed: {error.message}")
        status = 1
    finally:
        helper.terminate()
        print(f"helper stopped: {helper.wait()}")
    sys.exit(status)
