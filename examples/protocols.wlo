# Protocols: structural interfaces. A class satisfies a protocol by having its
# methods; it does not declare that it implements it.

protocol Shape:
    def area() -> float
    def name() -> str

class Square:
    side: float

    def area() -> float:
        return self.side * self.side

    def name() -> str:
        return "square"

class Circle:
    radius: float

    def area() -> float:
        return 3.14159 * self.radius * self.radius

    def name() -> str:
        return "circle"

def report(shapes: list[Shape]):
    for shape in shapes:
        print(f"{shape.name():<8s}{shape.area():>8.2f}")

# A protocol can take type parameters.
protocol Source[T]:
    def read() -> T | none

class Countdown:
    current: int

    def read() -> int | none:
        if self.current == 0:
            return none
        self.current = self.current - 1
        return self.current + 1

def drain[T](source: Source[T]) -> list[T]:
    items: list[T] = []
    item = source.read()
    while item is not none:
        items.append(item)
        item = source.read()
    return items

def main():
    report([Square(2.0), Circle(1.0)])
    print(len(drain[int](Countdown(3))))
