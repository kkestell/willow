# Type aliases: names for types, including generic and recursive aliases.

type Score = int | none
type Pair[K, V] = tuple[K, V]
type Tree = int | list[Tree]

def total(tree: Tree) -> int:
    if tree is int:
        return tree
    var sum = 0
    for child in tree:
        sum = sum + total(child)
    return sum

def best(scores: dict[str, Score]) -> Pair[str, int] | none:
    var winner: Pair[str, int] | none = none
    for name in scores:
        var score = scores[name]
        if score is not none:
            if winner is none or score > winner[1]:
                winner = (name, score)
    return winner

def main():
    print(total([1, [2, 3], [[4], 5]]))
    var result = best({"ada": 7, "alan": none, "grace": 9})
    if result is not none:
        var name, score = result
        print(f"{name} scored {score}")
