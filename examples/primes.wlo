# Prints the primes below 50 by trial division.

def is_prime(n: int) -> bool:
    if n < 2:
        return False
    if n % 2 == 0:
        return n == 2
    # Odd divisors up to the square root are enough.
    for divisor in range(3, n, 2):
        if divisor * divisor > n:
            break
        if n % divisor == 0:
            return False
    return True

def main() -> None:
    for n in range(50):
        if is_prime(n):
            print(n)
