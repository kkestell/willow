# Functions: annotated parameters, defaults, keyword arguments, keyword-only
# parameters, recursion, and nested functions.

def greet(name: str, greeting: str = "Hello") -> str:
    return f"{greeting}, {name}!"

# Parameters after `*` must be passed by name.
def describe(path: str, *, size: int, hidden: bool = false) -> str:
    text = f"{path} ({size} bytes)"
    if hidden:
        text = text + ", hidden"
    return text

def factorial(n: int) -> int:
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def sum_of_squares(numbers: list[int]) -> int:
    def square(n: int) -> int:
        return n * n

    total = 0
    for n in numbers:
        total = total + square(n)
    return total

# A function may call one declared later in the file.
def is_even(n: int) -> bool:
    if n == 0:
        return true
    return is_odd(n - 1)

def is_odd(n: int) -> bool:
    if n == 0:
        return false
    return is_even(n - 1)

def main():
    print(greet("Ada"))
    print(greet("Alan", greeting="Welcome"))
    print(greet(greeting="Hi", name="Grace"))
    print(describe("notes.txt", size=120))
    print(describe(".profile", hidden=true, size=64))
    print(factorial(10))
    print(sum_of_squares([1, 2, 3]))
    print(is_even(10))
