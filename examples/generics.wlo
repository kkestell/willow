# Generics: type parameters on functions and classes, inferred or written
# explicitly, with optional bounds.

def first[T](items: list[T]) -> T:
    return items[0]

def swap[A, B](pair: tuple[A, B]) -> tuple[B, A]:
    return (pair[1], pair[0])

class Stack[T]:
    items: list[T]

    def push(self, item: T):
        self.items.append(item)

    def pop(self) -> T:
        return self.items.pop()

    def size(self) -> int:
        return len(self.items)

protocol Named:
    def name(self) -> str

class User:
    login: str

    def name(self) -> str:
        return self.login

# The bound `T: Named` lets the body call `name` on any `T`.
def longest[T: Named](items: list[T]) -> T:
    best = items[0]
    for item in items:
        if len(item.name()) > len(best.name()):
            best = item
    return best

def main():
    print(first([3, 1, 2]))
    print(first(["x", "y"]))
    print(first[float]([2.5]))

    word, number = swap((1, "one"))
    print(f"{word} {number}")

    numbers = Stack[int]([])
    numbers.push(1)
    numbers.push(2)
    print(numbers.pop())
    print(numbers.size())

    users = [User("ada"), User("grace")]
    print(longest(users).login)
