# Optional types: `T | None` holds a value or `None`, and an `is None` check
# narrows it to `T`.

def find(names: list[str], prefix: str) -> str | None:
    for name in names:
        if name.startswith(prefix):
            return name
    return None

def greeting(name: str | None) -> str:
    if name is None:
        return "Hello, stranger"
    return "Hello, " + name

def main():
    names = ["ada", "alan", "grace"]
    print(greeting(find(names, "gr")))
    print(greeting(find(names, "x")))

    ages = {"ada": 36}
    age = ages.get("alan")
    print(age)
    if age is None:
        age = 0
    print(age + 1)

    # An assert also narrows the value after it.
    first = find(names, "a")
    assert first is not None
    print(first.upper())
