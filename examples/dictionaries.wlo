# Dictionaries: maps from `str`, `int`, or enum keys to values, kept in
# insertion order.

def main():
    ages = {"ada": 36, "alan": 41}
    ages["grace"] = 85
    print(len(ages))
    print(ages["alan"])
    print(ages.get("linus"))
    print("ada" in ages)
    print(ages.pop("alan"))
    for name in ages:
        print(f"{name}: {ages[name]}")

    counts: dict[str, int] = {}
    for word in "the cat and the hat".split(" "):
        current = counts.get(word)
        if current is None:
            counts[word] = 1
        else:
            counts[word] = current + 1
    for word in sorted(counts):
        print(f"{word} {counts[word]}")

    try:
        print(ages["nobody"])
    except KeyError as error:
        print(error.message)
