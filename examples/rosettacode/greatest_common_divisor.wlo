# https://rosettacode.org/wiki/Greatest_common_divisor

def gcd(a: int, b: int) -> int:
    while b != 0:
        remainder = a % b
        a = b
        b = remainder
    if a < 0:
        return -a
    return a

def main() -> None:
    print(gcd(40902, 24140))
    print(gcd(-12, 18))
    print(gcd(17, 5))
    print(gcd(0, 9))
