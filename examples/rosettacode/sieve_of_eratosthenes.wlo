# https://rosettacode.org/wiki/Sieve_of_Eratosthenes

def primes_up_to(limit: int) -> list[int]:
    var is_prime: list[bool] = []
    for candidate in range(limit + 1):
        is_prime.append(candidate >= 2)
    var n = 2
    while n * n <= limit:
        if is_prime[n]:
            for multiple in range(n * n, limit + 1, n):
                is_prime[multiple] = false
        n = n + 1
    var primes: list[int] = []
    for candidate in range(limit + 1):
        if is_prime[candidate]:
            primes.append(candidate)
    return primes

def main():
    var words: list[str] = []
    for p in primes_up_to(100):
        words.append(str(p))
    print(" ".join(words))
    print(len(primes_up_to(1000000)))
