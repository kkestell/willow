# https://rosettacode.org/wiki/Palindrome_detection

def is_palindrome(text: str) -> bool:
    var i = 0
    var j = len(text) - 1
    while i < j:
        if text[i] != text[j]:
            return false
        i = i + 1
        j = j - 1
    return true

def letters(text: str) -> str:
    var result = ""
    for c in text.lower():
        if c != c.upper():
            result = result + c
    return result

def main():
    for text in ["racecar", "rotor", "willow", "A man, a plan, a canal: Panama!"]:
        var exact = is_palindrome(text)
        var inexact = is_palindrome(letters(text))
        print(f"{text:<32}exact: {exact:<6}inexact: {inexact}")
