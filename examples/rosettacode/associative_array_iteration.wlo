# https://rosettacode.org/wiki/Associative_array/Iteration

def main():
    var ages = {"Ada": 36, "Alan": 41, "Grace": 85}
    for name in ages:
        print(f"{name}: {ages[name]}")
    print("")
    for name in sorted(ages, reverse=true):
        print(name)
    print("")
    for name in ages:
        print(ages[name])
