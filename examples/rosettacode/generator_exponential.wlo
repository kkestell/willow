# https://rosettacode.org/wiki/Generator/Exponential

def power(n: int, m: int) -> int:
    var result = 1
    for i in range(m):
        result = result * n
    return result

# The m'th powers of 0, 1, 2, and so on.
def powers(m: int) -> Iterator[int]:
    var n = 0
    while true:
        yield power(n, m)
        n = n + 1

# The values that `excluded` lacks. Both sequences increase, so `excluded`
# advances only as far as the current value.
def without(values: Iterator[int], excluded: Iterator[int]) -> Generator[int]:
    var skip = next(excluded)
    for value in values:
        while skip < value:
            skip = next(excluded)
        if value != skip:
            yield value

def main():
    var squares = without(powers(2), powers(3))
    for i in range(20):
        next(squares)
    for i in range(10):
        print(next(squares))
    squares.close()
