# https://rosettacode.org/wiki/Factorial

def factorial_recursive(n: int) -> int:
    if n < 2:
        return 1
    return n * factorial_recursive(n - 1)

def factorial_iterative(n: int) -> int:
    var result = 1
    for k in range(2, n + 1):
        result = result * k
    return result

def main():
    for n in range(11):
        print(f"{n}! = {factorial_iterative(n)}")
    # 18! is the largest factorial in Willow's integer range.
    print(factorial_recursive(18) == factorial_iterative(18))
    print(factorial_recursive(18))
