# https://rosettacode.org/wiki/N-queens_problem

# columns[r] is the column of the queen in row r.
def safe(columns: list[int], column: int) -> bool:
    row = len(columns)
    for r in range(row):
        c = columns[r]
        if c == column or c - column == r - row or c - column == row - r:
            return False
    return True

def solve(n: int, columns: list[int], solutions: list[list[int]]) -> None:
    if len(columns) == n:
        solutions.append(columns[:])
        return
    for column in range(n):
        if safe(columns, column):
            columns.append(column)
            solve(n, columns, solutions)
            columns.pop()

def queens(n: int) -> list[list[int]]:
    solutions: list[list[int]] = []
    solve(n, [], solutions)
    return solutions

def main() -> None:
    for n in range(1, 11):
        print(f"{n:>2} queens: {len(queens(n))} solutions")
    print("")
    for column in queens(8)[0]:
        row = ""
        for c in range(8):
            if c == column:
                row = row + " Q"
            else:
                row = row + " ."
        print(row)
