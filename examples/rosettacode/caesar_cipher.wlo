# https://rosettacode.org/wiki/Caesar_cipher

def shift(c: str, key: int, first: str) -> str:
    return chr((ord(c) - ord(first) + key) % 26 + ord(first))

def encode(text: str, key: int) -> str:
    result = ""
    for c in text:
        if "a" <= c and c <= "z":
            result = result + shift(c, key, "a")
        elif "A" <= c and c <= "Z":
            result = result + shift(c, key, "A")
        else:
            result = result + c
    return result

def decode(text: str, key: int) -> str:
    return encode(text, -key)

def main() -> None:
    text = "The quick brown fox Jumped over the lazy Dog"
    encoded = encode(text, 11)
    print(encoded)
    print(decode(encoded, 11))
