# https://rosettacode.org/wiki/Fibonacci_sequence

def fib_recursive(n: int) -> int:
    if n < 2:
        return n
    return fib_recursive(n - 1) + fib_recursive(n - 2)

def fib_iterative(n: int) -> int:
    if n == 0:
        return 0
    var previous = 0
    var current = 1
    for _ in range(1, n):
        previous, current = (current, previous + current)
    return current

def main():
    for n in range(16):
        print(f"fib({n}) = {fib_iterative(n)}")
    print(fib_recursive(25) == fib_iterative(25))
    # fib(78) is the largest Fibonacci number in Willow's integer range.
    print(fib_iterative(78))
