# https://rosettacode.org/wiki/Parametric_polymorphism

class Tree[T]:
    value: T
    left: Tree[T] | None = None
    right: Tree[T] | None = None

    # Builds a tree of the same shape whose values are `f` of this tree's.
    def map[U](self, f: (T) -> U) -> Tree[U]:
        result = Tree(f(self.value))
        left = self.left
        if left is not None:
            result.left = left.map(f)
        right = self.right
        if right is not None:
            result.right = right.map(f)
        return result

def show(tree: Tree[str] | None) -> str:
    if tree is None:
        return "."
    return "(" + show(tree.left) + " " + tree.value + " " + show(tree.right) + ")"

def main() -> None:
    numbers = Tree(2, Tree(1), Tree(3))
    print(show(numbers.map(lambda n: str(n * n))))
