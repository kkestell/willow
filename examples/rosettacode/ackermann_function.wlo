# https://rosettacode.org/wiki/Ackermann_function

def ackermann(m: int, n: int) -> int:
    if m == 0:
        return n + 1
    if n == 0:
        return ackermann(m - 1, 1)
    return ackermann(m - 1, ackermann(m, n - 1))

def main():
    for m in range(4):
        for n in range(5):
            print(f"A({m}, {n}) = {ackermann(m, n)}")
