# async/await: calling an async function produces a coroutine, which runs only
# when it is awaited. Methods and protocol methods can be async too.

import aio

async def fetch(name: str, seconds: float) -> str:
    await aio.sleep(seconds)
    return f"{name} ready"

protocol Loader:
    async def load(key: str) -> int

class Cache:
    values: dict[str, int]

    async def load(key: str) -> int:
        await aio.sleep(0.0)
        var value = self.values.get(key)
        if value is none:
            return 0
        return value

async def total(loader: Loader, keys: list[str]) -> int:
    var sum = 0
    for key in keys:
        sum = sum + await loader.load(key)
    return sum

# A coroutine is a value of type `Coroutine[T]`.
async def run_twice(make: () -> Coroutine[str]) -> str:
    var first = await make()
    var second = await make()
    return first + ", " + second

async def main():
    print(await fetch("first", 0.01))

    var pending = fetch("second", 0.01)
    print("created, not started")
    print(await pending)

    # A coroutine runs once.
    try:
        await pending
    except RuntimeError as error:
        print(error.message)

    print(await total(Cache({"a": 1, "b": 2}), ["a", "b", "c"]))
    print(await run_twice(() => fetch("again", 0.0)))
