import core

class File:
    _fd: int
    _path: str
    _mode: str
    _borrowed: bool
    _buffer: ptr
    _closed: bool = False

    def _usable(self, reading: bool):
        if self._closed:
            raise ValueError("I/O operation on closed file")
        if reading and self._mode != "r":
            raise ValueError("file is not open for reading")
        if not reading and self._mode == "r":
            raise ValueError("file is not open for writing")

    def read(self, size: int) -> bytes:
        self._usable(True)
        if size < 1:
            raise ValueError("read size must be positive")
        return __bytes(__word(core.file_read(self._fd, self._buffer, size, self._path)))

    def readline(self) -> str | None:
        self._usable(True)
        return core.file_readline(self._fd, self._buffer, self._path, False)

    def write(self, data: bytes):
        self._usable(False)
        if not core.write_bytes(self._fd, __offset(__ptr(__word(data)), 16), len(data)):
            core.fail_os("write", self._path)

    def write_text(self, text: str):
        self._usable(False)
        if not core.write_bytes(self._fd, core.str_bytes(text), core.str_size(text)):
            core.fail_os("write", self._path)

    def iter(self) -> Iterator[str]:
        return _Lines(self)

    def flush(self):
        if self._closed:
            raise ValueError("I/O operation on closed file")

    def close(self):
        if self._borrowed:
            raise ValueError("cannot close a standard stream")
        if self._closed:
            return
        self._closed = True
        if core.close(self._fd) < 0:
            core.fail_os("close", self._path)

    def enter(self) -> File:
        if self._borrowed:
            raise ValueError("cannot close a standard stream")
        if self._closed:
            raise ValueError("I/O operation on closed file")
        return self

    def exit(self, error: Exception | None):
        self.close()

class _Lines:
    _file: File

    def iter(self) -> _Lines:
        return self

    def next(self) -> str:
        line = self._file.readline()
        if line is None:
            raise StopIteration("")
        return line

def open(path: str, mode: str = "r") -> File:
    if mode not in ["r", "w", "a"]:
        raise ValueError(f"invalid mode '{mode}'")
    flags = 0
    if mode == "w":
        flags = core.write_flags()
    elif mode == "a":
        if __os == "linux":
            flags = 1 + 64 + 1024
        else:
            flags = 1 + 512 + 8
    fd = core.open(core.path_bytes(path), flags, 438)
    if fd < 0:
        core.fail_os("open", path)
    return File(fd, path, mode, False, core.file_buffer())

def stdin() -> File:
    return File(0, "<stdin>", "r", True, core.stdin_buffer())

def stdout() -> File:
    return File(1, "<stdout>", "w", True, core.file_buffer())

def stderr() -> File:
    return File(2, "<stderr>", "w", True, core.file_buffer())
