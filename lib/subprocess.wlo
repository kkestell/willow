import aio
import core
import io
import time

class Result:
    returncode: int
    stdout: bytes | none
    stderr: bytes | none

def _check_timeout(timeout: float | none):
    if timeout is not none:
        if not (timeout > 0.0 and timeout - timeout == 0.0):
            raise ValueError("timeout must be finite and positive")

def _deadline(timeout: float | none) -> float | none:
    if timeout is none:
        return none
    return core.aio_now() + timeout

def _delay(deadline: float | none) -> float:
    if deadline is none:
        return 0.01
    return max(0.0, min(0.01, deadline - core.aio_now()))

class Process:
    _child: core.Child

    def poll() -> int | none:
        return core.process_poll(self._child, false)

    def wait(timeout: float | none = none) -> int:
        _check_timeout(timeout)
        var code: int | none
        if timeout is none:
            code = core.process_poll(self._child, true)
            assert code is not none
            return code
        var deadline = _deadline(timeout)
        code = self.poll()
        while code is none:
            if _delay(deadline) == 0.0:
                raise TimeoutError(f"process did not exit within {timeout} seconds")
            time.sleep(_delay(deadline))
            code = self.poll()
        assert code is not none
        return code

    async def wait_async(timeout: float | none = none) -> int:
        await aio.sleep(0.0)
        _check_timeout(timeout)
        var deadline = _deadline(timeout)
        var code = self.poll()
        while code is none:
            if _delay(deadline) == 0.0:
                raise TimeoutError(f"process did not exit within {timeout} seconds")
            await aio.sleep(_delay(deadline))
            code = self.poll()
        assert code is not none
        return code

    def terminate():
        core.process_signal(self._child, 15)

    def kill():
        core.process_signal(self._child, 9)

def spawn(args: list[str], cwd: str | none = none, env: dict[str, str] | none = none, stdin: io.File | none = none, stdout: io.File | none = none, stderr: io.File | none = none) -> Process:
    var redirects = [-1, -1, -1]
    if stdin is not none:
        redirects[0] = stdin._child_fd("stdin", true)
    if stdout is not none:
        redirects[1] = stdout._child_fd("stdout", false)
    if stderr is not none:
        redirects[2] = stderr._child_fd("stderr", false)
    return Process(core.process_start(args, cwd, env, redirects))

def _octets(buffer: ptr, count: int) -> bytes:
    var data = core.str_alloc(count)
    core.memcpy(__offset(data, 24), buffer, count)
    return __bytes(__word(core.bytes_tag(__str(__word(data)))))

def _join(parts: list[bytes]) -> bytes:
    return __bytes(__word(core.bytes_tag(core.str_join("", __ptr(__word(parts))))))

class _Run:
    _child: core.Child
    _input_fd: int
    _output_fd: int
    _error_fd: int
    _input: bytes | none
    _capture: bool
    _output: list[bytes]
    _error: list[bytes]
    _buffer: ptr
    _offset: int = 0

    def _write() -> bool:
        var fd = self._input_fd
        var data = self._input
        if fd < 0 or data is none:
            return false
        var progress = false
        if self._offset < len(data):
            var count = min(65536, len(data) - self._offset)
            var written = core.write(fd, __offset(__ptr(__word(data)), 24 + self._offset), count)
            if written > 0:
                self._offset = self._offset + written
                progress = true
            else if written < 0:
                var code = core.errno()
                if code == 32:
                    self._offset = len(data)
                else if code != 4 and not core.would_block(code):
                    raise OSError("cannot write input: " + core.os_reason())
        if self._offset == len(data):
            core.close(fd)
            self._input_fd = -1
            progress = true
        return progress

    def _read(fd: int, parts: list[bytes], size: int) -> int:
        var count = core.read(fd, self._buffer, size)
        if count > 0:
            parts.append(_octets(self._buffer, count))
        else if count < 0:
            var code = core.errno()
            if code != 4 and not core.would_block(code):
                raise OSError("cannot read output: " + core.os_reason())
        return count

    def step() -> bool:
        var progress = self._write()
        for which in range(2):
            var fd = self._output_fd
            var parts = self._output
            if which == 1:
                fd = self._error_fd
                parts = self._error
            if fd >= 0:
                var count = self._read(fd, parts, 65536)
                if count >= 0:
                    progress = true
                if count == 0:
                    core.close(fd)
                    if which == 0:
                        self._output_fd = -1
                    else:
                        self._error_fd = -1
        return progress

    def wait(seconds: float):
        var fds = __alloc_atomic(24)
        var count = 0
        for fd in [self._input_fd, self._output_fd, self._error_fd]:
            if fd >= 0:
                var events = 1
                if fd == self._input_fd:
                    events = 4
                __store4(fds, count * 8, fd)
                __store4(fds, count * 8 + 4, events)
                count = count + 1
        if core.poll(fds, count, int(core.ceil(seconds * 1000.0))) < 0:
            if core.errno() != 4:
                raise OSError("cannot poll: " + core.os_reason())

    def finish(code: int) -> Result:
        for which in range(2):
            var fd = self._output_fd
            var parts = self._output
            if which == 1:
                fd = self._error_fd
                parts = self._error
            if fd >= 0:
                var remaining = core.process_available(fd)
                while remaining > 0:
                    var count = self._read(fd, parts, min(65536, remaining))
                    if count <= 0:
                        break
                    remaining = remaining - count
        var output: bytes | none = none
        var error: bytes | none = none
        if self._capture:
            output = _join(self._output)
            error = _join(self._error)
        return Result(code, output, error)

    def close():
        for fd in [self._input_fd, self._output_fd, self._error_fd]:
            if fd >= 0:
                core.close(fd)
        self._input_fd = -1
        self._output_fd = -1
        self._error_fd = -1

def _start(args: list[str], input: bytes | none, capture_output: bool, cwd: str | none, env: dict[str, str] | none) -> _Run:
    var redirects = [-1, -1, -1]
    var all_fds: list[int] = []
    var parent: list[int] = []
    var input_fd = -1
    var output_fd = -1
    var error_fd = -1
    var started = false
    try:
        if input is not none:
            var pipe = core.process_pipe()
            all_fds.extend(pipe)
            redirects[0] = pipe[0]
            input_fd = pipe[1]
            parent.append(input_fd)
        if capture_output:
            var pipe = core.process_pipe()
            all_fds.extend(pipe)
            output_fd = pipe[0]
            redirects[1] = pipe[1]
            parent.append(output_fd)
            pipe = core.process_pipe()
            all_fds.extend(pipe)
            error_fd = pipe[0]
            redirects[2] = pipe[1]
            parent.append(error_fd)
        for fd in parent:
            core.process_nonblocking(fd)
        var child = core.process_start(args, cwd, env, redirects)
        var result = _Run(child, input_fd, output_fd, error_fd, input, capture_output, [], [], __alloc_atomic(65536))
        started = true
        return result
    finally:
        for fd in all_fds:
            if not started or fd not in parent:
                core.close(fd)

def run(args: list[str], input: bytes | none = none, capture_output: bool = false, cwd: str | none = none, env: dict[str, str] | none = none, timeout: float | none = none) -> Result:
    _check_timeout(timeout)
    var state = _start(args, input, capture_output, cwd, env)
    var deadline = _deadline(timeout)
    var code: int | none = none
    try:
        while code is none:
            var progress = state.step()
            code = core.process_poll(state._child, false)
            if code is none:
                var delay = _delay(deadline)
                if delay == 0.0:
                    raise TimeoutError(f"command timed out after {timeout} seconds")
                if not progress:
                    state.wait(delay)
        assert code is not none
        return state.finish(code)
    finally:
        try:
            if state._child.code is none:
                core.process_signal(state._child, 9)
                core.process_poll(state._child, true)
        finally:
            state.close()

async def run_async(args: list[str], input: bytes | none = none, capture_output: bool = false, cwd: str | none = none, env: dict[str, str] | none = none, timeout: float | none = none) -> Result:
    await aio.sleep(0.0)
    _check_timeout(timeout)
    var state = _start(args, input, capture_output, cwd, env)
    var deadline = _deadline(timeout)
    var code: int | none = none
    try:
        while code is none:
            var progress = state.step()
            code = core.process_poll(state._child, false)
            if code is none:
                var delay = _delay(deadline)
                if delay == 0.0:
                    raise TimeoutError(f"command timed out after {timeout} seconds")
                if progress:
                    delay = 0.0
                await aio.sleep(delay)
        assert code is not none
        return state.finish(code)
    finally:
        try:
            if state._child.code is none:
                core.process_signal(state._child, 9)
                code = core.process_poll(state._child, false)
                while code is none:
                    await aio.sleep(0.001)
                    code = core.process_poll(state._child, false)
        finally:
            state.close()
