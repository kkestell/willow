import core
import sys

extern def opendir(path: ptr) -> ptr
extern def readdir(directory: ptr) -> ptr
extern def closedir(directory: ptr) -> cint
extern def unlink(path: ptr) -> cint
extern def mkstemp(template: ptr) -> cint
extern def mkdtemp(template: ptr) -> ptr

class Stat:
    kind: str
    size: int
    modified: float

def read_file(path: str) -> str:
    return core.fs_read_file(path)

def write_file(path: str, text: str):
    core.fs_write_file(path, text)

def exists(path: str) -> bool:
    return core.fs_exists(path)

def realpath(path: str) -> str:
    return core.fs_realpath(path)

def read_bytes(path: str) -> bytes:
    return __str(__word(core.fs_read_data(path))).encode()

def write_bytes(path: str, data: bytes):
    core.fs_write_file(path, __str(__word(data)))

def join(a: str, b: str) -> str:
    core.path_bytes(a)
    core.path_bytes(b)
    if b.startswith("/"):
        return b
    if a == "" or a.endswith("/"):
        return a + b
    return a + "/" + b

def basename(path: str) -> str:
    core.path_bytes(path)
    return path.rsplit("/", 1)[-1]

def dirname(path: str) -> str:
    core.path_bytes(path)
    var parts = path.rsplit("/", 1)
    if len(parts) == 1:
        return ""
    var head = parts[0] + "/"
    if head.replace("/", "") == "":
        return head
    while head.endswith("/"):
        head = head[:-1]
    return head

def _listdir(path: str, pattern: str | none) -> list[str]:
    var layout = core.fs_layout()
    var directory = opendir(core.path_bytes(path))
    if __addr_is_null(directory):
        if pattern is not none:
            return []
        core.fail_os("list", path)
    var names: list[str] = []
    try:
        while true:
            core.clear_errno()
            var entry = readdir(directory)
            if __addr_is_null(entry):
                if core.errno() != 0:
                    if pattern is not none:
                        return []
                    core.fail_os("list", path)
                break
            var name = __offset(entry, layout.name_offset)
            var size = core.strlen(name)
            if size == 1 and __load1(name, 0) == 46:
                continue
            if size == 2 and __load1(name, 0) == 46 and __load1(name, 1) == 46:
                continue
            var text = core.str_from_bytes(name, size)
            if pattern is none or _match(pattern, text):
                names.append(text)
    finally:
        closedir(directory)
    names.sort()
    return names

def listdir(path: str) -> list[str]:
    return _listdir(path, none)

def _kind(buf: ptr, layout: core.FsLayout) -> str:
    var mode = __load4(buf, layout.mode_offset) % 65536 // 4096
    if mode == 8:
        return "file"
    if mode == 4:
        return "directory"
    if mode == 10:
        return "symlink"
    return "other"

def stat(path: str, follow_symlinks: bool = true) -> Stat:
    var layout = core.fs_layout()
    var buf = __alloc_atomic(layout.buffer_size)
    if core.fs_stat(core.path_bytes(path), buf, follow_symlinks) != 0:
        core.fail_os("stat", path)
    var size = __int(__load8(buf, layout.size_offset))
    if size < 0:
        raise OverflowError("file size out of range")
    var modified = float(__int(__load8(buf, layout.modified_offset))) + float(__load4(buf, layout.modified_offset + 8)) / 1000000000.0
    return Stat(_kind(buf, layout), size, modified)

def _is_directory(path: str) -> bool:
    var layout = core.fs_layout()
    var buf = __alloc_atomic(layout.buffer_size)
    return core.fs_stat(core.path_bytes(path), buf, true) == 0 and _kind(buf, layout) == "directory"

def mkdir(path: str, parents: bool = false, exist_ok: bool = false):
    core.path_bytes(path)
    while len(path) > 1 and path.endswith("/"):
        path = path[:-1]
    if core.mkdir(core.str_bytes(path), 511) == 0:
        return
    var code = core.errno()
    var reason = core.os_reason()
    if code == 2 and parents:
        var parent = dirname(path)
        if parent != "" and parent != path:
            mkdir(parent, parents=true, exist_ok=true)
            if core.mkdir(core.str_bytes(path), 511) == 0:
                return
            code = core.errno()
            reason = core.os_reason()
    if code == 17 and exist_ok and _is_directory(path):
        return
    raise OSError("cannot create directory " + path + ": " + reason)

def remove(path: str):
    if unlink(core.path_bytes(path)) != 0:
        core.fail_os("remove", path)

def rmdir(path: str):
    if core.rmdir(core.path_bytes(path)) != 0:
        core.fail_os("remove directory", path)

def rename(source: str, destination: str):
    if core.rename(core.path_bytes(source), core.path_bytes(destination)) != 0:
        core.fail_os("rename " + source + " to", destination)

def copy_file(source: str, destination: str):
    var source_bytes = core.path_bytes(source)
    var destination_bytes = core.path_bytes(destination)
    var input = core.open(source_bytes, 0)
    if input < 0:
        core.fail_os("read", source)
    var output = -1
    var closed = 0
    try:
        var buf = __alloc_atomic(65536)
        var count = core.read(input, buf, 65536)
        if count < 0:
            core.fail_os("read", source)
        if core.fs_same_file(source, destination):
            raise OSError("cannot copy " + source + " to " + destination + ": they are the same file")
        output = core.open(destination_bytes, core.write_flags(), 438)
        if output < 0:
            core.fail_os("write", destination)
        while count > 0:
            var done = 0
            while done < count:
                var written = core.write(output, __offset(buf, done), count - done)
                if written < 0:
                    core.fail_os("write", destination)
                done = done + written
            count = core.read(input, buf, 65536)
            if count < 0:
                core.fail_os("read", source)
    finally:
        core.close(input)
        if output >= 0:
            closed = core.close(output)
    if closed < 0:
        core.fail_os("write", destination)

def normpath(path: str) -> str:
    core.path_bytes(path)
    var slashes = ""
    if path.startswith("/"):
        slashes = "/"
    if path.startswith("//") and not path.startswith("///"):
        slashes = "//"
    var parts: list[str] = []
    for part in path.split("/"):
        if part == "" or part == ".":
            continue
        if part != ".." or (slashes == "" and len(parts) == 0) or (len(parts) > 0 and parts[-1] == ".."):
            parts.append(part)
        else if len(parts) > 0:
            parts.pop()
    var result = slashes + "/".join(parts)
    if result == "":
        return "."
    return result

def abspath(path: str) -> str:
    if not path.startswith("/"):
        path = join(sys.getcwd(), path)
    return normpath(path)

def _has_magic(pattern: str) -> bool:
    return "*" in pattern or "?" in pattern or "[" in pattern

def _match_set(pattern: list[str], start: int, char: str) -> tuple[bool, int]:
    var at = start + 1
    var negate = at < len(pattern) and pattern[at] == "!"
    if negate:
        at = at + 1
    var end = at
    if end < len(pattern) and pattern[end] == "]":
        end = end + 1
    while end < len(pattern) and pattern[end] != "]":
        end = end + 1
    if end == len(pattern):
        return (char == "[", start + 1)
    var matched = false
    while at < end:
        if at + 2 < end and pattern[at + 1] == "-":
            matched = matched or (pattern[at] <= char and char <= pattern[at + 2])
            at = at + 3
        else:
            matched = matched or pattern[at] == char
            at = at + 1
    return (matched != negate, end + 1)

def _match(pattern: str, name: str) -> bool:
    if name.startswith(".") and not pattern.startswith("."):
        return false
    var chars = list(pattern)
    var text = list(name)
    var at = 0
    var pos = 0
    var star = -1
    var retry = 0
    while pos < len(text):
        if at < len(chars) and chars[at] == "*":
            star = at
            at = at + 1
            retry = pos
            continue
        var matched = false
        var after = at + 1
        if at < len(chars):
            if chars[at] == "[":
                matched, after = _match_set(chars, at, text[pos])
            else:
                matched = chars[at] == "?" or chars[at] == text[pos]
        if matched:
            at = after
            pos = pos + 1
        else if star >= 0:
            retry = retry + 1
            pos = retry
            at = star + 1
        else:
            return false
    while at < len(chars) and chars[at] == "*":
        at = at + 1
    return at == len(chars)

def _glob(pattern: str) -> list[str]:
    var head = dirname(pattern)
    var tail = basename(pattern)
    var heads = [head]
    if _has_magic(head):
        heads = _glob(head)
    var paths: list[str] = []
    for directory in heads:
        if tail == "":
            if _is_directory(directory):
                paths.append(join(directory, ""))
        else if _has_magic(tail):
            var scan = directory
            if scan == "":
                scan = "."
            for name in _listdir(scan, tail):
                paths.append(join(directory, name))
        else:
            var path = join(directory, tail)
            var layout = core.fs_layout()
            var buf = __alloc_atomic(layout.buffer_size)
            if core.fs_stat(core.str_bytes(path), buf, false) == 0:
                paths.append(path)
    return paths

def glob(pattern: str) -> list[str]:
    core.path_bytes(pattern)
    var paths = _glob(pattern)
    paths.sort()
    return paths

def walk(path: str) -> Iterator[tuple[str, list[str], list[str]]]:
    var pending = [path]
    while len(pending) > 0:
        var directory = pending.pop()
        var directories: list[str] = []
        var files: list[str] = []
        for name in listdir(directory):
            if stat(join(directory, name), follow_symlinks=false).kind == "directory":
                directories.append(name)
            else:
                files.append(name)
        for i in range(len(directories) - 1, -1, -1):
            pending.append(join(directory, directories[i]))
        yield (directory, directories, files)

def _temp(prefix: str, directory: str | none, file: bool) -> str:
    if "/" in prefix or "\x00" in prefix:
        raise ValueError("prefix must be a single path component")
    if directory is none:
        directory = sys.getenv("TMPDIR")
        if directory is none or directory == "":
            directory = "/tmp"
    var text = join(directory, prefix + "XXXXXX")
    var template = __alloc_atomic(core.str_size(text) + 1)
    core.memcpy(template, core.str_bytes(text), core.str_size(text) + 1)
    if file:
        var fd = mkstemp(template)
        if fd < 0:
            core.fail_os("create temporary file in", directory)
        if core.close(fd) != 0:
            core.fail_os("create temporary file in", directory)
    else if __addr_is_null(mkdtemp(template)):
        core.fail_os("create temporary directory in", directory)
    return core.str_from_bytes(template, core.strlen(template))

def temp_file(prefix: str = "willow-", directory: str | none = none) -> str:
    return _temp(prefix, directory, true)

def temp_dir(prefix: str = "willow-", directory: str | none = none) -> str:
    return _temp(prefix, directory, false)
