import core
import io
import sys

def isatty(file: io.File) -> bool:
    return file._isatty()

def color_enabled(file: io.File) -> bool:
    return isatty(file) and sys.getenv("TERM") != "dumb" and sys.getenv("NO_COLOR") is none

def style(text: str, color: str = "default", bold: bool = false, enabled: bool = true) -> str:
    colors = ["default", "black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    if color not in colors:
        raise ValueError(f"unknown color '{color}'")
    codes: list[str] = []
    if bold:
        codes.append("1")
    for i in range(1, len(colors)):
        if color == colors[i]:
            codes.append(str(29 + i))
    if not enabled or len(codes) == 0:
        return text
    return "\x1b[" + ";".join(codes) + "m" + text + "\x1b[0m"

def _capable() -> bool:
    return core.isatty(2) == 1 and sys.getenv("TERM") != "dumb"

def progress(message: str):
    if "\r" in message or "\n" in message:
        raise ValueError("progress message cannot contain a line break")
    if _capable():
        core.write_str(2, "\r\x1b[K" + message)

def finish_progress(message: str = ""):
    if _capable():
        core.write_str(2, "\r\x1b[K")
    if message != "":
        sys.eprint(message)
