type Json = None | bool | int | float | str | list[Json] | dict[str, Json]

class JsonError(Exception):
    pass

class _Parser:
    chars: list[str]
    pos: int

def _error(p: _Parser, problem: str) -> JsonError:
    if p.pos >= len(p.chars):
        problem = "unexpected end of input"
    line = 1
    column = 1
    for i in range(p.pos):
        if p.chars[i] == "\n":
            line = line + 1
            column = 1
        else:
            column = column + 1
    return JsonError(f"{problem} at line {line}, column {column}")

def _peek(p: _Parser) -> str:
    if p.pos < len(p.chars):
        return p.chars[p.pos]
    return ""

def _advance(p: _Parser) -> None:
    p.pos = p.pos + 1

# `"" in s` is True, so the end of input needs its own test.
def _is_digit(c: str) -> bool:
    return c != "" and c in "0123456789"

def _skip_space(p: _Parser) -> None:
    c = _peek(p)
    while c == " " or c == "\t" or c == "\n" or c == "\r":
        _advance(p)
        c = _peek(p)

def _word(p: _Parser, word: str) -> None:
    for c in word:
        if _peek(p) != c:
            raise _error(p, f"expected '{word}'")
        _advance(p)

# Reads four hex digits; `start` is the escape's backslash.
def _hex4(p: _Parser, start: int) -> int:
    value = 0
    for i in range(4):
        c = _peek(p)
        if c == "":
            raise _error(p, "")
        digit = "0123456789abcdef".find(c)
        if digit < 0:
            digit = "0123456789ABCDEF".find(c)
        if digit < 0:
            p.pos = start
            raise _error(p, "invalid escape")
        value = value * 16 + digit
        _advance(p)
    return value

def _string(p: _Parser) -> str:
    _advance(p)
    parts: list[str] = []
    while True:
        c = _peek(p)
        if c == "":
            raise _error(p, "")
        if c == "\"":
            _advance(p)
            return "".join(parts)
        if c == "\\":
            start = p.pos
            _advance(p)
            e = _peek(p)
            if e == "":
                raise _error(p, "")
            _advance(p)
            if e == "\"" or e == "\\" or e == "/":
                parts.append(e)
            elif e == "b":
                parts.append(chr(8))
            elif e == "f":
                parts.append(chr(12))
            elif e == "n":
                parts.append("\n")
            elif e == "r":
                parts.append("\r")
            elif e == "t":
                parts.append("\t")
            elif e == "u":
                code = _hex4(p, start)
                # U+D800 through U+DFFF are surrogates; a high one (through
                # U+DBFF) must pair with an escaped low one.
                if code >= 55296 and code <= 57343:
                    if code > 56319 or _peek(p) != "\\":
                        p.pos = start
                        raise _error(p, "unpaired surrogate")
                    _advance(p)
                    if _peek(p) != "u":
                        p.pos = start
                        raise _error(p, "unpaired surrogate")
                    _advance(p)
                    low = _hex4(p, p.pos - 2)
                    if low < 56320 or low > 57343:
                        p.pos = start
                        raise _error(p, "unpaired surrogate")
                    code = 65536 + (code - 55296) * 1024 + (low - 56320)
                parts.append(chr(code))
            else:
                p.pos = start
                raise _error(p, "invalid escape")
        elif ord(c) < 32:
            raise _error(p, "control character in string")
        else:
            parts.append(c)
            _advance(p)
    return ""

def _number(p: _Parser) -> Json:
    start = p.pos
    if _peek(p) == "-":
        _advance(p)
    if _peek(p) == "0":
        _advance(p)
    elif _is_digit(_peek(p)):
        while _is_digit(_peek(p)):
            _advance(p)
    else:
        p.pos = start
        raise _error(p, "invalid number")
    is_float = False
    if _peek(p) == ".":
        is_float = True
        _advance(p)
        if not _is_digit(_peek(p)):
            p.pos = start
            raise _error(p, "invalid number")
        while _is_digit(_peek(p)):
            _advance(p)
    c = _peek(p)
    if c == "e" or c == "E":
        is_float = True
        _advance(p)
        c = _peek(p)
        if c == "+" or c == "-":
            _advance(p)
        if not _is_digit(_peek(p)):
            p.pos = start
            raise _error(p, "invalid number")
        while _is_digit(_peek(p)):
            _advance(p)
    parts: list[str] = []
    for i in range(start, p.pos):
        parts.append(p.chars[i])
    text = "".join(parts)
    if not is_float:
        try:
            return int(text)
        except ValueError:
            pass
    return float(text)

def _value(p: _Parser) -> Json:
    _skip_space(p)
    c = _peek(p)
    if c == "{":
        _advance(p)
        fields: dict[str, Json] = {}
        _skip_space(p)
        if _peek(p) == "}":
            _advance(p)
            return fields
        while True:
            _skip_space(p)
            if _peek(p) != "\"":
                raise _error(p, "expected string")
            key = _string(p)
            _skip_space(p)
            if _peek(p) != ":":
                raise _error(p, "expected ':'")
            _advance(p)
            fields[key] = _value(p)
            _skip_space(p)
            c = _peek(p)
            if c == "}":
                _advance(p)
                return fields
            if c != ",":
                raise _error(p, "expected ',' or '}'")
            _advance(p)
    if c == "[":
        _advance(p)
        items: list[Json] = []
        _skip_space(p)
        if _peek(p) == "]":
            _advance(p)
            return items
        while True:
            items.append(_value(p))
            _skip_space(p)
            c = _peek(p)
            if c == "]":
                _advance(p)
                return items
            if c != ",":
                raise _error(p, "expected ',' or ']'")
            _advance(p)
    if c == "\"":
        return _string(p)
    if c == "t":
        _word(p, "true")
        return True
    if c == "f":
        _word(p, "false")
        return False
    if c == "n":
        _word(p, "null")
        return None
    if c == "-" or _is_digit(c):
        return _number(p)
    raise _error(p, "expected value")

def parse(text: str) -> Json:
    chars: list[str] = []
    for c in text:
        chars.append(c)
    p = _Parser(chars, 0)
    value = _value(p)
    _skip_space(p)
    if p.pos < len(chars):
        raise _error(p, "unexpected text after value")
    return value

def _quote(text: str, out: list[str]) -> None:
    out.append("\"")
    for c in text:
        code = ord(c)
        if c == "\"":
            out.append("\\\"")
        elif c == "\\":
            out.append("\\\\")
        elif code == 8:
            out.append("\\b")
        elif code == 12:
            out.append("\\f")
        elif c == "\n":
            out.append("\\n")
        elif c == "\r":
            out.append("\\r")
        elif c == "\t":
            out.append("\\t")
        elif code < 32:
            low = code % 16
            digit = str(low)
            if low >= 10:
                digit = chr(ord("a") + low - 10)
            out.append("\\u00" + str(code // 16) + digit)
        else:
            out.append(c)
    out.append("\"")

def _dump(value: Json, out: list[str]) -> None:
    if value is None:
        out.append("null")
    elif isinstance(value, bool):
        if value:
            out.append("true")
        else:
            out.append("false")
    elif isinstance(value, int):
        out.append(str(value))
    elif isinstance(value, float):
        # Infinities and NaN give NaN here.
        if value - value != 0.0:
            raise JsonError("cannot encode " + str(value))
        out.append(str(value))
    elif isinstance(value, str):
        _quote(value, out)
    elif isinstance(value, list):
        out.append("[")
        first = True
        for item in value:
            if not first:
                out.append(",")
            first = False
            _dump(item, out)
        out.append("]")
    else:
        out.append("{")
        first = True
        for key in value:
            if not first:
                out.append(",")
            first = False
            _quote(key, out)
            out.append(":")
            _dump(value[key], out)
        out.append("}")

def dump(value: Json) -> str:
    out: list[str] = []
    _dump(value, out)
    return "".join(out)
