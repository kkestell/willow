import core
import time

def _wait(fd: int, events: int, deadline: float | none) -> bool:
    descriptor = core.net_pollfd(fd, events)
    ready = 0
    while ready <= 0:
        milliseconds = -1
        if deadline is not none:
            remaining = (deadline - time.monotonic()) * 1000.0
            if remaining <= 0.0:
                return false
            milliseconds = int(min(core.ceil(remaining), 2147483647.0))
        ready = core.poll(descriptor, 1, milliseconds)
        if ready < 0 and core.errno() != 4:
            raise OSError("cannot poll socket: " + core.os_reason())
    return true

class Connection:
    _fd: int
    _broken: bool

    def _usable():
        if self._fd < 0:
            raise ValueError("I/O operation on closed connection")
        if self._broken:
            raise ValueError("connection is unusable after a failed send")

    def recv(size: int, timeout: float | none = none) -> bytes:
        self._usable()
        if size < 1:
            raise ValueError("size must be positive")
        core.net_check_timeout(timeout)
        deadline = core.net_deadline(timeout)
        buffer = core.str_alloc(size)
        count = core.net_try_recv(self._fd, buffer, size)
        while count < 0:
            if not _wait(self._fd, 1, deadline):
                core.net_timed_out("recv", timeout)
            count = core.net_try_recv(self._fd, buffer, size)
        return __bytes(core.net_received(buffer))

    def sendall(data: bytes, timeout: float | none = none):
        self._usable()
        core.net_check_timeout(timeout)
        deadline = core.net_deadline(timeout)
        sent = 0
        try:
            while sent < len(data):
                count = core.net_try_send(self._fd, __ptr(__word(data)), sent, len(data))
                if count >= 0:
                    sent = sent + count
                else if not _wait(self._fd, 4, deadline):
                    core.net_timed_out("send", timeout)
        except Exception:
            self._broken = true
            raise

    def close():
        if self._fd >= 0:
            core.close(self._fd)
            self._fd = -1

    def enter() -> Connection:
        self._usable()
        return self

    def exit(error: Exception | none):
        self.close()

class Listener:
    _fd: int

    def _usable():
        if self._fd < 0:
            raise ValueError("I/O operation on closed listener")

    def accept(timeout: float | none = none) -> Connection:
        self._usable()
        core.net_check_timeout(timeout)
        deadline = core.net_deadline(timeout)
        fd = core.net_try_accept(self._fd)
        while fd < 0:
            if not _wait(self._fd, 1, deadline):
                core.net_timed_out("accept", timeout)
            fd = core.net_try_accept(self._fd)
        return Connection(fd, false)

    def local_port() -> int:
        self._usable()
        return core.net_local_port(self._fd)

    def close():
        if self._fd >= 0:
            core.close(self._fd)
            self._fd = -1

    def enter() -> Listener:
        self._usable()
        return self

    def exit(error: Exception | none):
        self.close()

def connect(host: str, port: int, timeout: float | none = 30.0) -> Connection:
    core.net_check_host(host, port, 1)
    core.net_check_timeout(timeout)
    addresses = core.net_resolve(host, port)
    deadline = core.net_deadline(timeout)
    state = core.NetConnect(host, port, addresses, 0, -1, "no addresses")
    connected = false
    try:
        while not core.net_connect_step(state):
            if not _wait(state.fd, 4, deadline):
                core.net_timed_out("connect", timeout)
        connected = true
        return Connection(state.fd, false)
    finally:
        if not connected and state.fd >= 0:
            core.close(state.fd)

def listen(host: str, port: int, backlog: int = 16) -> Listener:
    return Listener(core.net_listen(host, port, backlog))

class Reader:
    _connection: Connection
    _buffer: bytes
    _closed: bool

    def _usable():
        if self._closed:
            raise ValueError("I/O operation on closed reader")

    def _fill(what: str, timeout: float | none, deadline: float | none) -> bool:
        remaining: float | none = none
        if deadline is not none:
            remaining = deadline - time.monotonic()
            if remaining <= 0.0:
                core.net_timed_out(what, timeout)
        try:
            chunk = self._connection.recv(65536, remaining)
        except TimeoutError:
            core.net_timed_out(what, timeout)
            return false
        self._buffer = self._buffer + chunk
        return len(chunk) > 0

    def _take(count: int) -> bytes:
        data = self._buffer[:count]
        self._buffer = self._buffer[count:]
        return data

    def read_exactly(size: int, timeout: float | none = none) -> bytes:
        self._usable()
        if size < 0:
            raise ValueError("size must not be negative")
        core.net_check_timeout(timeout)
        deadline = core.net_deadline(timeout)
        while len(self._buffer) < size:
            if not self._fill("read_exactly", timeout, deadline):
                raise OSError(f"unexpected end of stream: expected {size} bytes, received {len(self._buffer)}")
        return self._take(size)

    def read_until(separator: bytes, max_bytes: int = 1048576, timeout: float | none = none) -> bytes:
        self._usable()
        if len(separator) == 0:
            raise ValueError("separator must not be empty")
        if max_bytes < 1:
            raise ValueError("max_bytes must be positive")
        core.net_check_timeout(timeout)
        deadline = core.net_deadline(timeout)
        at = self._buffer.find(separator)
        while at is none or at + len(separator) > max_bytes:
            if at is not none or len(self._buffer) >= max_bytes:
                raise ValueError(f"separator not found within {max_bytes} bytes")
            if not self._fill("read_until", timeout, deadline):
                return self._take(len(self._buffer))
            at = self._buffer.find(separator)
        assert at is not none, "the loop exits only when the separator is found"
        return self._take(at + len(separator))

    def close():
        if not self._closed:
            self._closed = true
            self._buffer = bytes([])
            self._connection.close()

    def enter() -> Reader:
        self._usable()
        return self

    def exit(error: Exception | none):
        self.close()

def reader(connection: Connection) -> Reader:
    connection.enter()
    return Reader(connection, bytes([]), false)
