# The built-in functions, exception classes, and standard protocols, as the
# binder sees them. L0 has no module variables, so each table is built
# when it is asked for; the binder builds them once. Types compare
# declarations by type_name, so tables built twice agree.

import ast
import types

# A built-in function, or a function of a provided module.
class Builtin:
    name: str
    params: list[BuiltinParam]
    # none when the checker works the result out from the arguments, and for
    # range, which has its own form.
    result: types.Type | none
    # The runtime helper, when it is not named after the function.
    helper: str

# A parameter without a name is positional-only. A parameter without a type
# takes any value; the checker checks it by the function's name.
class BuiltinParam:
    name: str
    ty: types.Type | none
    default: ast.Expr | none
    keyword_only: bool

# A compiler-provided module. It has no source; a program's own module of the
# same name shadows it.
class Module:
    name: str
    functions: dict[str, Builtin]
    classes: dict[str, types.Class]
    aliases: dict[str, types.Type]
    # Float constants, which binding replaces with their values.
    constants: dict[str, float]

def prim(name: str) -> types.Type:
    return types.prim(name)

def optional(name: str) -> types.Type:
    return types.optional(types.prim(name))

def list_of(name: str) -> types.Type:
    return types.ListType(types.prim(name))

# Literal defaults, at no position.
def none_default() -> ast.Expr:
    return ast.Expr(0, 0, ast.Constant.NONE)

def bool_default(value: bool) -> ast.Expr:
    if value:
        return ast.Expr(0, 0, ast.Constant.TRUE)
    return ast.Expr(0, 0, ast.Constant.FALSE)

def int_default(text: str) -> ast.Expr:
    return ast.Expr(0, 0, ast.Int(text))

def float_default(value: float) -> ast.Expr:
    return ast.Expr(0, 0, ast.Float(value))

def str_default(value: str) -> ast.Expr:
    return ast.Expr(0, 0, ast.String(value))

def arg(name: str, ty: types.Type) -> BuiltinParam:
    return BuiltinParam(name, ty, none, false)

def any_arg(name: str) -> BuiltinParam:
    return BuiltinParam(name, none, none, false)

def defaulted(name: str, ty: types.Type, default: ast.Expr) -> BuiltinParam:
    return BuiltinParam(name, ty, default, false)

def add(table: dict[str, Builtin], name: str, params: list[BuiltinParam], result: types.Type | none):
    table[name] = Builtin(name, params, result, "")

def add_helper(table: dict[str, Builtin], name: str, params: list[BuiltinParam], result: types.Type | none, helper: str):
    table[name] = Builtin(name, params, result, helper)

# The built-in functions. `bytes.fromhex` is listed by that name, which the
# binder resolves.
def builtins() -> dict[str, Builtin]:
    var table: dict[str, Builtin] = {}
    add(table, "print", [any_arg("")], prim("none"))
    add(table, "str", [any_arg("")], prim("str"))
    add(table, "int", [any_arg("")], prim("int"))
    add(table, "float", [any_arg("")], prim("float"))
    add(table, "len", [any_arg("")], prim("int"))
    add(table, "iter", [any_arg("")], none)
    add(table, "next", [any_arg("")], none)
    add(table, "range", [], none)
    add(table, "input", [], optional("str"))
    add(table, "ord", [arg("", prim("str"))], prim("int"))
    add(table, "chr", [arg("", prim("int"))], prim("str"))
    var sorted_params = [any_arg("items")]
    sorted_params.extend(sort_params())
    add(table, "sorted", sorted_params, none)
    add(table, "bytes", [arg("", list_of("int"))], prim("bytes"))
    add_helper(table, "bytes.fromhex", [arg("text", prim("str"))], prim("bytes"), "bytes_fromhex")
    # The checker works out these results from the arguments; min and max
    # take one or two arguments.
    add(table, "abs", [any_arg("x")], none)
    add(table, "round", [arg("x", prim("float"))], prim("int"))
    add(table, "min", [any_arg(""), any_arg("")], none)
    add(table, "max", [any_arg(""), any_arg("")], none)
    add(table, "sum", [any_arg("items")], none)
    add(table, "any", [any_arg("items")], prim("bool"))
    add(table, "all", [any_arg("items")], prim("bool"))
    add(table, "list", [any_arg("items")], none)
    var start = defaulted("start", prim("int"), int_default("0"))
    add(table, "enumerate", [any_arg("items"), start], none)
    add(table, "zip", [any_arg("a"), any_arg("b")], none)
    return table

# The parameters of `sorted` after `items`, and of `list.sort`.
def sort_params() -> list[BuiltinParam]:
    var reverse = defaulted("reverse", prim("bool"), bool_default(false))
    return [reverse, BuiltinParam("key", none, none_default(), true)]

# The string methods, with the spec's parameter names and defaults. Each
# lowers to core's `str_<name>`.
def str_methods() -> dict[str, Builtin]:
    var table: dict[str, Builtin] = {}
    var text = prim("str")
    var flag = prim("bool")
    add(table, "find", [arg("sub", text)], optional("int"))
    add(table, "split", [defaulted("sep", optional("str"), none_default()), defaulted("maxsplit", prim("int"), int_default("-1"))], list_of("str"))
    add(table, "rsplit", [defaulted("sep", optional("str"), none_default()), defaulted("maxsplit", prim("int"), int_default("-1"))], list_of("str"))
    add(table, "splitlines", [defaulted("keepends", flag, bool_default(false))], list_of("str"))
    add(table, "encode", [], prim("bytes"))
    add(table, "join", [arg("items", list_of("str"))], text)
    add(table, "startswith", [arg("prefix", text)], flag)
    add(table, "endswith", [arg("suffix", text)], flag)
    add(table, "strip", [], text)
    add(table, "lstrip", [], text)
    add(table, "rstrip", [], text)
    add(table, "replace", [arg("old", text), arg("new", text)], text)
    add(table, "removeprefix", [arg("prefix", text)], text)
    add(table, "removesuffix", [arg("suffix", text)], text)
    add(table, "isascii", [], flag)
    add(table, "isdigit", [], flag)
    add(table, "isalpha", [], flag)
    add(table, "isalnum", [], flag)
    add(table, "isspace", [], flag)
    add(table, "ljust", [arg("width", prim("int"))], text)
    add(table, "rjust", [arg("width", prim("int"))], text)
    add(table, "lower", [], text)
    add(table, "upper", [], text)
    return table

def bytes_methods() -> dict[str, Builtin]:
    var table: dict[str, Builtin] = {}
    var data = prim("bytes")
    add(table, "decode", [], prim("str"))
    add(table, "find", [arg("sub", data)], optional("int"))
    add(table, "startswith", [arg("prefix", data)], prim("bool"))
    add(table, "endswith", [arg("suffix", data)], prim("bool"))
    add(table, "split", [arg("sep", data), defaulted("maxsplit", prim("int"), int_default("-1"))], list_of("bytes"))
    add(table, "hex", [], prim("str"))
    return table

# The intrinsics that core calls. `__type` has its
# own syntax, and `__os` is a name.
def intrinsics() -> dict[str, Builtin]:
    var table: dict[str, Builtin] = {}
    add(table, "__ccall", [], none)
    add(table, "__alloc", [arg("", prim("int"))], prim("ptr"))
    add(table, "__alloc_atomic", [arg("", prim("int"))], prim("ptr"))
    add(table, "__load1", [arg("", prim("ptr")), arg("", prim("int"))], prim("int"))
    add(table, "__load4", [arg("", prim("ptr")), arg("", prim("int"))], prim("int"))
    add(table, "__load8", [arg("", prim("ptr")), arg("", prim("int"))], prim("word"))
    add(table, "__store1", [arg("", prim("ptr")), arg("", prim("int")), arg("", prim("int"))], prim("none"))
    add(table, "__store4", [arg("", prim("ptr")), arg("", prim("int")), arg("", prim("int"))], prim("none"))
    add(table, "__store8", [arg("", prim("ptr")), arg("", prim("int")), arg("", prim("word"))], prim("none"))
    add(table, "__word", [any_arg("")], prim("word"))
    add(table, "__int", [arg("", prim("word"))], prim("int"))
    add(table, "__float", [arg("", prim("word"))], prim("float"))
    add(table, "__bool", [arg("", prim("word"))], prim("bool"))
    add(table, "__ptr", [arg("", prim("word"))], prim("ptr"))
    add(table, "__str", [arg("", prim("word"))], prim("str"))
    add(table, "__bytes", [arg("", prim("word"))], prim("bytes"))
    add(table, "__addr_is_null", [arg("", prim("ptr"))], prim("bool"))
    add(table, "__dtosi", [arg("", prim("float"))], prim("int"))
    add(table, "__offset", [arg("", prim("ptr")), arg("", prim("int"))], prim("ptr"))
    return table

# An exception class: a class with only a `message` field.
def exception(name: str, type_name: str) -> types.Class:
    var message = types.Field("message", prim("str"), none)
    return types.Class(name, type_name, [], [message], [], true, false, "")

# The built-in exception classes.
def exceptions() -> dict[str, types.Class]:
    var table: dict[str, types.Class] = {}
    var names = "Exception AssertionError OverflowError ZeroDivisionError ValueError IndexError KeyError RuntimeError OSError TimeoutError StopIteration"
    for name in names.split(" "):
        table[name] = exception(name, name)
    return table

def optional_exception() -> types.Type:
    return types.optional(types.ClassType(exception("Exception", "Exception"), []))

# A standard protocol with one type parameter `T`, whose id is `id`, without
# methods yet. The standard library's type parameters have fixed negative ids
# (types.TypeVar), so tables built twice agree; types.iterator_protocol's is
# -1.
def standard_protocol(name: str, id: int) -> types.Protocol:
    return types.Protocol(name, name, [types.TypeVar(id, "T", none)], [])

# Adds a method with the parameters `params` after `self`.
def protocol_method(decl: types.Protocol, name: str, params: list[types.Param], result: types.Type):
    var receiver = types.Param("self", types.protocol_self(decl), none, false)
    var all_params = [receiver]
    all_params.extend(params)
    decl.methods.append(types.Function(0, name, decl.type_name + "." + name, [], all_params, result))

def param(name: str, ty: types.Type) -> types.Param:
    return types.Param(name, ty, none, false)

# The standard protocols, each generic in `T`.
def protocols() -> dict[str, types.Protocol]:
    var iterable = standard_protocol("Iterable", -2)
    protocol_method(iterable, "iter", [], types.iterator(iterable.typevars[0]))
    var manager = standard_protocol("ContextManager", -3)
    protocol_method(manager, "enter", [], manager.typevars[0])
    protocol_method(manager, "exit", [param("error", optional_exception())], prim("none"))
    var generator = standard_protocol("Generator", -4)
    var t = generator.typevars[0]
    protocol_method(generator, "iter", [], types.iterator(t))
    protocol_method(generator, "next", [], t)
    protocol_method(generator, "close", [], prim("none"))
    protocol_method(generator, "enter", [], types.protocol_self(generator))
    protocol_method(generator, "exit", [param("error", optional_exception())], prim("none"))
    return {
        "Iterator": types.iterator_protocol(),
        "Iterable": iterable,
        "ContextManager": manager,
        "Generator": generator,
    }

# `Coroutine[T]`, an opaque generic type with no methods. Values are created
# only by calling async functions.
def coroutine() -> types.Class:
    return types.Class("Coroutine", "Coroutine", [types.TypeVar(-5, "T", none)], [], [], false, true, "")

def coroutine_of(t: types.Type) -> types.Type:
    return types.ClassType(coroutine(), [t])

# Whether `t` is a coroutine type or a union with a coroutine member.
def has_coroutine(t: types.Type) -> bool:
    for m in types.members(t):
        if m is types.ClassType and m.decl.type_name == "Coroutine":
            return true
    return false

# An ordinary class of a provided module, with `fields` names and `kinds`
# types.
def provided_class(module: str, name: str, names: list[str], kinds: list[types.Type]) -> types.Class:
    var fields: list[types.Field] = []
    for i in range(len(names)):
        fields.append(types.Field(names[i], kinds[i], none))
    return types.Class(name, module + "." + name, [], fields, [], false, false, "", true)

# A native type: a provided class with no fields that only its module's
# functions create. Its methods lower to helpers named after `prefix`.
def native_class(module: str, name: str, prefix: str) -> types.Class:
    return types.Class(name, module + "." + name, [], [], [], false, true, prefix, true)

def class_type(decl: types.Class) -> types.Type:
    return types.class_self(decl)

# Adds a method with the parameters `params` after `self`; a parameter named
# "" is positional-only.
def native_method(decl: types.Class, name: str, params: list[types.Param], result: types.Type):
    generic_method(decl, name, [], params, result)

# A native method generic in `typevars`.
def generic_method(decl: types.Class, name: str, typevars: list[types.TypeVar], params: list[types.Param], result: types.Type):
    var receiver = types.Param("self", types.class_self(decl), none, false)
    var all_params = [receiver]
    all_params.extend(params)
    decl.methods.append(types.Function(0, name, decl.type_name + "." + name, typevars, all_params, result))

def default_param(name: str, ty: types.Type, default: ast.Expr) -> types.Param:
    return types.Param(name, ty, default, false)

# Gives a native type the context-manager methods: `enter` returns the open
# handle and `exit` closes it.
def scoped(decl: types.Class):
    native_method(decl, "enter", [], class_type(decl))
    native_method(decl, "exit", [param("error", optional_exception())], prim("none"))

def new_module(name: str) -> Module:
    return Module(name, {}, {}, {}, {})

def io_file() -> types.Class:
    var file = native_class("io", "File", "file")
    native_method(file, "read", [param("size", prim("int"))], prim("bytes"))
    native_method(file, "readline", [], optional("str"))
    native_method(file, "write", [param("data", prim("bytes"))], prim("none"))
    native_method(file, "write_text", [param("text", prim("str"))], prim("none"))
    native_method(file, "flush", [], prim("none"))
    native_method(file, "close", [], prim("none"))
    native_method(file, "iter", [], types.iterator(prim("str")))
    scoped(file)
    return file

def none_param(name: str, ty: types.Type) -> types.Param:
    return default_param(name, ty, none_default())

# The compiler-provided modules, by name.
def modules() -> dict[str, Module]:
    return {}

# Run-time types of built-in values that protocol dispatch finds converters
# for, named by their dispatch tags, which no class can have. Programs cannot
# name them. Their methods lower to helpers named after their prefixes. Each
# has an `iter` method over items of a type parameter `T` of its own.
def dispatched() -> list[types.Class]:
    var result: list[types.Class] = []
    var id = -10
    for name in "list dict str bytes tuple range".split(" "):
        result.append(dispatched_class(name, name, types.TypeVar(id, "T", none)))
        id = id - 1
    var t = types.TypeVar(-16, "T", none)
    var iterator = dispatched_class("<iterator>", "iterator", t)
    native_method(iterator, "next", [], t)
    result.append(iterator)
    t = types.TypeVar(-17, "T", none)
    var generator = dispatched_class("<generator>", "generator", t)
    native_method(generator, "next", [], t)
    native_method(generator, "close", [], prim("none"))
    var generators = protocols()["Generator"]
    native_method(generator, "enter", [], types.ProtocolType(generators, [t]))
    native_method(generator, "exit", [param("error", optional_exception())], prim("none"))
    result.append(generator)
    return result

def dispatched_class(tag: str, prefix: str, t: types.TypeVar) -> types.Class:
    var decl = types.Class(tag, tag, [], [], [], false, true, prefix)
    native_method(decl, "iter", [], types.iterator(t))
    return decl
