# Checks the lexer's edge cases and diagnostics. Prints each mismatch and
# exits with status 1 if there was one.

import diagnostic
import lexer
import sys
import tokens

# The tokens of `source` as words, writing keywords and operators as their
# text and others by kind, with a string's text after a colon; or the first
# error as "line:col: message".
def describe(source: str) -> str:
    result = lexer.lex("test.wlo", source)
    if isinstance(result, diagnostic.Diagnostic):
        return f"{result.line}:{result.col}: {result.message}"
    words: list[str] = []
    for token in result:
        name = str(token.kind).removeprefix("Kind.")
        if token.text != "" and name != "NAME" and name != "STRING_LITERAL" and name != "FSTRING_TEXT" and name != "FIELD_END" and name != "INT_LITERAL" and name != "FLOAT_LITERAL":
            words.append(token.text)
        else if token.text != "" and name != "NAME":
            words.append(f"{name}:{token.text}")
        else:
            words.append(name)
    return " ".join(words)

def check(source: str, expected: str) -> bool:
    actual = describe(source)
    if actual == expected:
        return true
    print(f"FAIL {source}")
    print(f"  expected: {expected}")
    print(f"  actual:   {actual}")
    return false

# The line and column of the token with index `index` in `source`.
def position(source: str, index: int) -> str:
    result = lexer.lex("test.wlo", source)
    if isinstance(result, diagnostic.Diagnostic):
        return result.format()
    token = result[index]
    return f"{token.line}:{token.col}"

def main():
    cases = [
        ["() => 1", "( ) => INT_LITERAL:1 NEWLINE EOF"],
        ["def inc(x: int) -> int:\n    return x + 1\n", "def NAME ( NAME : int ) -> int : NEWLINE INDENT return NAME + INT_LITERAL:1 NEWLINE DEDENT EOF"],
        ["def f():\r\n    pass\r\n", "def NAME ( ) : NEWLINE INDENT pass NEWLINE DEDENT EOF"],
        ["x = 1\ry = 2\n", "1:6: bare carriage return; line endings must be LF or CRLF"],
        ["x = 1\n# a\rb\n", "2:4: bare carriage return; line endings must be LF or CRLF"],
        ["x = 'héllo' + y\n", "NAME = STRING_LITERAL:héllo + NAME NEWLINE EOF"],
        ["def f():\n\tpass\n", "2:1: tabs are not allowed outside strings and comments"],
        ["x =\t1\n", "1:4: tabs are not allowed outside strings and comments"],
        ["x = 1\n  \t\ny = 2\n", "2:3: tabs are not allowed outside strings and comments"],
        ["x = '\t'  # \t\n", "NAME = STRING_LITERAL:\t NEWLINE EOF"],
        ["def f():\n\n   # odd\n  \n    pass\n      # deeper\n# end\n", "def NAME ( ) : NEWLINE INDENT pass NEWLINE DEDENT EOF"],
        ["def f():\n    while true:\n        pass", "def NAME ( ) : NEWLINE INDENT while true : NEWLINE INDENT pass NEWLINE DEDENT DEDENT EOF"],
        ["def f():\n    g(1,\n  2,\n          (3\n),\n    )\n    pass\n", "def NAME ( ) : NEWLINE INDENT NAME ( INT_LITERAL:1 , INT_LITERAL:2 , ( INT_LITERAL:3 ) , ) NEWLINE pass NEWLINE DEDENT EOF"],
        ["x = (1,\n", "NAME = ( INT_LITERAL:1 , EOF"],
        ["def f():\n  pass\n", "2:3: indentation must be a multiple of four spaces"],
        ["def f():\n        pass\n", "2:9: unexpected indent"],
        ["while true and not x_1 int Iterable none lambda print _\n", "while true and not NAME int Iterable none NAME NAME NAME NEWLINE EOF"],
        ["True False None\n", "NAME NAME NAME NEWLINE EOF"],
        ["elif else if\n", "NAME else if NEWLINE EOF"],
        ["9223372036854775807", "INT_LITERAL:9223372036854775807 NEWLINE EOF"],
        ["x = 9223372036854775808\n", "1:5: integer literal out of range"],
        ["x = 12345678901234567890\n", "1:5: integer literal out of range"],
        ["x = 007\n", "1:5: integer literal has leading zeros"],
        ["x = 0x1F\n", "1:5: invalid number literal '0x1F'"],
        ["x = 1_000\n", "1:5: invalid number literal '1_000'"],
        ["0.25 1e9 2.5e-3 1E+5", "FLOAT_LITERAL:0.25 FLOAT_LITERAL:1e9 FLOAT_LITERAL:2.5e-3 FLOAT_LITERAL:1E+5 NEWLINE EOF"],
        ["x = 1.\n", "1:5: invalid number literal '1.'"],
        ["x = 1.e5\n", "1:5: invalid number literal '1.e5'"],
        ["x = 1e\n", "1:5: invalid number literal '1e'"],
        ["x = 1e+\n", "1:5: invalid number literal '1e+'"],
        ["x = 1.5.2\n", "1:5: invalid number literal '1.5.2'"],
        ["x = 01.5\n", "1:5: float literal has leading zeros"],
        ["x = 1e400\n", "1:5: float literal out of range"],
        ["'\\\\ \\' \\\" \\n \\t'", "STRING_LITERAL:\\ ' \" \n \t NEWLINE EOF"],
        ["'\\x41\\u00e9\\U0001F600'", "STRING_LITERAL:Aé😀 NEWLINE EOF"],
        ["x = 'a\\qb'\n", "1:7: unknown escape sequence '\\q'"],
        ["x = '\\x4'\n", "1:6: escape '\\x' needs 2 hexadecimal digits"],
        ["x = '\\uD800'\n", "1:6: escape '\\uD800' is not a valid code point"],
        ["x = '\\U00110000'\n", "1:6: escape '\\U00110000' is not a valid code point"],
        ["x = 'ab\ncd'\n", "1:5: unterminated string literal"],
        ["x = 'ab\\\ncd'\n", "1:5: unterminated string literal"],
        ["x = 'abc", "1:5: unterminated string literal"],
        ["x = \"\"\"a\n    b\r\nc\\t\"\"\" + y\n", "NAME = STRING_LITERAL:a\n    b\nc\t + NAME NEWLINE EOF"],
        ["'''it's'''", "STRING_LITERAL:it's NEWLINE EOF"],
        ["x = \"\"\"abc\ndef\n", "1:5: unterminated string literal"],
        ["f\"a{b}c{{d}}{e[1]:>10.2f}\"", "FSTRING_START FSTRING_TEXT:a NAME FIELD_END FSTRING_TEXT:c{d} NAME [ INT_LITERAL:1 ] FIELD_END:>10.2f FSTRING_END NEWLINE EOF"],
        ["f\"{ {'k': 1}['}'] }{a != b}{t[1:3]}{a:}\"", "FSTRING_START { STRING_LITERAL:k : INT_LITERAL:1 } [ STRING_LITERAL:} ] FIELD_END NAME != NAME FIELD_END NAME [ INT_LITERAL:1 : INT_LITERAL:3 ] FIELD_END NAME FIELD_END FSTRING_END NEWLINE EOF"],
        ["f\"{f'{x}'}\"", "FSTRING_START FSTRING_START NAME FIELD_END FSTRING_END FIELD_END FSTRING_END NEWLINE EOF"],
        ["x = f\"a}b\"\n", "1:8: single '}' is not allowed in an f-string"],
        ["x = f\"{ }\"\n", "1:7: empty f-string field"],
        ["x = f\"{a\\n}\"\n", "1:9: f-string fields cannot contain a backslash"],
        ["x = f\"{a#}\"\n", "1:9: f-string fields cannot contain '#'"],
        ["x = f\"{\"a\"}\"\n", "1:8: f-string fields cannot contain the f-string's quote character"],
        ["x = f\"{'a#'}\"\n", "1:10: f-string fields cannot contain '#'"],
        ["x = f\"{a!r}\"\n", "1:9: conversions are not supported"],
        ["x = f'{a\n", "1:7: unterminated f-string field"],
        ["x = f\"\"\"{'a\nb'}\"\"\"\n", "1:10: unterminated string literal"],
        ["x = f\"{a:05}\"\n", "1:9: invalid format specification '05'"],
        ["x = f\"{a:{b}}\"\n", "1:9: invalid format specification '{b'"],
        ["x = f\"{a:.2s}\"\n", "1:9: format precision requires type 'f'"],
        ["x = f\"\"\"{a +\n b:q}\"\"\"\n", "2:3: invalid format specification 'q'"],
        ["-> == != <= >= < > = + - * / // % | ( ) [ ] { } , : .", "-> == != <= >= < > = + - * / // % | ( ) [ ] { } , : . NEWLINE EOF"],
        ["a //= b\n", "1:3: unsupported operator '//='"],
        ["a += b\n", "1:3: unsupported operator '+='"],
        ["a ~ b\n", "1:3: unsupported operator '~'"],
        ["x = @\n", "1:5: unexpected character '@'"],
        ["x = é\n", "1:5: unexpected character 'é'"],
    ]
    ok = true
    for pair in cases:
        if not check(pair[0], pair[1]):
            ok = false
    # Positions after a triple-quoted string and inside a multi-line field.
    positions = [
        [position("x = \"\"\"a\n    b\r\nc\\t\"\"\" + y\n", 3), "3:8"],
        [position("x = f\"\"\"\n{a +\n b}\"\"\"\n", 6), "3:2"],
        [position("def f():\r\n    pass\r\n", 7), "2:5"],
    ]
    for pair in positions:
        if pair[0] != pair[1]:
            print(f"FAIL position: expected {pair[1]}, actual {pair[0]}")
            ok = false
    if not ok:
        sys.exit(1)
    print("lexer tests passed")
