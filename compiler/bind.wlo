# Resolves names and types in a program's modules: each module's declarations,
# their signatures, fields, aliases, type parameters, and defaults as types.wlo
# types, the symbols of
# parameters and locals, nested functions, captures, and the
# names that expressions use, recorded in the tree as ast.wlo describes.
# Binding stops at the first error.

import ast
import diagnostic
import loader
import parser
import stdlib
import types

# The names of a lexical block, falling back to its enclosing scope.
class Scope:
    names: dict[str, ast.Symbol]
    outer: Scope | none

    def find(name: str) -> ast.Symbol | none:
        if name in self.names:
            return self.names[name]
        var outer = self.outer
        if outer is none:
            return none
        return outer.find(name)

# The type parameters in scope where types are resolved, by name. In a
# generic alias's body they are its parameters' type arguments instead, and
# `depth` counts the alias applications that enclose it.
class TypeScope:
    names: dict[str, types.Type]
    outer: TypeScope | none
    depth: int

    def find(name: str) -> types.Type | none:
        if name in self.names:
            return self.names[name]
        var outer = self.outer
        if outer is none:
            return none
        return outer.find(name)

# A library module's alias, such as json.Json.
class ProvidedAlias:
    name: str
    type_name: str
    ty: types.Type

# A library module's float constant, such as math.pi.
class ProvidedConstant:
    name: str
    value: float

# What a module-qualified name can reach.
type Member = ast.Decl | stdlib.Builtin | types.Class | ProvidedAlias | ProvidedConstant

# What a name in a type can reach.
type Named = types.Class | types.Protocol | types.Enum | AliasState | ProvidedAlias

# A program's alias as the binder resolves it. A generic alias has a type
# for each list of type arguments it is given.
class AliasState:
    decl: ast.AliasDecl
    module: ast.Module
    typevars: list[types.TypeVar]
    resolved: types.Type | none
    resolving: bool
    applications: list[Application]

class Application:
    args: list[types.Type]
    ty: types.Type | none

# A list element or dict value waiting to be resolved, in the type scope
# where it was written.
class PendingLazy:
    lazy: types.Lazy
    node: ast.TypeExpr
    module: ast.Module
    scope: TypeScope

# A union whose members are checked for overlap once method signatures are
# resolved, because a protocol member needs them.
class Overlap:
    module: ast.Module
    members: list[types.Type]
    lines: list[int]
    cols: list[int]

# A type argument whose bound is checked once the lazy types in it are
# resolved, so that `list[int]` satisfies `Iterable[int]`.
class Bound:
    module: ast.Module
    parameter: types.TypeVar
    arg: types.Type
    line: int
    col: int

type Check = Overlap | Bound

class Binder:
    modules: list[ast.Module]
    # The program's modules, and core and the library's modules, by name.
    by_name: dict[str, ast.Module]
    libraries: dict[str, ast.Module]
    entry: ast.Module
    last_id: int
    error: diagnostic.Diagnostic | none
    builtins: dict[str, stdlib.Builtin]
    # Only privileged modules may call these.
    intrinsics: dict[str, stdlib.Builtin]
    exceptions: dict[str, types.Class]
    protocols: dict[str, types.Protocol]
    provided: dict[str, stdlib.Module]
    coroutine: types.Class
    # By types.identity of the alias's type_name.
    aliases: dict[str, AliasState]
    pending: list[PendingLazy]
    # Checks that run once the declarations' method signatures and lazy
    # types are resolved.
    waiting: list[Check]

    def fail(module: ast.Module, line: int, col: int, message: str):
        if self.error is none:
            self.error = diagnostic.Diagnostic(module.path, line, col, message)

    def new_id() -> int:
        self.last_id = self.last_id + 1
        return self.last_id

    # Checks names that must be unique within a list.
    def check_unique(module: ast.Module, items: list[ast.Ident], what: str):
        var seen: dict[str, bool] = {}
        for item in items:
            if item.name in seen:
                self.fail(module, item.line, item.col, f"duplicate {what} '{item.name}'")
                return
            seen[item.name] = true

    # Declarations

    # Collects the imports and declarations of `module`, which share one
    # namespace, and reports clashes in source order. An import takes its
    # root name, which several qualified imports may share.
    def declare(module: ast.Module):
        var taken: dict[str, bool] = {}
        var imported: dict[str, bool] = {}
        for imp in module.imports:
            if not self.check_builtin_name(module, imp.root, imp.line, imp.col):
                return
            for other in imported:
                var short = other
                var long = imp.name
                if len(short) > len(long):
                    short = imp.name
                    long = other
                if long.startswith(short + "."):
                    self.fail(module, imp.line, imp.col, f"'{short}' is imported as a module and as a namespace")
                    return
            if imp.name in imported or imp.root in taken and imp.root not in module.roots:
                self.fail(module, imp.line, imp.col, f"duplicate import '{imp.name}'")
                return
            imported[imp.name] = true
            taken[imp.root] = true
            module.roots[imp.root] = true
            var target = self.imported_module(module, imp.name)
            if target is not none:
                module.imported[imp.name] = target
            else if imp.name in self.provided:
                module.provided[imp.name] = self.provided[imp.name]
        for decl in module.declarations:
            var ident = decl_ident(decl)
            if not self.check_builtin_name(module, ident.name, ident.line, ident.col):
                return
            if ident.name in taken:
                self.fail(module, ident.line, ident.col, f"duplicate {noun(decl)} '{ident.name}'")
                return
            taken[ident.name] = true
            module.names[ident.name] = decl
            var type_name = ident.name
            if module.privileged or module.name != self.entry.name:
                type_name = module.name + "." + ident.name
            set_type_name(decl, type_name)
            if not self.declare_record(module, decl, type_name):
                return

    # The module that `importer` reaches by importing `name`: the program's
    # own module of that name, except from a library module, or else the
    # library's.
    def imported_module(importer: ast.Module, name: str) -> ast.Module | none:
        if not importer.privileged and name in self.by_name:
            return self.by_name[name]
        return self.libraries.get(name)

    # Reports a declaration or import that takes a built-in name.
    def check_builtin_name(module: ast.Module, name: str, line: int, col: int) -> bool:
        if name in self.builtins:
            self.fail(module, line, col, f"cannot redefine built-in function '{name}'")
            return false
        if name in self.exceptions:
            self.fail(module, line, col, f"cannot redefine built-in class '{name}'")
            return false
        return true

    # Makes the types record of `decl`, whose type parameters, if any, get
    # their type variables now so that other declarations can name them.
    def declare_record(module: ast.Module, decl: ast.Decl, type_name: str) -> bool:
        if decl is ast.FunctionDecl:
            if decl.external and not module.privileged:
                self.fail(module, decl.line, decl.col, "extern functions are only allowed in core")
                return false
            decl.id = self.new_id()
            decl.record = types.Function(decl.id, decl.name, type_name, [], [], types.prim("none"))
        else if decl is ast.ClassDecl:
            if decl.exception and len(decl.type_params) > 0:
                var first = decl.type_params[0]
                self.fail(module, first.line, first.col, "exception classes cannot be generic")
                return false
            var native = module.privileged and not decl.exception
            for field in decl.fields:
                if not field.name.startswith("_"):
                    native = false
            decl.record = types.Class(decl.name, type_name, self.new_typevars(decl.type_params), [], [], decl.exception, native, "", module.privileged)
        else if decl is ast.ProtocolDecl:
            decl.record = types.Protocol(decl.name, type_name, self.new_typevars(decl.type_params), [], module.privileged)
        else if decl is ast.EnumDecl:
            var members: list[str] = []
            for member in decl.members:
                members.append(member.name)
            decl.record = types.Enum(decl.name, type_name, members, module.privileged)
        else:
            self.aliases[types.identity(type_name, module.privileged)] = AliasState(decl, module, [], none, false, [])
        return true

    def new_typevars(params: list[ast.TypeParam]) -> list[types.TypeVar]:
        var result: list[types.TypeVar] = []
        for param in params:
            result.append(types.TypeVar(self.new_id(), param.name, none))
        return result

    # Gives `method`, of `owner`, its id, type name, and record.
    def declare_method(method: ast.FunctionDecl, type_name: str) -> types.Function:
        method.id = self.new_id()
        method.type_name = type_name + "." + method.name
        var record = types.Function(method.id, method.name, method.type_name, [], [], types.prim("none"))
        method.record = record
        return record

    def has_module(module: ast.Module, path: str) -> bool:
        return path in module.imported or path in module.provided

    # Member `name` of the module that `module` imports as `path`. Names that
    # begin with `_` are private to their module.
    def lookup(module: ast.Module, path: str, name: str, line: int, col: int) -> Member | none:
        if path in module.imported:
            var target = module.imported[path]
            if name in target.constants:
                return ProvidedConstant(name, target.constants[name])
            if name not in target.names:
                self.fail(module, line, col, f"module '{target.name}' has no function, class, enum, or alias '{name}'")
                return none
            if name.startswith("_") and target.name != module.name:
                self.fail(module, line, col, f"'{name}' is private to module '{target.name}'")
                return none
            if target.privileged and target.name == "sys":
                # The compiler converts eprint's printable argument to text
                # and recognizes exit as a control transfer.
                if name == "eprint":
                    return stdlib.Builtin(name, [stdlib.any_arg("value")], types.prim("none"), "")
                if name == "exit":
                    return stdlib.Builtin(name, [stdlib.arg("status", types.prim("int"))], types.prim("none"), "")
            return target.names[name]
        var provided = module.provided[path]
        if name in provided.functions:
            return provided.functions[name]
        if name in provided.classes:
            return provided.classes[name]
        if name in provided.aliases:
            return ProvidedAlias(name, path + "." + name, provided.aliases[name])
        if name in provided.constants:
            return ProvidedConstant(name, provided.constants[name])
        self.fail(module, line, col, f"module '{provided.name}' has no function, class, enum, or alias '{name}'")
        return none

    # The enum that `object` names as `E` or `module.E` in `module` when no
    # name in `scope` shadows it, or none.
    def enum_named(module: ast.Module, object: ast.Expr, scope: Scope | none) -> ast.EnumDecl | none:
        var path = qualified_name(object)
        if path == "":
            return none
        var parts = path.split(".")
        var root = parts[0]
        if scope is not none and scope.find(root) is not none:
            return none
        var found: Member | none = none
        if len(parts) == 1:
            if path in module.names:
                found = module.names[path]
        else if root in module.roots:
            var prefix = ".".join(parts[:len(parts) - 1])
            if self.has_module(module, prefix):
                found = self.lookup(module, prefix, parts[len(parts) - 1], object.line, object.col)
        if found is ast.EnumDecl:
            return found
        return none

    # Makes `expr`, a Field on `decl`, an EnumMember.
    def resolve_member(module: ast.Module, expr: ast.Expr, decl: ast.EnumDecl, name: str):
        for member in decl.members:
            if member.name == name:
                expr.node = ast.EnumMember(decl, name)
                return
        self.fail(module, expr.line, expr.col, f"enum '{decl.type_name}' has no member '{name}'")

    # Types

    # The class, protocol, enum, or alias that `ref`, a name in a type, an
    # `except` clause, or `is` type tests, names. These are found through
    # file-level declarations, imports, built-in exception classes, and
    # built-in protocols, which locals never shadow.
    def resolve_named(module: ast.Module, ref: ast.TypeName) -> Named | none:
        var found: Member | none = none
        var written = ref.name
        # Whether a declaration found is the library's.
        var library = module.privileged
        if ref.module != "":
            written = ref.module + "." + ref.name
            if not self.has_module(module, ref.module):
                self.fail(module, ref.line, ref.col, f"unknown module '{ref.module}'")
                return none
            if ref.module in module.imported:
                library = module.imported[ref.module].privileged
            found = self.lookup(module, ref.module, ref.name, ref.line, ref.col)
            if found is none:
                return none
        else if ref.name in module.names:
            found = module.names[ref.name]
        else if ref.name in self.exceptions:
            found = self.exceptions[ref.name]
        else if ref.name in self.protocols:
            return self.protocols[ref.name]
        else if ref.name == "Coroutine":
            found = self.coroutine
        var named = self.as_named(found, library)
        if named is none:
            self.fail(module, ref.line, ref.col, f"unknown type '{written}'")
        return named

    def as_named(found: Member | none, library: bool) -> Named | none:
        if found is ast.ClassDecl:
            return found.record
        if found is ast.ProtocolDecl:
            return found.record
        if found is ast.EnumDecl:
            return found.record
        if found is ast.AliasDecl:
            return self.aliases[types.identity(found.type_name, library)]
        if found is types.Class:
            return found
        if found is ProvidedAlias:
            return found
        return none

    # The source text of type `node`, with declarations named by their
    # type_name, which names a lazy type.
    def type_text(node: ast.TypeExpr, module: ast.Module, scope: TypeScope) -> str:
        if node is ast.UnionType:
            var names: list[str] = []
            for member in node.members:
                var text = self.type_text(member, module, scope)
                if member is ast.CallableType:
                    text = "(" + text + ")"
                names.append(text)
            return " | ".join(names)
        if node is ast.CallableType:
            return "(" + self.type_texts(node.params, module, scope) + ") -> " + self.type_text(node.result, module, scope)
        var name = node.name
        if node.module == "":
            if name == "list":
                return "list[" + self.type_text(node.args[0], module, scope) + "]"
            if name == "dict":
                return "dict[" + self.type_texts(node.args, module, scope) + "]"
            if name == "tuple":
                return "tuple[" + self.type_texts(node.args, module, scope) + "]"
            if is_scalar(name) or module.privileged and name in ["ptr", "word"]:
                return name
            # A generic alias's body names the type arguments it was given.
            var found = scope.find(name)
            if found is not none:
                return types.display(found)
        var named = self.resolve_named(module, node)
        if named is none:
            return ""
        var type_name = named_type_name(named)
        if node.has_args and named is not types.Enum:
            return type_name + "[" + self.type_texts(node.args, module, scope) + "]"
        return type_name

    def type_texts(nodes: list[ast.TypeExpr], module: ast.Module, scope: TypeScope) -> str:
        var names: list[str] = []
        for node in nodes:
            names.append(self.type_text(node, module, scope))
        return ", ".join(names)

    # A lazy type keeps the type scope where it was written.
    def lazy(node: ast.TypeExpr, module: ast.Module, scope: TypeScope) -> types.Lazy:
        var lazy = types.Lazy(self.type_text(node, module, scope), none, str(self.new_id()))
        self.pending.append(PendingLazy(lazy, node, module, scope))
        return lazy

    # Resolves every lazy type; resolving one may queue more.
    def force_pending():
        while len(self.pending) > 0 and self.error is none:
            var item = self.pending.pop()
            item.lazy.target = self.resolve_type(item.node, item.module, item.scope, "")

    def check_overlap(overlap: Overlap):
        for i in range(1, len(overlap.members)):
            var message = types.conflict(overlap.members[:i], overlap.members[i])
            if message != "":
                self.fail(overlap.module, overlap.lines[i], overlap.cols[i], message)
                return

    def check_bound(bound: Bound):
        var message = types.unsatisfied(bound.parameter, bound.arg)
        if message != "":
            self.fail(bound.module, bound.line, bound.col, message)

    # Resolves the pending lazy types, then runs the waiting checks.
    def check_waiting():
        self.force_pending()
        var checks = self.waiting
        self.waiting = []
        for check in checks:
            if self.error is not none:
                return
            if check is Overlap:
                self.check_overlap(check)
            else:
                self.check_bound(check)

    # Puts `params`, a declaration's type parameters, in scope over `outer`,
    # making their type variables in `vars` on first use. Bounds resolve with
    # the parameters in scope.
    def enter_type_params(module: ast.Module, outer: TypeScope, params: list[ast.TypeParam], vars: list[types.TypeVar]) -> TypeScope:
        if len(params) == 0:
            return outer
        var scope = TypeScope({}, outer, 0)
        for i in range(len(params)):
            var param = params[i]
            if scope.find(param.name) is not none:
                self.fail(module, param.line, param.col, f"type parameter '{param.name}' hides another type parameter")
            if i >= len(vars):
                vars.append(types.TypeVar(self.new_id(), param.name, none))
            scope.names[param.name] = vars[i]
        for i in range(len(params)):
            var bound = params[i].bound
            if bound is not none and vars[i].bound is none and self.error is none:
                var resolved = self.resolve_type(bound, module, scope, "")
                if resolved is not types.ClassType and resolved is not types.ProtocolType:
                    self.fail(module, parser.type_line(bound), parser.type_col(bound), "a type parameter's bound must be a class, native type, or protocol")
                vars[i].bound = resolved
        return scope

    # The type generic alias `state` gives `args`. Each argument list is
    # resolved once, so a recursive use through `list` or `dict` with the
    # same arguments finds it. A recursive use with growing arguments nests
    # without end.
    def apply_alias(state: AliasState, args: list[types.Type], module: ast.Module, line: int, col: int, scope: TypeScope) -> types.Type:
        var decl = state.decl
        var application: Application
        for application_item in state.applications:
            application = application_item
            if same_args(application.args, args):
                var applied = application.ty
                if applied is none:
                    self.fail(module, line, col, f"alias '{decl.name}' expands to itself")
                    return types.prim("none")
                return applied
        var depth = scope.depth + 1
        if depth > 100:
            self.fail(module, line, col, f"alias '{decl.name}' expands without end")
            return types.prim("none")
        application = Application(args, none)
        state.applications.append(application)
        var names: dict[str, types.Type] = {}
        var arg_names: list[str] = []
        for i in range(len(decl.type_params)):
            names[decl.type_params[i].name] = args[i]
            arg_names.append(types.display(args[i]))
        var union_name = ""
        if decl.value is ast.UnionType:
            union_name = decl.type_name + "[" + ", ".join(arg_names) + "]"
        var result = self.resolve_type(decl.value, state.module, TypeScope(names, none, depth), union_name)
        application.ty = result
        return result

    # The type a non-generic alias names. A generic one is checked by
    # applying it to its own type parameters, and has no type of its own.
    def resolve_alias(state: AliasState) -> types.Type | none:
        var decl = state.decl
        if len(decl.type_params) > 0:
            if len(state.typevars) == 0:
                var root = TypeScope({}, none, 0)
                self.enter_type_params(state.module, root, decl.type_params, state.typevars)
                if self.error is none:
                    self.apply_alias(state, types.var_types(state.typevars), state.module, decl.line, decl.col, root)
            return none
        if state.resolved is none and not state.resolving:
            state.resolving = true
            var union_name = ""
            if decl.value is ast.UnionType:
                union_name = decl.type_name
            state.resolved = self.resolve_type(decl.value, state.module, TypeScope({}, none, 0), union_name)
            state.resolving = false
        return state.resolved

    # The type that `node`, written in `module`, names in `scope`. `name`
    # names a union.
    def resolve_type(node: ast.TypeExpr, module: ast.Module, scope: TypeScope, name: str) -> types.Type:
        var none_type = types.prim("none")
        if self.error is not none:
            return none_type
        if node is ast.UnionType:
            return self.resolve_union(node, module, scope, name)
        if node is ast.CallableType:
            var params: list[types.Type] = []
            for param in node.params:
                params.append(self.resolve_type(param, module, scope, ""))
            return types.CallableType(params, self.resolve_type(node.result, module, scope, ""))
        var written = node.name
        if node.module == "":
            if written == "list":
                return types.ListType(self.lazy(node.args[0], module, scope))
            if written == "dict":
                var key_node = node.args[0]
                var key = self.resolve_type(key_node, module, scope, "")
                if self.error is none and not types.is_key(key):
                    self.fail(module, parser.type_line(key_node), parser.type_col(key_node), "dictionary keys must be int, str, or an enum")
                    return none_type
                return types.DictType(key, self.lazy(node.args[1], module, scope))
            if written == "tuple":
                var elements: list[types.Type] = []
                for arg in node.args:
                    elements.append(self.resolve_type(arg, module, scope, ""))
                return types.TupleType(elements)
            if is_scalar(written):
                return types.prim(written)
            if module.privileged and written in ["ptr", "word"]:
                return types.prim(written)
            var found = scope.find(written)
            if found is not none:
                if node.has_args:
                    self.fail(module, node.line, node.col, f"type parameter '{written}' does not take type arguments")
                return found
        var named = self.resolve_named(module, node)
        if named is none:
            return none_type
        var type_name = named_type_name(named)
        var vars = named_typevars(named)
        var count = len(vars)
        if named is AliasState:
            count = len(named.decl.type_params)
        if count > 0:
            # A generic class, protocol, or alias takes all of its type
            # arguments.
            if not node.has_args:
                self.fail(module, node.line, node.col, f"type '{type_name}' needs type arguments")
                return none_type
            if len(node.args) != count:
                self.fail(module, node.line, node.col, f"'{type_name}' expects {count} {plural(count, 'type argument')}, received {len(node.args)}")
                return none_type
            var resolved: list[types.Type] = []
            for i in range(count):
                var arg = node.args[i]
                resolved.append(self.resolve_type(arg, module, scope, ""))
                if self.error is not none:
                    return none_type
                if i < len(vars) and vars[i].bound is not none:
                    self.waiting.append(Bound(module, vars[i], resolved[i], parser.type_line(arg), parser.type_col(arg)))
            if named is AliasState:
                return self.apply_alias(named, resolved, module, node.line, node.col, scope)
            if named is types.Protocol:
                return types.ProtocolType(named, resolved)
            if named is types.Class:
                return types.ClassType(named, resolved)
        if node.has_args:
            self.fail(module, node.line, node.col, f"type '{type_name}' does not take type arguments")
            return none_type
        if named is AliasState:
            if named.resolving:
                self.fail(module, node.line, node.col, f"alias '{named.decl.name}' expands to itself")
                return none_type
            var aliased = self.resolve_alias(named)
            if aliased is none:
                return none_type
            return aliased
        if named is ProvidedAlias:
            return named.ty
        if named is types.Class:
            return types.ClassType(named, [])
        if named is types.Protocol:
            return types.ProtocolType(named, [])
        return types.EnumType(named)

    def resolve_union(node: ast.UnionType, module: ast.Module, scope: TypeScope, name: str) -> types.Type:
        # A type argument substituted for a parameter flattens into the union,
        # dropping members the union already has.
        var substituted = false
        for member in node.members:
            if member is ast.TypeName and member.module == "":
                var found = scope.find(member.name)
                if found is not none and found is not types.TypeVar:
                    substituted = true
        var overlap = Overlap(module, [], [], [])
        var has_protocol = false
        for member in node.members:
            var resolved = self.resolve_type(member, module, scope, "")
            if self.error is not none:
                return types.prim("none")
            for m in types.members(resolved):
                var held = false
                if substituted:
                    for other in overlap.members:
                        if types.type_key(other) == types.type_key(m):
                            held = true
                if not held:
                    overlap.members.append(m)
                    overlap.lines.append(parser.type_line(member))
                    overlap.cols.append(parser.type_col(member))
                    if m is types.ProtocolType:
                        has_protocol = true
        if has_protocol:
            self.waiting.append(overlap)
        else:
            self.check_overlap(overlap)
        return types.named_union(overlap.members, name)

    # Resolves the parameter and result types of `function` in `outer`. A
    # method's `self` has the type of its class, which, like the method's
    # own, puts its type parameters in scope.
    def resolve_signature(module: ast.Module, function: ast.FunctionDecl, outer: TypeScope):
        var record = function.record
        if record is none:
            return
        if function.external:
            self.resolve_extern(module, function, record)
            return
        var scope = outer
        var self_type: types.Type = types.prim("none")
        var owner = function.owner
        if owner is ast.ClassDecl:
            var owner_record = owner.record
            if owner_record is not none:
                scope = self.enter_type_params(module, scope, owner.type_params, owner_record.typevars)
                self_type = types.class_self(owner_record)
        else if owner is ast.ProtocolDecl:
            var protocol_record = owner.record
            if protocol_record is not none:
                scope = self.enter_type_params(module, scope, owner.type_params, protocol_record.typevars)
                self_type = types.protocol_self(protocol_record)
        scope = self.enter_type_params(module, scope, function.type_params, record.typevars)
        var params: list[ast.Ident] = []
        for param in function.params:
            params.append(ast.Ident(param.line, param.col, param.name))
        self.check_unique(module, params, "parameter")
        for i in range(len(function.params)):
            var param = function.params[i]
            var ty: types.Type = self_type
            var annotation = param.annotation
            if owner is none or i > 0:
                if annotation is not none:
                    ty = self.resolve_type(annotation, module, scope, "")
            record.params.append(types.Param(param.name, ty, param.default, param.keyword_only))
        var result = self.resolve_type(function.return_type, module, scope, "")
        if function.is_async:
            # An async function's call produces a coroutine of its annotated
            # result.
            result = stdlib.coroutine_of(result)
        record.result = result

    # An extern function's C `int`, `cint`, is an int to its callers; the
    # emitter reads the annotation to pass it as one.
    def resolve_extern(module: ast.Module, function: ast.FunctionDecl, record: types.Function):
        var root = TypeScope({}, none, 0)
        for param in function.params:
            var annotation = param.annotation
            var ty: types.Type = types.prim("int")
            if annotation is not none and not is_cint(annotation):
                ty = self.resolve_type(annotation, module, root, "")
            record.params.append(types.Param(param.name, ty, none, false))
        record.result = types.prim("int")
        if not is_cint(function.return_type):
            record.result = self.resolve_type(function.return_type, module, root, "")

    # The type of `default`, a default in `module`, whose enum members it
    # resolves. Parameters and locals cannot shadow an enum named there.
    def default_type(module: ast.Module, default: ast.Expr) -> types.Type | none:
        var node = default.node
        if node is ast.Field:
            var decl = self.enum_named(module, node.object, none)
            if self.error is not none:
                return none
            if decl is none:
                self.fail(module, node.object.line, node.object.col, f"unknown enum '{qualified_name(node.object)}'")
                return none
            self.resolve_member(module, default, decl, node.name)
            var record = decl.record
            if record is none:
                return none
            return types.EnumType(record)
        if node is ast.TupleDisplay:
            var elements: list[types.Type] = []
            for element in node.elements:
                var element_type = self.default_type(module, element)
                if element_type is none:
                    return none
                element.ty = element_type
                elements.append(element_type)
            return types.TupleType(elements)
        if node is ast.Int:
            return types.prim("int")
        if node is ast.Float:
            return types.prim("float")
        if node is ast.String:
            return types.prim("str")
        if node is ast.Constant and node == ast.Constant.NONE:
            return types.prim("none")
        return types.prim("bool")

    # Checks that `default`, the default of a parameter or field of type
    # `ty`, fits it.
    def check_default(module: ast.Module, ty: types.Type, default: ast.Expr):
        if self.error is not none:
            return
        var given = self.default_type(module, default)
        default.ty = given
        if given is not none and not types.assignable(ty, given):
            self.fail(module, default.line, default.col, f"expected {types.display(ty)}, received {types.display(given)}")

    def check_param_defaults(module: ast.Module, function: ast.FunctionDecl):
        var record = function.record
        if record is none:
            return
        for i in range(len(function.params)):
            var default = function.params[i].default
            if default is not none and i < len(record.params):
                self.check_default(module, record.params[i].ty, default)

    # Scopes

    # Parameters are visible throughout a function; locals enter in source order.
    def resolve_function(module: ast.Module, function: ast.FunctionDecl, outer: Scope | none, type_scope: TypeScope):
        var scope = Scope({}, outer)
        var record = function.record
        for i in range(len(function.params)):
            var param = function.params[i]
            if scope.find(param.name) is not none:
                self.fail(module, param.line, param.col, f"cannot redeclare visible name '{param.name}'")
                return
            var symbol = ast.Symbol(self.new_id(), param.name, param.line, param.col, true, function)
            if record is not none and i < len(record.params):
                symbol.ty = record.params[i].ty
            param.symbol = symbol
            scope.names[param.name] = symbol
        var resolver = Resolver(self, module, function, scope, type_scope, 0)
        resolver.resolve_block(function.body, none)

# Resolves the names in one function body.
class Resolver:
    binder: Binder
    module: ast.Module
    function: ast.FunctionDecl
    scope: Scope
    type_scope: TypeScope
    # Grows with each call resolved in this function, not in nested ones.
    calls: int

    def failed() -> bool:
        return self.binder.error is not none

    def fail(line: int, col: int, message: str):
        self.binder.fail(self.module, line, col, message)

    def lookup(path: str, name: str, line: int, col: int) -> Member | none:
        return self.binder.lookup(self.module, path, name, line, col)

    def resolve_type(node: ast.TypeExpr) -> types.Type:
        var ty = self.binder.resolve_type(node, self.module, self.type_scope, "")
        if len(self.binder.waiting) > 0:
            self.binder.check_waiting()
        return ty

    def resolve_types(nodes: list[ast.TypeExpr]) -> list[types.Type]:
        var result: list[types.Type] = []
        for node in nodes:
            result.append(self.resolve_type(node))
        return result

    # The module name that `object` spells when it starts with an import's
    # root that no local shadows, or "".
    def module_path(object: ast.Expr) -> str:
        var path = qualified_name(object)
        if path == "":
            return ""
        var root = path.split(".")[0]
        if self.scope.find(root) is none and root in self.module.roots:
            return path
        return ""

    # A module that `object` names and the program imports, or "".
    def imported_path(object: ast.Expr) -> str:
        var path = self.module_path(object)
        if path != "" and self.binder.has_module(self.module, path):
            return path
        return ""

    # Makes `expr` a function value of `found`, or reports why something
    # named `name` cannot be a value.
    def declared_value(expr: ast.Expr, found: Member, name: str, qualified: bool):
        if found is ast.FunctionDecl:
            expr.node = ast.FunctionValue(found, qualified, [])
        else if found is ast.ClassDecl:
            self.fail(expr.line, expr.col, f"class '{name}' cannot be used as a value")
        else if found is types.Class:
            self.fail(expr.line, expr.col, f"class '{name}' cannot be used as a value")
        else if found is stdlib.Builtin:
            # range has a form of its own.
            if found.name == "range":
                self.fail(expr.line, expr.col, f"function '{name}' cannot be used as a value")
            else:
                expr.node = ast.BuiltinValue(found, name)
        else if found is ProvidedConstant:
            expr.node = ast.Float(found.value)
        else:
            self.fail(expr.line, expr.col, f"{member_noun(found)} '{name}' cannot be used as a value")

    # Records that `symbol`, a variable of an enclosing function, is captured
    # by this function and by each function between it and the owner.
    def capture(symbol: ast.Symbol, line: int, col: int):
        symbol.captured = true
        var function: ast.FunctionDecl | none = self.function
        while function is not none and function.id != symbol.owner.id:
            var found = false
            for capture in function.captures:
                if capture.symbol.id == symbol.id:
                    found = true
            if not found:
                function.captures.append(ast.Capture(symbol, line, col))
            function = function.parent

    def resolve_exprs(exprs: list[ast.Expr]):
        for expr in exprs:
            self.resolve_expr(expr, false)

    def resolve_args(args: list[ast.Expr], keywords: list[ast.Keyword]):
        self.resolve_exprs(args)
        for keyword in keywords:
            self.resolve_expr(keyword.value, false)

    # Resolves `expr`, which is a call's callee when `callee`.
    def resolve_expr(expr: ast.Expr, callee: bool):
        if self.failed():
            return
        var node = expr.node
        if node is ast.Call or node is ast.CallValue or node is ast.MethodCall:
            self.calls = self.calls + 1
        if node is ast.Name:
            self.resolve_name(expr, node, callee)
        else if node is ast.Call:
            self.resolve_call(expr, node)
        else if node is ast.SpecializedCall:
            self.resolve_specialized_call(expr, node)
        else if node is ast.Specialized:
            self.resolve_specialized(expr, node)
        else if node is ast.Lambda:
            # A lambda is a nested function whose body returns its expression.
            var params: list[ast.Ident] = []
            for param in node.params:
                params.append(ast.Ident(param.line, param.col, param.name))
            self.binder.check_unique(self.module, params, "parameter")
            # The checker infers its result from the expression body.
            var result = ast.TypeName(expr.line, expr.col, "none", "", [], false)
            var body = [ast.Stmt(expr.line, expr.col, ast.Return(node.body))]
            var function = ast.FunctionDecl(expr.line, expr.col, "<lambda>", [], node.params, result, body, false, [], [])
            function.id = self.binder.new_id()
            function.parent = self.function
            function.type_name = self.function.type_name + ".<lambda>"
            node.function = function
            self.binder.resolve_function(self.module, function, self.scope, self.type_scope)
            if self.failed():
                return
            for param in function.params:
                var annotation = param.annotation
                var symbol = param.symbol
                assert symbol is not none, "lambda parameter without a symbol"
                if annotation is not none:
                    symbol.ty = self.resolve_type(annotation)
        else if node is ast.CallValue:
            self.resolve_expr(node.callee, true)
            self.resolve_args(node.args, node.keywords)
        else if node is ast.MethodCall:
            self.resolve_method_call(expr, node)
        else if node is ast.Unary:
            self.resolve_expr(node.operand, false)
        else if node is ast.Is:
            self.resolve_expr(node.operand, false)
        else if node is ast.TypeTest:
            self.resolve_type_test(expr, node)
        else if node is ast.Binary:
            self.resolve_expr(node.left, false)
            self.resolve_expr(node.right, false)
        else if node is ast.Index:
            self.resolve_expr(node.object, false)
            self.resolve_expr(node.index, false)
        else if node is ast.Slice:
            self.resolve_expr(node.object, false)
            var start = node.start
            if start is not none:
                self.resolve_expr(start, false)
            var stop = node.stop
            if stop is not none:
                self.resolve_expr(stop, false)
        else if node is ast.Await:
            if not self.function.is_async:
                self.fail(expr.line, expr.col, "'await' is only allowed in an async function")
                return
            # An await may suspend the body, letting other code run, like a
            # call.
            self.resolve_expr(node.operand, false)
            self.calls = self.calls + 1
        else if node is ast.Field:
            var enum_decl = self.binder.enum_named(self.module, node.object, self.scope)
            var path = self.imported_path(node.object)
            if self.failed():
                return
            if enum_decl is not none:
                self.binder.resolve_member(self.module, expr, enum_decl, node.name)
            else if path != "":
                var member = self.lookup(path, node.name, expr.line, expr.col)
                if member is not none:
                    self.declared_value(expr, member, path + "." + node.name, true)
            else:
                self.resolve_expr(node.object, false)
        else if node is ast.FString:
            self.resolve_exprs(node.parts)
        else if node is ast.ListDisplay:
            self.resolve_exprs(node.elements)
        else if node is ast.TupleDisplay:
            self.resolve_exprs(node.elements)
        else if node is ast.DictDisplay:
            for i in range(len(node.keys)):
                self.resolve_expr(node.keys[i], false)
                self.resolve_expr(node.values[i], false)
        else if node is ast.TypeOf:
            # Only privileged modules may name a built-in type's descriptor.
            if not self.module.privileged:
                self.fail(expr.line, expr.col, "intrinsic '__type' is only available in core")
                return
            var target = node.target
            if target is not ast.TypeName or target.module != "" or target.name not in ["int", "float", "bool", "str", "bytes", "list", "dict", "tuple"]:
                self.fail(parser.type_line(target), parser.type_col(target), "'__type' takes int, float, bool, str, bytes, list, dict, or tuple")

    def resolve_name(expr: ast.Expr, node: ast.Name, callee: bool):
        var symbol = self.scope.find(node.name)
        if node.name == "self" and symbol is none:
            self.fail(expr.line, expr.col, "'self' is only available inside methods")
            return
        if symbol is none:
            if node.name in self.module.names:
                self.declared_value(expr, self.module.names[node.name], node.name, false)
                return
            if node.name in self.binder.builtins:
                self.declared_value(expr, self.binder.builtins[node.name], node.name, false)
                return
        if symbol is none:
            if node.name == "__os" and self.module.privileged:
                # The target's name, which the checker and emitter fold.
                return
            if node.name in self.module.roots:
                self.fail(expr.line, expr.col, f"module '{node.name}' cannot be used as a value")
            else if node.name in self.binder.exceptions:
                self.fail(expr.line, expr.col, f"class '{node.name}' cannot be used as a value")
            else:
                self.fail(expr.line, expr.col, f"unknown name '{node.name}'")
            return
        node.symbol = symbol
        # A generic nested function is a value of its specialization.
        var function = symbol.function
        if function is not none and is_generic(function) and not callee:
            expr.node = ast.FunctionValue(function, false, [], symbol)
        if symbol.owner.id != self.function.id:
            self.capture(symbol, expr.line, expr.col)

    def resolve_call(expr: ast.Expr, node: ast.Call):
        if self.scope.find(node.name) is not none:
            # A local hides a declaration of the same name, so this calls its
            # value.
            var name = ast.Expr(expr.line, expr.col, ast.Name(node.name, false))
            expr.node = ast.CallValue(name, node.args, node.keywords, node.type_args)
            self.resolve_expr(expr, false)
            return
        if node.target is none:
            var found: Member | none = none
            if node.name in self.module.names:
                found = self.module.names[node.name]
            else if node.name in self.binder.builtins:
                found = self.binder.builtins[node.name]
            else if node.name in self.binder.exceptions:
                found = self.binder.exceptions[node.name]
            else if node.name in self.binder.intrinsics:
                if not self.module.privileged:
                    self.fail(expr.line, expr.col, f"intrinsic '{node.name}' is only available in core")
                    return
                found = self.binder.intrinsics[node.name]
            if found is none:
                self.fail(expr.line, expr.col, f"unknown function '{node.name}'")
                return
            if cannot_call(found):
                self.fail(expr.line, expr.col, f"{member_noun(found)} '{node.name}' cannot be called")
                return
            node.target = call_target(found)
        self.resolve_args(node.args, node.keywords)

    def resolve_specialized_call(expr: ast.Expr, node: ast.SpecializedCall):
        var callee = node.callee.node
        var name = ""
        var symbol: ast.Symbol | none = none
        var found: Member | none = none
        if callee is ast.Name:
            name = callee.name
            symbol = self.scope.find(name)
            if symbol is none:
                if name in self.module.names:
                    found = self.module.names[name]
                else if name in self.binder.builtins:
                    found = self.binder.builtins[name]
        else if callee is ast.Field:
            var path = self.imported_path(callee.object)
            if path != "":
                name = path + "." + callee.name
                found = self.lookup(path, callee.name, node.callee.line, node.callee.col)
                if found is none:
                    return
        if callee is ast.Field and found is none and self.imported_path(callee.object) == "":
            var indexed = node.index
            var value_index = false
            if indexed is not none:
                var index_node = indexed.node
                assert index_node is ast.Index, "specialized call without an index"
                value_index = self.value_index(index_node.index)
            if not value_index:
                var type_args = self.resolve_types(node.type_args)
                expr.node = ast.MethodCall(callee.object, callee.name, node.args, node.keywords, none, type_args, node.index, node.index_error)
                self.resolve_expr(expr, false)
                return
        var generic = is_generic_member(found)
        if symbol is not none:
            var function = symbol.function
            generic = function is not none and is_generic(function)
        if generic:
            var type_args = self.resolve_types(node.type_args)
            if self.failed():
                return
            if symbol is not none:
                expr.node = ast.CallValue(node.callee, node.args, node.keywords, type_args)
            else if found is ast.FunctionDecl:
                expr.node = ast.Call(name, node.args, node.keywords, type_args, found, none, true)
            else if found is ast.ClassDecl:
                expr.node = ast.Call(name, node.args, node.keywords, type_args, found.record, none, true)
        else:
            # An index followed by a call, as in `handlers[i](x)`.
            if found is not none:
                self.fail(node.callee.line, node.callee.col, f"'{name}' is not generic")
                return
            var index = node.index
            if index is none:
                self.raise_error(node.index_error)
                return
            expr.node = ast.CallValue(index, node.args, node.keywords, [])
        self.resolve_expr(expr, false)

    def value_index(expr: ast.Expr) -> bool:
        var node = expr.node
        if node is ast.Name:
            return self.type_scope.find(node.name) is none and self.scope.find(node.name) is not none
        if node is ast.Field:
            var path = qualified_name(node.object)
            if path != "" and self.scope.find(path.split(".")[0]) is not none:
                return true
            return self.binder.enum_named(self.module, node.object, self.scope) is not none
        if node is ast.TupleDisplay:
            for element in node.elements:
                if self.value_index(element):
                    return true
        return false

    # A generic function specialized as a value, or else an index.
    def resolve_specialized(expr: ast.Expr, node: ast.Specialized):
        var callee = node.callee.node
        var symbol: ast.Symbol | none = none
        var found: Member | none = none
        if callee is ast.Name:
            symbol = self.scope.find(callee.name)
            if symbol is not none:
                found = symbol.function
            else if callee.name in self.module.names:
                found = self.module.names[callee.name]
        else if callee is ast.Field:
            var path = self.imported_path(callee.object)
            if path != "":
                found = self.lookup(path, callee.name, node.callee.line, node.callee.col)
                if found is none:
                    return
        if found is ast.FunctionDecl and is_generic(found):
            if symbol is not none:
                self.resolve_expr(node.callee, false)
            var type_args = self.resolve_types(node.type_args)
            expr.node = ast.FunctionValue(found, (callee is ast.Field), type_args, symbol)
            return
        var index = node.index
        if index is none:
            self.raise_error(node.index_error)
            return
        expr.line = index.line
        expr.col = index.col
        expr.node = index.node
        self.resolve_expr(expr, false)

    # Reports `error`, an error the parser kept for a later pass.
    def raise_error(error: diagnostic.Diagnostic | none):
        if error is not none and self.binder.error is none:
            self.binder.error = error

    def resolve_method_call(expr: ast.Expr, node: ast.MethodCall):
        var decl = self.binder.enum_named(self.module, node.object, self.scope)
        if self.failed():
            return
        var receiver = node.object.node
        var path = self.module_path(node.object)
        if decl is not none:
            self.fail(expr.line, expr.col, f"enum '{decl.type_name}' has no method '{node.name}'")
        else if receiver is ast.Name and receiver.reserved and receiver.name == "bytes":
            # `bytes.fromhex(...)` is the only static method of a type.
            if node.name != "fromhex":
                self.fail(expr.line, expr.col, f"type 'bytes' has no static method '{node.name}'")
                return
            expr.node = ast.Call("bytes.fromhex", node.args, node.keywords, [], self.binder.builtins["bytes.fromhex"])
            self.resolve_args(node.args, node.keywords)
        else if path != "":
            # `module.name(...)` calls a function or constructs a class of
            # that module.
            if not self.binder.has_module(self.module, path):
                self.fail(node.object.line, node.object.col, f"unknown module '{path}'")
                return
            var found = self.lookup(path, node.name, expr.line, expr.col)
            if found is none:
                return
            var name = path + "." + node.name
            if cannot_call(found):
                self.fail(expr.line, expr.col, f"{member_noun(found)} '{name}' cannot be called")
                return
            expr.node = ast.Call(name, node.args, node.keywords, [], call_target(found))
            self.resolve_args(node.args, node.keywords)
        else:
            self.resolve_expr(node.object, false)
            self.resolve_args(node.args, node.keywords)

    def resolve_type_test(expr: ast.Expr, node: ast.TypeTest):
        self.resolve_expr(node.operand, false)
        var ref = node.type_name
        if ref.module == "" and self.type_scope.find(ref.name) is not none:
            self.fail(ref.line, ref.col, f"type parameter '{ref.name}' cannot be used in a type test")
            return
        if ref.module == "" and is_builtin_type(ref.name):
            ref.coverage = [types.prim(ref.name)]
            return
        # A final enum member is a value, rather than a type name.
        if ref.module != "":
            var parts = ref.module.split(".")
            var owner = ast.TypeName(ref.line, ref.col, parts[-1], ".".join(parts[:-1]), [], false)
            var found: Member | none = none
            if owner.module == "" and owner.name in self.module.names:
                found = self.module.names[owner.name]
            else if self.binder.has_module(self.module, owner.module):
                found = self.binder.lookup(self.module, owner.module, owner.name, owner.line, owner.col)
            if found is ast.EnumDecl:
                self.fail(ref.line, ref.col, "an enum member cannot be used in a type test; use '=='")
                return
        var named = self.binder.resolve_named(self.module, ref)
        if named is types.Class:
            ref.record = named
            ref.coverage = [types.ClassType(named, [])]
        else if named is types.Enum:
            ref.record = named
            ref.coverage = [types.EnumType(named)]
        else if named is AliasState:
            var resolved = self.binder.resolve_alias(named)
            if len(named.decl.type_params) > 0:
                resolved = self.binder.apply_alias(named, types.var_types(named.typevars), self.module, ref.line, ref.col, self.type_scope)
            if resolved is not none:
                ref.coverage = types.members(resolved)
        else if named is ProvidedAlias:
            ref.coverage = types.members(named.ty)
        else if named is types.Protocol:
            self.fail(ref.line, ref.col, f"protocol '{ref.name}' cannot be used in a type test")
            return
        var coverage = ref.coverage
        if coverage is none:
            return
        for member in coverage:
            if types.is_open(member):
                self.fail(ref.line, ref.col, f"open alias '{ref.name}' cannot be used in a type test")

    def declare(name: str, line: int, col: int) -> ast.Symbol:
        var symbol = ast.Symbol(self.binder.new_id(), name, line, col, false, self.function)
        if self.scope.find(name) is not none:
            self.fail(line, col, f"cannot redeclare visible name '{name}'")
            return symbol
        self.scope.names[name] = symbol
        self.function.locals.append(symbol)
        return symbol

    def declare_target(target: ast.Target):
        if target.name != "":
            target.symbol = self.declare(target.name, target.line, target.col)
            return
        for element in target.elements:
            self.declare_target(element)

    def resolve_target(target: ast.Target):
        if target.name != "":
            var symbol = self.scope.find(target.name)
            if symbol is none:
                self.fail(target.line, target.col, f"unknown variable '{target.name}'; use 'var' to declare it")
            else if symbol.function is not none:
                self.fail(target.line, target.col, f"cannot assign to nested function '{target.name}'")
            else if symbol.owner.id != self.function.id:
                self.capture(symbol, target.line, target.col)
            target.symbol = symbol
            return
        for element in target.elements:
            self.resolve_target(element)

    def resolve_block(body: list[ast.Stmt], handling: ast.Try | none):
        var outer = self.scope
        self.scope = Scope({}, outer)
        for statement in body:
            if self.failed():
                break
            self.resolve_stmt(statement, handling)
        self.scope = outer

    def resolve_stmt(statement: ast.Stmt, handling: ast.Try | none):
        var node = statement.node
        if (node is ast.Var):
            var annotation = node.annotation
            if annotation is not none:
                node.declared = self.resolve_type(annotation)
            var value = node.value
            if value is not none:
                self.resolve_expr(value, false)
            self.declare_target(node.target)
        else if (node is ast.Unpack):
            self.resolve_expr(node.value, false)
            self.resolve_target(node.target)
        else if node is ast.Assign:
            self.resolve_expr(node.value, false)
            var assigned_target = ast.Target(statement.line, statement.col, node.name, [])
            self.resolve_target(assigned_target)
            node.symbol = assigned_target.symbol
        else if (node is ast.FunctionDef):
            self.resolve_nested(node)
        else if node is ast.FieldAssign:
            self.resolve_expr(node.value, false)
            var enum_decl = self.binder.enum_named(self.module, node.object, self.scope)
            if enum_decl is not none:
                self.fail(statement.line, statement.col, f"cannot assign to a member of enum '{enum_decl.type_name}'")
                return
            self.resolve_expr(node.object, false)
        else if node is ast.IndexAssign:
            self.resolve_expr(node.value, false)
            self.resolve_expr(node.object, false)
            self.resolve_expr(node.index, false)
        else if node is ast.CallStmt:
            self.resolve_expr(node.call, false)
        else if node is ast.Return:
            var value = node.value
            if value is not none:
                self.resolve_expr(value, false)
        else if node is ast.If:
            self.resolve_expr(node.condition, false)
            self.resolve_block(node.body, handling)
            self.resolve_block(node.else_body, handling)
        else if node is ast.While:
            var before = self.calls
            self.resolve_expr(node.condition, false)
            self.resolve_block(node.body, handling)
            node.calls = self.calls != before
        else if node is ast.For:
            self.resolve_expr(node.iterable, false)
            var outer = self.scope
            self.scope = Scope({}, outer)
            self.declare_target(node.target)
            var before = self.calls
            self.resolve_block(node.body, handling)
            node.calls = self.calls != before
            self.scope = outer
        else if (node is ast.Assert):
            self.resolve_expr(node.condition, false)
            var message = node.message
            if message is not none:
                self.resolve_expr(message, false)
        else if node is ast.Yield:
            if self.function.is_async:
                self.fail(statement.line, statement.col, "'yield' cannot be used in an async function")
                return
            # A yield suspends the body, letting other code run, like a call.
            self.resolve_expr(node.value, false)
            self.function.generator = true
            self.calls = self.calls + 1
        else if node is ast.Raise:
            var raised = node.value
            if raised is not none:
                self.resolve_expr(raised, false)
            else if handling is none:
                self.fail(statement.line, statement.col, "bare 'raise' is only allowed in an 'except' clause")
                return
            node.handler = handling
        else if (node is ast.With):
            var outer = self.scope
            self.scope = Scope({}, outer)
            # Entering and exiting call the managers' methods.
            for item in node.items:
                self.resolve_expr(item.manager, false)
                var target = item.target
                if target is not none:
                    self.declare_target(target)
                self.calls = self.calls + 2
            self.resolve_block(node.body, handling)
            self.scope = outer
        else if (node is ast.AsyncWith):
            if not self.function.is_async:
                self.fail(statement.line, statement.col, "'async with' is only allowed in an async function")
                return
            self.resolve_expr(node.manager, false)
            var outer = self.scope
            self.scope = Scope({}, outer)
            var scope_target = node.target
            if scope_target is not none:
                self.declare_target(scope_target)
            # The join lets other code run.
            self.calls = self.calls + 1
            self.resolve_block(node.body, handling)
            self.scope = outer
        else if (node is ast.Try):
            self.resolve_block(node.body, handling)
            for handler in node.handlers:
                var named = self.binder.resolve_named(self.module, handler.type_name)
                if named is none:
                    return
                if named is not types.Class or not named.exception:
                    self.fail(handler.type_name.line, handler.type_name.col, f"'{named_name(named)}' is not an exception class")
                    return
                handler.type_name.record = named
                var outer = self.scope
                self.scope = Scope({}, outer)
                if handler.name != "":
                    handler.symbol = self.declare(handler.name, handler.line, handler.col)
                self.resolve_block(handler.body, node)
                self.scope = outer
            self.resolve_block(node.finally_body, handling)

    # A nested function's signature resolves where it is defined, with the
    # enclosing type parameters in scope, before its body.
    def resolve_nested(node: ast.FunctionDef):
        var nested = node.function
        nested.id = self.binder.new_id()
        nested.parent = self.function
        nested.type_name = self.function.type_name + "." + nested.name
        var record = types.Function(nested.id, nested.name, nested.type_name, [], [], types.prim("none"))
        nested.record = record
        self.binder.resolve_signature(self.module, nested, self.type_scope)
        self.binder.check_waiting()
        self.binder.check_param_defaults(self.module, nested)
        if self.failed():
            return
        var symbol = self.declare(nested.name, nested.line, nested.col)
        symbol.function = nested
        node.symbol = symbol
        var type_scope = self.binder.enter_type_params(self.module, self.type_scope, nested.type_params, record.typevars)
        self.binder.resolve_function(self.module, nested, self.scope, type_scope)

# Binds the modules of `sources`, the entry first, and returns the first
# error, if any. A test entry (`test`) needs no `main`; instead its `tests`
# lists its `test_*` functions by name.
def bind(sources: list[loader.Source], test: bool) -> diagnostic.Diagnostic | none:
    var modules: list[ast.Module] = []
    var by_name: dict[str, ast.Module] = {}
    var libraries: dict[str, ast.Module] = {}
    for source in sources:
        source.tree.name = source.name
        modules.append(source.tree)
        if source.tree.privileged:
            libraries[source.name] = source.tree
        else:
            by_name[source.name] = source.tree
    var binder = Binder(modules, by_name, libraries, modules[0], 0, none, stdlib.builtins(), stdlib.intrinsics(), stdlib.exceptions(), stdlib.protocols(), stdlib.modules(), stdlib.coroutine(), {}, [], [])
    for module in modules:
        binder.declare(module)
        if binder.error is not none:
            return binder.error
    for module in modules:
        for decl in module.declarations:
            if decl is ast.EnumDecl:
                binder.check_unique(module, decl.members, "enum member")
    for module in modules:
        for decl in module.declarations:
            if decl is ast.AliasDecl and binder.error is none:
                binder.resolve_alias(binder.aliases[types.identity(decl.type_name, module.privileged)])
    for module in modules:
        if binder.error is none:
            resolve_declarations(binder, module)
    binder.check_waiting()
    for module in modules:
        if binder.error is none:
            check_defaults(binder, module)
    if binder.error is not none:
        return binder.error
    if test:
        check_tests(binder, modules[0])
    else:
        check_main(binder, modules[0])
    var root = TypeScope({}, none, 0)
    for module in modules:
        for function in functions(module):
            if binder.error is not none:
                return binder.error
            var scope = root
            var owner = function.owner
            if owner is ast.ClassDecl:
                var owner_record = owner.record
                if owner_record is not none:
                    scope = binder.enter_type_params(module, scope, owner.type_params, owner_record.typevars)
            var record = function.record
            if record is not none:
                scope = binder.enter_type_params(module, scope, function.type_params, record.typevars)
            binder.resolve_function(module, function, none, scope)
    binder.check_waiting()
    return binder.error

# The types the binder gave the functions, methods, and class fields of
# `module`, one per line.
def signatures(module: ast.Module) -> list[str]:
    var lines: list[str] = []
    for function in functions(module):
        var record = function.record
        if record is not none:
            var params: list[str] = []
            for param in record.params:
                if param.name != "self":
                    params.append(param.name + ": " + types.display(param.ty))
            lines.append(f"def {record.type_name}({', '.join(params)}) -> {types.display(record.result)}")
    for decl in module.declarations:
        if decl is ast.ClassDecl:
            var class_record = decl.record
            if class_record is not none:
                for field in class_record.fields:
                    lines.append(f"field {class_record.type_name}.{field.name}: {types.display(field.ty)}")
    return lines

# The fields and signatures of classes and protocols, and functions'
# signatures, in declaration order.
def resolve_declarations(binder: Binder, module: ast.Module):
    var root = TypeScope({}, none, 0)
    for decl in module.declarations:
        var record = decl_class_record(decl)
        if decl is ast.ClassDecl and record is not none:
            var fields: list[ast.Ident] = []
            for field in decl.fields:
                fields.append(ast.Ident(field.line, field.col, field.name))
            binder.check_unique(module, fields, "field")
            binder.check_unique(module, idents(decl.methods), "method")
            var scope = binder.enter_type_params(module, root, decl.type_params, record.typevars)
            for field in decl.fields:
                record.fields.append(types.Field(field.name, binder.resolve_type(field.annotation, module, scope, ""), field.default))
            for method in decl.methods:
                for field in decl.fields:
                    if field.name == method.name:
                        binder.fail(module, method.line, method.col, f"method '{method.name}' has the same name as a field")
                method.owner = decl
                record.methods.append(binder.declare_method(method, decl.type_name))
                binder.resolve_signature(module, method, root)
    for decl in module.declarations:
        if decl is ast.ProtocolDecl:
            var protocol_record = decl.record
            if protocol_record is not none:
                binder.check_unique(module, idents(decl.methods), "method")
                binder.enter_type_params(module, root, decl.type_params, protocol_record.typevars)
                for method in decl.methods:
                    method.owner = decl
                    protocol_record.methods.append(binder.declare_method(method, decl.type_name))
                    binder.resolve_signature(module, method, root)
    for decl in module.declarations:
        if decl is ast.FunctionDecl:
            binder.resolve_signature(module, decl, root)

def decl_class_record(decl: ast.Decl) -> types.Class | none:
    if decl is ast.ClassDecl:
        return decl.record
    return none

def check_defaults(binder: Binder, module: ast.Module):
    for decl in module.declarations:
        if decl is ast.ClassDecl:
            var record = decl.record
            if record is not none:
                for i in range(len(decl.fields)):
                    var default = decl.fields[i].default
                    if default is not none:
                        binder.check_default(module, record.fields[i].ty, default)
    for function in functions(module):
        binder.check_param_defaults(module, function)
    for decl in module.declarations:
        if decl is ast.ProtocolDecl:
            for method in decl.methods:
                binder.check_param_defaults(module, method)

def check_main(binder: Binder, entry: ast.Module):
    var main: ast.Decl | none = none
    if "main" in entry.names:
        main = entry.names["main"]
    if main is not ast.FunctionDecl:
        binder.fail(entry, 1, 1, "program has no main function")
        return
    if len(main.params) > 0 or not returns_none(main):
        binder.fail(entry, main.line, main.col, "main must take no parameters and return none")

# A test entry's tests are its functions whose names begin with `test_`, in
# order of name.
def check_tests(binder: Binder, entry: ast.Module):
    for decl in entry.declarations:
        if decl is ast.FunctionDecl and decl.name.startswith("test_"):
            if len(decl.params) > 0 or not returns_none(decl):
                binder.fail(entry, decl.line, decl.col, f"test function '{decl.name}' must take no parameters and return none")
                return
            var i = len(entry.tests)
            entry.tests.append(decl)
            while i > 0 and entry.tests[i - 1].name > decl.name:
                entry.tests[i] = entry.tests[i - 1]
                i = i - 1
            entry.tests[i] = decl

# Whether the result of `function`, or of an async function's coroutine, is
# none.
def returns_none(function: ast.FunctionDecl) -> bool:
    var record = function.record
    if record is none:
        return false
    var result = record.result
    if function.is_async and result is types.ClassType and len(result.args) == 1:
        result = result.args[0]
    return result is types.Prim and result.name == "none"

# The functions of `module` that have bodies, followed by the methods of its
# classes.
def functions(module: ast.Module) -> list[ast.FunctionDecl]:
    var result: list[ast.FunctionDecl] = []
    for decl in module.declarations:
        if decl is ast.FunctionDecl and not decl.external:
            result.append(decl)
    for decl in module.declarations:
        if decl is ast.ClassDecl:
            result.extend(decl.methods)
    return result

def idents(functions: list[ast.FunctionDecl]) -> list[ast.Ident]:
    var result: list[ast.Ident] = []
    for function in functions:
        result.append(ast.Ident(function.line, function.col, function.name))
    return result

def decl_ident(decl: ast.Decl) -> ast.Ident:
    if decl is ast.FunctionDecl:
        return ast.Ident(decl.line, decl.col, decl.name)
    if decl is ast.ClassDecl:
        return ast.Ident(decl.line, decl.col, decl.name)
    if decl is ast.ProtocolDecl:
        return ast.Ident(decl.line, decl.col, decl.name)
    if decl is ast.EnumDecl:
        return ast.Ident(decl.line, decl.col, decl.name)
    return ast.Ident(decl.line, decl.col, decl.name)

def set_type_name(decl: ast.Decl, name: str):
    if decl is ast.FunctionDecl:
        decl.type_name = name
    else if decl is ast.ClassDecl:
        decl.type_name = name
    else if decl is ast.ProtocolDecl:
        decl.type_name = name
    else if decl is ast.EnumDecl:
        decl.type_name = name
    else:
        decl.type_name = name

# How errors name the kind of `decl`.
def noun(decl: ast.Decl) -> str:
    if decl is ast.FunctionDecl:
        return "function"
    if decl is ast.ClassDecl:
        return "class"
    if decl is ast.ProtocolDecl:
        return "protocol"
    if decl is ast.EnumDecl:
        return "enum"
    return "alias"

def member_noun(found: Member) -> str:
    if found is ast.FunctionDecl:
        return noun(found)
    if found is ast.ClassDecl:
        return noun(found)
    if found is ast.ProtocolDecl:
        return noun(found)
    if found is ast.EnumDecl:
        return noun(found)
    if found is ast.AliasDecl:
        return noun(found)
    if found is stdlib.Builtin:
        return "function"
    if found is types.Class:
        return "class"
    if found is ProvidedAlias:
        return "alias"
    return "constant"

# The declarations that name no function or class to call.
def cannot_call(found: Member) -> bool:
    return found is ast.AliasDecl or found is ast.EnumDecl or found is ast.ProtocolDecl or found is ProvidedAlias or found is ProvidedConstant

# What a call of `found`, which can be called, reaches.
def call_target(found: Member) -> ast.FunctionDecl | stdlib.Builtin | types.Class | none:
    if found is ast.FunctionDecl:
        return found
    if found is ast.ClassDecl:
        return found.record
    if found is stdlib.Builtin:
        return found
    if found is types.Class:
        return found
    return none

def named_type_name(named: Named) -> str:
    if named is types.Class:
        return named.type_name
    if named is types.Protocol:
        return named.type_name
    if named is types.Enum:
        return named.type_name
    if named is AliasState:
        return named.decl.type_name
    return named.type_name

def named_name(named: Named) -> str:
    if named is types.Class:
        return named.name
    if named is types.Protocol:
        return named.name
    if named is types.Enum:
        return named.name
    if named is AliasState:
        return named.decl.name
    return named.name

def named_typevars(named: Named) -> list[types.TypeVar]:
    if named is types.Class:
        return named.typevars
    if named is types.Protocol:
        return named.typevars
    if named is AliasState:
        return named.typevars
    return []

def plural(count: int, noun: str) -> str:
    if count == 1:
        return noun
    return noun + "s"

def is_generic(function: ast.FunctionDecl) -> bool:
    return len(function.type_params) > 0

def is_generic_member(found: Member | none) -> bool:
    if found is ast.FunctionDecl:
        return len(found.type_params) > 0
    if found is ast.ClassDecl:
        return len(found.type_params) > 0
    return false

def is_cint(node: ast.TypeExpr) -> bool:
    return node is ast.TypeName and node.module == "" and node.name == "cint"

def is_scalar(name: str) -> bool:
    return name in ["int", "float", "bool", "str", "bytes", "none"]

# The type names that type tests take without a declaration.
def is_builtin_type(name: str) -> bool:
    return is_scalar(name) or name in ["list", "dict", "tuple"]

# The dotted name that `expr` spells, a Name or Fields on one, or "".
def qualified_name(expr: ast.Expr) -> str:
    var node = expr.node
    if node is ast.Name:
        return node.name
    if node is ast.Field:
        var path = qualified_name(node.object)
        if path == "":
            return ""
        return path + "." + node.name
    return ""

# Whether two lists of type arguments are the same, as far as reusing a
# generic alias's specialization goes: types compare by structure and lazy
# types by their ids.
def same_args(a: list[types.Type], b: list[types.Type]) -> bool:
    if len(a) != len(b):
        return false
    for i in range(len(a)):
        if types.type_key(a[i]) != types.type_key(b[i]):
            return false
    return true
