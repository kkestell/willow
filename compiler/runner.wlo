# The test command's discovery and runs (spec §12), the counterpart of
# compiler/runner.lua: finds test files, and runs each test of a built test
# program in its own process.

import fs
import io
import subprocess

# The test files at `path`, sorted: the `test_*.wlo` files inside a
# directory, directly or, when `recursive`, at any depth without following
# symlinks to directories; or the path itself.
def discover(path: str, recursive: bool) -> list[str]:
    if not is_directory(path):
        return [path]
    shown = ""
    if path != ".":
        shown = path
        while shown.endswith("/"):
            shown = shown[:-1]
        shown = shown + "/"
    files: list[str] = []
    collect(path, shown, recursive, files)
    return sorted(files)

def is_directory(path: str) -> bool:
    try:
        return fs.stat(path).kind == "directory"
    except OSError:
        return False

# Adds the test files in `directory`, written as `shown` and a name, to
# `files`.
def collect(directory: str, shown: str, recursive: bool, files: list[str]):
    for name in fs.listdir(directory):
        kind = fs.stat(directory + "/" + name, follow_symlinks=False).kind
        if kind == "directory" and recursive:
            collect(directory + "/" + name, shown + name + "/", True, files)
        elif kind == "file" and len(name) >= 9 and name.startswith("test_") and name.endswith(".wlo"):
            files.append(shown + name)

# How many tests passed and failed.
class Tally:
    passed: int
    failed: int

# Runs each test in `names` of the test program at `program`, built from the
# test file `file`, with the environment `env`, and reports it. Files that
# the runs need go in `directory`.
def run_file(program: str, file: str, names: list[str], env: dict[str, str], directory: str, tally: Tally):
    marker = directory + "/returned"
    for name in names:
        returned, status, output = run_test(program, name, marker, env, directory)
        if returned and status == 0:
            tally.passed = tally.passed + 1
            print(f"PASS {file} {name}")
            continue
        tally.failed = tally.failed + 1
        print(f"FAIL {file} {name}")
        if output != "" and not output.endswith("\n"):
            output = output + "\n"
        for line in output.split("\n")[:-1]:
            if line == "":
                print("")
            else:
                print("  " + line)
        if returned:
            print(f"  exit status {status}")
        else:
            print(f"  test did not return (exit status {status})")

# Runs test `name` of the program at `program` with no arguments and empty
# stdin. Returns whether it returned normally, which the program shows by
# creating `marker`, its exit status as a shell gives it, and its stdout and
# stderr together.
def run_test(program: str, name: str, marker: str, env: dict[str, str], directory: str) -> tuple[bool, int, str]:
    path = directory + "/output"
    output = io.open(path, "w")
    empty = io.open("/dev/null")
    process = subprocess.spawn([program, name, marker], env=env, stdin=empty, stdout=output, stderr=output)
    status = process.wait()
    output.close()
    empty.close()
    if status < 0:
        status = 128 - status
    returned = fs.exists(marker)
    if returned:
        fs.remove(marker)
    return (returned, status, fs.read_file(path))
