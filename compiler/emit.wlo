# Writes checked functions as QBE intermediate language, with stage 0's value
# representation and symbols: every value is an
# `l` slot, a function is `$W.<module>.<name>`, a string literal
# `$W.str.<n>`, and a type descriptor `$W.<type>.type`, except that the
# program's own modules' functions and types start with `$P.`, apart from
# library modules of the same name. Locals live in stack slots, which QBE
# promotes to registers. Output depends only on the order functions are
# emitted in.

import ast
import check
import bind
import coroutine
import stdlib
import types

class Instantiation:
    function: ast.FunctionDecl
    args: list[types.Type]
    bindings: dict[str, types.Type]
    symbol: str

class Witness:
    source: types.Type
    target: types.ProtocolType
    symbol: str
    marker: str

class Emitter:
    # `__os`, which an `if` that compares it with a literal folds.
    target_os: str
    # The entry module's name, which its types' names leave out.
    entry: str
    # The symbol root of each declared function's module, by the function's
    # id: "W." and the module's name for core and the library's modules,
    # and "P." and the name for the program's, which may reuse a library
    # module's name.
    module_names: dict[int, str]
    descriptors: dict[str, list[str]]
    lines: list[str]
    # String literals, numbered in order of first use.
    strings: dict[str, int]
    # Per function: the temporaries and labels used so far, and whether the
    # current block has ended with a jump or return.
    temps: int
    labels: int
    ended: bool
    # Whether the current function returns a value.
    returns: bool
    loop_next: list[str]
    loop_end: list[str]
    tuple_kinds: dict[str, int]
    functions: dict[int, ast.FunctionDecl]
    instantiations: list[Instantiation]
    instances: dict[int, list[Instantiation]]
    bindings: dict[str, types.Type]
    witnesses: list[Witness]
    protocols: list[types.ProtocolType]
    # The path of each module, by symbol root, for the locations of
    # exceptions.
    module_paths: dict[str, str]
    # The privileged modules by symbol root, whose functions record no
    # frames.
    privileged: dict[str, bool]
    # The built-in exception classes, by name.
    exceptions: dict[str, types.Class]
    # The enclosing `try` statements with a `finally` clause, innermost last,
    # and the exceptions the enclosing `except` clauses handle.
    protects: list[Protect]
    handled: list[str]
    exception_descriptors: list[str]

    # The functions emitted after the top-level function that uses them, in
    # order of first use, how many of them have been emitted, and the symbols
    # of the wrappers among them, which are emitted once.
    later: list[Later]
    wrappers: dict[str, bool]
    emitted: int = 0
    # Per function: its name in frames, its module's path, and whether it
    # records frames, which privileged modules' functions do not, so that
    # an exception raised in one is located at the call from the program.
    function_name: str = ""
    path: str = ""
    frames: bool = false
    async_body: bool = false
    # Whether int arithmetic checks for overflow. Core's own arithmetic
    # stays in range by construction and checks explicitly where program
    # values could leave it.
    overflow_checks: bool = true
    # Where a pending exception goes: the innermost handler, or `@unwind`,
    # which returns, and whether the function uses `@unwind`.
    target: str = ""
    unwinds: bool = false
    # The location of the expression or statement being emitted, which an
    # exception raised there records.
    at_line: int = 0
    at_col: int = 0

    def write(text: str):
        self.lines.append(text)

    def line(text: str):
        self.lines.append("\t" + text)

    def temp() -> str:
        self.temps = self.temps + 1
        return f"%.{self.temps}"

    def new_label() -> str:
        self.labels = self.labels + 1
        return f"@L.{self.labels}"

    def label(label: str):
        self.write(label)
        self.ended = false

    # Writes a jump or return, unless the block has already ended: the jumps
    # that close an `if` or `while` body can follow a return.
    def jump(text: str):
        if not self.ended:
            self.line(text)
            self.ended = true

    def string(text: str) -> str:
        if text not in self.strings:
            self.strings[text] = len(self.strings)
        return f"$W.str.{self.strings[text]}"

    def core_call(name: str, args: list[str], returns: bool) -> str:
        if name == "list_len" or name == "str_size" or name == "list_capacity" or name == "list_slots":
            var offset = 8
            if name == "list_capacity":
                offset = 16
            if name == "list_slots":
                offset = 24
            var address = self.temp()
            var result = self.temp()
            self.line(f"{address} =l add {args[0]}, {offset}")
            self.line(f"{result} =l loadl {address}")
            return result
        if name == "str_bytes":
            var result = self.temp()
            self.line(f"{result} =l add {args[0]}, 24")
            return result
        if name == "str_byte":
            var address = self.temp()
            var result = self.temp()
            self.line(f"{address} =l add {args[0]}, 24")
            self.line(f"{address} =l add {address}, {args[1]}")
            self.line(f"{result} =l loadub {address}")
            return result
        if name == "tuple_get":
            var offset = self.temp()
            var address = self.temp()
            var result = self.temp()
            self.line(f"{offset} =l mul {args[1]}, 8")
            self.line(f"{address} =l add {args[0]}, 24")
            self.line(f"{address} =l add {address}, {offset}")
            self.line(f"{result} =l loadl {address}")
            return result
        if name == "list_get" or name == "list_set":
            return self.inline_list(name, args, returns)
        return self.willow_call(f"$W.core.{name}", typed(args), returns)

    # Arguments are already evaluated. Only the failing path calls core, so
    # it keeps the original exception handler and source location.
    def inline_list(name: str, args: list[str], returns: bool) -> str:
        var address = self.temp()
        var length = self.temp()
        var index = self.temp()
        var negative = self.temp()
        var bad = self.temp()
        var normalize = self.new_label()
        var bounds = self.new_label()
        var access = self.new_label()
        var failed = self.new_label()
        var done = self.new_label()
        var result = self.temp()
        self.line(f"{address} =l add {args[0]}, 8")
        self.line(f"{length} =l loadl {address}")
        self.line(f"{index} =l copy {args[1]}")
        self.line(f"{negative} =l csltl {index}, 0")
        self.jump(f"jnz {negative}, {normalize}, {bounds}")
        self.label(normalize)
        # A negative index plus a non-negative length cannot overflow.
        self.line(f"{index} =l add {index}, {length}")
        self.label(bounds)
        self.line(f"{bad} =l cugel {index}, {length}")
        self.jump(f"jnz {bad}, {failed}, {access}")
        self.label(failed)
        var slow = self.willow_call(f"$W.core.{name}", typed(args), returns)
        self.line(f"{result} =l copy {slow}")
        self.jump(f"jmp {done}")
        self.label(access)
        self.line(f"{address} =l add {args[0]}, 24")
        self.line(f"{address} =l loadl {address}")
        var offset = self.temp()
        # A valid index addresses an existing slot in the allocated array.
        self.line(f"{offset} =l mul {index}, 8")
        self.line(f"{address} =l add {address}, {offset}")
        if returns:
            self.line(f"{result} =l loadl {address}")
        else:
            self.line(f"storel {args[2]}, {address}")
            self.line(f"{result} =l copy 0")
        self.label(done)
        return result

    # Writes a call of a Willow function, which can raise.
    def willow_call(callee: str, args: list[str], returns: bool) -> str:
        var result = self.call_text(callee, args, returns)
        self.check_pending()
        return result

    # Writes call `text` and returns its result, or 0 when there is none.
    def call_text(callee: str, args: list[str], returns: bool) -> str:
        var text = "call " + callee + "(" + ", ".join(args) + ")"
        if not returns:
            self.line(text)
            return "0"
        var t = self.temp()
        self.line(f"{t} =l {text}")
        return t

    # Functions

    def concrete_type(ty: types.Type | none) -> types.Type:
        assert ty is not none, "unchecked type"
        if len(self.bindings) == 0:
            return types.expand(ty)
        return types.expand(types.substitute(ty, self.bindings))

    def function(function: ast.FunctionDecl):
        var owner = function.owner
        if len(function.type_params) > 0 or owner is ast.ClassDecl and len(owner.type_params) > 0:
            return
        var module = self.module_names[function.id]
        if module == "W.core":
            var body = coroutine.function(function.name)
            if body != "":
                self.write(body)
                return
        if module == "W.core" and function.name in ["http_cache", "re_cache"]:
            var library = "$W." + function.name.removesuffix("_cache") + ".library"
            self.write("data " + library + " = { l 0 }")
            self.begin(self.symbol(function), [], true)
            self.end(library)
            return
        if module == "W.core" and function.name == "ascii_character":
            self.emit_ascii_character()
            return
        if module == "W.core" and function.name in ["stdin_buffer", "stdout_buffer"]:
            self.begin(self.symbol(function), [], true)
            var stream = "stdin"
            if function.name == "stdout_buffer":
                stream = "stdout"
            self.end("$W." + stream + ".buffer")
            return
        if module == "W.core" and function.name in ["fail", "fail_at"]:
            self.emit_fail(function.name)
            return
        if module == "W.core" and function.name == "sys_arguments":
            self.begin(self.symbol(function), [], true)
            var args: list[str] = []
            for word in ["$W.argc", "$W.argv"]:
                var t = self.temp()
                self.line(f"{t} =l loadl {word}")
                args.append(t)
            self.end(self.core_call("sys_args", args, true))
            return
        self.emit_function(function, self.symbol(function), [], {})
        while self.emitted < len(self.later):
            self.emitted = self.emitted + 1
            self.emit_later(self.later[self.emitted - 1])

    def emit_ascii_character():
        self.write("\n".join([
            "function l $W.core.ascii_character(l %code) {",
            "@start",
            "    %offset =l mul %code, 32",
            "    %result =l add $W.ascii.characters, %offset",
            "    ret %result",
            "}",
        ]))

    def emit_ascii_characters():
        # Aligned string objects: descriptor, length, empty hash cache, byte, NUL.
        var entries: list[str] = []
        for code in range(128):
            entries.append(f"l $W.str.type, l 1, l 0, b {code}, b 0, z 6")
        self.write("data $W.ascii.characters = align 8 { " + ", ".join(entries) + " }")

    # Emits `function` as `symbol`, whose parameters start with `first`. A
    # captured parameter or local lives in a cell that its closures share.
    def emit_function(function: ast.FunctionDecl, symbol: str, first: list[str], bindings: dict[str, types.Type]):
        self.bindings = bindings
        var record = function.record
        assert record is not none, f"function {function.name} has no signature"
        var result = self.concrete_type(record.result)
        if function.is_async:
            self.emit_async_constructor(function, symbol, first)
            symbol = symbol + ".body"
            assert result is types.ClassType, "async function without a coroutine result"
            result = result.args[0]
        var params: list[str] = []
        params.extend(first)
        for param in function.params:
            params.append(f"l %p.{param.name}")
        if function.generator:
            self.emit_generator_factory(function, symbol, params)
            return
        self.begin(symbol, params, not is_none(result))
        self.function_body(function)

    def function_body(function: ast.FunctionDecl):
        var module = self.module_of(function)
        self.function_name = frame_name(function)
        self.path = self.module_paths[module]
        self.frames = module not in self.privileged
        self.async_body = function.is_async
        self.overflow_checks = module != "W.core"
        for param in function.params:
            var param_symbol = param.symbol
            assert param_symbol is not none, "parameter without a symbol"
            var slot = self.local_slot(param_symbol)
            self.line(f"{slot} =l alloc8 8")
            self.fresh_binding(param_symbol)
            self.line(f"storel %p.{param.name}, {self.local_address(param_symbol, param.name)}")
        for local in function.locals:
            self.line(f"{self.local_slot(local)} =l alloc8 8")
        for i in range(len(function.captures)):
            var captured = function.captures[i].symbol
            var slot = self.local_slot(captured)
            self.line(f"{slot} =l alloc8 8")
            var cell = self.load_field("%env", 16 + i * 8)
            self.line(f"storel {cell}, {slot}")
        self.block(function.body)
        # The checker proves a function with a result never reaches its end.
        if self.returns:
            self.jump("hlt")
        self.end("0")

    def emit_generator_factory(function: ast.FunctionDecl, symbol: str, params: list[str]):
        var record = function.record
        assert record is not none, "generator without a signature"
        var result = self.concrete_type(record.result)
        assert result is types.ProtocolType, "unchecked generator annotation"
        var generator_type = types.ProtocolType(stdlib.protocols()["Generator"], result.args)
        self.later.append(GeneratorBody(symbol, function, self.bindings))
        self.begin(symbol, params, true)
        var environment = self.core_call("object_new", ["0", str(len(function.params) + 2)], true)
        var captured = "0"
        if function.parent is not none:
            captured = "%env"
        self.store_field(environment, 16, captured)
        for i in range(len(function.params)):
            self.store_field(environment, 24 + i * 8, "%p." + function.params[i].name)
        var generator = self.core_call("generator_new", [symbol + ".body", environment], true)
        self.store_field(environment, 8, generator)
        var value = self.protocol_value(symbol + ".generator.type", generator)
        self.end(self.convert(value, generator_type, result))

    def emit_generator_body(body: GeneratorBody):
        self.bindings = body.bindings
        var function = body.function
        var record = function.record
        assert record is not none, "generator without a signature"
        var result = self.concrete_type(record.result)
        assert result is types.ProtocolType, "unchecked generator annotation"
        var symbol = body.symbol
        var iterator = symbol + ".iterator"
        self.iterator_descriptor(iterator, result.args[0])
        self.begin(iterator + ".next", ["l %state", "l %written"], true)
        self.end(self.core_call("generator_next", ["%state"], true))
        var generator_type = types.ProtocolType(stdlib.protocols()["Generator"], result.args)
        var marker = self.protocol_marker(generator_type)
        self.write(f"data {symbol}.generator.type = " + "{ l " + marker + f", l {iterator}.iter, l {iterator}.next, l {symbol}.close, l {symbol}.enter, l {symbol}.exit" + " }")
        self.begin(symbol + ".close", ["l %state", "l %written"], false)
        self.core_call("generator_close", ["%state"], false)
        self.end("0")
        self.begin(symbol + ".enter", ["l %state", "l %written"], true)
        self.end(self.protocol_value(symbol + ".generator.type", "%state"))
        self.begin(symbol + ".exit", ["l %state", "l %written", "l %error"], false)
        self.core_call("generator_close", ["%state"], false)
        self.end("0")
        self.begin(symbol + ".body", ["l %environment"], false)
        self.line(f"%generator =l copy {self.load_field('%environment', 8)}")
        self.line(f"%env =l copy {self.load_field('%environment', 16)}")
        for i in range(len(function.params)):
            var value = self.load_field("%environment", 24 + i * 8)
            self.line(f"%p.{function.params[i].name} =l copy {value}")
        self.function_body(function)

    def emit_yield(node: ast.Yield):
        var value = self.expr(node.value)
        self.core_call("coroutine_yield", [value], false)
        var closing = self.core_call("generator_closing", ["%generator"], true)
        var close = self.new_label()
        var resume = self.new_label()
        self.jump(f"jnz {closing}, {close}, {resume}")
        self.label(close)
        self.leave(0)
        self.jump("ret")
        self.label(resume)

    def emit_async_constructor(function: ast.FunctionDecl, symbol: str, first: list[str]):
        var params: list[str] = []
        params.extend(first)
        var values: list[str] = []
        if len(first) > 0:
            values.append("%env")
        for param in function.params:
            params.append(f"l %p.{param.name}")
            values.append(f"%p.{param.name}")
        self.begin(symbol, params, true)
        var body = self.new_closure(symbol + ".await", values)
        self.end(self.core_call("async_coroutine", [body], true))
        self.begin(symbol + ".await", ["l %env"], true)
        var args: list[str] = []
        for i in range(len(values)):
            args.append("l " + self.load_field("%env", 16 + i * 8))
        var record = function.record
        assert record is not none, "async function without a signature"
        var result = self.concrete_type(record.result)
        assert result is types.ClassType, "async function without a coroutine result"
        self.end(self.call_text(symbol + ".body", args, not is_none(result.args[0])))

    # Starts function `symbol` with `params`, which returns a value when
    # `returns`. Its frames are recorded only when the caller says so.
    def begin(symbol: str, params: list[str], returns: bool):
        self.temps = 0
        self.labels = 0
        self.target = "@unwind"
        self.unwinds = false
        self.frames = false
        self.async_body = false
        self.overflow_checks = true
        self.returns = returns
        var result = ""
        if returns:
            result = "l "
        self.write("function " + result + symbol + "(" + ", ".join(params) + ") {")
        self.label("@start")

    # Returns `value`, or nothing when the function has no result, and ends
    # the function.
    def end(value: str):
        if self.returns:
            self.jump("ret " + value)
        else:
            self.jump("ret")
        # An exception leaves with a dummy result, which no caller reads.
        if self.unwinds:
            self.label("@unwind")
            if self.returns:
                self.jump("ret 0")
            else:
                self.jump("ret")
        self.write("}")

    # Core's L0 `fail` and `fail_at` end the program; these bodies raise the
    # built-in exception they name instead.
    def emit_fail(name: str):
        var params = "l %p.class_name, l %p.message"
        if name == "fail_at":
            params = params + ", l %p.path, l %p.line, l %p.col"
        self.write("function $W.core." + name + "(" + params + ") {")
        self.label("@start")
        self.line("%e =l call $W.core.failure(l $W.exceptions, l %p.class_name, l %p.message)")
        if name == "fail_at":
            self.line("call $W.core.locate(l %e, l %p.path, l %p.line, l %p.col)")
        self.line("storel %e, $W.pending")
        self.jump("ret")
        self.write("}")

    def symbol(function: ast.FunctionDecl) -> str:
        return "$" + self.module_names[function.id] + "." + frame_name(function)

    def specialization(fn: types.Function, receiver: list[types.Type], args: list[types.Type]) -> str:
        if len(receiver) == 0 and len(args) == 0:
            return self.symbol(self.functions[fn.id])
        return self.instantiation(fn, receiver, args).symbol

    def instantiation(fn: types.Function, receiver: list[types.Type], args: list[types.Type]) -> Instantiation:
        var function = self.functions[fn.id]
        var bindings: dict[str, types.Type] = {}
        var concrete = types.substitute_all(receiver, self.bindings)
        var own = types.substitute_all(args, self.bindings)
        var owner = function.owner
        if owner is ast.ClassDecl:
            var record = owner.record
            assert record is not none, "class without a record"
            bindings = types.bind_vars(record.typevars, concrete)
        var own_bindings = types.bind_vars(fn.typevars, own)
        for key in own_bindings:
            bindings[key] = own_bindings[key]
        concrete.extend(own)
        return self.instance(function, concrete, bindings, self.symbol(function))

    # The specialization of nested generic function `function` by `args`
    # within the current specialization of the functions that enclose it,
    # whose type arguments are part of its key. Its code takes the closure
    # that holds its cells first.
    def nested_specialization(function: ast.FunctionDecl, args: list[types.Type]) -> Instantiation:
        var record = function.record
        assert record is not none, f"function {function.name} has no signature"
        var bindings: dict[str, types.Type] = {}
        var key: list[types.Type] = []
        for v in enclosing_vars(function):
            var bound = self.bindings[types.var_key(v)]
            bindings[types.var_key(v)] = bound
            key.append(bound)
        var own = types.substitute_all(args, self.bindings)
        var own_bindings = types.bind_vars(record.typevars, own)
        for name in own_bindings:
            bindings[name] = own_bindings[name]
        key.extend(own)
        return self.instance(function, key, bindings, "$" + self.module_of(function) + "." + frame_name(function) + "." + str(function.id))

    # The instantiation of `function` whose type arguments are `key`, queued
    # in order of first use and named after `base` and its place.
    def instance(function: ast.FunctionDecl, key: list[types.Type], bindings: dict[str, types.Type], base: str) -> Instantiation:
        if function.id not in self.instances:
            self.instances[function.id] = []
        var instance: Instantiation
        for instance_item in self.instances[function.id]:
            instance = instance_item
            if types.all_same(instance.args, key, []):
                return instance
        instance = Instantiation(function, key, bindings, base + f".inst.{len(self.instantiations)}")
        self.instances[function.id].append(instance)
        self.instantiations.append(instance)
        return instance

    def protocol_marker(target: types.ProtocolType) -> str:
        for i in range(len(self.protocols)):
            if types.same(self.protocols[i], target):
                return self.string(f"<protocol {i}>")
        self.protocols.append(target)
        return self.string(f"<protocol {len(self.protocols) - 1}>")

    def witness(source: types.Type, target: types.ProtocolType) -> Witness:
        var witness: Witness
        for witness_item in self.witnesses:
            witness = witness_item
            if types.same(witness.source, source) and types.same(witness.target, target):
                return witness
        witness = Witness(source, target, f"$W.protocol.{len(self.witnesses)}", self.protocol_marker(target))
        self.witnesses.append(witness)
        return witness

    # All indirect protocol calls pass through here, including forwarding
    # adapters. `written` has bit i set when the caller wrote argument i
    # rather than taking the protocol's default, which the implementation
    # replaces with its own.
    def protocol_call(object: str, receiver_type: types.ProtocolType, name: str, args: list[str], written: str) -> str:
        var descriptor = self.temp()
        var receiver_address = self.temp()
        var receiver = self.temp()
        self.line(f"{descriptor} =l loadl {object}")
        self.line(f"{receiver_address} =l add {object}, 8")
        self.line(f"{receiver} =l loadl {receiver_address}")
        for i in range(len(receiver_type.decl.methods)):
            var method = receiver_type.decl.methods[i]
            if method.name == name:
                var address = self.temp()
                var callee = self.temp()
                self.line(f"{address} =l add {descriptor}, {8 + i * 8}")
                self.line(f"{callee} =l loadl {address}")
                var signature = types.method(receiver_type, name)
                assert signature is not none, "missing protocol method"
                var passed = [receiver, written]
                passed.extend(args)
                return self.willow_call(callee, typed(passed), not is_none(signature.result))
        return self.unchecked("protocol method")

    def emit_witness(witness: Witness):
        self.bindings = {}
        var entries = ["l " + witness.marker]
        for i in range(len(witness.target.decl.methods)):
            var method = witness.target.decl.methods[i]
            var want = types.method(witness.target, method.name)
            var have = types.method(witness.source, method.name)
            assert want is not none and have is not none, "missing protocol implementation"
            var indexes = types.match_params(want, have)
            assert indexes is not none, "invalid protocol implementation"
            var symbol = witness.symbol + f".method.{i}"
            entries.append("l " + symbol)
            self.temps = 0
            self.labels = 0
            self.frames = false
            self.target = "@unwind"
            self.unwinds = false
            self.returns = not is_none(want.result)
            var params = ["l %p.self", "l %p.written"]
            for j in range(len(want.params)):
                params.append(f"l %p.{j}")
            var result = ""
            if self.returns:
                result = "l "
            self.write("function " + result + symbol + "(" + ", ".join(params) + ") {")
            self.label("@start")
            var forwarding = (witness.source is types.ProtocolType)
            # Where an argument that has a default goes, in the start block.
            var slots: list[str] = []
            for j in range(len(want.params)):
                slots.append("")
                if want.params[j].default is not none and not forwarding:
                    slots[j] = self.temp()
                    self.line(f"{slots[j]} =l alloc8 8")
            var args: list[str] = []
            # Bit j of `written` for an implementation that is a protocol too.
            var written = "0"
            var value: str
            for j in range(len(have.params)):
                var index = -1
                for k in range(len(indexes)):
                    if indexes[k] == j:
                        index = k
                if index < 0:
                    args.append(self.implementation_default(have.params[j]))
                    continue
                var given = self.convert(f"%p.{index}", want.params[index].ty, have.params[j].ty)
                if want.params[index].default is none:
                    args.append(given)
                    written = self.add_bit(written, "1", j)
                    continue
                var flag = self.temp()
                self.line(f"{flag} =l and %p.written, {bit(index)}")
                if forwarding:
                    args.append(given)
                    var present = self.temp()
                    self.line(f"{present} =l cnel {flag}, 0")
                    written = self.add_bit(written, present, j)
                    continue
                # The implementation's own default replaces the protocol's.
                var take = self.new_label()
                var omit = self.new_label()
                var join = self.new_label()
                self.jump(f"jnz {flag}, {take}, {omit}")
                self.label(take)
                self.line(f"storel {given}, {slots[index]}")
                self.jump(f"jmp {join}")
                self.label(omit)
                self.line(f"storel {self.implementation_default(have.params[j])}, {slots[index]}")
                self.jump(f"jmp {join}")
                self.label(join)
                value = self.temp()
                self.line(f"{value} =l loadl {slots[index]}")
                args.append(value)
            value = self.dispatch_method("%p.self", witness.source, method.name, args, [], written)
            value = self.convert(value, have.result, want.result)
            if self.returns:
                self.jump("ret " + value)
            else:
                self.jump("ret")
            if self.unwinds:
                self.label("@unwind")
                if self.returns:
                    self.jump("ret 0")
                else:
                    self.jump("ret")
            self.write("}")
        self.write("data " + witness.symbol + ".type = { " + ", ".join(entries) + " }")

    # The value of `param`'s default, of an implementation of a protocol
    # method, as the parameter's type.
    def implementation_default(param: types.Param) -> str:
        var default = param.default
        assert default is not none, "missing implementation default"
        return self.convert(self.expr(default), self.concrete_type(default.ty), param.ty)

    # `mask` with bit `j` set when `present`, 0 or 1, is 1.
    def add_bit(mask: str, present: str, j: int) -> str:
        if present == "1" and mask == "0":
            return str(bit(j))
        var shifted = self.temp()
        self.line(f"{shifted} =l mul {present}, {bit(j)}")
        var result = self.temp()
        self.line(f"{result} =l add {mask}, {shifted}")
        return result

    # Calls `function`, `main` or a test of the entry module, an async one
    # as the event loop's root task.
    def call_entry(entry: ast.Module, function: ast.FunctionDecl):
        if function.is_async:
            self.line(f"%root =l call $P.{entry.name}.{function.name}()")
            self.line("%result =l call $W.core.aio_run(l %root)")
        else:
            self.line(f"call $P.{entry.name}.{function.name}()")

    def emit_instantiations():
        var function_index = 0
        var witness_index = 0
        while function_index < len(self.instantiations) or witness_index < len(self.witnesses) or self.emitted < len(self.later):
            if function_index < len(self.instantiations):
                var instance = self.instantiations[function_index]
                function_index = function_index + 1
                var first: list[str] = []
                if instance.function.parent is not none:
                    first.append("l %env")
                self.emit_function(instance.function, instance.symbol, first, instance.bindings)
                while self.emitted < len(self.later):
                    self.emitted = self.emitted + 1
                    self.emit_later(self.later[self.emitted - 1])
            else if self.emitted < len(self.later):
                self.emitted = self.emitted + 1
                self.emit_later(self.later[self.emitted - 1])
            else:
                var witness = self.witnesses[witness_index]
                witness_index = witness_index + 1
                self.emit_witness(witness)
        self.bindings = {}

    # The module of `function`, which may be nested.
    def module_of(function: ast.FunctionDecl) -> str:
        var parent = function.parent
        while parent is not none:
            function = parent
            parent = function.parent
        return self.module_names[function.id]

    # The program entry, descriptors, and string literals, after every
    # function. The entry saves argc and argv for sys.args (core/API.md).
    #
    # The entry of a test file (`test`) runs the test that its first argument
    # names, and once it returns, creates the file its second argument names;
    # the program's own arguments are the rest.
    def finish(entry: ast.Module, test: bool) -> str:
        self.emit_instantiations()
        self.write("export function w $main(w %argc, l %argv) {")
        self.write("@start")
        self.line("call $GC_init()")
        self.line("%argc.l =l extsw %argc")
        if test:
            self.line("%args =l call $W.core.sys_args(l %argc.l, l %argv)")
            self.line("%name =l call $W.core.list_get(l %args, l 0)")
            self.line("%marker =l call $W.core.list_get(l %args, l 1)")
            # The marker becomes the program name, which sys.args leaves out.
            self.line("%argc.rest =l sub %argc.l, 2")
            self.line("%argv.rest =l add %argv, 16")
            self.line("storel %argc.rest, $W.argc")
            self.line("storel %argv.rest, $W.argv")
        else:
            self.line("storel %argc.l, $W.argc")
            self.line("storel %argv, $W.argv")
        self.line("call $W.core.init()")
        if test:
            for i in range(len(entry.tests)):
                var function = entry.tests[i]
                self.line(f"%is.{i} =l call $W.core.str_eq(l %name, l {self.string(function.name)})")
                self.line(f"jnz %is.{i}, @test.{i}, @next.{i}")
                self.write(f"@test.{i}")
                self.call_entry(entry, function)
                self.line("jmp @ran")
                self.write(f"@next.{i}")
            self.line("ret 2")
            self.write("@ran")
        else:
            var main = entry.names["main"]
            assert main is ast.FunctionDecl, "entry without main"
            self.call_entry(entry, main)
        self.line("%e =l loadl $W.pending")
        self.line("jnz %e, @uncaught, @done")
        self.write("@uncaught")
        self.line("storel 0, $W.pending")
        self.line("call $W.core.report(l %e)")
        self.line("ret 1")
        self.write("@done")
        self.line("call $W.core.flush_stdout()")
        if test:
            self.line(f"call $W.core.fs_write_file(l %marker, l {self.string('')})")
        self.line("ret 0")
        self.write("}")
        self.write("data $W.argc = { l 0 }")
        self.write("data $W.argv = { l 0 }")
        self.write("data $W.pending = { l 0 }")
        self.write("data $W.stdin.buffer = { z 4120 }")
        self.write("data $W.stdout.buffer = { z 4112 }")
        self.emit_ascii_characters()
        self.write(coroutine.data())
        for name in builtin_types():
            self.write(f"data $W.{name}.type = " + "{ l " + self.string(name) + " }")
        var exceptions: list[str] = []
        for name in self.exceptions:
            self.write(f"data $W.{name}.type = " + "{ l " + self.string(name) + " }")
            exceptions.append(f"l $W.{name}.type")
        self.write("data $W.exceptions = { " + ", ".join(exceptions) + " }")
        for symbol in self.descriptors:
            var values: list[str] = []
            for text in self.descriptors[symbol]:
                values.append("l " + self.string(text))
            self.write("data " + symbol + " = { " + ", ".join(values) + " }")
        # A file-level or built-in function value is a closure with no
        # captures, which needs no allocation.
        for later in self.later:
            var code = ""
            if later is ValueWrapper:
                code = later.symbol
            else if later is BuiltinWrapper:
                code = later.symbol
            else if later is SpecializedValue and later.instance.function.parent is none:
                code = later.symbol
            if code != "":
                self.write(f"data {code}.closure = " + "{ l $W.function.type, l " + code + " }")
        for kinds in self.tuple_kinds:
            var values: list[str] = []
            if kinds == "":
                values.append("l 0")
            else:
                for kind in kinds.split(","):
                    values.append("l " + kind)
            self.write(f"data $W.tuple.kinds.{self.tuple_kinds[kinds]} = " + "{ " + ", ".join(values) + " }")
        for text in self.strings:
            var data = f"l $W.str.type, l {len(utf8(text))}, l 0, " + data_bytes(text) + "b 0"
            self.write(f"data $W.str.{self.strings[text]} = " + "{ " + data + " }")
        return "\n".join(self.lines) + "\n"

    # Statements

    def block(body: list[ast.Stmt]):
        for statement in body:
            # Statements after a jump or return cannot run. The checker
            # rejects them, except after a kept `__os` arm that transfers
            # control, where they are the other platform's code.
            if self.ended:
                return
            self.stmt(statement)

    def stmt(statement: ast.Stmt):
        var line = self.at_line
        var col = self.at_col
        self.at_line = statement.line
        self.at_col = statement.col
        self.emit_stmt(statement)
        self.at_line = line
        self.at_col = col

    def emit_stmt(statement: ast.Stmt):
        var node = statement.node
        if (node is ast.Var):
            self.fresh_pattern(node.target)
            var initializer = node.value
            if initializer is not none:
                var value = self.expr(initializer)
                if node.target.name != "":
                    self.line(f"storel {value}, {self.local_address(node.target.symbol, node.target.name)}")
                else:
                    self.store_pattern(node.target, value, self.concrete_type(initializer.ty))
        else if (node is ast.Assign):
            var value = self.expr(node.value)
            self.line(f"storel {value}, {self.local_address(node.symbol, node.name)}")
        else if node is ast.Unpack:
            var value = self.expr(node.value)
            var ty = self.concrete_type(node.value.ty)
            self.store_pattern(node.target, value, ty)
        else if node is ast.CallStmt:
            self.expr(node.call)
        else if node is ast.If:
            self.emit_if(node)
        else if node is ast.While:
            self.emit_while(node)
        else if node is ast.Return:
            self.emit_return(node)
        else if node is ast.Yield:
            self.emit_yield(node)
        else if node is ast.IndexAssign:
            self.emit_index_assign(node)
        else if node is ast.FieldAssign:
            self.field_assign(node)
        else if node is ast.For:
            self.emit_for(node)
        else if node is ast.Assert:
            self.emit_assert(node)
        else if node is ast.Raise:
            self.emit_raise(node)
        else if node is ast.Try:
            self.emit_try(node)
        else if node is ast.With:
            self.emit_with(node, 0)
        else if node is ast.AsyncWith:
            self.emit_async_with(node)
        else if (node is ast.FunctionDef):
            self.fresh_binding(node.symbol)
            var closure = ""
            if len(node.function.type_params) > 0:
                # Only the cells: each specialization's code is compiled
                # where it is used.
                closure = self.new_closure("0", self.cells(node.function))
            else:
                closure = self.closure(node.function)
            self.line(f"storel {closure}, {self.local_address(node.symbol, node.function.name)}")
        else if (node is ast.SimpleStatement):
            if node == ast.SimpleStatement.BREAK:
                self.leave(self.loop_protects())
                self.jump("jmp " + self.loop_end[-1])
            else if node == ast.SimpleStatement.CONTINUE:
                self.leave(self.loop_protects())
                self.jump("jmp " + self.loop_next[-1])
        else:
            self.unchecked("statement")

    # A function without a result returns nothing to QBE, even from
    # `return none` or the return of a call without a result. The value is
    # computed before the `finally` clauses the return leaves run.
    def emit_return(node: ast.Return):
        var returned = node.value
        var value = ""
        if returned is not none:
            value = self.expr(returned)
        self.leave(0)
        if returned is not none and self.returns:
            self.jump("ret " + value)
        else:
            self.jump("ret")

    # Exceptions

    # After a call: when an exception is pending, adds this function's frame
    # to it and goes to the innermost handler, or returns. The frame's calls
    # run with no exception pending.
    def check_pending():
        var pending = self.temp()
        self.line(f"{pending} =l loadl $W.pending")
        var ok = self.new_label()
        if not self.frames:
            self.use_target()
            self.jump(f"jnz {pending}, {self.target}, {ok}")
        else:
            var failed = self.new_label()
            self.jump(f"jnz {pending}, {failed}, {ok}")
            self.label(failed)
            self.line("storel 0, $W.pending")
            self.frame_call("trace", pending)
            self.line(f"storel {pending}, $W.pending")
            self.propagate()
        self.label(ok)

    # Calls core function `name` with `exception` and this function's name
    # and location.
    def frame_call(name: str, exception: str):
        var function = self.string(self.function_name)
        var path = self.string(self.path)
        self.line(f"call $W.core.{name}(l {exception}, l {function}, l {path}, l {self.at_line}, l {self.at_col})")

    # Clears the location and frames of `exception`, which may have been
    # raised before, so that the first frame recorded is its caller's.
    def clear_frames(exception: str):
        for offset in ["8", "16"]:
            var address = self.temp()
            self.line(f"{address} =l add {exception}, {offset}")
            self.line(f"storel 0, {address}")

    def use_target():
        if self.target == "@unwind":
            self.unwinds = true

    # Goes to where the pending exception is handled.
    def propagate():
        self.use_target()
        self.jump("jmp " + self.target)

    # A bare `raise` raises the exception the innermost `except` clause
    # handles again, keeping its location and frames.
    def emit_raise(node: ast.Raise):
        var value = node.value
        var exception = ""
        if value is none:
            exception = self.handled[-1]
        else:
            exception = self.expr(value)
            if self.frames:
                self.frame_call("raised", exception)
            else:
                self.clear_frames(exception)
        self.line(f"storel {exception}, $W.pending")
        self.propagate()

    # A handler block tests the `except` clauses in order. A `finally` body
    # is emitted once for each way of leaving the statement: completing,
    # raising, and each return, break, or continue that leaves it.
    def emit_try(node: ast.Try):
        var outside = self.target
        var end = self.new_label()
        var normal = end
        var raising = outside
        var has_finally = len(node.finally_body) > 0
        var protect = Protect(node.finally_body, outside, len(self.loop_end), len(self.handled))
        if has_finally:
            normal = self.new_label()
            raising = self.new_label()
            self.protects.append(protect)
        var handlers = raising
        if len(node.handlers) > 0:
            handlers = self.new_label()
        self.target = handlers
        self.block(node.body)
        self.jump(f"jmp {normal}")
        if len(node.handlers) > 0:
            self.label(handlers)
            self.target = raising
            var exception = self.temp()
            self.line(f"{exception} =l loadl $W.pending")
            self.line("storel 0, $W.pending")
            var cancelling = self.temp()
            var cancelled = self.new_label()
            var catching = self.new_label()
            self.line(f"{cancelling} =l ceql {exception}, $W.aio.cancel")
            self.jump(f"jnz {cancelling}, {cancelled}, {catching}")
            self.label(cancelled)
            self.line(f"storel {exception}, $W.pending")
            self.propagate()
            self.label(catching)
            var kind = self.temp()
            self.line(f"{kind} =l loadl {exception}")
            for handler in node.handlers:
                var record = handler.type_name.record
                assert record is types.Class, "unchecked except clause"
                var body = self.new_label()
                var next = self.new_label()
                if record.type_name != "Exception":
                    var matches = self.temp()
                    self.line(f"{matches} =l ceql {kind}, {self.descriptor(record.type_name, record.library)}")
                    self.jump(f"jnz {matches}, {body}, {next}")
                self.label(body)
                if handler.name != "":
                    self.fresh_binding(handler.symbol)
                    self.line(f"storel {exception}, {self.local_address(handler.symbol, handler.name)}")
                self.handled.append(exception)
                self.block(handler.body)
                self.handled.pop()
                self.jump(f"jmp {normal}")
                self.label(next)
            self.line(f"storel {exception}, $W.pending")
            self.propagate()
        self.target = outside
        if has_finally:
            self.protects.pop()
            self.label(normal)
            self.cleanup(protect, "0")
            self.jump(f"jmp {end}")
            self.label(raising)
            var exception = self.temp()
            self.line(f"{exception} =l loadl $W.pending")
            self.line("storel 0, $W.pending")
            self.cleanup(protect, "0")
            # A finally clause that raises replaces the exception.
            if not self.ended:
                self.line(f"storel {exception}, $W.pending")
            self.propagate()
        self.label(end)

    # Runs the `finally` clauses that a return, break, or continue leaves,
    # innermost first: those of the protects past the first `count`. Each
    # runs where its `try` statement is.
    def leave(count: int):
        var protects = self.protects
        var handled = self.handled
        var target = self.target
        var i = len(protects) - 1
        while i >= count and not self.ended:
            var protect = protects[i]
            self.protects = protects[:i]
            self.handled = handled[:protect.handled]
            self.target = protect.outside
            self.cleanup(protect, "0")
            i = i - 1
        self.protects = protects
        self.handled = handled
        self.target = target

    def cleanup(protect: Protect, error: str):
        if protect.group:
            self.emit_group_exit(protect.manager, error)
            return
        var scope = ""
        var outside = self.target
        var failed = ""
        var end = ""
        if self.async_body:
            scope = self.call_text("$W.core.aio_scope", [], true)
            self.call_text("$W.core.aio_set_scope", ["l 0"], false)
            failed = self.new_label()
            end = self.new_label()
            self.target = failed
        var call = protect.exit_call
        if call is none:
            self.block(protect.finally_body)
        else:
            error = self.core_call("aio_exception", [error], true)
            self.saved_method(call, protect.manager, [error])
        if self.async_body:
            if not self.ended:
                self.call_text("$W.core.aio_set_scope", ["l " + scope], false)
            self.jump("jmp " + end)
            self.label(failed)
            var exception = self.temp()
            self.line(f"{exception} =l loadl $W.pending")
            self.line("storel 0, $W.pending")
            self.call_text("$W.core.aio_set_scope", ["l " + scope], false)
            self.line(f"storel {exception}, $W.pending")
            self.target = outside
            self.propagate()
            self.label(end)

    def emit_group_exit(group: str, error: str):
        var outcome = self.core_call("aio_group_exit", [group, error], true)
        self.line(f"storel {outcome}, $W.pending")
        var ok = self.new_label()
        self.use_target()
        self.jump(f"jnz {outcome}, {self.target}, {ok}")
        self.label(ok)

    def emit_async_with(node: ast.AsyncWith):
        var manager = self.expr(node.manager)
        var group = self.load_field(manager, 8)
        self.core_call("aio_group_enter", [group], false)
        var pattern = node.target
        if pattern is not none:
            self.fresh_pattern(pattern)
            self.store_pattern(pattern, manager, self.concrete_type(node.manager.ty))
        var outside = self.target
        var raising = self.new_label()
        var end = self.new_label()
        var protect = Protect([], outside, len(self.loop_end), len(self.handled), group, none, true)
        self.protects.append(protect)
        self.target = raising
        self.block(node.body)
        self.protects.pop()
        self.target = outside
        if not self.ended:
            self.emit_group_exit(group, "0")
        self.jump("jmp " + end)
        self.label(raising)
        var error = self.temp()
        self.line(f"{error} =l loadl $W.pending")
        self.line("storel 0, $W.pending")
        self.emit_group_exit(group, error)
        self.label(end)

    def emit_with(node: ast.With, index: int):
        if index == len(node.items):
            self.block(node.body)
            return
        var item = node.items[index]
        var manager = self.expr(item.manager)
        var enter = item.enter_call
        var exit = item.exit_call
        assert enter is not none and exit is not none, "unchecked context manager"
        var value = self.saved_method(enter, manager, [])
        var outside = self.target
        var normal = self.new_label()
        var raising = self.new_label()
        var end = self.new_label()
        var protect = Protect([], outside, len(self.loop_end), len(self.handled), manager, exit)
        self.protects.append(protect)
        self.target = raising
        var target = item.target
        if target is not none:
            self.fresh_pattern(target)
            self.store_pattern(target, value, self.concrete_type(enter.ty))
        self.emit_with(node, index + 1)
        self.jump("jmp " + normal)
        self.protects.pop()
        self.target = outside
        self.label(normal)
        self.cleanup(protect, "0")
        self.jump("jmp " + end)
        self.label(raising)
        var error = self.temp()
        self.line(f"{error} =l loadl $W.pending")
        self.line("storel 0, $W.pending")
        self.cleanup(protect, error)
        self.line(f"storel {error}, $W.pending")
        self.propagate()
        self.label(end)

    # The number of protects outside the innermost loop.
    def loop_protects() -> int:
        var count = len(self.protects)
        while count > 0 and self.protects[count - 1].loops == len(self.loop_end):
            count = count - 1
        return count

    # The message is evaluated only when the condition is false.
    def emit_assert(node: ast.Assert):
        var condition = self.expr(node.condition)
        var ok = self.new_label()
        var failed = self.new_label()
        self.jump(f"jnz {condition}, {ok}, {failed}")
        self.label(failed)
        var message = self.string("assertion failed")
        var written = node.message
        if written is not none:
            message = self.expr(written)
        self.core_call("fail", [self.string("AssertionError"), message], false)
        self.jump("hlt")
        self.label(ok)

    # Fails on a construct the checker does not accept yet.
    def unchecked(what: str) -> str:
        assert false, f"unchecked {what}"
        return "0"

    # An `__os` test emits only the arm it selects, so core can call
    # functions that exist on only one platform.
    def emit_if(node: ast.If):
        var test = self.os_test(node.condition)
        if test == "true":
            self.block(node.body)
            return
        if test == "false":
            self.block(node.else_body)
            return
        var condition = self.expr(node.condition)
        var then_label = self.new_label()
        var else_label = self.new_label()
        var end = self.new_label()
        self.jump(f"jnz {condition}, {then_label}, {else_label}")
        self.label(then_label)
        self.block(node.body)
        self.jump(f"jmp {end}")
        self.label(else_label)
        self.block(node.else_body)
        self.label(end)

    # "true" or "false" when `condition` compares `__os` with a string
    # literal using `==` or `!=`, and "" otherwise.
    def os_test(condition: ast.Expr) -> str:
        var node = condition.node
        if node is not ast.Binary or node.op not in ["==", "!="]:
            return ""
        var left = node.left.node
        var right = node.right.node
        var text = ""
        if is_os(node.left) and right is ast.String:
            text = right.value
        else if is_os(node.right) and left is ast.String:
            text = left.value
        else:
            return ""
        if (text == self.target_os) == (node.op == "=="):
            return "true"
        return "false"

    def emit_while(node: ast.While):
        var test = self.new_label()
        var body = self.new_label()
        var end = self.new_label()
        self.label(test)
        var condition = self.expr(node.condition)
        self.jump(f"jnz {condition}, {body}, {end}")
        self.label(body)
        self.loop_next.append(test)
        self.loop_end.append(end)
        self.block(node.body)
        self.loop_next.pop()
        self.loop_end.pop()
        self.jump(f"jmp {test}")
        self.label(end)

    def emit_index_assign(node: ast.IndexAssign):
        var value = self.expr(node.value)
        var object = self.expr(node.object)
        var index = self.expr(node.index)
        var ty = self.concrete_type(node.object.ty)
        self.core_call(types.kind(ty) + "_set", [object, index, value], false)

    def emit_for(node: ast.For):
        var call = node.iterable.node
        var declared = node.iterable.ty
        assert declared is not none, "unchecked iterable"
        if types.expand(declared) is types.TypeVar:
            self.for_protocol(node)
        else if call is ast.Call and call.name == "range" and (call.target is stdlib.Builtin):
            self.for_range(node, call)
        else if call is ast.MethodCall and call.name in ["keys", "values", "items"] and types.kind(self.concrete_type(call.object.ty)) == "dict":
            self.for_dict(node, call.object, call.name)
        else:
            var ty = self.concrete_type(node.iterable.ty)
            if types.kind(ty) == "dict":
                self.for_dict(node, node.iterable, "keys")
            else if types.kind(types.expand(ty)) in ["str", "bytes"]:
                self.for_sequence(node)
            else if types.expand(ty) is types.TupleType:
                self.for_tuple(node)
            else if types.kind(ty) == "list":
                self.for_list(node)
            else:
                self.for_protocol(node)

    def for_protocol(node: ast.For):
        var iteration = node.iteration
        assert iteration is not none, "unchecked iterable"
        var source = self.expr(node.iterable)
        var iterator = self.saved_method(iteration.iter_call, source, [])
        var test = self.new_label()
        var end = self.new_label()
        self.label(test)
        var item = self.advance(iterator, iteration.next_call, end)
        self.for_body(node, item, test, end)
        self.label(end)

    # Only advancement consumes StopIteration. Creation, assignment, and the
    # body keep the surrounding exception target.
    def advance(iterator: str, call: ast.Expr, end: str) -> str:
        var outside = self.target
        var failed = self.new_label()
        var ready = self.new_label()
        self.target = failed
        var frames = self.frames
        self.frames = false
        var value = self.saved_method(call, iterator, [])
        self.frames = frames
        self.target = outside
        self.jump("jmp " + ready)
        self.label(failed)
        var error = self.temp()
        var kind = self.temp()
        var stop = self.temp()
        var propagate = self.new_label()
        var exhausted = self.new_label()
        self.line(f"{error} =l loadl $W.pending")
        self.line(f"{kind} =l loadl {error}")
        self.line(f"{stop} =l ceql {kind}, $W.StopIteration.type")
        self.jump(f"jnz {stop}, {exhausted}, {propagate}")
        self.label(exhausted)
        self.line("storel 0, $W.pending")
        self.jump("jmp " + end)
        self.label(propagate)
        self.check_pending()
        self.jump("jmp " + ready)
        self.label(ready)
        return value

    def for_dict(node: ast.For, source: ast.Expr, part: str):
        var object = self.expr(source)
        var ty = self.concrete_type(source.ty)
        ty = types.expand(ty)
        assert ty is types.DictType, "unchecked dict loop"
        var version = self.core_call("dict_version", [object], true)
        var entry = self.core_call("dict_next", [object, "0", version], true)
        var test = self.new_label()
        var body = self.new_label()
        var next = self.new_label()
        var end = self.new_label()
        self.label(test)
        var more = self.temp()
        self.line(f"{more} =l csgel {entry}, 0")
        self.jump(f"jnz {more}, {body}, {end}")
        self.label(body)
        var item_type = self.concrete_type(node.item)
        var item: str
        if part == "values":
            item = self.core_call("dict_value_at", [object, entry], true)
        else if part == "items":
            var key = self.core_call("dict_key_at", [object, entry], true)
            var value = self.core_call("dict_value_at", [object, entry], true)
            assert item_type is types.TupleType, "unchecked dict items"
            item = self.tuple_value(item_type, [key, value])
        else:
            item = self.core_call("dict_key_at", [object, entry], true)
        self.fresh_pattern(node.target)
        self.store_pattern(node.target, item, item_type)
        self.loop_next.append(next)
        self.loop_end.append(end)
        self.block(node.body)
        self.loop_next.pop()
        self.loop_end.pop()
        self.jump(f"jmp {next}")
        self.label(next)
        var after = self.temp()
        self.line(f"{after} =l add {entry}, 1")
        var advanced = self.core_call("dict_next", [object, after, version], true)
        self.line(f"{entry} =l copy {advanced}")
        self.jump(f"jmp {test}")
        self.label(end)

    def for_list(node: ast.For):
        var source = self.expr(node.iterable)
        var index = self.temp()
        self.line(f"{index} =l copy 0")
        var test = self.new_label()
        var body = self.new_label()
        var end = self.new_label()
        self.label(test)
        var length = self.core_call("list_len", [source], true)
        var more = self.temp()
        self.line(f"{more} =l csltl {index}, {length}")
        self.jump(f"jnz {more}, {body}, {end}")
        self.label(body)
        var item = self.core_call("list_get", [source, index], true)
        self.line(f"{index} =l add {index}, 1")
        self.for_body(node, item, test, end)
        self.jump(f"jmp {test}")
        self.label(end)

    # Each step takes the code point at a byte offset, which advances by its
    # size before the body.
    def for_sequence(node: ast.For):
        var source = self.expr(node.iterable)
        var at = self.temp()
        self.line(f"{at} =l copy 0")
        var test = self.new_label()
        var body = self.new_label()
        var end = self.new_label()
        self.label(test)
        var size = self.core_call("str_size", [source], true)
        var more = self.temp()
        self.line(f"{more} =l csltl {at}, {size}")
        self.jump(f"jnz {more}, {body}, {end}")
        self.label(body)
        var ty = node.iterable.ty
        assert ty is not none, "unchecked sequence loop"
        var width = "1"
        var item = ""
        if types.kind(ty) == "bytes":
            item = self.core_call("str_byte", [source, at], true)
        else:
            item = self.core_call("str_char_at", [source, at], true)
            width = self.core_call("str_size", [item], true)
        self.line(f"{at} =l add {at}, {width}")
        self.for_body(node, item, test, end)
        self.jump(f"jmp {test}")
        self.label(end)

    def for_range(node: ast.For, call: ast.Call):
        var args: list[str] = []
        for arg in call.args:
            args.append(self.expr(arg))
        var first = "0"
        var last = args[0]
        var step = "1"
        if len(args) > 1:
            first = args[0]
            last = args[1]
        if len(args) > 2:
            step = args[2]
        var zero = self.temp()
        self.line(f"{zero} =l ceql {step}, 0")
        self.at_line = node.iterable.line
        self.at_col = node.iterable.col
        self.guard(zero, "ValueError", "range step must not be zero")
        var current = self.temp()
        self.line(f"{current} =l copy {first}")
        var test = self.new_label()
        var body = self.new_label()
        var next = self.new_label()
        var advance = self.new_label()
        var end = self.new_label()
        self.label(test)
        var up = self.temp()
        var below = self.temp()
        var above = self.temp()
        var down = self.temp()
        var more = self.temp()
        self.line(f"{up} =l csgtl {step}, 0")
        self.line(f"{below} =l csltl {current}, {last}")
        self.line(f"{above} =l csgtl {current}, {last}")
        self.line(f"{below} =l and {up}, {below}")
        self.line(f"{down} =l ceql {up}, 0")
        self.line(f"{above} =l and {down}, {above}")
        self.line(f"{more} =l or {below}, {above}")
        self.jump(f"jnz {more}, {body}, {end}")
        self.label(body)
        self.for_body(node, current, next, end)
        self.label(next)
        var stepped = self.temp()
        var a = self.temp()
        var b = self.temp()
        self.line(f"{stepped} =l add {current}, {step}")
        self.line(f"{a} =l xor {current}, {stepped}")
        self.line(f"{b} =l xor {step}, {stepped}")
        self.line(f"{a} =l and {a}, {b}")
        self.line(f"{a} =l csltl {a}, 0")
        self.jump(f"jnz {a}, {end}, {advance}")
        self.label(advance)
        self.line(f"{current} =l copy {stepped}")
        self.jump(f"jmp {test}")
        self.label(end)

    def for_body(node: ast.For, item: str, next: str, end: str):
        var ty = self.concrete_type(node.item)
        self.fresh_pattern(node.target)
        self.store_pattern(node.target, item, ty)
        self.loop_next.append(next)
        self.loop_end.append(end)
        self.block(node.body)
        self.loop_next.pop()
        self.loop_end.pop()
        self.jump(f"jmp {next}")

    def store_pattern(target: ast.Target, value: str, ty: types.Type):
        ty = self.concrete_type(ty)
        if target.name != "":
            var symbol = target.symbol
            assert symbol is not none, "target without a symbol"
            var declared = self.concrete_type(symbol.ty)
            value = self.convert(value, ty, declared)
            self.line(f"storel {value}, {self.local_address(symbol, target.name)}")
            return
        assert ty is types.TupleType, "unchecked tuple target"
        for i in range(len(target.elements)):
            var item = self.core_call("tuple_get", [value, str(i)], true)
            self.store_pattern(target.elements[i], item, ty.elements[i])

    def for_tuple(node: ast.For):
        var source = self.expr(node.iterable)
        var ty = self.concrete_type(node.iterable.ty)
        var item_type = self.concrete_type(node.item)
        assert ty is types.TupleType, "unchecked tuple loop"
        var index = self.temp()
        self.line(f"{index} =l copy 0")
        var test = self.new_label()
        var body = self.new_label()
        var end = self.new_label()
        self.label(test)
        var more = self.temp()
        self.line(f"{more} =l csltl {index}, {len(ty.elements)}")
        self.jump(f"jnz {more}, {body}, {end}")
        self.label(body)
        var raw = self.core_call("tuple_get", [source, index], true)
        var item = self.tuple_item(raw, index, ty, item_type)
        self.line(f"{index} =l add {index}, 1")
        self.for_body(node, item, test, end)
        self.label(end)

    def tuple_value(ty: types.TupleType, values: list[str]) -> str:
        var kinds: list[str] = []
        for element in ty.elements:
            kinds.append(equality_kind(element))
        var key = ",".join(kinds)
        if key not in self.tuple_kinds:
            self.tuple_kinds[key] = len(self.tuple_kinds)
        var metadata = f"$W.tuple.kinds.{self.tuple_kinds[key]}"
        var result = self.core_call("tuple_new", [str(len(values)), metadata], true)
        for i in range(len(values)):
            self.core_call("tuple_set", [result, str(i), values[i]], false)
        return result

    def tuple_display(expr: ast.Expr, node: ast.TupleDisplay) -> str:
        var ty = self.concrete_type(expr.ty)
        assert ty is types.TupleType, "unchecked tuple display"
        var values: list[str] = []
        for element in node.elements:
            values.append(self.expr(element))
        return self.tuple_value(ty, values)

    def list_display(node: ast.ListDisplay) -> str:
        var result = self.core_call("list_new", [str(len(node.elements))], true)
        for element in node.elements:
            var value = self.expr(element)
            self.core_call("list_append", [result, value], false)
        return result

    def list_method(node: ast.MethodCall) -> str:
        var args = [self.expr(node.object)]
        args.extend(self.arg_values(node.args, node.order))
        if node.name == "extend":
            var iterations = node.iterables
            assert iterations is not none, "unchecked list extension"
            var ty = self.concrete_type(node.object.ty)
            assert ty is types.ListType, "unchecked list extension receiver"
            var collected = self.collect(args[1], iterations[0], types.expand(ty.element))
            return self.core_call("list_extend", [args[0], collected], false)
        if node.name == "sort":
            var ty = self.concrete_type(node.object.ty)
            assert ty is types.ListType, "unchecked list sort receiver"
            self.sort(args[0], types.expand(ty.element), node.args[1], args[2], args[1], true)
            return "0"
        return self.core_call("list_" + node.name, args, node.name == "pop")

    def dict_display(expr: ast.Expr, node: ast.DictDisplay) -> str:
        var ty = self.concrete_type(expr.ty)
        ty = types.expand(ty)
        assert ty is types.DictType, "unchecked dict type"
        var kind = "0"
        if types.kind(ty.key) == "str":
            kind = "2"
        var result = self.core_call("dict_new", [kind], true)
        for i in range(len(node.keys)):
            var key = self.expr(node.keys[i])
            var value = self.expr(node.values[i])
            self.core_call("dict_set", [result, key, value], false)
        return result

    def method_call(expr: ast.Expr, node: ast.MethodCall) -> str:
        var ty = self.concrete_type(node.object.ty)
        ty = types.expand(ty)
        var declared = node.object.ty
        assert declared is not none, "unchecked method receiver"
        declared = types.expand(declared)
        if declared is types.TypeVar:
            var bound = declared.bound
            if bound is not none:
                var receiver_type = self.concrete_type(bound)
                if receiver_type is types.ProtocolType:
                    var object = self.convert(self.expr(node.object), ty, receiver_type)
                    var args = self.arg_values(node.args, node.order)
                    return self.protocol_call(object, receiver_type, node.name, args, written_mask(node))
        if node.name == "iter" and types.iteration_item(ty) is not none:
            return self.native_iter(self.expr(node.object), ty, "")
        if ty is types.ClassType:
            return self.class_method(node, ty)
        if ty is types.ProtocolType:
            return self.class_method(node, ty)
        if ty is types.ListType:
            return self.list_method(node)
        if ty is types.DictType:
            return self.dict_method(expr, node)
        if ty is types.Prim and ty.name in ["str", "bytes"]:
            var args = [self.expr(node.object)]
            args.extend(self.arg_values(node.args, node.order))
            return self.core_call(ty.name + "_" + node.name, args, true)
        return self.unchecked("method call")

    def dict_method(expr: ast.Expr, node: ast.MethodCall) -> str:
        var object = self.expr(node.object)
        var args = self.arg_values(node.args, node.order)
        if node.name in ["keys", "values", "items"]:
            return self.native_iter(object, self.concrete_type(node.object.ty), node.name)
        var key = args[0]
        if node.name == "pop":
            return self.core_call("dict_pop", [object, key], true)
        assert node.name == "get", "unchecked dict method"
        var default = args[1]
        var entry = self.core_call("dict_find", [object, key], true)
        var missing = self.temp()
        self.line(f"{missing} =l csltl {entry}, 0")
        var have = self.new_label()
        var lack = self.new_label()
        var done = self.new_label()
        var result = self.temp()
        self.jump(f"jnz {missing}, {lack}, {have}")
        self.label(have)
        var found = self.core_call("dict_value_at", [object, entry], true)
        var ty = self.concrete_type(node.object.ty)
        var target = self.concrete_type(expr.ty)
        ty = types.expand(ty)
        assert ty is types.DictType, "unchecked dict get object"
        found = self.convert(found, types.expand(ty.value), target)
        self.line(f"{result} =l copy {found}")
        self.jump(f"jmp {done}")
        self.label(lack)
        self.line(f"{result} =l copy {default}")
        self.label(done)
        return result

    def index(node: ast.Index) -> str:
        var object = self.expr(node.object)
        var ty = self.concrete_type(node.object.ty)
        if ty is types.TupleType:
            return self.core_call("tuple_get", [object, str(node.position)], true)
        var index = self.expr(node.index)
        var name = "list_get"
        if types.kind(ty) == "str":
            name = "str_index"
        else if types.kind(ty) == "bytes":
            name = "bytes_index"
        else if types.kind(ty) == "dict":
            name = "dict_get"
        return self.core_call(name, [object, index], true)

    def slice(node: ast.Slice) -> str:
        var object = self.expr(node.object)
        var start = node.start
        var stop = node.stop
        var first = "0"
        var last = "9223372036854775807"
        if start is not none:
            first = self.expr(start)
        if stop is not none:
            last = self.expr(stop)
        var ty = self.concrete_type(node.object.ty)
        return self.core_call(types.kind(ty) + "_slice", [object, first, last], true)

    def emit_len(node: ast.Call) -> str:
        var arg = node.args[0]
        var value = self.expr(arg)
        var ty = self.concrete_type(arg.ty)
        if types.kind(ty) == "bytes":
            return self.core_call("str_size", [value], true)
        return self.core_call(types.kind(ty) + "_len", [value], true)

    def contains(node: ast.Binary) -> str:
        var item = self.expr(node.left)
        var container = self.expr(node.right)
        var ty = self.concrete_type(node.right.ty)
        ty = types.expand(ty)
        var result = "0"
        if ty is types.DictType:
            result = self.core_call("dict_contains", [container, item], true)
        else if ty is types.Prim:
            result = self.core_call(ty.name + "_contains", [container, item], true)
        else:
            assert ty is types.ListType, "unchecked membership"
            var element = types.expand(ty.element)
            var left = self.concrete_type(node.left.ty)
            if types.tuple_member(left) is not none or types.tuple_member(element) is not none or not types.assignable(element, left):
                result = self.tuple_contains(node, item, container, element)
            else:
                result = self.core_call("list_contains", [container, item, equality_kind(element)], true)
        if node.op == "not in":
            var negated = self.temp()
            self.line(f"{negated} =l ceql {result}, 0")
            return negated
        return result

    def tuple_contains(node: ast.Binary, item: str, container: str, element: types.Type) -> str:
        var left = self.concrete_type(node.left.ty)
        var target = element
        if types.assignable(left, element):
            target = left
        var index = self.temp()
        var result = self.temp()
        self.line(f"{index} =l copy 0")
        self.line(f"{result} =l copy 0")
        var test = self.new_label()
        var body = self.new_label()
        var end = self.new_label()
        self.label(test)
        var length = self.core_call("list_len", [container], true)
        var more = self.temp()
        self.line(f"{more} =l csltl {index}, {length}")
        self.jump(f"jnz {more}, {body}, {end}")
        self.label(body)
        var value = self.core_call("list_get", [container, index], true)
        value = self.convert(value, element, target)
        var equal = self.core_call("union_eq", [item, value], true)
        self.line(f"{result} =l copy {equal}")
        self.line(f"{index} =l add {index}, 1")
        self.jump(f"jnz {equal}, {end}, {test}")
        self.label(end)
        return result

    # Expressions

    # Writes the instructions that compute `expr` and returns its operand, as
    # a value of the type it is checked against, if any.
    def expr(expr: ast.Expr) -> str:
        var line = self.at_line
        var col = self.at_col
        self.at_line = expr.line
        self.at_col = expr.col
        var value = self.node_value(expr)
        var ty = expr.ty
        var expected = expr.expected
        if ty is not none and expected is not none:
            value = self.convert(value, ty, expected)
        self.at_line = line
        self.at_col = col
        return value

    # A tuple is copied only when its positions change representation.
    def convert(value: str, source: types.Type, target: types.Type) -> str:
        source = self.concrete_type(source)
        target = self.concrete_type(target)
        if types.same(source, target):
            return value
        if source is types.UnionType and protocol_conversion(source, target):
            return self.convert_union(value, source, target)
        if target is types.UnionType and protocol_conversion(source, target):
            # An open union has only its protocol member and none.
            # Protocol conversion therefore has a single destination.
            for member in target.members:
                if member is types.ProtocolType:
                    return self.convert(value, source, member)
        if target is types.ProtocolType and source is not types.UnionType:
            var witness = self.witness(source, target)
            var object = self.core_call("object_new", [witness.symbol + ".type", "1"], true)
            var address = self.temp()
            self.line(f"{address} =l add {object}, 8")
            self.line(f"storel {value}, {address}")
            return object
        if adapts(source, target):
            value = self.adapt(value, source, target)
            # The union's tuple member may convert too.
            if not is_union(source):
                return value
        var from_tuple = types.tuple_member(source)
        var to_tuple = types.tuple_member(target)
        if from_tuple is not none and to_tuple is not none and representation_changes(from_tuple, to_tuple):
            if is_union(source):
                var take = self.new_label()
                var done = self.new_label()
                var result = self.temp()
                self.line(f"{result} =l copy {value}")
                var held = self.core_call("is_instance", [value, self.descriptor("tuple", false)], true)
                self.jump(f"jnz {held}, {take}, {done}")
                self.label(take)
                var converted = self.convert_tuple(value, from_tuple, to_tuple)
                self.line(f"{result} =l copy {converted}")
                self.label(done)
                return result
            return self.convert_tuple(value, from_tuple, to_tuple)
        if is_union(target) and not is_union(source):
            var descriptor = self.box_descriptor(source)
            if descriptor != "":
                return self.core_call("box", [descriptor, value], true)
        else if is_union(source) and not is_union(target):
            if self.box_descriptor(target) != "":
                return self.core_call("unbox", [value], true)
        return value

    def member_test(value: str, member: types.Type) -> str:
        if is_none(member):
            var result = self.temp()
            self.line(f"{result} =l ceql {value}, 0")
            return result
        if member is types.ProtocolType:
            var result = self.temp()
            var present = self.temp()
            var take = self.new_label()
            var done = self.new_label()
            self.line(f"{result} =l copy 0")
            self.line(f"{present} =l cnel {value}, 0")
            self.jump(f"jnz {present}, {take}, {done}")
            self.label(take)
            var descriptor = self.temp()
            var marker = self.temp()
            self.line(f"{descriptor} =l loadl {value}")
            self.line(f"{marker} =l loadl {descriptor}")
            self.line(f"{result} =l ceql {marker}, {self.protocol_marker(member)}")
            self.label(done)
            return result
        var name = types.kind(member)
        var library = false
        if name == "callable":
            name = "function"
        if member is types.ClassType:
            name = member.decl.type_name
            library = member.decl.library
        else if member is types.EnumType:
            name = member.decl.type_name
            library = member.decl.library
        return self.instance_test(value, name, library)

    def instance_test(value: str, name: str, library: bool) -> str:
        if name != "Exception":
            return self.core_call("is_instance", [value, self.descriptor(name, library)], true)
        var result = self.temp()
        var present = self.temp()
        var take = self.new_label()
        var done = self.new_label()
        self.line(f"{result} =l copy 0")
        self.line(f"{present} =l cnel {value}, 0")
        self.jump(f"jnz {present}, {take}, {done}")
        self.label(take)
        var descriptor = self.temp()
        self.line(f"{descriptor} =l loadl {value}")
        for exception in self.exception_descriptors:
            var matches = self.temp()
            self.line(f"{matches} =l ceql {descriptor}, {exception}")
            self.line(f"{result} =l or {result}, {matches}")
        self.label(done)
        return result

    def convert_union(value: str, source: types.UnionType, target: types.Type) -> str:
        var result = self.temp()
        var done = self.new_label()
        for member in source.members:
            var take = self.new_label()
            var next = self.new_label()
            var held = self.member_test(value, member)
            self.jump(f"jnz {held}, {take}, {next}")
            self.label(take)
            var raw = value
            if self.box_descriptor(member) != "":
                raw = self.core_call("unbox", [value], true)
            var converted = self.convert(raw, member, target)
            self.line(f"{result} =l copy {converted}")
            self.jump("jmp " + done)
            self.label(next)
        self.jump("hlt")
        self.label(done)
        return result

    def convert_tuple(value: str, source: types.TupleType, target: types.TupleType) -> str:
        var values: list[str] = []
        for i in range(len(source.elements)):
            var element = self.core_call("tuple_get", [value, str(i)], true)
            values.append(self.convert(element, source.elements[i], target.elements[i]))
        return self.tuple_value(target, values)

    # The descriptor of a scalar type that is boxed in a union, or "".
    def box_descriptor(t: types.Type) -> str:
        t = types.expand(t)
        if t is types.EnumType:
            return self.descriptor(t.decl.type_name, t.decl.library)
        if types.kind(t) in ["int", "float", "bool"]:
            return self.descriptor(types.kind(t), false)
        return ""

    # The descriptor symbol of the built-in type, class, or enum `type_name`,
    # which `library` marks as core's or the standard library's.
    def descriptor(type_name: str, library: bool) -> str:
        if library or type_name in builtin_types() or type_name in self.exceptions:
            return f"$W.{type_name}.type"
        if "." in type_name:
            return f"$P.{type_name}.type"
        return f"$P.{self.entry}.{type_name}.type"

    def node_value(expr: ast.Expr) -> str:
        var node = expr.node
        if node is ast.Int:
            return node.text
        else if node is ast.String:
            return self.string(node.value)
        else if node is ast.Constant:
            if node == ast.Constant.TRUE:
                return "1"
            return "0"
        else if node is ast.Name:
            var symbol = node.symbol
            if symbol is none:
                return self.string(self.target_os)
            var t = self.temp()
            self.line(f"{t} =l loadl {self.local_address(symbol, node.name)}")
            var declared = self.concrete_type(symbol.ty)
            var ty = self.concrete_type(expr.ty)
            return self.convert(t, declared, ty)
        else if node is ast.Binary:
            return self.binary(node)
        else if node is ast.Call:
            return self.call(node)
        else if node is ast.TypeOf:
            var target = node.target
            assert target is ast.TypeName, "unchecked __type"
            return f"$W.{target.name}.type"
        else if node is ast.Float:
            return self.float_bits("d_" + str(node.value))
        else if node is ast.FString:
            return self.fstring(node)
        else if node is ast.EnumMember:
            var record = node.decl.record
            assert record is not none, "unchecked enum"
            for i in range(len(record.members)):
                if record.members[i] == node.name:
                    return str(i)
            return self.unchecked("enum member")
        else if node is ast.MethodCall:
            return self.method_call(expr, node)
        else if node is ast.Field:
            var object = self.expr(node.object)
            var method = expr.ty
            if method is types.FunctionType:
                return self.bound_method(node.object, method.fn, object)
            var address = self.field_address(node.object, node.name, object)
            var value = self.temp()
            self.line(f"{value} =l loadl {address}")
            return value
        else if node is ast.Index:
            return self.index(node)
        else if node is ast.Slice:
            return self.slice(node)
        else if node is ast.Unary:
            return self.unary(node)
        else if node is ast.Is:
            return self.emit_is(node)
        else if node is ast.TypeTest:
            return self.emit_type_test(node)
        else if node is ast.ListDisplay:
            return self.list_display(node)
        else if node is ast.TupleDisplay:
            return self.tuple_display(expr, node)
        else if node is ast.DictDisplay:
            return self.dict_display(expr, node)
        else if node is ast.CallValue:
            return self.call_value(node)
        else if node is ast.FunctionValue:
            if len(node.type_args) > 0:
                return self.specialized_value(expr, node)
            var code = self.symbol(node.target) + ".value"
            if self.module_of(node.target) == "W.aio" and node.target.name == "sleep":
                code = code + f".{len(self.later)}"
                self.wrap(code, ValueWrapper(code, node.target, self.path, self.at_line, self.at_col))
            else:
                self.wrap(code, ValueWrapper(code, node.target))
            return code + ".closure"
        else if node is ast.BuiltinValue:
            var call = node.call
            assert call is not none, "unchecked built-in value"
            var code = f"$W.builtin.{len(self.later)}"
            var callable = self.concrete_type(expr.ty)
            assert callable is types.CallableType, "unchecked built-in signature"
            self.later.append(BuiltinWrapper(code, call, len(callable.params)))
            return code + ".closure"
        else if node is ast.Lambda:
            var function = node.function
            assert function is not none, "unbound lambda"
            return self.closure(function)
        else if node is ast.Await:
            var name = "async_await"
            var operand = self.concrete_type(node.operand.ty)
            var value = self.expr(node.operand)
            if operand is types.ClassType and operand.decl.library and operand.decl.type_name == "aio.Task":
                name = "aio_await_task"
                value = self.load_field(value, 8)
            return self.core_call(name, [value], true)
        else if node is ast.Typed:
            return f"%p.{node.index}"
        return self.unchecked("expression")

    def binary(node: ast.Binary) -> str:
        var op = node.op
        if op == "and" or op == "or":
            return self.logic(node)
        if op == "in" or op == "not in":
            return self.contains(node)
        var left_type = self.concrete_type(node.left.ty)
        var right_type = self.concrete_type(node.right.ty)
        if (op == "==" or op == "!=") and (may_be_none(left_type) or may_be_none(right_type) or (left_type is types.TupleType)):
            return self.union_equality(node)
        var kind = types.kind(left_type)
        var left = self.expr(node.left)
        var right = self.expr(node.right)
        if left_type is types.TupleType:
            return self.tuple_order(op, left, right, left_type)
        var t: str
        if kind in ["str", "bytes"]:
            if op == "+":
                return self.core_call(kind + "_concat", [left, right], true)
            if op in ["<", "<=", ">", ">="]:
                # Strings order by the sign of core's three-way comparison.
                var order = self.core_call("str_compare", [left, right], true)
                t = self.temp()
                self.line(f"{t} =l {comparison_instruction(op)} {order}, 0")
                return t
            var equal = self.core_call("str_eq", [left, right], true)
            if op == "==":
                return equal
            t = self.temp()
            self.line(f"{t} =l ceql {equal}, 0")
            return t
        if kind == "float":
            return self.float_binary(op, left, right)
        if op == "/":
            self.check_divisor(right)
            return self.float_bits(self.int_quotient(left, right))
        if op == "//" or op == "%":
            var literal = node.right.node
            if literal is ast.Int:
                var shift = power_of_two(literal.text)
                if shift != 0:
                    # In two's complement, an arithmetic shift is floor
                    # division by 2^k, and masking with 2^k - 1 is the floor
                    # remainder, negative operands included.
                    t = self.temp()
                    if op == "//":
                        self.line(f"{t} =l sar {left}, {shift}")
                    else:
                        self.line(f"{t} =l and {left}, {bit(shift) - 1}")
                    return t
            return self.floor_divide(op, left, right)
        if op in ["+", "-", "*"]:
            return self.checked(arithmetic_instruction(op), left, right)
        t = self.temp()
        self.line(f"{t} =l {comparison_instruction(op)} {left}, {right}")
        return t

    # The checker gives both operands a common type before comparing slots.
    def union_equality(node: ast.Binary) -> str:
        var left = self.expr(node.left)
        var right = self.expr(node.right)
        var equal = self.core_call("union_eq", [left, right], true)
        if node.op == "==":
            return equal
        var t = self.temp()
        self.line(f"{t} =l ceql {equal}, 0")
        return t

    def tuple_order(op: str, left: str, right: str, ty: types.TupleType) -> str:
        var result = self.temp()
        var equal_result = "0"
        if op == "<=" or op == ">=":
            equal_result = "1"
        self.line(f"{result} =l copy {equal_result}")
        var done = self.new_label()
        for i in range(len(ty.elements)):
            var a = self.core_call("tuple_get", [left, str(i)], true)
            var b = self.core_call("tuple_get", [right, str(i)], true)
            var element = ty.elements[i]
            var equal = self.core_call("slots_equal", [a, b, equality_kind(element)], true)
            var same = self.new_label()
            var different = self.new_label()
            self.jump(f"jnz {equal}, {same}, {different}")
            self.label(different)
            var ordered: str
            if element is types.TupleType:
                ordered = self.tuple_order(op, a, b, element)
            else if types.kind(element) == "float":
                ordered = self.float_binary(op, a, b)
            else:
                if types.kind(element) == "str":
                    a = self.core_call("str_compare", [a, b], true)
                    b = "0"
                ordered = self.temp()
                self.line(f"{ordered} =l {comparison_instruction(op)} {a}, {b}")
            self.line(f"{result} =l copy {ordered}")
            self.jump(f"jmp {done}")
            self.label(same)
        self.label(done)
        return result

    def emit_is(node: ast.Is) -> str:
        var operand = self.expr(node.operand)
        var t = self.temp()
        if node.negated:
            self.line(f"{t} =l cnel {operand}, 0")
        else:
            self.line(f"{t} =l ceql {operand}, 0")
        return t

    # The test's covered members have the same runtime classes after
    # substituting type arguments; only their representations may change.
    def emit_type_test(node: ast.TypeTest) -> str:
        var operand = self.expr(node.operand)
        var ty = self.concrete_type(node.operand.ty)
        var result = "1"
        if is_union(ty):
            result = "0"
            for member in check.tested_members(ty, node.type_name):
                var held = self.member_test(operand, member)
                var combined = self.temp()
                self.line(f"{combined} =l or {result}, {held}")
                result = combined
        if node.negated:
            var negated = self.temp()
            self.line(f"{negated} =l ceql {result}, 0")
            return negated
        return result

    def unary(node: ast.Unary) -> str:
        var value = self.expr(node.operand)
        var ty = self.concrete_type(node.operand.ty)
        if node.op == "+":
            return value
        if node.op == "not":
            var t = self.temp()
            self.line(f"{t} =l ceql {value}, 0")
            return t
        if types.kind(ty) == "float":
            var d = self.as_float(value)
            var t = self.temp()
            self.line(f"{t} =d neg {d}")
            return self.float_bits(t)
        return self.checked("sub", "0", value)

    def logic(node: ast.Binary) -> str:
        var left = self.expr(node.left)
        var result = self.temp()
        self.line(f"{result} =l copy {left}")
        var rhs = self.new_label()
        var end = self.new_label()
        if node.op == "and":
            self.jump(f"jnz {left}, {rhs}, {end}")
        else:
            self.jump(f"jnz {left}, {end}, {rhs}")
        self.label(rhs)
        var right = self.expr(node.right)
        self.line(f"{result} =l copy {right}")
        self.label(end)
        return result

    def as_float(value: str) -> str:
        var d = self.temp()
        self.line(f"{d} =d cast {value}")
        return d

    def float_bits(value: str) -> str:
        var t = self.temp()
        self.line(f"{t} =l cast {value}")
        return t

    def float_binary(op: str, left: str, right: str) -> str:
        if op == "//":
            return self.core_call("float_floordiv", [left, right], true)
        if op == "%":
            return self.core_call("float_mod", [left, right], true)
        var a = self.as_float(left)
        var b = self.as_float(right)
        if op in ["+", "-", "*", "/"]:
            if op == "/":
                var zero = self.temp()
                self.line(f"{zero} =l ceqd {b}, d_0")
                self.guard(zero, "ZeroDivisionError", "division by zero")
            var d = self.temp()
            self.line(f"{d} =d {arithmetic_instruction(op)} {a}, {b}")
            return self.float_bits(d)
        var t = self.temp()
        self.line(f"{t} =l {float_comparison_instruction(op)} {a}, {b}")
        return t

    def check_divisor(right: str):
        var zero = self.temp()
        self.line(f"{zero} =l ceql {right}, 0")
        self.guard(zero, "ZeroDivisionError", "division by zero")

    def floor_divide(op: str, left: str, right: str) -> str:
        self.check_divisor(right)
        var q = self.temp()
        var product = self.temp()
        var m = self.temp()
        var signs = self.temp()
        var differ = self.temp()
        var nonzero = self.temp()
        var adjust = self.temp()
        self.line(f"{q} =l div {left}, {right}")
        # The quotient rounds toward zero, so |q * right| <= |left| and the
        # plain multiply cannot wrap.
        self.line(f"{product} =l mul {q}, {right}")
        self.line(f"{m} =l sub {left}, {product}")
        self.line(f"{signs} =l xor {m}, {right}")
        self.line(f"{differ} =l csltl {signs}, 0")
        self.line(f"{nonzero} =l cnel {m}, 0")
        self.line(f"{adjust} =l and {differ}, {nonzero}")
        var t = self.temp()
        if op == "%":
            var step = self.temp()
            self.line(f"{step} =l mul {right}, {adjust}")
            self.line(f"{t} =l add {m}, {step}")
        else:
            self.line(f"{t} =l sub {q}, {adjust}")
        return t

    # `left instr right` on ints, failing with an OverflowError when the
    # result leaves the symmetric int range.
    def checked(instr: str, left: str, right: str) -> str:
        var t: str
        if not self.overflow_checks:
            t = self.temp()
            self.line(f"{t} =l {instr} {left}, {right}")
            return t
        if instr == "mul":
            return self.checked_multiply(left, right)
        t = self.temp()
        self.line(f"{t} =l {instr} {left}, {right}")
        var a = self.temp()
        var b = self.temp()
        var wrapped = self.temp()
        var minimum = self.temp()
        # The sum wrapped when its sign differs from both operands'; the
        # difference, when the operands' signs differ and its sign differs
        # from the left operand's.
        if instr == "add":
            self.line(f"{a} =l xor {left}, {t}")
            self.line(f"{b} =l xor {right}, {t}")
        else:
            self.line(f"{a} =l xor {left}, {right}")
            self.line(f"{b} =l xor {left}, {t}")
        self.line(f"{a} =l and {a}, {b}")
        self.line(f"{wrapped} =l csltl {a}, 0")
        self.line(f"{minimum} =l ceql {t}, -9223372036854775808")
        self.line(f"{wrapped} =l or {wrapped}, {minimum}")
        self.guard(wrapped, "OverflowError", "integer overflow")
        return t

    def checked_multiply(left: str, right: str) -> str:
        var t = self.temp()
        var wide = self.temp()
        var ext = self.temp()
        var fits_left = self.temp()
        var fits_right = self.temp()
        var fits = self.temp()
        var zero = self.temp()
        var minimum = self.temp()
        var skip = self.temp()
        var a = self.temp()
        var b = self.temp()
        var divisor = self.temp()
        var wrapped = self.temp()
        var slow = self.new_label()
        var done = self.new_label()
        self.line(f"{t} =l mul {left}, {right}")
        # Operands that fit in a signed 32-bit int cannot overflow: their
        # product's magnitude is at most 2^62, so skip the division check.
        self.line(f"{wide} =w copy {left}")
        self.line(f"{ext} =l extsw {wide}")
        self.line(f"{fits_left} =l ceql {ext}, {left}")
        self.line(f"{wide} =w copy {right}")
        self.line(f"{ext} =l extsw {wide}")
        self.line(f"{fits_right} =l ceql {ext}, {right}")
        self.line(f"{fits} =l and {fits_left}, {fits_right}")
        self.jump(f"jnz {fits}, {done}, {slow}")
        self.label(slow)
        # Use 1 as the divisor when the left operand is zero or the product
        # is -2^63, so the overflow check cannot divide by zero or trap.
        self.line(f"{zero} =l ceql {left}, 0")
        self.line(f"{minimum} =l ceql {t}, -9223372036854775808")
        self.line(f"{skip} =l or {zero}, {minimum}")
        self.line(f"{a} =l sub 0, {skip}")
        self.line(f"{b} =l xor {left}, 1")
        self.line(f"{b} =l and {b}, {a}")
        self.line(f"{divisor} =l xor {left}, {b}")
        self.line(f"{a} =l div {t}, {divisor}")
        self.line(f"{a} =l cnel {a}, {right}")
        self.line(f"{b} =l ceql {zero}, 0")
        self.line(f"{wrapped} =l and {a}, {b}")
        self.line(f"{wrapped} =l or {wrapped}, {minimum}")
        self.guard(wrapped, "OverflowError", "integer overflow")
        self.jump(f"jmp {done}")
        self.label(done)
        return t

    # Above 2^53, converting both operands before division would round
    # twice. Long division keeps 56 bits with a sticky low bit, then one
    # conversion rounds the quotient. Scaling by powers of two is exact.
    def int_quotient(left: str, right: str) -> str:
        var fast = self.new_label()
        var slow = self.new_label()
        var shr_test = self.new_label()
        var shr = self.new_label()
        var shl_test = self.new_label()
        var shl = self.new_label()
        var rounding = self.new_label()
        var up_test = self.new_label()
        var up = self.new_label()
        var down_test = self.new_label()
        var down = self.new_label()
        var sign = self.new_label()
        var negate = self.new_label()
        var done = self.new_label()
        var result = self.temp()
        var abs_left = self.temp()
        var abs_right = self.temp()
        var cond = self.temp()
        var q = self.temp()
        var rem = self.temp()
        var e = self.temp()
        var lost = self.temp()
        var bit = self.temp()
        var t = self.temp()
        var d = self.temp()
        var divisor = self.temp()
        self.line(f"{t} =l sar {left}, 63")
        self.line(f"{abs_left} =l xor {left}, {t}")
        self.line(f"{abs_left} =l sub {abs_left}, {t}")
        self.line(f"{t} =l sar {right}, 63")
        self.line(f"{abs_right} =l xor {right}, {t}")
        self.line(f"{abs_right} =l sub {abs_right}, {t}")
        self.line(f"{cond} =l culel {abs_left}, 9007199254740992")
        self.line(f"{t} =l culel {abs_right}, 9007199254740992")
        self.line(f"{cond} =l and {cond}, {t}")
        self.line(f"{t} =l ceql {left}, 0")
        self.line(f"{cond} =l or {cond}, {t}")
        self.jump(f"jnz {cond}, {fast}, {slow}")
        self.label(fast)
        self.line(f"{d} =d sltof {left}")
        self.line(f"{divisor} =d sltof {right}")
        self.line(f"{result} =d div {d}, {divisor}")
        self.jump(f"jmp {done}")
        self.label(slow)
        self.line(f"{q} =l udiv {abs_left}, {abs_right}")
        self.line(f"{rem} =l urem {abs_left}, {abs_right}")
        self.line(f"{e} =l copy 0")
        self.line(f"{lost} =l copy 0")
        self.label(shr_test)
        self.line(f"{cond} =l cugel {q}, 72057594037927936")
        self.jump(f"jnz {cond}, {shr}, {shl_test}")
        self.label(shr)
        self.line(f"{bit} =l and {q}, 1")
        self.line(f"{lost} =l or {lost}, {bit}")
        self.line(f"{q} =l shr {q}, 1")
        self.line(f"{e} =l add {e}, 1")
        self.jump(f"jmp {shr_test}")
        self.label(shl_test)
        self.line(f"{cond} =l cultl {q}, 36028797018963968")
        self.jump(f"jnz {cond}, {shl}, {rounding}")
        self.label(shl)
        # Subtracting the divisor restores a doubled remainder even when
        # it passes 2^63: these instructions operate modulo 2^64.
        self.line(f"{t} =l sub {abs_right}, {rem}")
        self.line(f"{bit} =l cugel {rem}, {t}")
        self.line(f"{q} =l shl {q}, 1")
        self.line(f"{q} =l or {q}, {bit}")
        self.line(f"{rem} =l shl {rem}, 1")
        self.line(f"{t} =l mul {bit}, {abs_right}")
        self.line(f"{rem} =l sub {rem}, {t}")
        self.line(f"{e} =l sub {e}, 1")
        self.jump(f"jmp {shl_test}")
        self.label(rounding)
        self.line(f"{t} =l cnel {rem}, 0")
        self.line(f"{lost} =l or {lost}, {t}")
        self.line(f"{q} =l or {q}, {lost}")
        self.line(f"{d} =d sltof {q}")
        self.label(up_test)
        self.line(f"{cond} =l csgtl {e}, 0")
        self.jump(f"jnz {cond}, {up}, {down_test}")
        self.label(up)
        self.line(f"{d} =d mul {d}, d_2")
        self.line(f"{e} =l sub {e}, 1")
        self.jump(f"jmp {up_test}")
        self.label(down_test)
        self.line(f"{cond} =l csltl {e}, 0")
        self.jump(f"jnz {cond}, {down}, {sign}")
        self.label(down)
        self.line(f"{d} =d mul {d}, d_0.5")
        self.line(f"{e} =l add {e}, 1")
        self.jump(f"jmp {down_test}")
        self.label(sign)
        self.line(f"{t} =l xor {left}, {right}")
        self.line(f"{cond} =l csltl {t}, 0")
        self.line(f"{result} =d copy {d}")
        self.jump(f"jnz {cond}, {negate}, {done}")
        self.label(negate)
        self.line(f"{result} =d neg {d}")
        self.label(done)
        return result

    # Raises `class_name` with `message` when `condition` is nonzero.
    def guard(condition: str, class_name: str, message: str):
        var failed = self.new_label()
        var ok = self.new_label()
        self.jump(f"jnz {condition}, {failed}, {ok}")
        self.label(failed)
        self.core_call("fail", [self.string(class_name), self.string(message)], false)
        self.jump("hlt")
        self.label(ok)

    # Calls

    # Save written arguments before evaluating omitted defaults, then pass
    # the saved values in parameter order.
    def arg_values(args: list[ast.Expr], order: list[int] | none) -> list[str]:
        assert order is not none, "unbound call arguments"
        var values: list[str] = []
        for arg in args:
            values.append("")
        for i in order:
            values[i] = self.expr(args[i])
        return values

    def call(node: ast.Call) -> str:
        var target = node.target
        if target is ast.FunctionDecl:
            if target.external:
                return self.extern_call(node, target, "$" + target.name)
            var args = self.arg_values(node.args, node.order)
            if self.module_of(target) == "W.aio" and target.name == "sleep":
                args.extend([self.string(self.path), str(self.at_line), str(self.at_col)])
                return self.core_call("aio_sleep_coroutine", args, true)
            var record = target.record
            assert record is not none, f"function {target.name} has no signature"
            var symbol = self.specialization(record, [], node.type_args)
            var result = types.substitute(record.result, types.bind_vars(record.typevars, types.substitute_all(node.type_args, self.bindings)))
            if self.module_of(target) == "W.core":
                return self.core_call(target.name, args, not is_none(self.concrete_type(result)))
            return self.willow_call(symbol, typed(args), not is_none(self.concrete_type(result)))
        if target is stdlib.Builtin:
            return self.builtin(node, target)
        assert target is types.Class, "unchecked constructor"
        return self.construct(node, target)

    def construct(node: ast.Call, target: types.Class) -> str:
        var values = self.arg_values(node.args, node.order)
        var base = field_base(target)
        var size = len(values) + (base - 8) // 8
        var object = self.core_call("object_new", [self.descriptor(target.type_name, target.library), str(size)], true)
        for i in range(len(values)):
            var address = self.temp()
            self.line(f"{address} =l add {object}, {base + i * 8}")
            self.line(f"storel {values[i]}, {address}")
        return object

    def field_address(expr: ast.Expr, name: str, object: str) -> str:
        var ty = self.concrete_type(expr.ty)
        ty = types.expand(ty)
        assert ty is types.ClassType, "unchecked field receiver"
        for i in range(len(ty.decl.fields)):
            if ty.decl.fields[i].name == name:
                var address = self.temp()
                self.line(f"{address} =l add {object}, {field_base(ty.decl) + i * 8}")
                return address
        return self.unchecked("field")

    def field_assign(node: ast.FieldAssign):
        var value = self.expr(node.value)
        var object = self.expr(node.object)
        var address = self.field_address(node.object, node.name, object)
        self.line(f"storel {value}, {address}")

    def class_method(node: ast.MethodCall, ty: types.ClassType | types.ProtocolType) -> str:
        var object = self.expr(node.object)
        var args = self.arg_values(node.args, node.order)
        var own = node.type_args
        if own is none:
            own = []
        return self.dispatch_method(object, ty, node.name, args, own, written_mask(node))

    # `written` is as protocol_call takes it.
    def dispatch_method(object: str, ty: types.Type, name: str, args: list[str], own: list[types.Type], written: str) -> str:
        if ty is types.ProtocolType:
            return self.protocol_call(object, ty, name, args, written)
        if name == "iter" and types.iteration_item(ty) is not none:
            return self.native_iter(object, ty, "")
        assert ty is types.ClassType, "unchecked method receiver"
        for method in ty.decl.methods:
            if method.name == name:
                var passed = [object]
                passed.extend(args)
                var result = types.substitute(method.result, types.record_map(ty))
                result = types.substitute(result, types.bind_vars(method.typevars, types.substitute_all(own, self.bindings)))
                if ty.decl.prefix != "":
                    return self.core_call(ty.decl.prefix + "_" + name, passed, not is_none(result))
                if ty.decl.library and ty.decl.type_name == "aio.TaskGroup" and name == "start":
                    var starter: types.Function | none = none
                    for helper in ty.decl.methods:
                        if helper.name == "_start":
                            starter = helper
                    assert starter is not none, "aio.TaskGroup has no start helper"
                    method = starter
                    passed.extend([self.string(self.path), str(self.at_line), str(self.at_col)])
                var symbol = self.specialization(method, ty.args, own)
                return self.willow_call(symbol, typed(passed), not is_none(self.concrete_type(result)))
        return self.unchecked("class method")

    def fstring(node: ast.FString) -> str:
        var text = self.string("")
        for i in range(len(node.parts)):
            var part = node.parts[i]
            var spec = node.specs[i]
            var ty = part.ty
            assert ty is not none, "unchecked f-string field"
            var align = spec.align
            var value: str
            if types.kind(ty) == "union" and spec.width > 0:
                value = self.core_call("format_union", [self.expr(part), str(spec.width), self.string(align)], true)
            else:
                if spec.kind == "f":
                    value = self.core_call("format_fixed", [self.expr(part), str(spec.precision)], true)
                else:
                    value = self.to_str(part)
                if spec.width > 0:
                    if align == "":
                        align = ">"
                        if types.kind(ty) == "str":
                            align = "<"
                    value = self.core_call("pad", [value, str(spec.width), self.string(align)], true)
            if i == 0:
                text = value
            else:
                text = self.core_call("str_concat", [text, value], true)
        return text

    # A call of a built-in function, a host module's function, or an
    # intrinsic, by the name it is written with.
    def builtin(node: ast.Call, target: stdlib.Builtin) -> str:
        var name = node.name
        if name.startswith("__"):
            return self.intrinsic(node, target)
        else if name == "print":
            return self.emit_print(node)
        else if name == "len":
            return self.emit_len(node)
        else if name == "str":
            return self.conversion(node)
        else if name == "int":
            return self.conversion(node)
        else if name == "float":
            return self.conversion(node)
        else if name == "bytes":
            return self.core_call("bytes_new", self.arg_values(node.args, node.order), true)
        else if name == "bytes.fromhex":
            return self.core_call("bytes_fromhex", self.arg_values(node.args, node.order), true)
        else if name == "input":
            return self.core_call("input_line", [], true)
        else if name == "range":
            var values: list[str] = []
            for arg in node.args:
                values.append(self.expr(arg))
            var first = "0"
            var stop = values[0]
            var step = "1"
            if len(values) > 1:
                first = values[0]
                stop = values[1]
            if len(values) > 2:
                step = values[2]
            var value = self.core_call("range_new", [first, stop, step], true)
            var adapter = self.native_adapter(types.prim("ptr"), types.prim("int"), "range")
            return self.protocol_value(adapter.symbol + ".range.type", value)
        else if name == "round":
            return self.core_call("float_round", self.arg_values(node.args, node.order), true)
        else if name == "sorted":
            return self.emit_sorted(node)
        else if name in ["abs", "min", "max", "sum", "any", "all", "list", "enumerate", "zip"]:
            return self.iterable_builtin(node)
        else if name == "ord":
            return self.core_call("str_ord", [self.expr(node.args[0])], true)
        else if name == "chr":
            return self.core_call("str_chr", [self.expr(node.args[0])], true)
        else if name == "sys.args":
            return self.host(node, target)
        else if name == "sys.exit":
            return self.willow_call("$W.sys.exit", typed(self.arg_values(node.args, node.order)), false)
        else if name == "sys.eprint":
            return self.willow_call("$W.sys.eprint", typed([self.to_str(node.args[0])]), false)
        else if name == "fs.read_file":
            return self.host(node, target)
        else if name == "fs.write_file":
            return self.host(node, target)
        else if name == "fs.exists":
            return self.host(node, target)
        else if name == "fs.realpath":
            return self.host(node, target)
        return self.unchecked(f"'{name}'")

    def saved_method(expr: ast.Expr, object: str, supplied: list[str]) -> str:
        var line = self.at_line
        var col = self.at_col
        self.at_line = expr.line
        self.at_col = expr.col
        var node = expr.node
        assert node is ast.MethodCall, "unchecked saved method"
        var declared = node.object.ty
        assert declared is not none, "unchecked saved receiver"
        var ty = self.concrete_type(declared)
        if declared is types.TypeVar:
            var bound = declared.bound
            if bound is not none:
                var target = self.concrete_type(bound)
                object = self.convert(object, ty, target)
                ty = target
        var args: list[str] = []
        var value: str
        for i in range(len(node.args)):
            if i < len(supplied):
                var arg = node.args[i]
                value = supplied[i]
                var expected = arg.expected
                if expected is not none:
                    value = self.convert(value, self.concrete_type(arg.ty), expected)
                args.append(value)
            else:
                args.append(self.expr(node.args[i]))
        var own = node.type_args
        if own is none:
            own = []
        value = self.dispatch_method(object, ty, node.name, args, own, written_mask(node))
        self.at_line = line
        self.at_col = col
        return value

    def protocol_value(descriptor: str, receiver: str) -> str:
        var object = self.core_call("object_new", [descriptor, "1"], true)
        self.store_field(object, 8, receiver)
        return object

    def native_adapter(source: types.Type, item: types.Type, part: str) -> NativeIterator:
        for later in self.later:
            if later is NativeIterator and later.part == part and types.same(later.source, source) and types.same(later.item, item):
                return later
        var adapter = NativeIterator(f"$W.iterator.{len(self.later)}", source, item, part)
        self.later.append(adapter)
        return adapter

    def native_iter(source: str, ty: types.Type, part: str) -> str:
        var item = types.iteration_item(ty)
        assert item is not none, "unchecked native iteration"
        var version = "0"
        if ty is types.DictType:
            version = self.core_call("dict_version", [source], true)
            if part == "values":
                item = types.expand(ty.value)
            else if part == "items":
                item = types.TupleType([ty.key, types.expand(ty.value)])
        assert item is not none, "missing native item"
        var state = self.core_call("iterator_state", [source, version], true)
        var adapter = self.native_adapter(ty, item, part)
        return self.protocol_value(adapter.symbol + ".type", state)

    def iterator_descriptor(symbol: str, item: types.Type):
        var marker = self.protocol_marker(types.iterator(item))
        self.write(f"data {symbol}.type = " + "{ l " + marker + f", l {symbol}.iter, l {symbol}.next" + " }")
        self.begin(symbol + ".iter", ["l %state", "l %written"], true)
        self.end(self.protocol_value(symbol + ".type", "%state"))

    def emit_native_iterator(adapter: NativeIterator):
        self.bindings = {}
        self.iterator_descriptor(adapter.symbol, adapter.item)
        if adapter.part == "range":
            var marker = self.protocol_marker(types.ProtocolType(stdlib.protocols()["Iterable"], [types.prim("int")]))
            self.write(f"data {adapter.symbol}.range.type = " + "{ l " + marker + f", l {adapter.symbol}.range.iter" + " }")
            self.begin(adapter.symbol + ".range.iter", ["l %source"], true)
            var state = self.core_call("range_iter", ["%source"], true)
            self.end(self.protocol_value(adapter.symbol + ".type", state))
        self.begin(adapter.symbol + ".next", ["l %state", "l %written"], true)
        var source_type = adapter.source
        var kind = types.kind(source_type)
        if adapter.part == "range":
            kind = "range"
        var index = "0"
        if kind == "tuple":
            index = self.core_call("iterator_cursor", ["%state"], true)
        var value = self.core_call("iterator_" + kind + "_next", ["%state"], true)
        if source_type is types.DictType:
            var source = self.core_call("iterator_source", ["%state"], true)
            if adapter.part == "values":
                value = self.core_call("dict_value_at", [source, value], true)
            else if adapter.part == "items":
                var key = self.core_call("dict_key_at", [source, value], true)
                var item = self.core_call("dict_value_at", [source, value], true)
                var ty = adapter.item
                assert ty is types.TupleType, "unchecked dictionary items"
                value = self.tuple_value(ty, [key, item])
            else:
                value = self.core_call("dict_key_at", [source, value], true)
        else if source_type is types.TupleType:
            value = self.tuple_item(value, index, source_type, adapter.item)
        self.end(value)

    def tuple_item(raw: str, index: str, source: types.TupleType, item: types.Type) -> str:
        var value = self.temp()
        self.line(f"{value} =l copy 0")
        var done = self.new_label()
        for i in range(len(source.elements)):
            var take = self.new_label()
            var skip = self.new_label()
            var at = self.temp()
            self.line(f"{at} =l ceql {index}, {i}")
            self.jump(f"jnz {at}, {take}, {skip}")
            self.label(take)
            var converted = self.convert(raw, source.elements[i], item)
            self.line(f"{value} =l copy {converted}")
            self.jump("jmp " + done)
            self.label(skip)
        self.jump("hlt")
        self.label(done)
        return value

    def collect(source: str, iteration: ast.Iteration, element: types.Type) -> str:
        var iterator = self.saved_method(iteration.iter_call, source, [])
        var result = self.core_call("list_new", ["0"], true)
        var test = self.new_label()
        var end = self.new_label()
        self.label(test)
        var value = self.advance(iterator, iteration.next_call, end)
        value = self.convert(value, self.concrete_type(iteration.item), element)
        self.core_call("list_append", [result, value], false)
        self.jump("jmp " + test)
        self.label(end)
        return result

    def emit_sorted(node: ast.Call) -> str:
        var values = self.arg_values(node.args, node.order)
        var iterations = node.iterables
        assert iterations is not none, "unchecked sorted"
        var item = self.concrete_type(iterations[0].item)
        var items = self.collect(values[0], iterations[0], item)
        self.sort(items, item, node.args[2], values[2], values[1], false)
        return items

    # Sorts list `xs` of `item`s in place by `key`, the key argument, whose
    # value is `key_value`. Each key is computed once, in order, before
    # anything moves. When `checked`, the key function must leave `xs` as it
    # was.
    def sort(xs: str, item: types.Type, key: ast.Expr, key_value: str, reverse: str, checked: bool):
        var expected = key.expected
        if expected is none:
            self.core_call("list_sort", [xs, xs, equality_kind(item), reverse], false)
            return
        var callable = types.callable_member(self.concrete_type(expected))
        assert callable is not none, "unchecked sort key"
        var source = xs
        if checked:
            source = self.core_call("list_slice", [xs, "0", self.core_call("list_len", [xs], true)], true)
        var count = self.core_call("list_len", [source], true)
        var keys = self.core_call("list_new", [count], true)
        var index = self.temp()
        self.line(f"{index} =l copy 0")
        var test = self.new_label()
        var body = self.new_label()
        var end = self.new_label()
        self.label(test)
        var more = self.temp()
        self.line(f"{more} =l csltl {index}, {count}")
        self.jump(f"jnz {more}, {body}, {end}")
        self.label(body)
        var value = self.core_call("list_get", [source, index], true)
        var code = self.load_field(key_value, 8)
        var result = self.willow_call(code, typed([key_value, value]), true)
        self.core_call("list_append", [keys, result], false)
        self.line(f"{index} =l add {index}, 1")
        self.jump(f"jmp {test}")
        self.label(end)
        if checked:
            var changed = self.core_call("list_changed", [xs, source], true)
            self.guard(changed, "RuntimeError", "list changed during sort")
        self.core_call("list_sort", [xs, keys, equality_kind(callable.result), reverse], false)

    def validate_nan(value: str, ty: types.Type):
        if ty is types.TupleType:
            for i in range(len(ty.elements)):
                var item = self.core_call("tuple_get", [value, str(i)], true)
                self.validate_nan(item, ty.elements[i])
        else if types.kind(ty) == "float":
            var d = self.as_float(value)
            var nan = self.temp()
            self.line(f"{nan} =l cned {d}, {d}")
            self.guard(nan, "ValueError", "cannot compare NaN")

    def ordered(left: str, right: str, ty: types.Type, op: str) -> str:
        if ty is types.TupleType:
            return self.tuple_order(op, left, right, ty)
        if types.kind(ty) == "float":
            return self.float_binary(op, left, right)
        if types.kind(ty) == "str":
            left = self.core_call("str_compare", [left, right], true)
            right = "0"
        var result = self.temp()
        self.line(f"{result} =l {comparison_instruction(op)} {left}, {right}")
        return result

    def select_extreme(name: str, left: str, right: str, ty: types.Type) -> str:
        var op = "<"
        if name == "max":
            op = ">"
        var select = self.ordered(right, left, ty, op)
        var take = self.new_label()
        var done = self.new_label()
        self.jump(f"jnz {select}, {take}, {done}")
        self.label(take)
        self.line(f"{left} =l copy {right}")
        self.label(done)
        return left

    def iterable_builtin(node: ast.Call) -> str:
        var values = self.arg_values(node.args, node.order)
        var name = node.name
        var ty = self.concrete_type(node.args[0].ty)
        var value: str
        var end: str
        if name == "abs":
            if types.kind(ty) == "float":
                return self.core_call("float_abs", values, true)
            value = self.temp()
            self.line(f"{value} =l copy {values[0]}")
            var negative = self.temp()
            self.line(f"{negative} =l csltl {value}, 0")
            var take = self.new_label()
            end = self.new_label()
            self.jump(f"jnz {negative}, {take}, {end}")
            self.label(take)
            self.line(f"{value} =l neg {value}")
            self.label(end)
            return value
        var result: str
        if name in ["min", "max"] and len(values) == 2:
            self.validate_nan(values[0], ty)
            self.validate_nan(values[1], ty)
            result = self.temp()
            self.line(f"{result} =l copy {values[0]}")
            return self.select_extreme(name, result, values[1], ty)
        var iterations = node.iterables
        assert iterations is not none, "unchecked iterable built-in"
        var iteration = iterations[0]
        var item = self.concrete_type(iteration.item)
        if name == "list":
            return self.collect(values[0], iteration, item)
        var iterator = self.saved_method(iteration.iter_call, values[0], [])
        if name in ["enumerate", "zip"]:
            var calls = [iteration.next_call]
            var elements: list[types.Type] = []
            var state = ""
            if name == "enumerate":
                elements = [types.prim("int"), item]
                state = self.core_call("iterator_enumerate_state", [iterator, values[1]], true)
            else:
                var other = iterations[1]
                var right = self.saved_method(other.iter_call, values[1], [])
                calls.append(other.next_call)
                elements = [item, self.concrete_type(other.item)]
                state = self.core_call("iterator_zip_state", [iterator, right], true)
            var adapter = LazyIterator(f"$W.iterator.{len(self.later)}", name, types.TupleType(elements), calls, self.bindings)
            self.later.append(adapter)
            return self.protocol_value(adapter.symbol + ".type", state)
        result = self.temp()
        var initial = "0"
        if name == "all":
            initial = "1"
        self.line(f"{result} =l copy {initial}")
        var seen = self.temp()
        self.line(f"{seen} =l copy 0")
        var test = self.new_label()
        end = self.new_label()
        self.label(test)
        value = self.advance(iterator, iteration.next_call, end)
        if name in ["min", "max"]:
            self.validate_nan(value, item)
            var first = self.new_label()
            var compare = self.new_label()
            var ready = self.new_label()
            self.jump(f"jnz {seen}, {compare}, {first}")
            self.label(first)
            self.line(f"{result} =l copy {value}")
            self.line(f"{seen} =l copy 1")
            self.jump("jmp " + ready)
            self.label(compare)
            self.select_extreme(name, result, value, item)
            self.label(ready)
        else if name == "sum":
            var added = ""
            if types.kind(item) == "float":
                added = self.float_binary("+", result, value)
            else:
                added = self.checked("add", result, value)
            self.line(f"{result} =l copy {added}")
        else:
            self.line(f"{result} =l copy {value}")
            var keep = self.new_label()
            if name == "any":
                self.jump(f"jnz {value}, {end}, {keep}")
            else:
                self.jump(f"jnz {value}, {keep}, {end}")
            self.label(keep)
        self.jump("jmp " + test)
        self.label(end)
        if name in ["min", "max"]:
            var empty = self.temp()
            self.line(f"{empty} =l ceql {seen}, 0")
            self.guard(empty, "ValueError", name + "() of an empty iterable")
        return result

    def emit_lazy_iterator(adapter: LazyIterator):
        self.bindings = adapter.bindings
        self.iterator_descriptor(adapter.symbol, adapter.item)
        self.begin(adapter.symbol + ".next", ["l %state", "l %written"], true)
        self.core_call("iterator_check", ["%state"], false)
        var source = self.core_call("iterator_source", ["%state"], true)
        var exhausted = self.new_label()
        var left = self.advance(source, adapter.calls[0], exhausted)
        var values: list[str] = []
        if adapter.name == "enumerate":
            var count = self.core_call("iterator_enumerate_count", ["%state"], true)
            values = [count, left]
        else:
            source = self.core_call("iterator_right", ["%state"], true)
            var right = self.advance(source, adapter.calls[1], exhausted)
            values = [left, right]
        var value = self.tuple_value(adapter.item, values)
        self.jump("ret " + value)
        self.label(exhausted)
        self.core_call("iterator_exhaust", ["%state"], false)
        self.jump("ret 0")
        self.end("0")

    # A C function's `cint` travels as QBE `w` and a float as `d`; a C int
    # result is sign-extended to fill its slot, and a float result becomes its
    # bits. Arguments past the declared ones follow a `...` marker.
    def extern_call(node: ast.Call, target: ast.FunctionDecl, address: str) -> str:
        var args: list[str] = []
        for i in range(len(node.args)):
            var arg = node.args[i]
            var value = self.expr(arg)
            if i == len(target.params):
                args.append("...")
            var ty = self.concrete_type(arg.ty)
            var abi = "l"
            if i < len(target.params):
                abi = c_type(target.params[i].annotation, ty)
            else if types.kind(ty) == "float":
                abi = "d"
            if abi == "d":
                var d = self.temp()
                self.line(f"{d} =d cast {value}")
                value = d
            args.append(f"{abi} {value}")
        if target.variadic and len(node.args) == len(target.params):
            args.append("...")
        var record = target.record
        assert record is not none, f"function {target.name} has no signature"
        var text = "call " + address + "(" + ", ".join(args) + ")"
        if is_none(record.result):
            self.line(text)
            return "0"
        var result = c_type(target.return_type, record.result)
        var t: str
        if result == "l":
            t = self.temp()
            self.line(f"{t} =l {text}")
            return t
        var r = self.temp()
        self.line(f"{r} ={result} {text}")
        t = self.temp()
        if result == "w":
            self.line(f"{t} =l extsw {r}")
        else:
            self.line(f"{t} =l cast {r}")
        return t

    # A function of sys or fs, which core implements as `sys_exit`,
    # `fs_read_file`, and so on. sys.args reads the argc and argv the entry
    # saved.
    def host(node: ast.Call, target: stdlib.Builtin) -> str:
        var args: list[str] = []
        if node.name == "sys.args":
            for word in ["$W.argc", "$W.argv"]:
                var t = self.temp()
                self.line(f"{t} =l loadl {word}")
                args.append(t)
        args.extend(self.arg_values(node.args, node.order))
        var result = target.result
        assert result is not none, f"{node.name} has no result"
        return self.core_call(node.name.replace(".", "_"), args, not is_none(result))

    def emit_print(node: ast.Call) -> str:
        return self.core_call("print_str", [self.to_str(node.args[0])], false)

    def conversion(node: ast.Call) -> str:
        var arg = node.args[0]
        if node.name == "str":
            return self.to_str(arg)
        var ty = self.concrete_type(arg.ty)
        var kind = types.kind(ty)
        var value = self.expr(arg)
        if node.name == "int":
            if kind == "float":
                return self.core_call("float_to_int", [value], true)
            return self.core_call("str_to_int", [value], true)
        if kind == "str":
            return self.core_call("str_to_float", [value], true)
        var d = self.temp()
        self.line(f"{d} =d sltof {value}")
        return self.float_bits(d)

    def to_str(arg: ast.Expr) -> str:
        var value = self.expr(arg)
        var ty = self.concrete_type(arg.ty)
        var kind = types.kind(ty)
        if kind == "int":
            return self.core_call("int_to_str", [value], true)
        else if kind == "float":
            return self.core_call("float_to_str", [value], true)
        else if kind == "bool":
            return self.core_call("bool_to_str", [value], true)
        else if kind == "union":
            return self.core_call("union_to_str", [value], true)
        else if kind == "none":
            return self.string("none")
        else if ty is types.EnumType:
            return self.core_call("enum_to_str", [self.descriptor(ty.decl.type_name, ty.decl.library), value], true)
        assert kind == "str", "unchecked scalar conversion"
        return value

    def intrinsic(node: ast.Call, target: stdlib.Builtin) -> str:
        if target.name == "__ccall":
            var signature = node.args[0].node
            assert signature is ast.FunctionValue, "unchecked C call signature"
            var function = signature.target
            var address = self.expr(node.args[1])
            var call = ast.Call(function.name, node.args[2:], [], [], function)
            return self.extern_call(call, function, address)
        var args: list[str] = []
        for arg in node.args:
            args.append(self.expr(arg))
        var name = target.name
        if name == "__alloc":
            return self.call_text("$GC_malloc", typed(args), true)
        if name == "__alloc_atomic":
            return self.call_text("$GC_malloc_atomic", typed(args), true)
        if name in ["__load1", "__load4", "__load8"]:
            var address = self.temp()
            self.line(f"{address} =l add {args[0]}, {args[1]}")
            var t = self.temp()
            self.line(f"{t} =l {load_instruction(name)} {address}")
            return t
        if name in ["__store1", "__store4", "__store8"]:
            var address = self.temp()
            self.line(f"{address} =l add {args[0]}, {args[1]}")
            self.line(f"{store_instruction(name)} {args[2]}, {address}")
            return "0"
        if name == "__addr_is_null":
            var t = self.temp()
            self.line(f"{t} =l ceql {args[0]}, 0")
            return t
        if name == "__dtosi":
            var d = self.temp()
            self.line(f"{d} =d cast {args[0]}")
            var t = self.temp()
            self.line(f"{t} =l dtosi {d}")
            return t
        # Addresses are not ints, so their arithmetic is not checked.
        if name == "__offset":
            var t = self.temp()
            self.line(f"{t} =l add {args[0]}, {args[1]}")
            return t
        # Reinterpretations change only the static type.
        return args[0]

    # Function values

    def local_slot(symbol: ast.Symbol) -> str:
        return f"%v.{symbol.id}"

    # A captured binding has a shared heap cell, renewed whenever its
    # declaration runs; closures keep the cell from that execution.
    def fresh_binding(symbol: ast.Symbol | none):
        assert symbol is not none, "binding without a symbol"
        if symbol.captured:
            var cell = self.call_text("$W.core.object_new", ["l 0", "l 1"], true)
            self.line(f"storel {cell}, {self.local_slot(symbol)}")

    def fresh_pattern(target: ast.Target):
        if target.name != "":
            self.fresh_binding(target.symbol)
        for element in target.elements:
            self.fresh_pattern(element)

    def local_address(symbol: ast.Symbol | none, name: str) -> str:
        assert symbol is not none, "local without a symbol"
        var slot = self.local_slot(symbol)
        if not symbol.captured:
            return slot
        var cell = self.temp()
        self.line(f"{cell} =l loadl {slot}")
        var address = self.temp()
        self.line(f"{address} =l add {cell}, 8")
        return address

    def load_field(object: str, offset: int) -> str:
        var address = self.temp()
        self.line(f"{address} =l add {object}, {offset}")
        var value = self.temp()
        self.line(f"{value} =l loadl {address}")
        return value

    def store_field(object: str, offset: int, value: str):
        var address = self.temp()
        self.line(f"{address} =l add {object}, {offset}")
        self.line(f"storel {value}, {address}")

    # A closure: the function descriptor, the code, and `values`, which the
    # code reads from its first parameter.
    def new_closure(code: str, values: list[str]) -> str:
        var closure = self.call_text("$W.core.object_new", ["l $W.function.type", f"l {len(values) + 1}"], true)
        self.store_field(closure, 8, code)
        for i in range(len(values)):
            self.store_field(closure, 16 + i * 8, values[i])
        return closure

    # A closure of nested function or lambda `function` over the cells of
    # the variables it captures.
    def closure(function: ast.FunctionDecl) -> str:
        var symbol = "$" + self.module_of(function) + "." + frame_name(function).replace("<lambda>", "lambda") + "." + str(function.id)
        if len(self.bindings) > 0:
            symbol = symbol + f".inst.{len(self.later)}"
        self.wrap(symbol, Lifted(symbol, function, self.bindings))
        return self.new_closure(symbol, self.cells(function))

    # The cells of the variables nested function `function` captures.
    def cells(function: ast.FunctionDecl) -> list[str]:
        var cells: list[str] = []
        for capture in function.captures:
            var cell = self.temp()
            self.line(f"{cell} =l loadl {self.local_slot(capture.symbol)}")
            cells.append(cell)
        return cells

    # A generic function's specialization as a value of its callable type,
    # whose code supplies the defaults of the parameters the callable leaves
    # out. A nested one's closure holds the closure with its cells.
    def specialized_value(expr: ast.Expr, node: ast.FunctionValue) -> str:
        var ty = self.concrete_type(expr.ty)
        assert ty is types.CallableType, "unchecked generic function value"
        var symbol = node.symbol
        var instance: Instantiation
        var code: str
        if symbol is none:
            var record = node.target.record
            assert record is not none, "function value without a signature"
            instance = self.instantiation(record, [], node.type_args)
            code = instance.symbol + f".value.{len(ty.params)}"
            self.wrap(code, SpecializedValue(code, instance, len(ty.params)))
            return code + ".closure"
        instance = self.nested_specialization(node.target, node.type_args)
        code = instance.symbol + f".value.{len(ty.params)}"
        self.wrap(code, SpecializedValue(code, instance, len(ty.params)))
        var cells = self.temp()
        self.line(f"{cells} =l loadl {self.local_address(symbol, symbol.name)}")
        return self.new_closure(code, [cells])

    # A closure of `method` that keeps the receiver `object`, of the type of
    # `receiver`.
    def bound_method(receiver: ast.Expr, method: types.Function, object: str) -> str:
        var ty = self.concrete_type(receiver.ty)
        assert ty is types.ClassType, "unchecked receiver"
        var symbol = self.specialization(method, ty.args, [])
        self.wrap(symbol + ".bound", BoundWrapper(symbol + ".bound", symbol, method, ty))
        return self.new_closure(symbol + ".bound", [object])

    # Emits `wrapper`, whose symbol is `symbol`, unless it already is.
    def wrap(symbol: str, wrapper: Later):
        if symbol not in self.wrappers:
            self.wrappers[symbol] = true
            self.later.append(wrapper)

    # A call through a closure passes the closure first. The callee is
    # evaluated before the arguments.
    def call_value(node: ast.CallValue) -> str:
        var callee = self.expr(node.callee)
        var args = [callee]
        args.extend(self.arg_values(node.args, node.order))
        var ty = self.concrete_type(node.callee.ty)
        if len(node.type_args) > 0:
            # A nested generic function, called directly.
            var name = node.callee.node
            assert name is ast.Name and ty is types.FunctionType, "unchecked generic call"
            var symbol = name.symbol
            assert symbol is not none, "unbound generic call"
            var function = symbol.function
            assert function is not none, "unbound generic call"
            var instance = self.nested_specialization(function, node.type_args)
            var result = types.substitute(ty.fn.result, instance.bindings)
            return self.willow_call(instance.symbol, typed(args), not is_none(self.concrete_type(result)))
        var code = self.load_field(callee, 8)
        return self.willow_call(code, typed(args), not is_none(value_result(types.expand(ty))))

    # `value`, a function value of `source`, wrapped to serve the callable
    # member of `target`. A union holds a function only some of the time.
    def adapt(value: str, source: types.Type, target: types.Type) -> str:
        var member = function_member(source)
        var callable = types.callable_member(target)
        assert member is not none and callable is not none, "unchecked adapter"
        var symbol = f"$W.adapter.{len(self.later)}"
        self.later.append(Adapter(symbol, member, callable))
        if not is_union(source):
            return self.new_closure(symbol, [value])
        var take = self.new_label()
        var done = self.new_label()
        var result = self.temp()
        self.line(f"{result} =l copy {value}")
        var held = self.core_call("is_instance", [value, "$W.function.type"], true)
        self.jump(f"jnz {held}, {take}, {done}")
        self.label(take)
        var adapted = self.new_closure(symbol, [value])
        self.line(f"{result} =l copy {adapted}")
        self.label(done)
        return result

    def emit_later(later: Later):
        if later is Lifted:
            var bindings = self.bindings
            self.emit_function(later.function, later.symbol, ["l %env"], later.bindings)
            self.bindings = bindings
        else if later is GeneratorBody:
            var bindings = self.bindings
            self.emit_generator_body(later)
            self.bindings = bindings
        else if later is ValueWrapper:
            self.emit_value_wrapper(later)
        else if later is BoundWrapper:
            self.emit_bound_wrapper(later)
        else if later is BuiltinWrapper:
            self.emit_builtin_wrapper(later)
        else if later is SpecializedValue:
            var bindings = self.bindings
            self.emit_specialized_value(later)
            self.bindings = bindings
        else if later is Adapter:
            self.emit_adapter(later)
        else if later is NativeIterator:
            var bindings = self.bindings
            self.emit_native_iterator(later)
            self.bindings = bindings
        else:
            var bindings = self.bindings
            self.emit_lazy_iterator(later)
            self.bindings = bindings

    # The wrappers pass on a pending exception with the dummy result.
    def emit_value_wrapper(wrapper: ValueWrapper):
        var record = wrapper.function.record
        assert record is not none, "function value without a signature"
        var args = wrapper_args(len(record.params))
        self.begin(wrapper.symbol, with_env(args), not is_none(record.result))
        if self.module_of(wrapper.function) == "W.aio" and wrapper.function.name == "sleep":
            self.end(self.core_call("aio_sleep_coroutine", ["%p.0", self.string(wrapper.path), str(wrapper.line), str(wrapper.col)], true))
        else:
            self.end(self.call_text(self.symbol(wrapper.function), args, self.returns))

    def emit_bound_wrapper(wrapper: BoundWrapper):
        var signature = types.method(wrapper.receiver, wrapper.method.name)
        assert signature is not none, "bound method without a signature"
        var args = wrapper_args(len(signature.params))
        self.begin(wrapper.symbol, with_env(args), not is_none(signature.result))
        var receiver = ["l " + self.load_field("%env", 16)]
        receiver.extend(args)
        self.end(self.call_text(wrapper.method_symbol, receiver, self.returns))

    def emit_specialized_value(value: SpecializedValue):
        var instance = value.instance
        var record = instance.function.record
        assert record is not none, "function value without a signature"
        self.bindings = instance.bindings
        var args = wrapper_args(value.count)
        self.begin(value.symbol, with_env(args), not is_none(self.concrete_type(record.result)))
        var passed: list[str] = []
        if instance.function.parent is not none:
            passed.append("l " + self.load_field("%env", 16))
        passed.extend(args)
        for param in record.params[value.count:]:
            var default = param.default
            assert default is not none, "unchecked omitted default"
            passed.append("l " + self.expr(default))
        self.end(self.call_text(instance.symbol, passed, self.returns))

    def emit_builtin_wrapper(wrapper: BuiltinWrapper):
        var expected = wrapper.call.expected
        assert expected is not none, "unchecked built-in value"
        self.begin(wrapper.symbol, with_env(wrapper_args(wrapper.params)), not is_none(expected))
        self.end(self.expr(wrapper.call))

    # Converts each argument, supplies the omitted defaults, and converts
    # the result once no exception is pending.
    def emit_adapter(adapter: Adapter):
        var target = adapter.target
        var params = value_params(adapter.source)
        var result = value_result(adapter.source)
        self.begin(adapter.symbol, with_env(wrapper_args(len(target.params))), not is_none(target.result))
        var wrapped = self.load_field("%env", 16)
        var code = self.load_field(wrapped, 8)
        var args = [wrapped]
        for i in range(len(target.params)):
            args.append(self.convert(f"%p.{i}", target.params[i], params[i].ty))
        for i in range(len(target.params), len(params)):
            var default = params[i].default
            assert default is not none, "unchecked adapter default"
            args.append(self.expr(default))
        var value = self.willow_call(code, typed(args), not is_none(result))
        self.end(self.convert(value, result, target.result))

# A function emitted after the top-level function that uses it: a nested
# function or lambda, or the code of a closure that runs a function.
type Later = Lifted | ValueWrapper | BoundWrapper | BuiltinWrapper | SpecializedValue | Adapter | NativeIterator | LazyIterator | GeneratorBody

class GeneratorBody:
    symbol: str
    function: ast.FunctionDecl
    bindings: dict[str, types.Type]

class NativeIterator:
    symbol: str
    source: types.Type
    item: types.Type
    part: str

class LazyIterator:
    symbol: str
    name: str
    item: types.TupleType
    calls: list[ast.Expr]
    bindings: dict[str, types.Type]


class Lifted:
    symbol: str
    function: ast.FunctionDecl
    bindings: dict[str, types.Type]

# The code of a file-level function's closure.
class ValueWrapper:
    symbol: str
    function: ast.FunctionDecl
    path: str = ""
    line: int = 0
    col: int = 0

# The code of a bound method's closure, which holds the receiver.
class BoundWrapper:
    symbol: str
    method_symbol: str
    method: types.Function
    receiver: types.ClassType

# The code of a generic function's specialization as a value that takes
# `count` arguments.
class SpecializedValue:
    symbol: str
    instance: Instantiation
    count: int

# The code of a built-in function value's closure, which runs its call.
class BuiltinWrapper:
    symbol: str
    call: ast.Expr
    params: int

# The code of a closure that holds a function value of `source` and serves
# callable `target`.
class Adapter:
    symbol: str
    source: types.FunctionType | types.CallableType
    target: types.CallableType

# An emitter for a program whose modules are `modules`, core among them, and
# whose target's `__os` is `target_os`. Descriptors' names are the first
# strings, as in stage 0.
def emitter(modules: list[ast.Module], target_os: str) -> Emitter:
    var module_names: dict[int, str] = {}
    var functions: dict[int, ast.FunctionDecl] = {}
    for module in modules:
        for function in bind.functions(module):
            functions[function.id] = function
    var module_paths: dict[str, str] = {}
    var privileged: dict[str, bool] = {}
    for module in modules:
        var root = "P." + module.name
        if module.privileged:
            root = "W." + module.name
            privileged[root] = true
        module_paths[root] = module.path
        for decl in module.declarations:
            if decl is ast.FunctionDecl:
                module_names[decl.id] = root
            else if decl is ast.ClassDecl:
                for method in decl.methods:
                    module_names[method.id] = root
    var result = Emitter(target_os, modules[0].name, module_names, {}, [], {}, 0, 0, false, false, [], [], {}, functions, [], {}, {}, [], [], module_paths, privileged, stdlib.exceptions(), [], [], [], [], {})
    for name in builtin_types():
        result.string(name)
    for name in result.exceptions:
        result.string(name)
        result.exception_descriptors.append(result.descriptor(name, false))
    for module in modules:
        for decl in module.declarations:
            if decl is ast.ClassDecl:
                # An uncaught exception reports its class by the name types
                # write, qualified outside the entry module.
                var name = decl.name
                if decl.exception:
                    name = decl.type_name
                    result.exception_descriptors.append(result.descriptor(decl.type_name, module.privileged))
                result.descriptors[result.descriptor(decl.type_name, module.privileged)] = [name]
            else if decl is ast.EnumDecl:
                var texts = [decl.name]
                for member in decl.members:
                    texts.append(decl.name + "." + member.name)
                result.descriptors[result.descriptor(decl.type_name, module.privileged)] = texts
    return result

# An enclosing `try` statement with a `finally` clause, which a return,
# break, or continue that leaves it runs.
class Protect:
    finally_body: list[ast.Stmt]
    # Where an exception goes outside the statement.
    outside: str
    # How many loops and handled exceptions enclose the statement.
    loops: int
    handled: int
    manager: str = ""
    exit_call: ast.Expr | none = none
    group: bool = false

# The parameters `node` was written with, as a mask with bit i for
# parameter i.
def written_mask(node: ast.MethodCall) -> str:
    var order = node.order
    assert order is not none, "unbound call arguments"
    var mask = 0
    for i in order[:node.written]:
        mask = mask + bit(i)
    return str(mask)

def bit(i: int) -> int:
    var result = 1
    for j in range(i):
        result = result * 2
    return result

# The exponent of the power of two that the int literal `text` holds, or 0.
def power_of_two(text: str) -> int:
    var value = int(text)
    if value < 2 or value > 4611686018427387904:
        return 0
    var k = 0
    while value % 2 == 0:
        value = value // 2
        k = k + 1
    if value == 1:
        return k
    return 0

# The name of `function` in frames, and in its symbol.
def frame_name(function: ast.FunctionDecl) -> str:
    var parent = function.parent
    if parent is not none:
        return frame_name(parent) + "." + function.name
    var owner = function.owner
    if owner is ast.ClassDecl:
        return owner.name + "." + function.name
    return function.name

# The type parameters of the functions and class that enclose nested
# function `function`.
def enclosing_vars(function: ast.FunctionDecl) -> list[types.TypeVar]:
    var result: list[types.TypeVar] = []
    var parent = function.parent
    while parent is not none:
        var record = parent.record
        assert record is not none, f"function {parent.name} has no signature"
        result.extend(record.typevars)
        function = parent
        parent = function.parent
    var owner = function.owner
    if owner is ast.ClassDecl:
        var decl = owner.record
        assert decl is not none, "class without a record"
        result.extend(decl.typevars)
    return result

# The offset of a class's first field. An exception's location and frames
# come before its fields (core/API.md).
def field_base(decl: types.Class) -> int:
    if decl.exception:
        return 24
    return 8

# The built-in types with descriptors, which every program emits.
def builtin_types() -> list[str]:
    return ["int", "float", "bool", "str", "bytes", "list", "dict", "tuple", "function", "Coroutine"]

def equality_kind(t: types.Type) -> str:
    var kind = types.kind(types.expand(t))
    if kind == "float":
        return "1"
    if kind in ["str", "bytes"]:
        return "2"
    if kind == "union":
        return "3"
    if kind == "tuple":
        return "4"
    return "0"

def protocol_conversion(source: types.Type, target: types.Type) -> bool:
    for member in types.members(source):
        for to in types.members(target):
            if to is types.ProtocolType and types.assignable(to, member) and not types.same(to, member):
                return true
    return false

def representation_changes(source: types.Type, target: types.Type) -> bool:
    source = types.expand(source)
    target = types.expand(target)
    if protocol_conversion(source, target):
        return true
    if is_union(source) != is_union(target):
        var scalar = source
        if is_union(source):
            scalar = target
        if types.kind(scalar) in ["int", "float", "bool", "enum"]:
            return true
    var a = types.tuple_member(source)
    var b = types.tuple_member(target)
    if a is not none and b is not none:
        for i in range(len(a.elements)):
            if representation_changes(a.elements[i], b.elements[i]):
                return true
    return adapts(source, target)

# Whether a function value of `source` needs an adapter to serve the
# callable member of `target`: to supply defaults, convert an argument or
# the result, or give a result where the function has none.
def adapts(source: types.Type, target: types.Type) -> bool:
    var member = function_member(source)
    var callable = types.callable_member(target)
    if member is none or callable is none:
        return false
    var params = value_params(member)
    if len(params) != len(callable.params):
        return true
    for i in range(len(params)):
        if representation_changes(callable.params[i], params[i].ty):
            return true
    var result = value_result(member)
    return representation_changes(result, callable.result) or is_none(result) and not is_none(callable.result)

# The function or callable member of `t`, or none.
def function_member(t: types.Type) -> types.FunctionType | types.CallableType | none:
    for m in types.members(t):
        if m is types.FunctionType:
            return m
        if m is types.CallableType:
            return m
    return none

# The parameters a function value's code takes after its closure.
def value_params(t: types.FunctionType | types.CallableType) -> list[types.Param]:
    if t is types.FunctionType:
        return types.function_params(t)
    var result: list[types.Param] = []
    for param in t.params:
        result.append(types.Param("", param, none, false))
    return result

def value_result(t: types.Type) -> types.Type:
    if t is types.FunctionType:
        return types.function_result(t)
    assert t is types.CallableType, "call of a value that is not a function"
    return t.result

# The parameters of a closure's code: the closure, then `args`.
def with_env(args: list[str]) -> list[str]:
    var result = ["l %env"]
    result.extend(args)
    return result

def wrapper_args(count: int) -> list[str]:
    var result: list[str] = []
    for i in range(count):
        result.append(f"l %p.{i}")
    return result

def is_union(t: types.Type) -> bool:
    return types.expand(t) is types.UnionType

def may_be_none(t: types.Type) -> bool:
    return is_union(t) or types.kind(t) == "none"

def is_none(t: types.Type) -> bool:
    return t is types.Prim and t.name == "none"

def is_os(expr: ast.Expr) -> bool:
    var node = expr.node
    return node is ast.Name and node.symbol is none and node.name == "__os"

def typed(args: list[str]) -> list[str]:
    var result: list[str] = []
    for arg in args:
        result.append("l " + arg)
    return result

# The QBE type of an extern parameter or result annotated `annotation`
# whose Willow type is `ty`.
def c_type(annotation: ast.TypeExpr | none, ty: types.Type) -> str:
    if annotation is ast.TypeName and annotation.module == "" and annotation.name == "cint":
        return "w"
    if types.kind(ty) == "float":
        return "d"
    return "l"

def arithmetic_instruction(op: str) -> str:
    if op == "+":
        return "add"
    if op == "-":
        return "sub"
    if op == "*":
        return "mul"
    return "div"

def float_comparison_instruction(op: str) -> str:
    if op == "==":
        return "ceqd"
    if op == "!=":
        return "cned"
    if op == "<":
        return "cltd"
    if op == "<=":
        return "cled"
    if op == ">":
        return "cgtd"
    return "cged"

def comparison_instruction(op: str) -> str:
    if op == "==":
        return "ceql"
    if op == "!=":
        return "cnel"
    if op == "<":
        return "csltl"
    if op == "<=":
        return "cslel"
    if op == ">":
        return "csgtl"
    return "csgel"

def load_instruction(name: str) -> str:
    if name == "__load1":
        return "loadub"
    if name == "__load4":
        return "loadsw"
    return "loadl"

def store_instruction(name: str) -> str:
    if name == "__store1":
        return "storeb"
    if name == "__store4":
        return "storew"
    return "storel"

# The UTF-8 bytes of `text`.
def utf8(text: str) -> list[int]:
    var result: list[int] = []
    for c in text:
        var n = ord(c)
        if n < 128:
            result.append(n)
        else if n < 2048:
            result.append(192 + n // 64)
            result.append(128 + n % 64)
        else if n < 65536:
            result.append(224 + n // 4096)
            result.append(128 + n // 64 % 64)
            result.append(128 + n % 64)
        else:
            result.append(240 + n // 262144)
            result.append(128 + n // 4096 % 64)
            result.append(128 + n // 64 % 64)
            result.append(128 + n % 64)
    return result

# The bytes of `text` as QBE data items, each followed by a comma and a
# space. Only printable ASCII other than quotes and backslashes goes inside
# quotes, because QBE passes quoted text to the assembler, which reads
# escapes in it.
def data_bytes(text: str) -> str:
    var parts: list[str] = []
    var quoted = false
    for b in utf8(text):
        var plain = b >= 32 and b < 127 and b != 34 and b != 92
        if plain and not quoted:
            parts.append("b \"")
            quoted = true
        else if not plain and quoted:
            parts.append("\", ")
            quoted = false
        if plain:
            parts.append(chr(b))
        else:
            parts.append(f"b {b}, ")
    if quoted:
        parts.append("\", ")
    return "".join(parts)
