# The willow command (spec §12).
#
# Core is compiled into every program. Its text and the standard library's
# are compiled into the compiler (see loader.wlo).

import ast
import bind
import check
import core
import coroutine
import diagnostic
import emit
import fs
import init
import loader
import manifest
import runner
import subprocess
import sys

def usage_text() -> str:
    return (
        "usage: willow init\n       willow check [file]\n       willow run [file [args...] | -- args...]\n"
        + "       willow compile [file] -o <output>\n       willow build [file] -o <output>\n"
        + "       willow test [--check] [path]\n"
        + "Without a file, the command uses willow.json in the current directory."
    )

def fail(message: str):
    sys.eprint(message)
    sys.exit(1)

def usage_error(reason: str):
    fail("error: " + reason + "\n" + usage_text())

# A command line: the command, its source file and output, which are none
# when not given, and for `run`, the program's arguments.
class Command:
    name: str
    input: str | none
    output: str | none
    program_args: list[str]

def parse_args(args: list[str]) -> Command:
    if len(args) == 0:
        usage_error("missing command")
    name = args[0]
    if name not in ["check", "run", "compile", "build"]:
        usage_error(f"unknown command '{name}'")
    writes = name in ["compile", "build"]
    input: str | none = none
    output: str | none = none
    program_args: list[str] = []
    i = 1
    while i < len(args):
        argument = args[i]
        if input is not none and name == "run":
            # Everything after the source path belongs to the program.
            program_args.append(argument)
            i = i + 1
        else if argument == "--" and input is none and name == "run":
            # `run -- args` runs the project entry with `args`.
            program_args.extend(args[i + 1:])
            break
        else if argument == "-o" and writes:
            if output is not none:
                usage_error("-o given more than once")
            if i + 1 == len(args):
                usage_error("-o needs a path")
            output = args[i + 1]
            i = i + 2
        else if argument.startswith("-"):
            usage_error(f"unknown option '{argument}'")
        else if input is not none:
            usage_error(f"unexpected argument '{argument}'")
        else:
            input = argument
            i = i + 1
    if writes and output is none:
        usage_error(f"{name} needs -o <output>")
    return Command(name, input, output, program_args)

# `willow test [--check] [path]`: the path, or none, and whether to check
# only.
def parse_test_args(args: list[str]) -> tuple[str | none, bool]:
    check_only = false
    path: str | none = none
    for argument in args[1:]:
        if argument == "--check" and not check_only:
            check_only = true
        else if argument == "--check":
            usage_error("--check given more than once")
        else if argument.startswith("-"):
            usage_error(f"unknown option '{argument}'")
        else if path is not none:
            usage_error(f"unexpected argument '{argument}'")
        else:
            path = argument
    return (path, check_only)

def main():
    args = sys.args()
    if len(args) > 0 and args[0] == "init":
        if len(args) > 1:
            usage_error(f"unexpected argument '{args[1]}'")
        init.init()
        return
    if len(args) > 0 and args[0] == "test":
        test(args)
        return
    command = parse_args(args)
    path = command.input
    if path is none:
        project = read_project()
        if project is none:
            fail("error: no source file given and no willow.json in the current directory")
            return
        path = project.entry
        roots = loader.Roots(project.source, project.dependencies, project.entry_name)
    else:
        roots = loader.file_roots(path)
    try:
        text = loader.read_source(path)
    except OSError as error:
        fail("error: " + loader.read_reason(error))
        return
    if isinstance(text, diagnostic.Diagnostic):
        fail(text.format())
        return
    # A project's entry name was checked with its manifest.
    if roots.entry == "core" or command.input is not none and not loader.is_identifier(roots.entry):
        fail(f"error: {path}: '{roots.entry}' cannot be a module name")
    output = command.output
    if output is not none and core.fs_same_file(path, output):
        fail(f"error: output {output} is the input file")
    modules = translate(path, text, roots)
    if command.name == "run":
        run(emit_il(modules, false), command.program_args)
    if output is none:
        return
    for module in modules[1:]:
        if not module.privileged and core.fs_same_file(module.path, output):
            fail(f"error: output {output} is the module file {module.path}")
    il = emit_il(modules, false)
    if command.name == "compile":
        write_output(output, il)
    else:
        build(il, output)

# The project in the current directory, or none; a broken manifest fails.
def read_project() -> manifest.Project | none:
    try:
        return manifest.read()
    except manifest.ManifestError as error:
        fail("error: " + error.message)
        return none

# The checked modules of the program whose entry file is at `path` and has
# the text `text`, entry first and core among them. Fails with the first
# error.
def translate(path: str, text: str, roots: loader.Roots) -> list[ast.Module]:
    modules = checked(path, text, roots, false)
    if isinstance(modules, diagnostic.Diagnostic):
        fail(modules.format())
        return []
    return modules

# The modules translate gives, or the first error. A test file (`test`)
# needs no `main`.
def checked(path: str, text: str, roots: loader.Roots, test: bool) -> list[ast.Module] | diagnostic.Diagnostic:
    sources = loader.load(path, text, roots, true)
    if isinstance(sources, diagnostic.Diagnostic):
        return sources
    error = bind.bind(sources, test)
    if error is not none:
        return error
    modules: list[ast.Module] = []
    for source in sources:
        modules.append(source.tree)
    error = check.check_program(modules)
    if error is not none:
        return error
    return modules

# The IL of the program of `modules`, whose entry is a test file when
# `test`.
def emit_il(modules: list[ast.Module], test: bool) -> str:
    emitter = emit.emitter(modules, core.os())
    for module in modules:
        for function in bind.functions(module):
            emitter.function(function)
    return emitter.finish(modules[0], test)

# The environment of the programs that run and test start: this one's, with
# WILLOW naming this executable.
def program_environment() -> dict[str, str]:
    env = sys.environ()
    env["WILLOW"] = core.executable_path()
    return env

# Builds `il` to a temporary file, runs it with `args`, and exits with its
# status.
def run(il: str, args: list[str]):
    directory = fs.temp_dir()
    program = directory + "/program"
    message = link(il, program)
    if message != "":
        core.run(["rm", "-rf", directory])
        fail(message)
    command = [program]
    command.extend(args)
    try:
        status = subprocess.run(command, env=program_environment()).returncode
    finally:
        core.run(["rm", "-rf", directory])
    if status < 0:
        status = 128 - status
    sys.exit(status)

# A test file that checked: its path, its program's IL, and its tests' names.
class TestFile:
    path: str
    il: str
    names: list[str]

# `willow test`: checks every test file, then runs each test in its own
# process.
def test(args: list[str]):
    path, check_only = parse_test_args(args)
    project = read_project()
    if path is none:
        path = "."
        if project is not none:
            path = project.tests
    files: list[TestFile] = []
    failed_checks = false
    count = 0
    for file in runner.discover(path, project is not none):
        roots = loader.file_roots(file)
        if project is not none:
            roots = loader.Roots(project.source, project.dependencies, roots.entry)
        try:
            text = loader.read_source(file)
        except OSError as error:
            sys.eprint("error: " + loader.read_reason(error))
            failed_checks = true
            continue
        if isinstance(text, diagnostic.Diagnostic):
            sys.eprint(text.format())
            failed_checks = true
            continue
        modules = checked(file, text, roots, true)
        if isinstance(modules, diagnostic.Diagnostic):
            sys.eprint(modules.format())
            failed_checks = true
            continue
        names: list[str] = []
        for function in modules[0].tests:
            names.append(function.name)
        count = count + len(names)
        files.append(TestFile(file, emit_il(modules, true), names))
    if failed_checks:
        sys.exit(1)
    if count == 0:
        fail(f"error: no tests found in {path}")
    if check_only:
        return
    env = program_environment()
    directory = fs.temp_dir()
    tally = runner.Tally(0, 0)
    try:
        for test_file in files:
            message = link(test_file.il, directory + "/program")
            if message != "":
                core.run(["rm", "-rf", directory])
                fail(message)
            runner.run_file(directory + "/program", test_file.path, test_file.names, env, directory, tally)
    finally:
        core.run(["rm", "-rf", directory])
    print(f"{tally.passed} passed, {tally.failed} failed")
    if tally.failed > 0:
        sys.exit(1)

# Writes `text` to `output` through a sibling file renamed into place, so a
# failure leaves an existing output unchanged.
def write_output(output: str, text: str):
    temp = output + ".tmp"
    try:
        fs.write_file(temp, text)
        fs.rename(temp, output)
    except OSError as error:
        if fs.exists(temp):
            fs.remove(temp)
        fail(cannot_write(output, error))

# The message for an OSError from fs while writing `output` through its
# temporary file, including that file's name.
def cannot_write(output: str, error: OSError) -> str:
    parts = error.message.split(": ")
    return f"error: cannot write {output}: {output}.tmp: {parts[len(parts) - 1]}"

# Builds `il` into the executable `output`, failing if it cannot.
def build(il: str, output: str):
    message = link(il, output)
    if message != "":
        fail(message)

# Assembles `il` with qbe and links it with libgc into the executable
# `output`, through a sibling file renamed into place. The intermediate files
# go in a temporary directory. Returns the error message, or "".
def link(il: str, output: str) -> str:
    linked = output + ".tmp"
    # Creating the file first reports an unwritable output before cc does.
    try:
        fs.write_file(linked, "")
    except OSError as error:
        return cannot_write(output, error)
    directory = fs.temp_dir()
    ssa = directory + "/program.ssa"
    asm = directory + "/program.s"
    scratch = directory + "/scratch"
    fs.write_file(ssa, il)
    arch = shell_output("uname -m", scratch).strip()
    target = qbe_target(arch)
    message = ""
    if target == "":
        message = f"error: unsupported host {core.os()} {arch}"
    else if core.run(["qbe", "-t", target, "-o", asm, ssa]) != 0:
        message = "error: qbe failed"
    else:
        fs.write_file(asm, fs.read_file(asm) + coroutine.assembly(target))
        command = ["cc", "-o", linked, asm]
        command.extend(gc_flags(scratch))
        command.append("-lm")
        if core.run(command) != 0:
            message = "error: cc failed"
    core.run(["rm", "-rf", directory])
    if message != "":
        fs.remove(linked)
        return message
    try:
        fs.rename(linked, output)
    except OSError as error:
        fs.remove(linked)
        return cannot_write(output, error)
    return ""

# The QBE target for the host's operating system and the architecture
# `arch`, as `uname -m` names it, or "" for an unsupported host.
def qbe_target(arch: str) -> str:
    os = core.os()
    if arch == "aarch64" or arch == "arm64":
        if os == "darwin":
            return "arm64_apple"
        return "arm64"
    if arch == "x86_64":
        if os == "darwin":
            return "amd64_apple"
        return "amd64_sysv"
    return ""

# The compiler flags that link libgc.
def gc_flags(scratch: str) -> list[str]:
    flags = shell_output("pkg-config --cflags --libs bdw-gc 2>/dev/null", scratch)
    if flags == "":
        return ["-lgc"]
    return flags.split()

# The standard output of shell `command`, or "" if it fails, by way of the
# file `scratch`; core.run cannot capture output.
def shell_output(command: str, scratch: str) -> str:
    if core.run(["sh", "-c", command + " >\"$1\"", "sh", scratch]) != 0:
        return ""
    return fs.read_file(scratch)
