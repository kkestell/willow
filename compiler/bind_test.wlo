        ["main.wlo:2:24: error: union members Iterable[int] and list[str] overlap", "def main():\n    x: Iterable[int] | list[str] = []\n"],
        # Bounds are checked once the lazy types in the argument are
        # resolved; the Lua binder rejects these programs.
        ["main.wlo:3:14: error: type argument list[float] does not satisfy the bound Iterable[int | float] of 'T'", "class Box[T: Iterable[int | float]]:\n    item: T\ndef f(b: Box[list[float]]):\n    pass\ndef main():\n    pass\n"],
