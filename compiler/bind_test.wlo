        ["main.wlo:2:10: error: 'Opt' expects 1 type argument, received 2", "type Opt[T] = T | None\ndef f(x: Opt[int, str]):\n    pass\ndef main():\n    pass\n"],
        ["main.wlo:2:10: error: type 'I' does not take type arguments", "type I = int\ndef f(x: I[str]):\n    pass\ndef main():\n    pass\n"],
        ["main.wlo:1:13: error: a type parameter can be in a union only with None", "type G[T] = T | list[G[list[T]]]\ndef f(g: G[int]):\n    pass\ndef main():\n    pass\n"],
        ["main.wlo:1:13: error: a type parameter can be in a union only with None", "def f[T](x: T | int) -> T:\n    return x\ndef main():\n    pass\n"],
        ["main.wlo:1:13: error: type parameter 'T' does not take type arguments", "def f[T](x: T[int]) -> T:\n    return x\ndef main():\n    pass\n"],
        ["main.wlo:1:10: error: a type parameter's bound must be a class, native type, or protocol", "def f[T: int](x: T) -> T:\n    return x\ndef main():\n    pass\n"],
        ["main.wlo:5:14: error: type argument int does not satisfy the bound Named of 'T'", "protocol Named:\n    def name(self) -> str\nclass Box[T: Named]:\n    v: T\ndef g(b: Box[int]):\n    pass\ndef main():\n    pass\n"],
        ["main.wlo:7:14: error: union members P and C overlap", "protocol P:\n    def m(self) -> int\nclass C:\n    x: int\n    def m(self) -> int:\n        return 1\ndef f(x: P | C):\n    pass\ndef main():\n    pass\n"],
