        ["main.wlo:3:29: error: type 'Coroutine' needs type arguments", "async def g() -> int:\n    return 1\ndef f(c: Coroutine[int], d: Coroutine) -> None:\n    pass\ndef main():\n    pass\n"],
        ["main.wlo:1:9: error: exception classes cannot be generic", "class E[T](Exception):\n    pass\ndef main():\n    pass\n"],
        ["main.wlo:1:7: error: cannot redefine built-in class 'ValueError'", "class ValueError:\n    x: int\ndef main():\n    pass\n"],
        ["main.wlo:3:10: error: type 'Box' needs type arguments", "class Box[T]:\n    v: T\ndef f(b: Box):\n    pass\ndef main():\n    pass\n"],
        ["main.wlo:4:20: error: expected int, received str", "def main():\n    def g[T](x: T) -> T:\n        return x\n    def h(x: int = 'a'):\n        pass\n"],
        ["main.wlo:2:11: error: type parameter 'T' hides another type parameter", "def f[T](x: T) -> T:\n    def g[T](y: T) -> T:\n        return y\n    return x\ndef main():\n    pass\n"],
        ["main.wlo:2:15: error: dictionary keys must be int, str, or an enum", "type K = int | str\ndef f(d: dict[K, int]):\n    pass\ndef main():\n    pass\n"],
        # The Lua implementation has neither extern nor __type; these are
        # stage 0's errors.
        ["main.wlo:1:12: error: extern functions are only allowed in core", "extern def write(fd: int) -> int\ndef main():\n    pass\n"],
        ["main.wlo:2:9: error: intrinsic '__type' is only available in core", "def main():\n    x = __type(str)\n"],
    ]
    ok = True
    for program in cases:
        actual = describe(program)
        if actual != program[0]:
            print(f"FAIL {program[1]}")
            print(f"  expected: {program[0]}")
            print(f"  actual:   {actual}")
            ok = False
    signature_cases = [
        ["main: def f(box: C, index: int) -> None\nmain: def main() -> None\nmain: field C.items: list[int]", "class C:\n    items: list[int]\ndef f(box: C, index: int):\n    box.items[index]()\ndef main():\n    pass\n"],
        ["main: def f(box: C) -> None\nmain: def main() -> None\nmain: field C.items: dict[E, int]", "enum E:\n    A\nclass C:\n    items: dict[E, int]\ndef f(box: C):\n    box.items[E.A]()\ndef main():\n    pass\n"],
        ["main: def f(t: Tree, j: J) -> list[Tree]\nmain: def main() -> None", "type Tree = int | list[Tree]\ntype J = None | dict[str, J]\ndef f(t: Tree, j: J) -> list[Tree]:\n    return [t]\ndef main():\n    pass\n"],
        ["main: def f(p: tuple[int, str], o: Opt[int], q: Opt[list[int]]) -> Opt[str]\nmain: def main() -> None", "type Pair[K, V] = tuple[K, V]\ntype Opt[T] = T | None\ndef f(p: Pair[int, str], o: Opt[int], q: Opt[list[int]]) -> Opt[str]:\n    return None\ndef main():\n    pass\n"],
        ["main: def f(x: None, y: Opt[int | None]) -> None\nmain: def main() -> None", "type Opt[T] = T | None\ndef f(x: Opt[None], y: Opt[int | None]):\n    pass\ndef main():\n    pass\n"],
        ["main: def f(x: list[Count], y: dict[str, Count]) -> list[list[Count]]\nmain: def main() -> None", "type Count = int\ndef f(x: list[Count], y: dict[str, Count]) -> list[list[Count]]:\n    return []\ndef main():\n    pass\n"],
        ["main: def f(connection: aio.Connection) -> aio.Connection\nmain: def main() -> None", "import aio\ndef f(connection: aio.Connection) -> aio.Connection:\n    return connection\ndef main():\n    pass\n"],
        ["main: def f(x: E, y: E | None, z: tuple[E, int]) -> None\nmain: def main() -> None\nmain: field C.e: E", "enum E:\n    A\n    B\ndef f(x: E = E.B, y: E | None = None, z: tuple[E, int] = (E.A, -1)):\n    pass\nclass C:\n    e: E = E.A\ndef main():\n    pass\n"],
        ["main: def f(x: (int) -> str | None, y: ((int) -> str) | None) -> None\nmain: def main() -> None", "def f(x: (int) -> str | None, y: ((int) -> str) | None):\n    pass\ndef main():\n    pass\n"],
        ["main: def f(x: P | C | None) -> None\nmain: def main() -> None\nmain: field C.x: int", "protocol P:\n    def m(self) -> int\nclass C:\n    x: int\ndef f(x: P | C | None):\n    pass\ndef main():\n    pass\n"],
        ["main: def f(x: T) -> T\nmain: def g(b: Box[P]) -> None\nmain: def main() -> None\nmain: def P.name(self: P) -> str\nmain: field P.n: str\nmain: field Box.v: T", "protocol Named:\n    def name(self) -> str\nclass P:\n    n: str\n    def name(self) -> str:\n        return self.n\ndef f[T: Named](x: T) -> T:\n    return x\nclass Box[T: Named]:\n    v: T\ndef g(b: Box[P]):\n    pass\ndef main():\n    pass\n"],
        ["main: def f(s: shapes.Shape, c: shapes.Circle) -> shapes.Kind\nmain: def main() -> None\nshapes: field shapes.Circle.r: float\nshapes: field shapes.Square.s: float", "import shapes\ndef f(s: shapes.Shape, c: shapes.Circle) -> shapes.Kind:\n    return shapes.Kind.A\ndef main():\n    pass\n", "shapes", "type Shape = Circle | Square\nclass Circle:\n    r: float\nclass Square:\n    s: float\nenum Kind:\n    A\n"],
        ["main: def main() -> Coroutine[None]", "async def main():\n    pass\n"],
        ["main: def f(b: Box[list[int]], s: list[list[int]], u: Box[list[int | float]]) -> Box[list[int]]\nmain: def main() -> None\nmain: field Box.item: T", "class Box[T: Iterable[int | float]]:\n    item: T\ntype SBox[T: Iterable[int]] = list[T]\ndef f(b: Box[list[int]], s: SBox[list[int]], u: Box[list[int | float]]) -> Box[list[int]]:\n    return b\ndef main():\n    pass\n"],
        ["main: def f(b: Box[L]) -> None\nmain: def main() -> None\nmain: def L.items(self: L) -> list[int]\nmain: field Box.item: T", "protocol HasList:\n    def items(self) -> list[int]\nclass L:\n    def items(self) -> list[int]:\n        return [1]\nclass Box[T: HasList]:\n    item: T\ndef f(b: Box[L]):\n    pass\ndef main():\n    pass\n"],
        ["main: def f(a: tuple[int, str], b: tuple[()], c: tuple[int]) -> None\nmain: def main() -> None", "def f(a: tuple[int, str], b: tuple[()], c: tuple[int]):\n    pass\ndef main():\n    pass\n"],
    ]
    for program in signature_cases:
        actual = signatures(program, False)
        if actual != program[0]:
            print(f"FAIL signatures {program[1]}")
            print(f"  expected: {program[0]}")
            print(f"  actual:   {actual}")
            ok = False
    # A test file needs no main; its tests take no parameters and return None.
    test_cases = [
        ["main: def test_b() -> None\nmain: def test_a() -> None\nmain: def test_c() -> Coroutine[None]", "def test_b():\n    pass\ndef test_a():\n    pass\nasync def test_c():\n    pass\n"],
        ["main.wlo:1:5: error: test function 'test_a' must take no parameters and return None", "def test_a(x: int):\n    pass\n"],
        ["main.wlo:1:5: error: test function 'test_b' must take no parameters and return None", "def test_b() -> int:\n    return 1\ndef test_a():\n    pass\n"],
    ]
    for program in test_cases:
        actual = signatures(program, True)
        if actual != program[0]:
            print(f"FAIL test file {program[1]}")
            print(f"  expected: {program[0]}")
            print(f"  actual:   {actual}")
            ok = False
    tested = bind_program(["", "def test_b():\n    pass\ndef helper():\n    pass\ndef test_a():\n    pass\n"], True)
    if isinstance(tested, str):
        print(f"FAIL tests in name order: {tested}")
        ok = False
    else:
        order: list[str] = []
        for function in tested[0].tests:
            order.append(function.name)
        if " ".join(order) != "test_a test_b":
            print("FAIL tests in name order: " + " ".join(order))
            ok = False
    names = function_names(["", "import a\nprotocol P:\n    def f(self) -> int\n    def g(self) -> int\nclass C:\n    x: int\n    def m(self) -> int:\n        return 1\ndef h() -> int:\n    return 1\ndef main():\n    if True:\n        def g[T](x: T) -> T:\n            return x\n    else:\n        def g[T](x: T) -> T:\n            f = lambda: x\n            return x\n", "a", "class D:\n    y: int\n    def n(self):\n        pass\n"])
    expected = "P.f P.g C.m h main main.g main.g main.g.<lambda> a.D.n"
    if names != expected:
        print("FAIL function ids and type names")
        print(f"  expected: {expected}")
        print(f"  actual:   {names}")
        ok = False
    if not ok:
        sys.exit(1)
    print("bind tests passed")
