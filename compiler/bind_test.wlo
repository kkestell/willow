        ["main [p, x*, g] [] { p = 1; for x in p { def g() -> None { y = x } } }\ng [y] [x] { y = x }", "def main():\n    p = 1\n    for x in p:\n        def g():\n            y = x\n"],
        ["first [] [] { return x }\nmain [xs, i] [] { xs = i; i = xs[i]; first[int](xs) }", "def first[T](x: T) -> T:\n    return x\ndef main():\n    xs = i\n    i = xs[i]\n    first[int](xs)\n"],
        # Types
        ["main.wlo:1:10: error: alias 'A' expands to itself", "type A = A | int\ndef main():\n    pass\n"],
