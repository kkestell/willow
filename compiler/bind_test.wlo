        ["main.wlo:4:13: error: 'x' is used before its nonlocal declaration", "def main():\n    x = 1\n    def g():\n        y = x\n        nonlocal x\n        x = 2\n"],
        ["main [x*, g] [] { x = 1; def g() -> None { nonlocal x; x = (x + 1) }; (g)() }\ng [] [x] { nonlocal x; x = (x + 1) }", "def main():\n    x = 1\n    def g():\n        nonlocal x\n        x = x + 1\n    g()\n"],
        ["main [x*, h] [] { x = 1; def h() -> None { def k() -> None { y = x } } }\nh [k] [x] { def k() -> None { y = x } }\nk [y] [x] { y = x }", "def main():\n    x = 1\n    def h():\n        def k():\n            y = x\n"],
        ["f [] [] { return None }\nmain [a, b, c, e, k, v, i] [] { <a, b> = f(); for c in f() { pass }; try { pass } except E as e { pass }; for <k, v> in f() { i = 1 } }",
            "class E(Exception):\n    pass\ndef f():\n    return None\ndef main():\n    a, b = f()\n    for c in f():\n        pass\n    try:\n        pass\n    except E as e:\n        pass\n    for k, v in f():\n        i = 1\n", ],
        ["f [] [] { pass }\nmain [g, y] [] { g = f; (g)(1); y = E.A; a.h(E.A) }\nh [] [] { pass }", "import a\nenum E:\n    A\ndef f(x: int):\n    pass\ndef main():\n    g = f\n    g(1)\n    y = E.A\n    a.h(E.A)\n", "a", "def h(x: int):\n    pass\n"],
        ["main [x*, f] [] { x = 1; f = (lambda y: (x + y)) }", "def main():\n    x = 1\n    f = lambda y: x + y\n"],
        ["f [] [] { pass }\nmain [f] [] { f = 1; (f)() }", "def f():\n    pass\ndef main():\n    f = 1\n    f()\n"],
        ["main [g, v, w] [] { def g[T](x: T) -> T { return x }; v = g; w = g[int]; (g)(1) }\ng [] [] { return x }", "def main():\n    def g[T](x: T) -> T:\n        return x\n    v = g\n    w = g[int]\n    g(1)\n"],
        ["main [h, x] [] { h = []; x = (h[0])(1) }", "def main():\n    h = []\n    x = h[0](1)\n"],
        ["main [c, v, e, b] [] { c = a.C(1); v = h; e = E.A; try { pass } except a.Bad as b { raise } }\nh [] [] { pass }", "import a\ndef main():\n    c = a.C(1)\n    v = a.h\n    e = a.E.A\n    try:\n        pass\n    except a.Bad as b:\n        raise\n", "a", "class C:\n    x: int\nenum E:\n    A\nclass Bad(Exception):\n    pass\ndef h():\n    pass\n"],
