# Checks the binder's name resolution and diagnostics. Each case is a
# program, the entry module `main` and then pairs of module names and
# sources. Prints each mismatch and exits with status 1 if there was one.

import ast
import bind
import diagnostic
import lexer
import loader
import parser
import show
import sys

# The modules of `program`, the entry first, after binding, or the first
# error. A `test` program is a test file.
def bind_program(program: list[str], test: bool) -> list[ast.Module] | str:
    sources: list[loader.Source] = []
    modules: list[ast.Module] = []
    i = 1
    while i < len(program):
        name = "main"
        source = program[i]
        if i > 1:
            name = program[i]
            source = program[i + 1]
            i = i + 1
        i = i + 1
        path = "/".join(name.split(".")) + ".wlo"
        lexed = lexer.lex(path, source)
        if isinstance(lexed, diagnostic.Diagnostic):
            return lexed.format()
        parsed = parser.parse(path, lexed, False)
        if isinstance(parsed, diagnostic.Diagnostic):
            return parsed.format()
        sources.append(loader.Source(name, parsed))
        modules.append(parsed)
    error = bind.bind(sources, test)
    if error is not None:
        return error.format()
    return modules

# The first error in the program, or each function's locals, with `*` on
# captured ones, its captures, and its body after binding.
def describe(program: list[str]) -> str:
    modules = bind_program(program, False)
    if isinstance(modules, str):
        return modules
    lines: list[str] = []
    for module in modules:
        for function in bind.functions(module):
            describe_function(function, lines)
    return "\n".join(lines)

# The first error in the program, or the types of its modules' functions and
# fields, as bind_files --signatures writes them.
def signatures(program: list[str], test: bool) -> str:
    modules = bind_program(program, test)
    if isinstance(modules, str):
        return modules
    lines: list[str] = []
    for module in modules:
        for line in bind.signatures(module):
            lines.append(f"{module.name}: {line}")
    return "\n".join(lines)

def describe_function(function: ast.FunctionDecl, lines: list[str]):
    locals: list[str] = []
    for symbol in function.locals:
        if symbol.captured:
            locals.append(symbol.name + "*")
        else:
            locals.append(symbol.name)
    captures: list[str] = []
    for capture in function.captures:
        captures.append(capture.symbol.name)
    lines.append(f"{function.name} [{', '.join(locals)}] [{', '.join(captures)}] {show.Printer(False).block(function.body)}")
    nested_functions(function.body, lines)

# Describes the functions nested in `body`.
def nested_functions(body: list[ast.Stmt], lines: list[str]):
    for statement in body:
        node = statement.node
        if isinstance(node, ast.FunctionDef):
            describe_function(node.function, lines)
        elif isinstance(node, ast.If):
            nested_functions(node.body, lines)
            nested_functions(node.else_body, lines)
        elif isinstance(node, ast.While):
            nested_functions(node.body, lines)
        elif isinstance(node, ast.For):
            nested_functions(node.body, lines)

# The type names of the functions of a bound program, which must all have
# distinct ids: declarations, methods, protocol methods, and nested functions
# and lambdas at any depth.
def function_names(program: list[str]) -> str:
    modules = bind_program(program, False)
    if isinstance(modules, str):
        return modules
    found: list[ast.FunctionDecl] = []
    for module in modules:
        for decl in module.declarations:
            if isinstance(decl, ast.FunctionDecl):
                collect_functions(decl, found)
            elif isinstance(decl, ast.ClassDecl):
                for method in decl.methods:
                    collect_functions(method, found)
            elif isinstance(decl, ast.ProtocolDecl):
                for method in decl.methods:
                    collect_functions(method, found)
    names: list[str] = []
    ids: dict[int, bool] = {}
    for function in found:
        if function.id == 0 or function.id in ids:
            return f"{function.type_name} has id {function.id}, which is not unique"
        ids[function.id] = True
        names.append(function.type_name)
    return " ".join(names)

def collect_functions(function: ast.FunctionDecl, found: list[ast.FunctionDecl]):
    found.append(function)
    collect_in_block(function.body, found)

def collect_in_block(body: list[ast.Stmt], found: list[ast.FunctionDecl]):
    for statement in body:
        node = statement.node
        if isinstance(node, ast.FunctionDef):
            collect_functions(node.function, found)
        elif isinstance(node, ast.If):
            collect_in_block(node.body, found)
            collect_in_block(node.else_body, found)
        elif isinstance(node, ast.Assign):
            value = node.value.node
            if isinstance(value, ast.Lambda):
                function = value.function
                if function is not None:
                    collect_functions(function, found)

def main():
    cases = [
        # Declarations
        ["main.wlo:3:5: error: duplicate function 'f'", "def f():\n    pass\ndef f():\n    pass\ndef main():\n    pass\n"],
        ["main.wlo:3:7: error: duplicate class 'f'", "def f():\n    pass\nclass f:\n    x: int\ndef main():\n    pass\n"],
        ["main.wlo:2:5: error: duplicate function 'a'", "import a\ndef a():\n    pass\ndef main():\n    pass\n", "a", "def g():\n    pass\n"],
        ["main.wlo:2:8: error: duplicate import 'a'", "import a\nimport a\ndef main():\n    pass\n", "a", "def g():\n    pass\n"],
        ["main.wlo:2:8: error: 'a' is imported as a module and as a namespace", "import a\nimport a.b\ndef main():\n    pass\n", "a", "def g():\n    pass\n", "a.b", "def h():\n    pass\n"],
        ["main.wlo:4:5: error: duplicate enum member 'A'", "enum E:\n    A\n    B\n    A\ndef main():\n    pass\n"],
        ["main.wlo:3:5: error: duplicate field 'x'", "class C:\n    x: int\n    x: str\ndef main():\n    pass\n"],
        ["main.wlo:5:9: error: duplicate method 'm'", "class C:\n    def m(self):\n        pass\n\n    def m(self):\n        pass\ndef main():\n    pass\n"],
        ["main.wlo:4:9: error: method 'x' has the same name as a field", "class C:\n    x: int\n\n    def x(self):\n        pass\ndef main():\n    pass\n"],
        ["main.wlo:1:15: error: duplicate parameter 'a'", "def f(a: int, a: int):\n    pass\ndef main():\n    pass\n"],
        ["main.wlo:1:10: error: type parameter 'T' hides another type parameter", "def f[T, T](x: T) -> T:\n    return x\ndef main():\n    pass\n"],
        ["main.wlo:4:11: error: type parameter 'T' hides another type parameter", "class Box[T]:\n    value: T\n\n    def m[T](self, x: T) -> T:\n        return x\ndef main():\n    pass\n"],
        ["main.wlo:1:1: error: program has no main function", "def f():\n    pass\n"],
        ["main.wlo:1:1: error: program has no main function", "class main:\n    x: int\n"],
        ["main.wlo:1:5: error: main must take no parameters and return None", "def main(x: int):\n    pass\n"],
        # Names
        ["main.wlo:2:9: error: unknown name 'y'", "def main():\n    x = y\n"],
        ["main.wlo:2:5: error: unknown function 'g'", "def main():\n    g()\n"],
        ["main.wlo:3:9: error: module 'a' cannot be used as a value", "import a\ndef main():\n    x = a\n", "a", "def g():\n    pass\n"],
        ["main.wlo:4:9: error: class 'C' cannot be used as a value", "class C:\n    x: int\ndef main():\n    y = C\n"],
        ["main.wlo:3:9: error: alias 'T' cannot be used as a value", "type T = int\ndef main():\n    y = T\n"],
        ["main.wlo:4:5: error: enum 'E' cannot be called", "enum E:\n    A\ndef main():\n    E()\n"],
        ["main.wlo:3:5: error: alias 'T' cannot be called", "type T = int\ndef main():\n    T()\n"],
        ["main.wlo:4:5: error: protocol 'P' cannot be called", "protocol P:\n    def m(self)\ndef main():\n    P()\n"],
        ["main.wlo:5:11: error: enum 'E' has no member 'B'", "enum E:\n    A\ndef main():\n    x = E.A\n    y = E.B\n"],
        ["main.wlo:4:7: error: enum 'E' has no method 'm'", "enum E:\n    A\ndef main():\n    E.m()\n"],
        ["main.wlo:4:7: error: cannot assign to a member of enum 'E'", "enum E:\n    A\ndef main():\n    E.A = E.A\n"],
        ["main.wlo:3:7: error: module 'a' has no function, class, enum, or alias 'nope'", "import a\ndef main():\n    a.nope()\n", "a", "def g():\n    pass\n"],
        ["main.wlo:3:7: error: '_p' is private to module 'a'", "import a\ndef main():\n    a._p()\n", "a", "def _p():\n    pass\n"],
        ["main.wlo:3:13: error: enum 'a.E' has no member 'B'", "import a\ndef main():\n    x = a.E.B\n", "a", "enum E:\n    A\n"],
        ["main.wlo:4:7: error: alias 'a.T' cannot be called", "import a\ndef main():\n    a.g()\n    a.T()\n", "a", "def g():\n    pass\ntype T = int\n"],
        ["main.wlo:4:5: error: 'f' is not generic", "def f(x: int):\n    pass\ndef main():\n    f[int](1)\n"],
