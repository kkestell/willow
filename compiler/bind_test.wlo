        ["main.wlo:2:5: error: 'await' is only allowed in an async function", "def main():\n    await f()\nasync def f():\n    pass\n"],
        ["main.wlo:2:5: error: 'yield' cannot be used in an async function", "async def f():\n    yield 1\ndef main():\n    pass\n"],
        ["main.wlo:2:5: error: 'async with' is only allowed in an async function", "def main():\n    async with g:\n        pass\n"],
        ["main.wlo:2:5: error: bare 'raise' is only allowed in an 'except' clause", "def main():\n    raise\n"],
        ["main.wlo:6:12: error: 'C' is not an exception class", "class C:\n    x: int\ndef main():\n    try:\n        pass\n    except C:\n        pass\n"],
