# Reads a source file and checks its UTF-8 (spec §2).

import diagnostic
import fs

# A source file that could not be read, with the reason fs reported.
class Unreadable:
    reason: str

# The text of the source file at `path`, or a diagnostic at its first byte
# that is not valid UTF-8, or Unreadable when it cannot be read.
def read(path: str) -> str | diagnostic.Diagnostic | Unreadable:
    var data: bytes
    try:
        data = fs.read_bytes(path)
    except OSError as error:
        return Unreadable(read_reason(error))
    try:
        return data.decode()
    except ValueError:
        pass
    var line = 1
    var col = 1
    var i = 0
    var size = char_size(data, i)
    while size > 0:
        if data[i] == 10:
            line = line + 1
            col = 0
        col = col + 1
        i = i + size
        size = char_size(data, i)
    return diagnostic.Diagnostic(path, line, col, "invalid UTF-8")

# The byte length of the UTF-8 character at byte `i` of `data`, or 0 when the
# bytes there are not valid UTF-8. No prefix of a character decodes, so the
# shortest slice that does is one character.
def char_size(data: bytes, i: int) -> int:
    for size in range(1, 5):
        try:
            data[i:i + size].decode()
            return size
        except ValueError:
            pass
    return 0

# The reason in an OSError from fs.read_file: the path and the system's
# message.
def read_reason(error: OSError) -> str:
    return error.message.removeprefix("cannot read ")
