# Checks the bodies of a bound program's functions and annotates the tree
# for the emitter: each checked expression's `ty` and `expected`, and the
# type of each parameter's and local's symbol. Checking stops at the first
# error.

import ast
import bind
import diagnostic
import stdlib
import types

class GroupFlow:
    finally_depth: int
    loops: int
    exits: list[dict[int, types.Type]]
    departures: list[dict[int, types.Type]]

class GroupMark:
    exits: int
    departures: int

class Checker:
    module: ast.Module
    function: ast.FunctionDecl
    result: types.Type
    error: diagnostic.Diagnostic | none
    # The parameters and the locals assigned so far, by id.
    symbols: dict[int, ast.Symbol]
    groups: list[GroupFlow]
    loops: int = 0
    # The number of `finally` clauses enclosing the statement being checked,
    # and that number at the innermost loop.
    finally_depth: int = 0
    loop_finally: int = 0
    # The number of calls checked so far.
    calls: int = 0
    yield_type: types.Type | none = none

    def fail(line: int, col: int, message: str):
        if self.error is none:
            self.error = diagnostic.Diagnostic(self.module.path, line, col, message)

    def failed() -> bool:
        return self.error is not none

    # Reports a construct that stage 1 does not compile yet, and gives it the
    # type none so checking can unwind.
    def unsupported(line: int, col: int, what: str) -> types.Type:
        self.fail(line, col, f"stage 1 does not support {what} yet")
        return none_type()

    # Records that `expr`, of type `actual`, is used where `expected` is.
    def expect(expr: ast.Expr, expected: types.Type, actual: types.Type):
        if self.failed():
            return
        if not types.assignable(expected, actual):
            self.fail(expr.line, expr.col, f"expected {types.display(expected)}, received {types.display(actual)}")
            return
        expr.expected = expected

    def check_against(expr: ast.Expr, state: dict[int, types.Type], expected: types.Type):
        expr.expected = expected
        self.expect(expr, expected, self.check_expr(expr, state))

    # Checks the condition `expr` and returns what it proves.
    def check_condition(expr: ast.Expr, state: dict[int, types.Type]) -> Facts:
        self.check_against(expr, state, types.prim("bool"))
        if self.failed():
            return Facts({}, {})
        return self.facts(expr)

    def check_arity(expr: ast.Expr, name: str, count: int, received: int):
        if received != count:
            self.fail(expr.line, expr.col, f"'{name}' expects {arguments(count)}, received {received}")

    # Keeps parameter order separate from evaluation order, and gives each call
    # its own default expressions and type annotations.
    def bind_args(expr: ast.Expr, node: ast.Call | ast.MethodCall | ast.CallValue, params: list[stdlib.BuiltinParam], noun: str):
        args: list[ast.Expr] = []
        keywords: list[ast.Keyword] = []
        name = ""
        if isinstance(node, ast.Call):
            args = node.args
            keywords = node.keywords
            name = node.name
        else if isinstance(node, ast.MethodCall):
            args = node.args
            keywords = node.keywords
            name = node.name
        else:
            args = node.args
            keywords = node.keywords
            name = callee_name(node.callee)
        bound: dict[int, ast.Expr] = {}
        order: list[int] = []
        for i in range(len(args)):
            arg = args[i]
            if i < len(params) and params[i].keyword_only:
                self.fail(arg.line, arg.col, f"'{name}' received a positional argument for keyword-only parameter '{params[i].name}'")
                return
            bound[i] = arg
            order.append(i)
        for keyword in keywords:
            if noun == "":
                self.fail(keyword.line, keyword.col, f"'{name}' does not accept keyword arguments")
                return
            index = -1
            for i in range(len(params)):
                if params[i].name == keyword.name:
                    index = i
            if index == -1:
                self.fail(keyword.line, keyword.col, f"'{name}' has no {noun} '{keyword.name}'")
                return
            if index in bound:
                self.fail(keyword.line, keyword.col, f"'{name}' received more than one value for '{keyword.name}'")
                return
            bound[index] = keyword.value
            order.append(index)
        required = 0
        for i in range(len(params)):
            if params[i].default is none and not params[i].keyword_only:
                required = i + 1
        count = len(args) + len(keywords)
        if required == len(params):
            self.check_arity(expr, name, required, count)
        else if count < required or count > len(params):
            self.fail(expr.line, expr.col, f"'{name}' expects {required} to {len(params)} arguments, received {count}")
        if self.failed():
            return
        result: list[ast.Expr] = []
        for i in range(len(params)):
            if i not in bound:
                default = params[i].default
                if default is none:
                    self.fail(expr.line, expr.col, f"'{name}' is missing argument '{params[i].name}'")
                    return
                bound[i] = copy_default(default, expr.line, expr.col)
                order.append(i)
            result.append(bound[i])
        if isinstance(node, ast.Call):
            node.args = result
            node.order = order
        else if isinstance(node, ast.MethodCall):
            node.args = result
            node.order = order
            node.written = count
        else:
            node.args = result
            node.order = order

    # Statements

    # Checks `body`, updating `state`, the type of each definitely assigned
    # symbol by id. Returns whether the block transfers control, so that what
    # follows it cannot run.
    def check_block(body: list[ast.Stmt], state: dict[int, types.Type]) -> bool:
        transfers = false
        for statement in body:
            if self.failed():
                return transfers
            if transfers:
                self.fail(statement.line, statement.col, "unreachable statement")
                return transfers
            transfers = self.check_stmt(statement, state)
        return transfers

    def check_stmt(statement: ast.Stmt, state: dict[int, types.Type]) -> bool:
        node = statement.node
        line = statement.line
        col = statement.col
        if isinstance(node, ast.Assign):
            self.check_assign(statement, node, state)
        else if isinstance(node, ast.Unpack):
            self.check_pattern(node.target, self.check_expr(node.value, state), state)
        else if isinstance(node, ast.CallStmt):
            ty = self.check_expr(node.call, state)
            if stdlib.has_coroutine(ty):
                self.fail(line, col, f"cannot discard a value of type {types.display(ty)}; a discarded coroutine never runs")
            # sys.exit never returns, so it transfers control.
            call = node.call.node
            if isinstance(call, ast.Call):
                target = call.target
                return isinstance(target, stdlib.Builtin) and target.name == "exit"
        else if isinstance(node, ast.If):
            return self.check_if(node, state)
        else if isinstance(node, ast.While):
            self.check_while(node, state)
        else if isinstance(node, ast.Return):
            if self.finally_depth > 0:
                self.fail(line, col, "'return' cannot leave a 'finally' clause")
            self.check_return(statement, node, state)
            self.departure(state, true)
            return true
        else if isinstance(node, ast.Yield):
            if self.finally_depth > 0:
                self.fail(line, col, "'yield' cannot be used in a 'finally' clause")
            yielded = self.yield_type
            assert yielded is not none, "yield outside a generator"
            self.check_against(node.value, state, yielded)
            self.calls = self.calls + 1
            self.forget_captured(state)
        else if isinstance(node, ast.IndexAssign):
            self.check_index_assign(statement, node, state)
        else if isinstance(node, ast.FieldAssign):
            self.check_field_assign(statement, node, state)
        else if isinstance(node, ast.For):
            self.check_for(statement, node, state)
        else if isinstance(node, ast.Assert):
            self.check_assert(node, state)
        else if isinstance(node, ast.Raise):
            self.check_raise(node, state)
            return true
        else if isinstance(node, ast.Try):
            return self.check_try(node, state)
        else if isinstance(node, ast.With):
            return self.check_with(statement, node, state)
        else if isinstance(node, ast.AsyncWith):
            return self.check_async_with(node, state)
        else if isinstance(node, ast.FunctionDef):
            self.check_nested(statement, node, state)
        else if isinstance(node, ast.Nonlocal):
            # The binder has made later assignments rebind the outer variables.
            pass
        else if isinstance(node, ast.SimpleStatement):
            if node == ast.SimpleStatement.BREAK:
                return self.check_transfer(statement, "break", state)
            else if node == ast.SimpleStatement.CONTINUE:
                return self.check_transfer(statement, "continue", state)
        else:
            self.unsupported(line, col, "this statement")
        return false

    def check_assign(statement: ast.Stmt, node: ast.Assign, state: dict[int, types.Type]):
        symbol = node.symbol
        assert symbol is not none, "assignment without a symbol"
        declared = node.declared
        expected = symbol.ty
        if declared is not none:
            expected = declared
        node.value.expected = expected
        value_type = self.check_expr(node.value, state)
        if declared is not none:
            if symbol.is_param:
                self.fail(statement.line, statement.col, f"cannot annotate parameter '{node.name}'")
            # Statements are checked in source order, so a type means an
            # earlier assignment.
            if symbol.ty is not none:
                self.fail(statement.line, statement.col, f"only the first assignment to '{node.name}' can have an annotation")
            symbol.ty = declared
        self.symbols[symbol.id] = symbol
        ty = symbol.ty
        if ty is not none:
            self.expect(node.value, ty, value_type)
            state[symbol.id] = assigned_type(ty, value_type)
        else:
            symbol.ty = value_type
            state[symbol.id] = value_type

    def check_target(target: ast.Target, item: types.Type, state: dict[int, types.Type], line: int, col: int):
        symbol = target.symbol
        assert symbol is not none, "target without a symbol"
        declared = symbol.ty
        if declared is not none:
            if not types.assignable(declared, item):
                self.fail(line, col, f"expected {types.display(declared)}, received {types.display(item)}")
            state[symbol.id] = assigned_type(declared, item)
        else:
            symbol.ty = item
            state[symbol.id] = item
        self.symbols[symbol.id] = symbol

    def check_pattern(target: ast.Target, item: types.Type, state: dict[int, types.Type]):
        if self.failed():
            return
        if target.name != "":
            self.check_target(target, item, state, target.line, target.col)
            return
        if not isinstance(item, types.TupleType):
            self.fail(target.line, target.col, f"cannot unpack a value of type {types.display(item)}")
            return
        if len(target.elements) != len(item.elements):
            self.fail(target.line, target.col, f"cannot unpack {types.display(item)} into {len(target.elements)} targets")
            return
        for i in range(len(target.elements)):
            self.check_pattern(target.elements[i], item.elements[i], state)

    def check_if(node: ast.If, state: dict[int, types.Type]) -> bool:
        facts = self.check_condition(node.condition, state)
        body_state = narrow(state, facts.when_true)
        body_transfers = self.check_block(node.body, body_state)
        else_state = narrow(state, facts.when_false)
        else_transfers = self.check_block(node.else_body, else_state)
        if body_transfers and else_transfers:
            return true
        if body_transfers:
            replace(state, else_state)
        else if else_transfers:
            replace(state, body_state)
        else:
            replace(state, join(body_state, else_state, self.symbols))
        return false

    def check_while(node: ast.While, state: dict[int, types.Type]):
        # Narrowing before the loop holds in it and after it only for the
        # locals the loop does not assign.
        assigned: dict[int, bool] = {}
        assigned_symbols(node.body, assigned)
        for id in assigned:
            if id in state:
                state[id] = self.declared(id)
        if node.calls:
            self.forget_captured(state)
        facts = self.check_condition(node.condition, state)
        # The body may run zero times, so its assignments are not definite
        # after the loop.
        self.check_loop_body(node.body, narrow(state, facts.when_true))

    def check_loop_body(body: list[ast.Stmt], state: dict[int, types.Type]):
        loop_finally = self.loop_finally
        self.loop_finally = self.finally_depth
        self.loops = self.loops + 1
        self.check_block(body, state)
        self.loops = self.loops - 1
        self.loop_finally = loop_finally

    # The message runs only when the condition is false, and what follows
    # only when it is true.
    def check_assert(node: ast.Assert, state: dict[int, types.Type]):
        facts = self.check_condition(node.condition, state)
        message = node.message
        if message is not none:
            self.check_against(message, narrow(state, facts.when_false), types.prim("str"))
        replace(state, narrow(state, facts.when_true))

    def declared(id: int) -> types.Type:
        ty = self.symbols[id].ty
        assert ty is not none, "a symbol in the state has no type"
        return ty

    def check_transfer(statement: ast.Stmt, name: str, state: dict[int, types.Type]) -> bool:
        if self.loops == 0:
            self.fail(statement.line, statement.col, f"'{name}' outside of a loop")
        else if self.loop_finally < self.finally_depth:
            self.fail(statement.line, statement.col, f"'{name}' cannot leave a 'finally' clause")
        self.departure(state, false)
        return true

    def graceful_exit(state: dict[int, types.Type]):
        i = len(self.groups) - 1
        while i >= 0:
            group = self.groups[i]
            if group.finally_depth != self.finally_depth:
                break
            group.exits.append(copy(state))
            i = i - 1

    def departure(state: dict[int, types.Type], returning: bool):
        i = len(self.groups) - 1
        while i >= 0:
            group = self.groups[i]
            if not returning and group.loops != self.loops:
                break
            group.departures.append(copy(state))
            i = i - 1

    def group_mark() -> list[GroupMark]:
        marks: list[GroupMark] = []
        for group in self.groups:
            marks.append(GroupMark(len(group.exits), len(group.departures)))
        return marks

    def group_states(marks: list[GroupMark]) -> list[dict[int, types.Type]]:
        states: list[dict[int, types.Type]] = []
        for i in range(len(marks)):
            group = self.groups[i]
            states.extend(group.exits[marks[i].exits:])
            states.extend(group.departures[marks[i].departures:])
        return states

    def drop_group_states(marks: list[GroupMark]):
        for i in range(len(marks)):
            group = self.groups[i]
            group.exits = group.exits[:marks[i].exits]
            group.departures = group.departures[:marks[i].departures]

    def join_states(states: list[dict[int, types.Type]]) -> dict[int, types.Type]:
        result = states[0]
        for state in states[1:]:
            result = join(result, state, self.symbols)
        return result

    def check_async_with(node: ast.AsyncWith, state: dict[int, types.Type]) -> bool:
        group_type = self.check_expr(node.manager, state)
        if not isinstance(group_type, types.ClassType) or not group_type.decl.library or group_type.decl.type_name != "aio.TaskGroup":
            self.fail(node.manager.line, node.manager.col, f"expected aio.TaskGroup, received {types.display(group_type)}")
            return false
        pattern = node.target
        if pattern is not none:
            self.check_pattern(pattern, group_type, state)
        marks = self.group_mark()
        frame = GroupFlow(self.finally_depth, self.loops, [], [])
        self.groups.append(frame)
        body_state = copy(state)
        transfers = self.check_block(node.body, body_state)
        self.groups.pop()
        self.calls = self.calls + 1
        for recorded in self.group_states(marks):
            self.forget_captured(recorded)
        ends: list[dict[int, types.Type]] = []
        if not transfers:
            ends.append(body_state)
        ends.extend(frame.exits)
        reached: list[dict[int, types.Type]] = []
        reached.extend(ends)
        reached.extend(frame.departures)
        if len(reached) > 0:
            boundary = self.join_states(reached)
            self.forget_captured(boundary)
            self.graceful_exit(boundary)
        if len(ends) == 0:
            return true
        after = self.join_states(ends)
        self.forget_captured(after)
        replace(state, after)
        return false

    def check_raise(node: ast.Raise, state: dict[int, types.Type]):
        value = node.value
        if value is none:
            return
        ty = self.check_expr(value, state)
        if not self.failed() and not types.is_exception(types.expand(ty)):
            self.fail(value.line, value.col, f"expected an exception, received {types.display(ty)}")

    # The body may stop at any statement, so the clauses start from the state
    # before the `try`, without narrowing of the locals the parts before them
    # assign. Returns whether the statement transfers control.
    def check_try(node: ast.Try, state: dict[int, types.Type]) -> bool:
        handler_entry = copy(state)
        self.forget_narrowing(handler_entry, node.body)
        finally_entry = copy(handler_entry)
        body_state = copy(state)
        before = self.calls
        marks = self.group_mark()
        transfers = self.check_block(node.body, body_state)
        # A clause may start after any call in the parts before it.
        if self.calls != before:
            self.forget_captured(handler_entry)
            self.forget_captured(finally_entry)
        exits: list[dict[int, types.Type]] = []
        if not transfers:
            exits.append(body_state)
        named: list[str] = []
        for handler in node.handlers:
            if self.failed():
                return transfers
            record = handler.type_name.record
            assert isinstance(record, types.Class), "except clause without a class"
            if "Exception" in named or record.type_name in named:
                self.fail(handler.line, handler.col, "unreachable 'except' clause")
                return transfers
            named.append(record.type_name)
            handled = types.ClassType(record, [])
            handler_state = copy(handler_entry)
            symbol = handler.symbol
            if symbol is not none:
                declared = symbol.ty
                if declared is none:
                    symbol.ty = handled
                    declared = handled
                else if not types.assignable(declared, handled):
                    self.fail(handler.line, handler.col, f"expected {types.display(declared)}, received {types.display(handled)}")
                self.symbols[symbol.id] = symbol
                handler_state[symbol.id] = assigned_type(declared, handled)
            before = self.calls
            handler_transfers = self.check_block(handler.body, handler_state)
            if self.calls != before:
                self.forget_captured(finally_entry)
            if not handler_transfers:
                exits.append(handler_state)
            transfers = transfers and handler_transfers
            self.forget_narrowing(finally_entry, handler.body)
            if symbol is not none and symbol.id in finally_entry:
                finally_entry[symbol.id] = self.declared(symbol.id)
        result: dict[int, types.Type] = {}
        if len(exits) > 0:
            result = exits[0]
            for i in range(1, len(exits)):
                result = join(result, exits[i], self.symbols)
        if len(node.finally_body) > 0:
            self.finally_depth = self.finally_depth + 1
            finally_state = copy(finally_entry)
            before = self.calls
            finally_transfers = self.check_block(node.finally_body, finally_state)
            self.finally_depth = self.finally_depth - 1
            if finally_transfers:
                self.drop_group_states(marks)
                return true
            finally_calls = self.calls != before
            # The finally clause runs after whichever part completed. A local
            # it assigns on some paths only may no longer be narrowed.
            assigned: dict[int, bool] = {}
            assigned_symbols(node.finally_body, assigned)
            states = self.group_states(marks)
            states.append(result)
            for exit in states:
                if finally_calls:
                    self.forget_captured(exit)
                for id in assigned:
                    if id in exit:
                        exit[id] = self.declared(id)
                for id in finally_state:
                    if id in assigned or not types.same(finally_state[id], self.declared(id)):
                        exit[id] = finally_state[id]
        if transfers:
            return true
        replace(state, result)
        return false

    # Any call may rebind a captured variable, so captured variables lose
    # their narrowing after every call.
    def forget_captured(state: dict[int, types.Type]):
        for id in state:
            if self.symbols[id].captured:
                state[id] = self.declared(id)

    def without_captured(facts: dict[int, types.Type]) -> dict[int, types.Type]:
        result: dict[int, types.Type] = {}
        for id in facts:
            if not self.symbols[id].captured:
                result[id] = facts[id]
        return result

    # A nested `def` binds its name when it runs. Except for that name, what
    # it captures must be assigned by then, and its body starts with their
    # declared types.
    def check_nested(statement: ast.Stmt, node: ast.FunctionDef, state: dict[int, types.Type]):
        nested = node.function
        symbol = node.symbol
        record = nested.record
        assert symbol is not none and record is not none, "unbound nested function"
        entry: dict[int, ast.Symbol] = {}
        for capture in nested.captures:
            captured = capture.symbol
            if captured.id != symbol.id and captured.id not in state:
                self.fail(capture.line, capture.col, f"variable '{captured.name}' may be used before assignment")
                return
            entry[captured.id] = captured
        value = types.FunctionType(record, false, none)
        declared = symbol.ty
        if declared is none:
            symbol.ty = value
            declared = value
        else if not types.assignable(declared, value):
            self.fail(statement.line, statement.col, f"expected {types.display(declared)}, received {types.display(value)}")
            return
        self.symbols[symbol.id] = symbol
        state[symbol.id] = assigned_type(declared, value)
        self.adopt(check_function(self.module, nested, entry))

    def adopt(error: diagnostic.Diagnostic | none):
        if error is not none and self.error is none:
            self.error = error

    # Forgets the narrowing in `state` of the locals `body` assigns.
    def forget_narrowing(state: dict[int, types.Type], body: list[ast.Stmt]):
        assigned: dict[int, bool] = {}
        assigned_symbols(body, assigned)
        for id in assigned:
            if id in state:
                state[id] = self.declared(id)

    def checked_method(expr: ast.Expr, source: types.Type, name: str, args: list[ast.Expr], state: dict[int, types.Type]) -> ast.Expr:
        receiver = ast.Expr(expr.line, expr.col, ast.Typed(0, source))
        call = ast.Expr(expr.line, expr.col, ast.MethodCall(receiver, name, args, []))
        self.check_expr(call, state)
        return call

    def check_iterable(expr: ast.Expr, source: types.Type, state: dict[int, types.Type]) -> ast.Iteration:
        source = types.expand(source)
        item = iterable_item(bound_type(source))
        if item is none:
            message = ""
            if isinstance(source, types.TupleType):
                result = types.items(source)
                if isinstance(result, str):
                    message = ": " + result
            self.fail(expr.line, expr.col, f"cannot iterate over {types.display(source)}{message}")
            item = none_type()
        creation = self.checked_method(expr, source, "iter", [], state)
        iterator: types.Type = none_type()
        created = creation.ty
        if created is not none:
            iterator = created
        advance = self.checked_method(expr, iterator, "next", [], state)
        assert item is not none, "missing iterable item"
        return ast.Iteration(item, creation, advance)

    def check_for(statement: ast.Stmt, node: ast.For, state: dict[int, types.Type]):
        source = self.check_expr(node.iterable, state)
        iteration = self.check_iterable(node.iterable, source, state)
        node.iteration = iteration
        self.check_for_body(statement, node, iteration.item, state)

    def check_with(statement: ast.Stmt, node: ast.With, state: dict[int, types.Type]) -> bool:
        for item in node.items:
            manager = self.check_expr(item.manager, state)
            enter = types.method(bound_type(types.expand(manager)), "enter")
            if enter is none:
                self.fail(item.manager.line, item.manager.col, f"type {types.display(manager)} is not a context manager")
                return false
            target = types.ProtocolType(stdlib.protocols()["ContextManager"], [enter.result])
            if not types.assignable(target, bound_type(types.expand(manager))):
                self.fail(item.manager.line, item.manager.col, f"type {types.display(manager)} is not a context manager")
                return false
            item.enter_call = self.checked_method(item.manager, manager, "enter", [], state)
            pending = ast.Expr(item.manager.line, item.manager.col, ast.Typed(0, stdlib.optional_exception()))
            exit_call = self.checked_method(item.manager, manager, "exit", [pending], state)
            exit_call.line = statement.line
            exit_call.col = statement.col
            item.exit_call = exit_call
            self.forget_captured(state)
            pattern = item.target
            if pattern is not none:
                self.check_pattern(pattern, enter.result, state)
        marks = self.group_mark()
        transfers = self.check_block(node.body, state)
        self.forget_captured(state)
        for recorded in self.group_states(marks):
            self.forget_captured(recorded)
        return transfers

    def check_for_body(statement: ast.Stmt, node: ast.For, item: types.Type, state: dict[int, types.Type]):
        node.item = item
        assigned: dict[int, bool] = {}
        assigned_symbols(node.body, assigned)
        target_symbols(node.target, assigned)
        for id in assigned:
            if id in state:
                state[id] = self.declared(id)
        if node.calls:
            self.forget_captured(state)
        body_state = copy(state)
        if node.target.name != "":
            self.check_target(node.target, item, body_state, statement.line, statement.col)
        else:
            self.check_pattern(node.target, item, body_state)
        self.check_loop_body(node.body, body_state)

    def check_index_assign(statement: ast.Stmt, node: ast.IndexAssign, state: dict[int, types.Type]):
        object = types.expand(self.check_expr(node.object, state))
        if isinstance(object, types.DictType):
            self.check_against(node.index, state, object.key)
            self.check_against(node.value, state, types.expand(object.value))
            return
        if not isinstance(object, types.ListType):
            if types.kind(object) in ["str", "bytes", "tuple"]:
                self.fail(statement.line, statement.col, f"cannot assign to an index of a value of type {types.display(object)}")
            else:
                self.fail(statement.line, statement.col, f"cannot index a value of type {types.display(object)}")
            return
        self.check_against(node.index, state, types.prim("int"))
        self.check_against(node.value, state, types.expand(object.element))

    def check_index(expr: ast.Expr, node: ast.Index, state: dict[int, types.Type]) -> types.Type:
        object = types.expand(self.check_expr(node.object, state))
        item: types.Type = none_type()
        if isinstance(object, types.TupleType):
            index = node.index.node
            position = -1
            if isinstance(index, ast.Int):
                position = int(index.text)
            else if isinstance(index, ast.Unary) and index.op == "-":
                operand = index.operand.node
                if isinstance(operand, ast.Int):
                    position = -int(operand.text)
                else:
                    self.fail(node.index.line, node.index.col, "tuple index must be an integer literal")
                    return none_type()
            else:
                self.fail(node.index.line, node.index.col, "tuple index must be an integer literal")
                return none_type()
            if position < 0:
                position = position + len(object.elements)
            if position < 0 or position >= len(object.elements):
                self.fail(node.index.line, node.index.col, "tuple index out of range")
                return none_type()
            node.position = position
            return object.elements[position]
        else if isinstance(object, types.ListType):
            item = types.expand(object.element)
        else if isinstance(object, types.DictType):
            self.check_against(node.index, state, object.key)
            return types.expand(object.value)
        else if types.kind(object) == "str":
            item = object
        else if types.kind(object) == "bytes":
            item = types.prim("int")
        else:
            self.fail(expr.line, expr.col, f"cannot index a value of type {types.display(object)}")
        self.check_against(node.index, state, types.prim("int"))
        return item

    def check_slice(expr: ast.Expr, node: ast.Slice, state: dict[int, types.Type]) -> types.Type:
        object = self.check_expr(node.object, state)
        if types.kind(object) not in ["list", "str", "bytes"]:
            self.fail(expr.line, expr.col, f"cannot slice a value of type {types.display(object)}")
        start = node.start
        stop = node.stop
        if start is not none:
            self.check_against(start, state, types.prim("int"))
        if stop is not none:
            self.check_against(stop, state, types.prim("int"))
        return object

    def check_tuple(expr: ast.Expr, node: ast.TupleDisplay, state: dict[int, types.Type]) -> types.Type:
        target: types.TupleType | none = none
        expected = expr.expected
        if expected is not none:
            target = types.tuple_member(expected)
        if target is not none and len(target.elements) == len(node.elements):
            for i in range(len(node.elements)):
                self.check_against(node.elements[i], state, target.elements[i])
            return target
        elements: list[types.Type] = []
        for element in node.elements:
            elements.append(self.check_expr(element, state))
        return types.TupleType(elements)

    def check_list(expr: ast.Expr, node: ast.ListDisplay, state: dict[int, types.Type]) -> types.Type:
        expected = expr.expected
        if expected is not none:
            for member in types.members(expected):
                if isinstance(member, types.ListType):
                    for entry in node.elements:
                        self.check_against(entry, state, types.expand(member.element))
                    return member
        if len(node.elements) == 0:
            self.fail(expr.line, expr.col, "cannot infer the element type of an empty list")
            return none_type()
        element = self.check_expr(node.elements[0], state)
        for i in range(1, len(node.elements)):
            self.check_against(node.elements[i], state, element)
        return types.ListType(element)

    def check_list_method(expr: ast.Expr, node: ast.MethodCall, state: dict[int, types.Type], object: types.ListType) -> types.Type:
        name = node.name
        if name not in ["append", "pop", "extend", "reverse", "sort"]:
            self.fail(expr.line, expr.col, f"type {types.display(object)} has no method '{name}'")
            return none_type()
        if name == "sort":
            self.bind_args(expr, node, stdlib.sort_params(), "parameter")
            if self.failed():
                return none_type()
            self.check_sort_args(node.args, node.order, 1, state)
            if not self.failed():
                self.check_sort_key(expr, object, types.expand(object.element), node.args[1], state)
            return none_type()
        params: list[stdlib.BuiltinParam] = []
        if name == "append":
            params.append(stdlib.arg("v", types.expand(object.element)))
        else if name == "extend":
            params.append(stdlib.arg("items", object))
        noun = ""
        if len(params) > 0:
            noun = "parameter"
        self.bind_args(expr, node, params, noun)
        if self.failed():
            return none_type()
        if name == "append":
            self.check_against(node.args[0], state, types.expand(object.element))
        else if name == "extend":
            arg = node.args[0]
            target = types.ProtocolType(stdlib.protocols()["Iterable"], [types.expand(object.element)])
            arg.expected = object
            actual = self.check_expr(arg, state)
            iteration = self.check_iterable(arg, actual, state)
            node.iterables = [iteration]
            if not self.failed() and (not types.assignable(types.expand(object.element), iteration.item) or types.converts(iteration.item, types.expand(object.element))):
                self.fail(arg.line, arg.col, f"expected {types.display(target)}, received {types.display(actual)}")
            arg.expected = none
        else if name == "pop":
            return types.expand(object.element)
        return none_type()

    # Checks the arguments of a sort whose key is at `key`, except a lambda or
    # built-in function value key, which takes its parameter type from the
    # items and is checked last. Creating either calls nothing.
    def check_sort_args(args: list[ast.Expr], order: list[int] | none, key: int, state: dict[int, types.Type]):
        assert order is not none, "unbound sort"
        for i in order:
            node = args[i].node
            if i == key:
                if not isinstance(node, ast.Lambda) and not isinstance(node, ast.BuiltinValue):
                    self.check_expr(args[i], state)
            else if i == key - 1:
                self.check_against(args[i], state, types.prim("bool"))
            else:
                self.check_expr(args[i], state)

    # Checks that the items of `container`, of type `item`, sort by `key`,
    # which is none when there is none. A key takes one item and returns an orderable
    # value; a lambda's body or a built-in's result gives that value's type.
    def check_sort_key(expr: ast.Expr, container: types.Type, item: types.Type, key: ast.Expr, state: dict[int, types.Type]):
        node = key.node
        if isinstance(node, ast.Constant) and node == ast.Constant.NONE:
            if not types.ordered(item, item):
                self.fail(expr.line, expr.col, f"cannot sort a value of type {types.display(container)}")
            return
        key_type = key.ty
        if isinstance(node, ast.Lambda):
            function = node.function
            assert function is not none, "unbound lambda"
            count = len(function.params)
            if count != 1:
                self.fail(key.line, key.col, f"a sort key takes 1 parameter, received a lambda with {count} parameters")
                return
            node.infer_result = true
            key.expected = types.CallableType([item], none_type())
            key_type = self.check_expr(key, state)
        else if isinstance(node, ast.BuiltinValue):
            # `abs` returns the type of its argument.
            returns = none_type()
            declared = node.builtin.result
            if declared is not none:
                returns = declared
            else if node.name == "abs":
                returns = item
            key.expected = types.CallableType([item], returns)
            key_type = self.check_expr(key, state)
        if self.failed():
            return
        assert key_type is not none, "unchecked sort key"
        expanded = types.expand(key_type)
        result: types.Type = none_type()
        if isinstance(expanded, types.CallableType):
            result = expanded.result
        else if isinstance(expanded, types.FunctionType):
            result = types.function_result(expanded)
        else:
            self.fail(key.line, key.col, f"a sort key must be a function, received {types.display(key_type)}")
            return
        if not types.ordered(result, result):
            self.fail(key.line, key.col, f"cannot sort by a key of type {types.display(result)}")
            return
        self.expect(key, types.CallableType([item], result), key_type)

    def check_sorted(node: ast.Call, state: dict[int, types.Type]) -> types.Type:
        self.check_sort_args(node.args, node.order, 2, state)
        if self.failed():
            return none_type()
        items = node.args[0]
        source = items.ty
        assert source is not none, "unchecked sort items"
        iteration = self.check_iterable(items, source, state)
        node.iterables = [iteration]
        self.check_sort_key(items, source, iteration.item, node.args[2], state)
        return types.ListType(iteration.item)

    def check_sequence_method(expr: ast.Expr, node: ast.MethodCall, state: dict[int, types.Type], object: types.Type) -> types.Type:
        name = node.name
        methods = stdlib.str_methods()
        if types.kind(object) == "bytes":
            methods = stdlib.bytes_methods()
        if name not in methods:
            self.fail(expr.line, expr.col, f"type {types.display(object)} has no method '{name}'")
            return none_type()
        method = methods[name]
        params = method.params
        noun = ""
        if len(params) > 0:
            noun = "parameter"
        self.bind_args(expr, node, params, noun)
        if self.failed():
            return none_type()
        order = node.order
        assert order is not none, "unbound sequence method"
        for i in order:
            param = params[i].ty
            assert param is not none, f"{types.kind(object)}.{name} has an untyped parameter"
            self.check_against(node.args[i], state, param)
        result = method.result
        assert result is not none, f"{types.kind(object)}.{name} has no result"
        return result

    def check_dict(expr: ast.Expr, node: ast.DictDisplay, state: dict[int, types.Type]) -> types.Type:
        expected = expr.expected
        if expected is not none:
            for member in types.members(expected):
                if isinstance(member, types.DictType):
                    for i in range(len(node.keys)):
                        self.check_against(node.keys[i], state, member.key)
                        self.check_against(node.values[i], state, types.expand(member.value))
                    return member
        if len(node.keys) == 0:
            self.fail(expr.line, expr.col, "cannot infer the key and value types of an empty dict")
            return none_type()
        key = self.check_expr(node.keys[0], state)
        if not self.failed() and not types.is_key(key):
            first = node.keys[0]
            self.fail(first.line, first.col, "dictionary keys must be int, str, or an enum")
        value = self.check_expr(node.values[0], state)
        for i in range(1, len(node.keys)):
            self.check_against(node.keys[i], state, key)
            self.check_against(node.values[i], state, value)
        return types.DictType(key, value)

    def check_dict_method(expr: ast.Expr, node: ast.MethodCall, object: types.DictType, state: dict[int, types.Type]) -> types.Type:
        name = node.name
        if name in ["keys", "values", "items"]:
            self.bind_args(expr, node, [], "")
            item: types.Type = object.key
            if name == "values":
                item = types.expand(object.value)
            else if name == "items":
                item = types.TupleType([object.key, types.expand(object.value)])
            return types.iterator(item)
        if name not in ["get", "pop"]:
            self.fail(expr.line, expr.col, f"type {types.display(object)} has no method '{name}'")
            return none_type()
        value = types.expand(object.value)
        optional = value
        if types.kind(value) != "none" and not types.is_optional(value):
            optional = types.optional(value)
        params = [stdlib.arg("k", object.key)]
        if name == "get":
            params.append(stdlib.defaulted("default", optional, stdlib.none_default()))
        self.bind_args(expr, node, params, "parameter")
        if self.failed():
            return none_type()
        order = node.order
        assert order is not none, "unbound dict method"
        for i in order:
            param = params[i].ty
            assert param is not none, "untyped dict method parameter"
            self.check_against(node.args[i], state, param)
        if name == "pop":
            return value
        default = node.args[1].ty
        assert default is not none, "unchecked dict default"
        result = optional
        if types.assignable(value, default):
            result = value
        node.args[1].expected = result
        return result

    def check_len(expr: ast.Expr, node: ast.Call, state: dict[int, types.Type]) -> types.Type:
        self.check_arity(expr, "len", 1, len(node.args))
        if not self.failed():
            arg = self.check_expr(node.args[0], state)
            if types.kind(arg) not in ["list", "str", "bytes", "dict", "tuple"]:
                self.fail(expr.line, expr.col, f"'len' cannot be applied to {types.display(arg)}")
        return types.prim("int")

    def check_return(statement: ast.Stmt, node: ast.Return, state: dict[int, types.Type]):
        value = node.value
        if self.yield_type is not none:
            if value is not none:
                self.fail(statement.line, statement.col, "a generator cannot return a value")
            return
        if value is not none:
            self.check_against(value, state, self.result)
        else if not types.assignable(self.result, none_type()):
            self.fail(statement.line, statement.col, f"expected {types.display(self.result)}, received none")

    # Expressions

    # Checks `expr` and records its type.
    def check_expr(expr: ast.Expr, state: dict[int, types.Type]) -> types.Type:
        if self.failed():
            return none_type()
        ty = self.check_node(expr, state)
        expr.ty = ty
        node = expr.node
        if isinstance(node, ast.Call) or isinstance(node, ast.CallValue) or isinstance(node, ast.MethodCall) or isinstance(node, ast.Await):
            self.calls = self.calls + 1
            self.forget_captured(state)
        if isinstance(node, ast.Await):
            self.graceful_exit(state)
        return ty

    def check_node(expr: ast.Expr, state: dict[int, types.Type]) -> types.Type:
        node = expr.node
        line = expr.line
        col = expr.col
        if isinstance(node, ast.Int):
            return types.prim("int")
        else if isinstance(node, ast.String):
            return types.prim("str")
        else if isinstance(node, ast.Constant):
            if node == ast.Constant.NONE:
                return none_type()
            return types.prim("bool")
        else if isinstance(node, ast.Name):
            return self.check_name(expr, node, state)
        else if isinstance(node, ast.Binary):
            return self.check_binary(expr, node, state)
        else if isinstance(node, ast.Call):
            return self.check_call(expr, node, state)
        else if isinstance(node, ast.TypeOf):
            return types.prim("ptr")
        else if isinstance(node, ast.Float):
            return types.prim("float")
        else if isinstance(node, ast.FString):
            return self.check_fstring(node, state)
        else if isinstance(node, ast.EnumMember):
            record = node.decl.record
            assert record is not none, "enum without a record"
            return types.EnumType(record)
        else if isinstance(node, ast.MethodCall):
            return self.check_method(expr, node, state)
        else if isinstance(node, ast.Field):
            return self.check_field(expr, node, state)
        else if isinstance(node, ast.FunctionValue):
            return self.check_function_value(expr, node, state)
        else if isinstance(node, ast.BuiltinValue):
            return self.check_builtin_value(expr, node, state)
        else if isinstance(node, ast.Lambda):
            return self.check_lambda(expr, node, state)
        else if isinstance(node, ast.CallValue):
            return self.check_call_value(expr, node, state)
        else if isinstance(node, ast.Await):
            expected = expr.expected
            if expected is not none:
                node.operand.expected = stdlib.coroutine_of(expected)
            operand = self.check_expr(node.operand, state)
            if isinstance(operand, types.ClassType) and (operand.decl.type_name == "Coroutine" or operand.decl.library and operand.decl.type_name == "aio.Task"):
                return operand.args[0]
            self.fail(line, col, f"cannot await a value of type {types.display(operand)}")
            return none_type()
        else if isinstance(node, ast.Typed):
            return node.ty
        else if isinstance(node, ast.Index):
            return self.check_index(expr, node, state)
        else if isinstance(node, ast.Slice):
            return self.check_slice(expr, node, state)
        else if isinstance(node, ast.Unary):
            return self.check_unary(expr, node, state)
        else if isinstance(node, ast.Is):
            return self.check_is(expr, node, state)
        else if isinstance(node, ast.IsInstance):
            return self.check_isinstance(node, state)
        else if isinstance(node, ast.TupleDisplay):
            return self.check_tuple(expr, node, state)
        else if isinstance(node, ast.ListDisplay):
            return self.check_list(expr, node, state)
        else if isinstance(node, ast.DictDisplay):
            return self.check_dict(expr, node, state)
        return self.unsupported(line, col, "this expression")

    def check_name(expr: ast.Expr, node: ast.Name, state: dict[int, types.Type]) -> types.Type:
        symbol = node.symbol
        if symbol is none:
            # `__os` in a privileged module, the only name the binder leaves without one.
            return types.prim("str")
        ty = state.get(symbol.id)
        if ty is none:
            self.fail(expr.line, expr.col, f"variable '{node.name}' may be used before assignment")
            return none_type()
        return ty

    def check_unary(expr: ast.Expr, node: ast.Unary, state: dict[int, types.Type]) -> types.Type:
        operand = self.check_expr(node.operand, state)
        if self.failed():
            return none_type()
        kind = types.kind(operand)
        if node.op in ["+", "-"] and kind in ["int", "float"] or node.op == "not" and kind == "bool":
            return operand
        self.fail(expr.line, expr.col, f"operator '{node.op}' cannot be applied to {types.display(operand)}")
        return none_type()

    def check_binary(expr: ast.Expr, node: ast.Binary, state: dict[int, types.Type]) -> types.Type:
        op = node.op
        if op == "and" or op == "or":
            return self.check_logic(expr, node, state)
        left = self.check_expr(node.left, state)
        right = self.check_expr(node.right, state)
        if self.failed():
            return none_type()
        if (op == "==" or op == "!=") and (may_be_none(left) or may_be_none(right) or isinstance(left, types.TupleType)):
            return self.check_union_equality(expr, node, left, right)
        pair = types.kind(left) + " " + types.kind(right)
        ty: types.Type | none = none
        supported = false
        if op == "==" or op == "!=":
            if types.comparable(left) and types.comparable(right) and (types.assignable(left, right) or types.assignable(right, left)):
                ty = types.prim("bool")
            else if pair == "ptr ptr" and self.module.privileged:
                ty = types.prim("bool")
            supported = pair in ["int int", "float float", "bool bool", "str str", "bytes bytes", "ptr ptr", "enum enum"]
        else if op in ["<", "<=", ">", ">="]:
            if types.ordered(left, right):
                ty = types.prim("bool")
            supported = pair in ["int int", "float float", "str str", "tuple tuple"]
        else if op in ["+", "-", "*", "/", "//", "%"]:
            ty = arithmetic_type(op, pair)
            supported = pair in ["int int", "float float"] or op == "+" and pair in ["str str", "bytes bytes"]
        else if op == "in" or op == "not in":
            container = types.expand(right)
            if isinstance(container, types.DictType):
                if types.assignable(container.key, left):
                    ty = types.prim("bool")
                    supported = true
            else if isinstance(container, types.ListType):
                element = types.expand(container.element)
                if types.comparable(left) and types.comparable(element) and (types.assignable(element, left) or types.assignable(left, element)):
                    ty = types.prim("bool")
                    supported = true
                    # The item is boxed to compare with a union element;
                    # a union item is compared with each element converted.
                    if types.assignable(element, left):
                        self.expect(node.left, element, left)
            else if types.kind(container) == "bytes" and types.kind(types.expand(left)) == "int":
                ty = types.prim("bool")
                supported = true
            else if types.kind(container) == "str" and types.kind(types.expand(left)) == "str":
                ty = types.prim("bool")
                supported = true
        if ty is none:
            self.fail(expr.line, expr.col, f"operator '{op}' cannot be applied to {types.display(left)} and {types.display(right)}")
            return none_type()
        if not supported:
            return self.unsupported(expr.line, expr.col, f"operator '{op}' on {types.display(left)} and {types.display(right)}")
        return ty

    # The right operand of `and` runs only when the left is true, and of `or`
    # only when it is false.
    def check_logic(expr: ast.Expr, node: ast.Binary, state: dict[int, types.Type]) -> types.Type:
        left = self.check_expr(node.left, state)
        if self.failed():
            return none_type()
        facts = self.facts(node.left)
        right_state = narrow(state, facts.when_false)
        if node.op == "and":
            right_state = narrow(state, facts.when_true)
        before = self.calls
        right = self.check_expr(node.right, right_state)
        if self.failed():
            return none_type()
        # A call in the right operand ends what the left proved about
        # captured variables.
        if self.calls != before:
            node.calls = true
            self.forget_captured(state)
        if types.kind(left) != "bool" or types.kind(right) != "bool":
            self.fail(expr.line, expr.col, f"operator '{node.op}' cannot be applied to {types.display(left)} and {types.display(right)}")
        return types.prim("bool")

    # Union and tuple equality use the same representation on both sides.
    def check_union_equality(expr: ast.Expr, node: ast.Binary, left: types.Type, right: types.Type) -> types.Type:
        target: types.Type | none = none
        if types.comparable(left) and types.comparable(right):
            if types.assignable(right, left):
                target = right
            else if types.assignable(left, right):
                target = left
        if target is none:
            self.fail(expr.line, expr.col, f"operator '{node.op}' cannot be applied to {types.display(left)} and {types.display(right)}")
            return none_type()
        self.expect(node.left, target, left)
        self.expect(node.right, target, right)
        return types.prim("bool")

    def check_is(expr: ast.Expr, node: ast.Is, state: dict[int, types.Type]) -> types.Type:
        operand = self.check_expr(node.operand, state)
        if not self.failed() and not types.is_optional(operand):
            op = "is"
            if node.negated:
                op = "is not"
            self.fail(expr.line, expr.col, f"operator '{op}' cannot be applied to {types.display(operand)}")
        return types.prim("bool")

    def check_isinstance(node: ast.IsInstance, state: dict[int, types.Type]) -> types.Type:
        operand = self.check_expr(node.operand, state)
        if self.failed():
            return none_type()
        if isinstance_member(operand, node.type_name) is none:
            named = node.type_name
            self.fail(named.line, named.col, f"type {types.display(operand)} has no member {type_name_text(named)}")
        return types.prim("bool")

    # What `expr`, a checked condition, proves when it is true and when it
    # is false about the locals it tests, from its operands' recorded types.
    def facts(expr: ast.Expr) -> Facts:
        node = expr.node
        if isinstance(node, ast.Is):
            symbol = local(node.operand)
            ty = node.operand.ty
            if symbol is none or ty is none:
                return Facts({}, {})
            kept: list[types.Type] = []
            for m in types.members(ty):
                if types.kind(m) != "none":
                    kept.append(m)
            # Only the outcome that rules out none narrows.
            some = {symbol.id: types.subset(ty, kept)}
            if node.negated:
                return Facts(some, {})
            return Facts({}, some)
        if isinstance(node, ast.IsInstance):
            symbol = local(node.operand)
            ty = node.operand.ty
            if symbol is none or ty is none or not is_union(ty):
                return Facts({}, {})
            member = isinstance_member(ty, node.type_name)
            if member is none:
                return Facts({}, {})
            others: list[types.Type] = []
            for m in types.members(ty):
                if not types.same(m, member):
                    others.append(m)
            return Facts({symbol.id: member}, {symbol.id: types.subset(ty, others)})
        if isinstance(node, ast.Unary) and node.op == "not":
            inner = self.facts(node.operand)
            return Facts(inner.when_false, inner.when_true)
        if isinstance(node, ast.Binary) and node.op == "and":
            left = self.facts(node.left)
            right = self.facts(node.right)
            when_true = left.when_true
            if node.calls:
                when_true = self.without_captured(when_true)
            return Facts(narrow(when_true, right.when_true), {})
        if isinstance(node, ast.Binary) and node.op == "or":
            left = self.facts(node.left)
            right = self.facts(node.right)
            when_false = left.when_false
            if node.calls:
                when_false = self.without_captured(when_false)
            return Facts({}, narrow(when_false, right.when_false))
        return Facts({}, {})

    # Calls

    def check_call(expr: ast.Expr, node: ast.Call, state: dict[int, types.Type]) -> types.Type:
        target = node.target
        if isinstance(target, ast.FunctionDecl):
            return self.check_function_call(expr, node, target, state)
        if isinstance(target, stdlib.Builtin):
            return self.check_builtin(expr, node, target, state)
        assert isinstance(target, types.Class), "call without a target"
        return self.check_constructor(expr, node, target, state)

    # Whether `decl` is a native type whose fields and constructor the module
    # being checked cannot use: any but one a library module declares, in
    # that module.
    def opaque(decl: types.Class) -> bool:
        if not decl.native:
            return false
        return not self.module.privileged or decl.type_name != self.module.name + "." + decl.name

    def check_constructor(expr: ast.Expr, node: ast.Call, target: types.Class, state: dict[int, types.Type]) -> types.Type:
        if self.opaque(target):
            self.fail(expr.line, expr.col, f"cannot construct native type {target.type_name}")
            return none_type()
        params: list[types.Param] = []
        for field in target.fields:
            params.append(types.Param(field.name, field.ty, field.default, false))
        result: types.Type = types.class_self(target)
        return self.check_generic_call(expr, node, params, result, target.typevars, state, "field")

    def field_type(line: int, col: int, name: str, object: types.Type) -> types.Type:
        object = bound_type(types.expand(object))
        if not isinstance(object, types.ClassType) or self.opaque(object.decl):
            self.fail(line, col, f"type {types.display(object)} has no field '{name}'")
            return none_type()
        for field in object.decl.fields:
            if field.name == name:
                return types.substitute(field.ty, types.record_map(object))
        self.fail(line, col, f"class {types.display(object)} has no field '{name}'")
        return none_type()

    # Reading a method gives it bound to the object.
    def check_field(expr: ast.Expr, node: ast.Field, state: dict[int, types.Type]) -> types.Type:
        object = self.check_expr(node.object, state)
        if self.failed():
            return none_type()
        expanded = types.expand(object)
        if isinstance(expanded, types.ClassType) and not self.opaque(expanded.decl):
            for method in expanded.decl.methods:
                if method.name == node.name:
                    if len(method.typevars) > 0:
                        self.fail(expr.line, expr.col, f"generic method '{node.name}' cannot be used as a value")
                        return none_type()
                    if len(expanded.args) > 0:
                        return types.FunctionType(method, true, expanded)
                    return types.FunctionType(method, true, none)
        return self.field_type(expr.line, expr.col, node.name, object)

    # Explicit type arguments or an expected callable specialize a generic
    # function, whose value takes its positional contract.
    def check_function_value(expr: ast.Expr, node: ast.FunctionValue, state: dict[int, types.Type]) -> types.Type:
        signature = node.target.record
        assert signature is not none, "function value without a signature"
        symbol = node.symbol
        if symbol is not none and symbol.id not in state:
            self.fail(expr.line, expr.col, f"variable '{symbol.name}' may be used before assignment")
            return none_type()
        vars = signature.typevars
        if len(vars) == 0:
            return types.FunctionType(signature, false, none)
        name = signature.name
        callable: types.CallableType | none = none
        expected = expr.expected
        if len(node.type_args) == 0 and expected is not none:
            callable = types.callable_member(expected)
        positional: list[types.Type] = []
        for param in signature.params:
            if param.keyword_only and param.default is none:
                self.fail(expr.line, expr.col, f"generic function '{name}' has required keyword-only parameters")
                return none_type()
            if not param.keyword_only and (param.default is none or callable is not none and len(positional) < len(callable.params)):
                positional.append(param.ty)
        args: list[types.Type] = []
        if len(node.type_args) > 0:
            if len(node.type_args) != len(vars):
                self.fail(expr.line, expr.col, f"'{name}' expects {len(vars)} {bind.plural(len(vars), 'type argument')}, received {len(node.type_args)}")
                return none_type()
            args = node.type_args
        else if callable is not none:
            candidates: dict[str, list[types.Type]] = {}
            for var in vars:
                candidates[types.var_key(var)] = []
            collect(types.CallableType(positional, signature.result), callable, candidates, [])
            args = self.choose_args(expr, name, vars, candidates)
        else:
            self.fail(expr.line, expr.col, f"generic function '{name}' needs type arguments or an expected callable type")
        if self.failed() or not self.check_bounds(expr, vars, args):
            return none_type()
        node.type_args = args
        bindings = types.bind_vars(vars, args)
        return types.CallableType(types.substitute_all(positional, bindings), types.substitute(signature.result, bindings))

    # A function value takes its whole call signature, and a callable
    # exactly its listed positional arguments.
    def check_call_value(expr: ast.Expr, node: ast.CallValue, state: dict[int, types.Type]) -> types.Type:
        callee = self.check_expr(node.callee, state)
        if self.failed():
            return none_type()
        expanded = types.expand(callee)
        params: list[types.Type] = []
        result: types.Type = none_type()
        if isinstance(expanded, types.FunctionType):
            if len(expanded.fn.typevars) > 0:
                return self.check_generic_call(expr, node, expanded.fn.params, expanded.fn.result, expanded.fn.typevars, state, "parameter")
            declared = types.function_params(expanded)
            self.bind_args(expr, node, call_params(declared), "parameter")
            for param in declared:
                params.append(param.ty)
            result = types.function_result(expanded)
        else if isinstance(expanded, types.CallableType):
            positional: list[stdlib.BuiltinParam] = []
            for param_type in expanded.params:
                positional.append(stdlib.BuiltinParam("", param_type, none, false))
            self.bind_args(expr, node, positional, "")
            params = expanded.params
            result = expanded.result
        else:
            self.fail(expr.line, expr.col, f"cannot call a value of type {types.display(callee)}")
            return none_type()
        if self.failed():
            return none_type()
        order = node.order
        assert order is not none, "unbound call of a value"
        for i in order:
            self.check_against(node.args[i], state, params[i])
        return result

    # An expected callable gives the parameter types; the body gives the
    # result. Creating the lambda calls nothing.
    def check_lambda(expr: ast.Expr, node: ast.Lambda, state: dict[int, types.Type]) -> types.Type:
        function = node.function
        assert function is not none, "unbound lambda"
        target: types.CallableType | none = none
        expected = expr.expected
        if expected is not none:
            target = types.callable_member(expected)
        count = len(function.params)
        if target is not none and len(target.params) != count:
            noun = "parameters"
            if count == 1:
                noun = "parameter"
            self.fail(expr.line, expr.col, f"expected {types.display(target)}, received a lambda with {count} {noun}")
            return none_type()
        checker = Checker(self.module, function, none_type(), none, {}, [])
        entry: dict[int, types.Type] = {}
        for capture in function.captures:
            captured = capture.symbol
            if captured.id not in state:
                self.fail(capture.line, capture.col, f"variable '{captured.name}' may be used before assignment")
                return none_type()
            checker.symbols[captured.id] = captured
            entry[captured.id] = self.declared(captured.id)
        params: list[types.Param] = []
        for i in range(count):
            declaration = function.params[i]
            symbol = declaration.symbol
            assert symbol is not none, "lambda parameter without a symbol"
            ty = symbol.ty
            if declaration.annotation is none:
                if target is none:
                    self.fail(declaration.line, declaration.col, f"lambda parameter '{declaration.name}' needs a type annotation or an expected callable type")
                    return none_type()
                ty = target.params[i]
            assert ty is not none, "unresolved lambda parameter annotation"
            symbol.ty = ty
            checker.symbols[symbol.id] = symbol
            entry[symbol.id] = ty
            params.append(types.Param(symbol.name, ty, none, false))
        returned = function.body[0].node
        assert isinstance(returned, ast.Return), "lambda without a return"
        body = returned.value
        assert body is not none, "lambda without a body"
        if target is not none and not node.infer_result:
            body.expected = target.result
        result = checker.check_expr(body, entry)
        if target is not none and not node.infer_result:
            checker.expect(body, target.result, result)
        # Context guides inference, but the function returns the body's type.
        body.expected = result
        self.adopt(checker.error)
        function.record = types.Function(function.id, function.name, function.type_name, [], params, result)
        parameter_types: list[types.Type] = []
        for param in params:
            parameter_types.append(param.ty)
        return types.CallableType(parameter_types, result)

    # The expected callable fixes the signature: the value runs a call of the
    # built-in with arguments of the callable's parameter types. Taking the
    # value calls nothing.
    def check_builtin_value(expr: ast.Expr, node: ast.BuiltinValue, state: dict[int, types.Type]) -> types.Type:
        target: types.CallableType | none = none
        expected = expr.expected
        if expected is not none:
            target = types.callable_member(expected)
        if target is none:
            self.fail(expr.line, expr.col, f"function '{node.name}' needs an expected callable type")
            return none_type()
        args: list[ast.Expr] = []
        for i in range(len(target.params)):
            args.append(ast.Expr(expr.line, expr.col, ast.Typed(i, target.params[i])))
        call = ast.Expr(expr.line, expr.col, ast.Call(node.name, args, [], [], node.builtin))
        node.call = call
        before = self.calls
        self.expect(call, target.result, self.check_expr(call, copy(state)))
        self.calls = before
        return target

    def check_field_assign(statement: ast.Stmt, node: ast.FieldAssign, state: dict[int, types.Type]):
        field = self.field_type(statement.line, statement.col, node.name, self.check_expr(node.object, state))
        self.check_against(node.value, state, field)

    def check_method(expr: ast.Expr, node: ast.MethodCall, state: dict[int, types.Type]) -> types.Type:
        object = bound_type(types.expand(self.check_expr(node.object, state)))
        if isinstance(object, types.ClassType):
            return self.check_class_method(expr, node, object, state)
        if node.type_args is not none:
            return self.field_type(expr.line, expr.col, node.name, object)
        if node.name == "iter" and types.iteration_item(object) is not none:
            self.bind_args(expr, node, [], "")
            item = types.iteration_item(object)
            assert item is not none, "missing native item"
            return types.iterator(item)
        if isinstance(object, types.ProtocolType):
            signature = types.method(object, node.name)
            if signature is not none:
                return self.check_generic_call(expr, node, signature.params, signature.result, [], state, "parameter")
        if isinstance(object, types.ListType):
            return self.check_list_method(expr, node, state, object)
        if types.kind(object) in ["str", "bytes"]:
            return self.check_sequence_method(expr, node, state, object)
        if isinstance(object, types.DictType):
            return self.check_dict_method(expr, node, object, state)
        if types.kind(object) in ["protocol", "int", "float", "bool", "none", "enum", "typevar", "union", "callable", "function", "ptr", "word", "cint"]:
            self.fail(expr.line, expr.col, f"type {types.display(object)} has no method '{node.name}'")
            return none_type()
        return self.unsupported(expr.line, expr.col, "method calls")

    def check_class_method(expr: ast.Expr, node: ast.MethodCall, object: types.ClassType, state: dict[int, types.Type]) -> types.Type:
        bindings = types.record_map(object)
        for method in object.decl.methods:
            if method.name == node.name:
                if node.type_args is not none and len(method.typevars) == 0:
                    if self.opaque(object.decl):
                        return self.field_type(expr.line, expr.col, node.name, object)
                    index = node.index
                    if index is none:
                        error = node.index_error
                        assert error is not none, "specialized method without an index"
                        self.error = error
                    else:
                        fn = types.FunctionType(method, true, object)
                        self.fail(index.line, index.col, f"cannot index a value of type {types.display(fn)}")
                    return none_type()
                params: list[types.Param] = []
                for param in method.params[1:]:
                    params.append(types.Param(param.name, types.substitute(param.ty, bindings), param.default, param.keyword_only))
                vars: list[types.TypeVar] = []
                for var in method.typevars:
                    bound = var.bound
                    if bound is not none:
                        bound = types.substitute(bound, bindings)
                    vars.append(types.TypeVar(var.id, var.name, bound))
                return self.check_generic_call(expr, node, params, types.substitute(method.result, bindings), vars, state, "parameter")
        self.fail(expr.line, expr.col, f"type {types.display(object)} has no method '{node.name}'")
        return none_type()

    def check_generic_call(expr: ast.Expr, node: ast.Call | ast.MethodCall | ast.CallValue, params: list[types.Param], result: types.Type, vars: list[types.TypeVar], state: dict[int, types.Type], noun: str) -> types.Type:
        name = ""
        explicit: list[types.Type] | none = none
        if isinstance(node, ast.Call):
            name = node.name
            if node.has_type_args:
                explicit = node.type_args
        else if isinstance(node, ast.CallValue):
            name = callee_name(node.callee)
            if len(node.type_args) > 0:
                explicit = node.type_args
        else:
            name = node.name
            explicit = node.type_args
        if explicit is not none:
            if len(vars) == 0:
                self.fail(expr.line, expr.col, f"'{name}' is not generic")
            else if len(explicit) != len(vars):
                self.fail(expr.line, expr.col, f"'{name}' expects {len(vars)} {bind.plural(len(vars), 'type argument')}, received {len(explicit)}")
        if self.failed():
            return none_type()
        self.bind_args(expr, node, call_params(params), noun)
        if self.failed():
            return none_type()
        call_args: list[ast.Expr] = []
        order: list[int] | none = none
        if isinstance(node, ast.Call):
            call_args = node.args
            order = node.order
        else if isinstance(node, ast.CallValue):
            call_args = node.args
            order = node.order
        else:
            call_args = node.args
            order = node.order
        assert order is not none, "unbound generic call"
        bindings: dict[str, types.Type] = {}
        if len(vars) > 0:
            args: list[types.Type] = []
            if explicit is not none:
                args = explicit
            else:
                candidates: dict[str, list[types.Type]] = {}
                for var in vars:
                    candidates[types.var_key(var)] = []
                lambdas: list[int] = []
                for i in order:
                    param = params[i].ty
                    if isinstance(call_args[i].node, ast.Lambda) and types.mentions_any(param, vars):
                        lambdas.append(i)
                    else:
                        known: types.Type | none = none
                        if not types.mentions_any(param, vars):
                            known = param
                        call_args[i].expected = known
                        actual = self.check_expr(call_args[i], state)
                        if self.failed():
                            return none_type()
                        collect(param, actual, candidates, [])
                for i in lambdas:
                    partial: dict[str, types.Type] = {}
                    for var in vars:
                        chosen = choose(candidates[types.var_key(var)])
                        if chosen is not none:
                            partial[types.var_key(var)] = chosen
                    expected_lambda = types.substitute(params[i].ty, partial)
                    target = types.callable_member(expected_lambda)
                    lambda_node = call_args[i].node
                    assert isinstance(lambda_node, ast.Lambda), "deferred non-lambda"
                    if target is none:
                        self.fail(call_args[i].line, call_args[i].col, "cannot infer the parameter types of this lambda")
                        return none_type()
                    for j in range(min(len(lambda_node.params), len(target.params))):
                        if lambda_node.params[j].annotation is none and types.mentions_any(target.params[j], vars):
                            self.fail(call_args[i].line, call_args[i].col, "cannot infer the parameter types of this lambda")
                            return none_type()
                    lambda_node.infer_result = types.mentions_any(target.result, vars)
                    call_args[i].expected = expected_lambda
                    actual = self.check_expr(call_args[i], state)
                    if self.failed():
                        return none_type()
                    collect(params[i].ty, actual, candidates, [])
                expected = expr.expected
                for var in vars:
                    key = types.var_key(var)
                    if len(candidates[key]) == 0 and expected is not none:
                        collect(result, expected, {key: candidates[key]}, [])
                args = self.choose_args(expr, name, vars, candidates)
                if self.failed():
                    return none_type()
            if not self.check_bounds(expr, vars, args):
                return none_type()
            bindings = types.bind_vars(vars, args)
            if isinstance(node, ast.Call):
                node.type_args = args
            else if isinstance(node, ast.CallValue):
                node.type_args = args
            else:
                node.type_args = args
        for i in order:
            param = types.substitute(params[i].ty, bindings)
            if len(vars) > 0 and explicit is none:
                checked = call_args[i].ty
                assert checked is not none, "unchecked inferred argument"
                self.expect(call_args[i], param, checked)
            else:
                self.check_against(call_args[i], state, param)
        return types.substitute(result, bindings)

    # The type argument of each of `vars` that its `candidates` agree on.
    # `name` names the generic in errors.
    def choose_args(expr: ast.Expr, name: str, vars: list[types.TypeVar], candidates: dict[str, list[types.Type]]) -> list[types.Type]:
        args: list[types.Type] = []
        for var in vars:
            choices = candidates[types.var_key(var)]
            chosen = choose(choices)
            if chosen is none:
                message = f"cannot infer type parameter '{var.name}' of '{name}'"
                if len(choices) > 0:
                    other = choices[0]
                    for choice in choices:
                        if not types.assignable(choices[0], choice):
                            other = choice
                            break
                    message = message + f" from {types.display(choices[0])} and {types.display(other)}"
                self.fail(expr.line, expr.col, message)
                return args
            args.append(chosen)
        return args

    # Whether each of `args` satisfies the bound of its type parameter.
    def check_bounds(expr: ast.Expr, vars: list[types.TypeVar], args: list[types.Type]) -> bool:
        for i in range(len(vars)):
            message = types.unsatisfied(vars[i], args[i])
            if message != "":
                self.fail(expr.line, expr.col, message)
                return false
        return true

    def check_fstring(node: ast.FString, state: dict[int, types.Type]) -> types.Type:
        for i in range(len(node.parts)):
            part = node.parts[i]
            ty = self.check_expr(part, state)
            if self.failed():
                return none_type()
            kind = node.specs[i].kind
            required = ""
            if kind == "s":
                required = "str"
            else if kind == "d":
                required = "int"
            else if kind == "f":
                required = "float"
            if required != "" and types.kind(ty) != required:
                self.fail(part.line, part.col, f"format type '{kind}' requires {required}, received {types.display(ty)}")
            else if not types.printable(ty):
                self.fail(part.line, part.col, f"cannot format a value of type {types.display(ty)}")
        return types.prim("str")

    # A call of a built-in function, a host module's function, or an
    # intrinsic, by the name it is written with.
    def check_builtin(expr: ast.Expr, node: ast.Call, target: stdlib.Builtin, state: dict[int, types.Type]) -> types.Type:
        name = node.name
        line = expr.line
        col = expr.col
        if name.startswith("__") or name == "range":
            if len(node.keywords) > 0:
                keyword = node.keywords[0]
                self.fail(keyword.line, keyword.col, f"'{name}' does not accept keyword arguments")
                return none_type()
            if name == "range":
                count = len(node.args)
                if count < 1 or count > 3:
                    self.fail(line, col, f"'range' expects 1 to 3 arguments, received {count}")
                for arg in node.args:
                    self.check_against(arg, state, types.prim("int"))
                return types.ProtocolType(stdlib.protocols()["Iterable"], [types.prim("int")])
            return self.check_intrinsic(expr, node, target, state)
        if name in ["min", "max", "abs", "sum", "any", "all", "list", "enumerate", "zip", "iter", "next"]:
            return self.check_iterable_builtin(expr, node, target, state)
        noun = ""
        if len(target.params) > 0 and target.params[0].name != "":
            noun = "parameter"
        self.bind_args(expr, node, target.params, noun)
        if self.failed():
            return none_type()
        if name == "print":
            return self.check_print(expr, node, state)
        else if name == "len":
            return self.check_len(expr, node, state)
        else if name == "str":
            return self.check_conversion(expr, node, state)
        else if name == "int":
            return self.check_conversion(expr, node, state)
        else if name == "float":
            return self.check_conversion(expr, node, state)
        else if name == "sorted":
            return self.check_sorted(node, state)
        else if name in ["bytes", "bytes.fromhex", "input", "round"]:
            return self.check_host(expr, node, target, state)
        else if name == "ord":
            return self.check_host(expr, node, target, state)
        else if name == "chr":
            return self.check_host(expr, node, target, state)
        else if name == "sys.args":
            return self.check_host(expr, node, target, state)
        else if name == "sys.exit":
            return self.check_host(expr, node, target, state)
        else if name == "sys.eprint":
            return self.check_print(expr, node, state)
        else if name == "fs.read_file":
            return self.check_host(expr, node, target, state)
        else if name == "fs.write_file":
            return self.check_host(expr, node, target, state)
        else if name == "fs.exists":
            return self.check_host(expr, node, target, state)
        else if name == "fs.realpath":
            return self.check_host(expr, node, target, state)
        # Not in L0.
        return self.unsupported(line, col, f"'{name}'")

    def check_iterable_builtin(expr: ast.Expr, node: ast.Call, target: stdlib.Builtin, state: dict[int, types.Type]) -> types.Type:
        name = node.name
        params = target.params
        if name in ["min", "max"]:
            if len(node.keywords) > 0:
                keyword = node.keywords[0]
                self.fail(keyword.line, keyword.col, f"'{name}' does not accept keyword arguments")
                return none_type()
            count = len(node.args)
            if count < 1 or count > 2:
                self.fail(expr.line, expr.col, f"'{name}' expects 1 to 2 arguments, received {count}")
                return none_type()
            params = params[:count]
        noun = "parameter"
        if params[0].name == "":
            noun = ""
        self.bind_args(expr, node, params, noun)
        if self.failed():
            return none_type()
        order = node.order
        assert order is not none, "unbound built-in"
        for i in order:
            param = params[i].ty
            if param is none:
                self.check_expr(node.args[i], state)
            else:
                self.check_against(node.args[i], state, param)
        if self.failed():
            return none_type()
        first = node.args[0].ty
        assert first is not none, "unchecked built-in argument"
        if name in ["iter", "next"]:
            protocol_item = iterable_item(bound_type(types.expand(first)))
            if name == "next":
                protocol_item = advancement(bound_type(types.expand(first)))
            if protocol_item is none:
                self.fail(expr.line, expr.col, f"'{name}' cannot be applied to {types.display(first)}")
                return none_type()
            method = ast.MethodCall(node.args[0], name, [], [])
            expr.node = method
            return self.check_method(expr, method, state)
        if name == "abs":
            if types.kind(first) not in ["int", "float"]:
                self.fail(expr.line, expr.col, f"'abs' cannot be applied to {types.display(first)}")
            return first
        if name in ["min", "max"] and len(node.args) == 2:
            second = node.args[1].ty
            assert second is not none, "unchecked operand"
            if not types.ordered(first, second):
                self.fail(expr.line, expr.col, f"'{name}' cannot be applied to {types.display(first)} and {types.display(second)}")
            return first
        iteration = self.check_iterable(node.args[0], first, state)
        node.iterables = [iteration]
        item = iteration.item
        if name in ["min", "max"]:
            if not types.ordered(item, item):
                self.fail(expr.line, expr.col, f"'{name}' cannot be applied to {types.display(first)}")
            return item
        if name == "sum":
            if types.kind(item) not in ["int", "float"]:
                self.fail(expr.line, expr.col, f"'sum' cannot be applied to {types.display(first)}")
            return item
        if name in ["any", "all"]:
            if types.kind(item) != "bool":
                self.fail(expr.line, expr.col, f"'{name}' cannot be applied to {types.display(first)}")
            return types.prim("bool")
        if name == "list":
            return types.ListType(item)
        if name == "enumerate":
            return types.iterator(types.TupleType([types.prim("int"), item]))
        second = node.args[1].ty
        assert second is not none, "unchecked zip argument"
        other = self.check_iterable(node.args[1], second, state)
        node.iterables = [iteration, other]
        return types.iterator(types.TupleType([item, other.item]))

    # A call of a program's or core's function, or of an extern function,
    # whose variadic arguments are ints, floats, or ptrs.
    def check_function_call(expr: ast.Expr, node: ast.Call, target: ast.FunctionDecl, state: dict[int, types.Type]) -> types.Type:
        record = target.record
        assert record is not none, f"function {target.name} has no signature"
        params = record.params
        if not target.external:
            return self.check_generic_call(expr, node, params, record.result, record.typevars, state, "parameter")
        else:
            if len(node.keywords) > 0:
                keyword = node.keywords[0]
                self.fail(keyword.line, keyword.col, f"'{node.name}' does not accept keyword arguments")
                return none_type()
            if not target.variadic or len(node.args) < len(params):
                self.check_arity(expr, node.name, len(params), len(node.args))
            for i in range(len(node.args)):
                arg = node.args[i]
                if i < len(params):
                    self.check_against(arg, state, params[i].ty)
                else:
                    ty = self.check_expr(arg, state)
                    if not self.failed() and types.kind(ty) not in ["int", "float", "ptr"]:
                        self.fail(arg.line, arg.col, "variadic arguments must be int, float, or ptr")
        return record.result

    # `ord`, `chr`, or a function of sys or fs, with the signature the spec
    # gives it.
    def check_host(expr: ast.Expr, node: ast.Call, target: stdlib.Builtin, state: dict[int, types.Type]) -> types.Type:
        self.check_arity(expr, node.name, len(target.params), len(node.args))
        if self.failed():
            return none_type()
        order = node.order
        assert order is not none, "unbound host call"
        for i in order:
            param = target.params[i].ty
            assert param is not none, f"{node.name} has an untyped parameter"
            self.check_against(node.args[i], state, param)
        result = target.result
        assert result is not none, f"{node.name} has no result"
        return result

    # `print`, and `sys.eprint`, which writes to stderr.
    def check_print(expr: ast.Expr, node: ast.Call, state: dict[int, types.Type]) -> types.Type:
        self.check_arity(expr, node.name, 1, len(node.args))
        if self.failed():
            return none_type()
        arg = node.args[0]
        ty = self.check_expr(arg, state)
        if self.failed():
            return none_type()
        if not types.printable(ty):
            self.fail(arg.line, arg.col, f"cannot print a value of type {types.display(ty)}")
        else if types.kind(ty) not in ["int", "float", "bool", "str", "none", "enum", "union"]:
            self.unsupported(arg.line, arg.col, f"printing {types.display(ty)}")
        return none_type()

    def check_conversion(expr: ast.Expr, node: ast.Call, state: dict[int, types.Type]) -> types.Type:
        name = node.name
        self.check_arity(expr, name, 1, len(node.args))
        if self.failed():
            return none_type()
        arg = node.args[0]
        ty = self.check_expr(arg, state)
        if self.failed():
            return none_type()
        kind = types.kind(ty)
        if name == "str":
            if not types.printable(ty):
                self.fail(arg.line, arg.col, f"cannot convert a value of type {types.display(ty)} to str")
            else if kind not in ["int", "float", "bool", "str", "none", "enum", "union"]:
                self.unsupported(arg.line, arg.col, f"converting {types.display(ty)} to str")
        else if name == "int" and kind not in ["float", "str"] or name == "float" and kind not in ["int", "str"]:
            self.fail(arg.line, arg.col, f"cannot convert a value of type {types.display(ty)} to {name}")
        return types.prim(name)

    # The intrinsics only privileged modules call. `__word`
    # takes a slot of any kind but word, which reinterprets as itself.
    def check_intrinsic(expr: ast.Expr, node: ast.Call, target: stdlib.Builtin, state: dict[int, types.Type]) -> types.Type:
        if target.name == "__ccall":
            if len(node.args) < 2:
                self.fail(expr.line, expr.col, "'__ccall' expects an extern function, an address, and its arguments")
                return none_type()
            signature = node.args[0].node
            if not isinstance(signature, ast.FunctionValue):
                self.fail(node.args[0].line, node.args[0].col, "'__ccall' requires an extern function as its signature")
                return none_type()
            function = signature.target
            if not function.external:
                self.fail(node.args[0].line, node.args[0].col, "'__ccall' requires an extern function as its signature")
                return none_type()
            self.check_against(node.args[1], state, types.prim("ptr"))
            call = ast.Call(function.name, node.args[2:], [], [], function)
            return self.check_function_call(expr, call, function, state)
        self.check_arity(expr, target.name, len(target.params), len(node.args))
        for i in range(len(node.args)):
            arg = node.args[i]
            param = target.params[i].ty
            if param is not none:
                self.check_against(arg, state, param)
            else:
                ty = self.check_expr(arg, state)
                if not self.failed() and types.kind(ty) in ["word", "none"]:
                    self.fail(arg.line, arg.col, f"cannot convert a value of type {types.display(ty)} to word")
        result = target.result
        assert result is not none, f"intrinsic {target.name} has no result"
        return result

# Checks the body of `function`, of `module`, and returns the first error.
# A nested function starts with the variables it captures, `entry`. Its
# defaults are checked too, for the adapters that supply them.
def check_function(module: ast.Module, function: ast.FunctionDecl, entry: dict[int, ast.Symbol]) -> diagnostic.Diagnostic | none:
    record = function.record
    assert record is not none, f"function {function.name} has no signature"
    result = record.result
    if function.is_async:
        assert isinstance(result, types.ClassType), "async function without a coroutine result"
        result = result.args[0]
    checker = Checker(module, function, result, none, {}, [])
    if function.generator:
        result = types.expand(result)
        if not isinstance(result, types.ProtocolType):
            checker.fail(function.line, function.col, "a generator function must be annotated Generator[T], Iterator[T], or Iterable[T]")
            return checker.error
        if result.decl.type_name not in ["Generator", "Iterator", "Iterable"]:
            checker.fail(function.line, function.col, "a generator function must be annotated Generator[T], Iterator[T], or Iterable[T]")
            return checker.error
        checker.yield_type = result.args[0]
    state: dict[int, types.Type] = {}
    for id in entry:
        checker.symbols[id] = entry[id]
        state[id] = checker.declared(id)
    for i in range(len(function.params)):
        symbol = function.params[i].symbol
        assert symbol is not none, "parameter without a symbol"
        symbol.ty = record.params[i].ty
        checker.symbols[symbol.id] = symbol
        state[symbol.id] = record.params[i].ty
        default = function.params[i].default
        if default is not none:
            checker.check_against(default, {}, record.params[i].ty)
    transfers = checker.check_block(function.body, state)
    if not checker.failed() and not function.generator and not transfers and not types.assignable(result, none_type()):
        name = "function '" + function.name
        owner = function.owner
        if isinstance(owner, ast.ClassDecl):
            name = "method '" + owner.name + "." + function.name
        checker.fail(function.line, function.col, f"{name}' must return a value on every path")
    return checker.error

# Checks every function of every module, in order, and returns the first error.
def check_program(modules: list[ast.Module]) -> diagnostic.Diagnostic | none:
    for module in modules:
        for function in bind.functions(module):
            error = check_function(module, function, {})
            if error is not none:
                return error
    return none

def none_type() -> types.Type:
    return types.prim("none")

def is_union(t: types.Type) -> bool:
    return isinstance(types.expand(t), types.UnionType)

def arguments(count: int) -> str:
    if count == 1:
        return "1 argument"
    return f"{count} arguments"

# The result of arithmetic operator `op` on operands whose kinds are `pair`,
# as "int int", or none when it does not apply.
def arithmetic_type(op: str, pair: str) -> types.Type | none:
    if pair == "int int":
        if op == "/":
            return types.prim("float")
        return types.prim("int")
    if pair == "float float":
        return types.prim("float")
    if op == "+" and pair == "str str":
        return types.prim("str")
    if op == "+" and pair == "bytes bytes":
        return types.prim("bytes")
    return none

def copy(state: dict[int, types.Type]) -> dict[int, types.Type]:
    result: dict[int, types.Type] = {}
    for id in state:
        result[id] = state[id]
    return result

def replace(state: dict[int, types.Type], result: dict[int, types.Type]):
    for id in copy(state):
        state.pop(id)
    for id in result:
        state[id] = result[id]

# The symbols assigned in both states, each with the members of its
# declared type, in `symbols`, that either state allows.
def join(a: dict[int, types.Type], b: dict[int, types.Type], symbols: dict[int, ast.Symbol]) -> dict[int, types.Type]:
    result: dict[int, types.Type] = {}
    for id in a:
        if id in b:
            if types.same(a[id], b[id]):
                result[id] = a[id]
            else:
                declared = symbols[id].ty
                assert declared is not none, "a symbol in the state has no type"
                kept: list[types.Type] = []
                for m in types.members(declared):
                    if has_member(a[id], m) or has_member(b[id], m):
                        kept.append(m)
                result[id] = types.subset(declared, kept)
    return result

# What a condition proves about the locals it tests when it is true and when
# it is false: their narrowed types, by symbol id.
class Facts:
    when_true: dict[int, types.Type]
    when_false: dict[int, types.Type]

# `state` with the narrowed types of `facts`.
def narrow(state: dict[int, types.Type], facts: dict[int, types.Type]) -> dict[int, types.Type]:
    result = copy(state)
    for id in facts:
        result[id] = facts[id]
    return result

def has_member(t: types.Type, member: types.Type) -> bool:
    for m in types.members(t):
        if types.same(m, member):
            return true
    return false

# The type a local declared `declared` has after a value of `value` is
# assigned to it: a value of one type other than none narrows a union to the
# member it is assignable to.
def assigned_type(declared: types.Type, value: types.Type) -> types.Type:
    result = declared
    if is_union(declared) and not is_union(value) and types.kind(value) != "none":
        for m in types.members(declared):
            if types.assignable(m, value):
                result = m
    return result

# Adds the id of every symbol that `body` assigns, including in nested
# blocks, to `result`.
def assigned_symbols(body: list[ast.Stmt], result: dict[int, bool]):
    for statement in body:
        node = statement.node
        if isinstance(node, ast.Assign):
            symbol = node.symbol
            if symbol is not none:
                result[symbol.id] = true
        else if isinstance(node, ast.FunctionDef):
            function_symbol = node.symbol
            if function_symbol is not none:
                result[function_symbol.id] = true
        else if isinstance(node, ast.Unpack):
            target_symbols(node.target, result)
        else if isinstance(node, ast.If):
            assigned_symbols(node.body, result)
            assigned_symbols(node.else_body, result)
        else if isinstance(node, ast.While):
            assigned_symbols(node.body, result)
        else if isinstance(node, ast.For):
            target_symbols(node.target, result)
            assigned_symbols(node.body, result)
        else if isinstance(node, ast.With):
            for item in node.items:
                target = item.target
                if target is not none:
                    target_symbols(target, result)
            assigned_symbols(node.body, result)
        else if isinstance(node, ast.Try):
            assigned_symbols(node.body, result)
            for handler in node.handlers:
                symbol = handler.symbol
                if symbol is not none:
                    result[symbol.id] = true
                assigned_symbols(handler.body, result)
            assigned_symbols(node.finally_body, result)

def target_symbols(target: ast.Target, result: dict[int, bool]):
    symbol = target.symbol
    if symbol is not none:
        result[symbol.id] = true
    for element in target.elements:
        target_symbols(element, result)

def may_be_none(t: types.Type) -> bool:
    return is_union(t) or types.kind(t) == "none"

# The local that `expr` names, or none.
def local(expr: ast.Expr) -> ast.Symbol | none:
    node = expr.node
    if isinstance(node, ast.Name):
        return node.symbol
    return none

# The member of `t` that `isinstance` with `named` tests for, or none: a
# class or enum by declaration, and a built-in type by kind.
def isinstance_member(t: types.Type, named: ast.TypeName) -> types.Type | none:
    record = named.record
    found: types.Type | none = none
    for m in types.members(t):
        if isinstance(record, types.Class):
            if isinstance(m, types.ClassType) and types.same_class(m.decl, record):
                found = m
        else if isinstance(record, types.Enum):
            if isinstance(m, types.EnumType) and types.same_enum(m.decl, record):
                found = m
        else if types.kind(m) == named.name:
            found = m
    return found

def type_name_text(named: ast.TypeName) -> str:
    record = named.record
    if isinstance(record, types.Class):
        return record.type_name
    if isinstance(record, types.Enum):
        return record.type_name
    return named.name


def copy_default(default: ast.Expr, line: int, col: int) -> ast.Expr:
    node = default.node
    if isinstance(node, ast.TupleDisplay):
        elements: list[ast.Expr] = []
        for element in node.elements:
            elements.append(copy_default(element, line, col))
        return ast.Expr(line, col, ast.TupleDisplay(elements))
    return ast.Expr(line, col, node)

def call_params(params: list[types.Param]) -> list[stdlib.BuiltinParam]:
    result: list[stdlib.BuiltinParam] = []
    for param in params:
        result.append(stdlib.BuiltinParam(param.name, param.ty, param.default, param.keyword_only))
    return result


def bound_type(t: types.Type) -> types.Type:
    if isinstance(t, types.TypeVar):
        bound = t.bound
        if bound is not none:
            return bound
    return t


def choose(candidates: list[types.Type]) -> types.Type | none:
    for candidate in candidates:
        fits = true
        for other in candidates:
            if not types.assignable(candidate, other):
                fits = false
        if fits:
            return candidate
    return none


def collect(param: types.Type, arg: types.Type, candidates: dict[str, list[types.Type]], matching: list[str]):
    # A recursive alias reaches the same pair of lazy types again.
    if isinstance(param, types.Lazy) and isinstance(arg, types.Lazy):
        pair = f"lazy {param.id} <- {arg.id}"
        if pair in matching:
            return
        matching.append(pair)
        collect(types.expand(param), types.expand(arg), candidates, matching)
        matching.pop()
        return
    param = types.expand(param)
    arg = types.expand(arg)
    if isinstance(param, types.TypeVar) and types.var_key(param) in candidates:
        candidates[types.var_key(param)].append(arg)
    else if isinstance(param, types.UnionType):
        rest: list[types.Type] = []
        for member in types.members(arg):
            if types.kind(member) != "none":
                rest.append(member)
        for part in param.members:
            if isinstance(part, types.TypeVar) and types.var_key(part) in candidates:
                if len(rest) > 0:
                    collect(part, types.union(rest), candidates, matching)
            else:
                for member in rest:
                    collect(part, member, candidates, matching)
    else if isinstance(param, types.ListType) and isinstance(arg, types.ListType):
        collect(param.element, arg.element, candidates, matching)
    else if isinstance(param, types.DictType) and isinstance(arg, types.DictType):
        collect(param.key, arg.key, candidates, matching)
        collect(param.value, arg.value, candidates, matching)
    else if isinstance(param, types.TupleType) and isinstance(arg, types.TupleType):
        if len(param.elements) == len(arg.elements):
            for i in range(len(param.elements)):
                collect(param.elements[i], arg.elements[i], candidates, matching)
    else if isinstance(param, types.ClassType) and isinstance(arg, types.ClassType):
        if types.same_class(param.decl, arg.decl):
            for i in range(len(param.args)):
                collect(param.args[i], arg.args[i], candidates, matching)
    else if isinstance(param, types.ProtocolType):
        if isinstance(arg, types.ProtocolType) and types.same_protocol(param.decl, arg.decl):
            for i in range(len(param.args)):
                collect(param.args[i], arg.args[i], candidates, matching)
            return
        pair = types.display(param) + " <- " + types.display(arg)
        if pair in matching:
            return
        matching.append(pair)
        for method in param.decl.methods:
            want = types.method(param, method.name)
            have = types.method(bound_type(arg), method.name)
            if want is not none and have is not none:
                for p in want.params:
                    for h in have.params:
                        if p.name == h.name:
                            collect(p.ty, h.ty, candidates, matching)
                collect(want.result, have.result, candidates, matching)
        matching.pop()
    else if isinstance(param, types.CallableType):
        parameters: list[types.Type] = []
        result: types.Type | none = none
        if isinstance(arg, types.CallableType):
            parameters = arg.params
            result = arg.result
        else if isinstance(arg, types.FunctionType):
            for p in types.function_params(arg):
                parameters.append(p.ty)
            result = types.function_result(arg)
        if result is not none:
            for i in range(len(param.params)):
                if i < len(parameters):
                    collect(param.params[i], parameters[i], candidates, matching)
            collect(param.result, result, candidates, matching)


# The name a call through `callee` gives in errors: a local's, a function's,
# or "callable".
def callee_name(callee: ast.Expr) -> str:
    node = callee.node
    if isinstance(node, ast.Name):
        return node.name
    ty = callee.ty
    if ty is not none:
        ty = types.expand(ty)
        if isinstance(ty, types.FunctionType):
            return ty.fn.name
    return "callable"

def advancement(t: types.Type) -> types.Type | none:
    method = types.method(t, "next")
    if method is not none and types.assignable(types.iterator(method.result), t):
        return method.result
    return none

def iterable_item(t: types.Type) -> types.Type | none:
    item = types.iteration_item(t)
    if item is not none:
        return item
    method = types.method(t, "iter")
    if method is not none:
        item = advancement(bound_type(types.expand(method.result)))
        if item is not none:
            target = types.ProtocolType(stdlib.protocols()["Iterable"], [item])
            if types.assignable(target, t):
                return item
    return none
