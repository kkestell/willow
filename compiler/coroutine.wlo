# Low-level core helpers and target assembly for stackful coroutines.

def function(name: str) -> str:
    if name == "signal_storage":
        return "\n".join([
            "data $W.signals = align 8 { z 272 }",
            "function l $W.core.signal_storage() {",
            "@start",
            "    ret $W.signals",
            "}",
        ])
    if name == "signal_handler_address":
        # Only async-signal-safe libc calls and plain memory accesses belong here.
        return "\n".join([
            "function l $W.core.signal_handler_address() {",
            "@start",
            "    ret $W.signal.handler",
            "}",
            "function $W.signal.handler(w %signal) {",
            "@start",
            "    %errno =l call $W.core.errno_address()",
            "    %saved =w loadw %errno",
            "    %number =l extuw %signal",
            "    %offset =l mul %number, 8",
            "    %slot =l add $W.signals, %offset",
            "    %pending =l add %slot, 20",
            "    storew 1, %pending",
            "    %output =l add $W.signals, 4",
            "    %fd =w loadw %output",
            "    %byte =l alloc4 4",
            "    storew %signal, %byte",
            "    call $write(w %fd, l %byte, l 1)",
            "    storew %saved, %errno",
            "    ret",
            "}",
        ])
    if name == "coroutine_available":
        return "\n".join([
            "function l $W.core.coroutine_available() {",
            "@start",
            "    %available =w call $W.coroutine.available()",
            "    %result =l extuw %available",
            "    ret %result",
            "}",
        ])
    if name == "coroutine_current":
        return "\n".join([
            "function l $W.core.coroutine_current() {",
            "@start",
            "    %current =l loadl $W.coroutine.current",
            "    ret %current",
            "}",
        ])
    if name == "coroutine_set_current":
        return "\n".join([
            "function $W.core.coroutine_set_current(l %current) {",
            "@start",
            "    storel %current, $W.coroutine.current",
            "    ret",
            "}",
        ])
    if name == "coroutine_set_pending":
        return "\n".join([
            "function $W.core.coroutine_set_pending(l %pending) {",
            "@start",
            "    storel %pending, $W.pending",
            "    ret",
            "}",
        ])
    if name == "coroutine_stack":
        return "\n".join([
            "function l $W.core.coroutine_stack(l %top) {",
            "@start",
            "    %sp =l call $W.coroutine.stack(l %top, l $W.core.coroutine_start)",
            "    ret %sp",
            "}",
        ])
    if name == "coroutine_invoke":
        return "\n".join([
            "function l $W.core.coroutine_invoke(l %entry, l %argument) {",
            "@start",
            "    call %entry(l %argument)",
            "    %pending =l loadl $W.pending",
            "    storel 0, $W.pending",
            "    ret %pending",
            "}",
        ])
    if name == "coroutine_switch":
        return "\n".join([
            "function $W.core.coroutine_switch(l %current, l %resumed) {",
            "@start",
            "    call $W.coroutine.switch(l %current, l %resumed)",
            "    %stack.address =l add %current, 16",
            "    %stack =l loadl %stack.address",
            "    jnz %stack, @done, @native",
            "@native",
            "    %sp.address =l add %current, 8",
            "    %sp =l loadl %sp.address",
            "    %bottom.address =l add %current, 24",
            "    %base =l loadl %bottom.address",
            "    %bottom =l loadl %base",
            "    call $GC_remove_roots(l %sp, l %bottom)",
            "    jmp @done",
            "@done",
            "    ret",
            "}",
        ])
    if name == "async_coroutine":
        return "\n".join([
            "function l $W.core.async_coroutine(l %body) {",
            "@start",
            "    %result =l call $W.core.object_new(l $W.Coroutine.type, l 2)",
            "    %address =l add %result, 8",
            "    storel %body, %address",
            "    ret %result",
            "}",
        ])
    if name == "async_invoke":
        return "\n".join([
            "function l $W.core.async_invoke(l %body) {",
            "@start",
            "    %address =l add %body, 8",
            "    %entry =l loadl %address",
            "    %result =l call %entry(l %body)",
            "    ret %result",
            "}",
        ])
    if name == "aio_loop":
        return "\n".join([
            "function l $W.core.aio_loop() {",
            "@start",
            "    %loop =l loadl $W.aio.loop",
            "    ret %loop",
            "}",
        ])
    if name == "aio_set_loop":
        return "\n".join([
            "function $W.core.aio_set_loop(l %loop) {",
            "@start",
            "    storel %loop, $W.aio.loop",
            "    ret",
            "}",
        ])
    if name == "aio_cancel":
        return "\n".join([
            "function l $W.core.aio_cancel() {",
            "@start",
            "    ret $W.aio.cancel",
            "}",
        ])
    if name == "aio_semaphore_body":
        return "\n".join([
            "function l $W.core.aio_semaphore_body(l %body) {",
            "@start",
            "    %address =l add %body, 16",
            "    %semaphore =l loadl %address",
            "    call $W.core.aio_semaphore_wait(l %semaphore)",
            "    ret 0",
            "}",
        ])
    if name == "aio_semaphore_acquire":
        return "\n".join([
            "function l $W.core.aio_semaphore_acquire(l %semaphore) {",
            "@start",
            "    %body =l call $W.core.object_new(l 0, l 2)",
            "    %entry =l add %body, 8",
            "    storel $W.core.aio_semaphore_body, %entry",
            "    %argument =l add %body, 16",
            "    storel %semaphore, %argument",
            "    %result =l call $W.core.async_coroutine(l %body)",
            "    ret %result",
            "}",
        ])
    if name in ["aio_task_address", "aio_sleep_address"]:
        var entry = "$W.core.aio_task_run"
        if name == "aio_sleep_address":
            entry = "$W.core.aio_sleep_body"
        return "\n".join([
            "function l $W.core." + name + "() {",
            "@start",
            "    ret " + entry,
            "}",
        ])
    if name == "aio_resume":
        return "\n".join([
            "function $W.core.aio_resume(l %task) {",
            "@start",
            "    %address =l add %task, 8",
            "    %context =l loadl %address",
            "    %result =l call $W.core.coroutine_resume(l %context)",
            "    %pending =l loadl $W.pending",
            "    %error =l add %task, 32",
            "    storel %pending, %error",
            "    storel 0, $W.pending",
            "    ret",
            "}",
        ])
    return ""

def data() -> str:
    return "data $W.coroutine.current = { l 0 }\ndata $W.aio.loop = { l 0 }\ndata $W.aio.cancel = { l 0 }"

def assembly(target: str) -> str:
    var prefix = ""
    if target.endswith("_apple"):
        prefix = "_"
    var switch = prefix + "W.coroutine.switch"
    var available = prefix + "W.coroutine.available"
    var prepare = prefix + "W.core.coroutine_prepare"
    var stack = prefix + "W.coroutine.stack"
    var text = ".text\n.p2align 2\n.globl " + available + "\n" + available + ":\n"
    if target in ["arm64", "arm64_apple"]:
        text = text + "    mov w0, #1\n    ret\n"
        text = text + ".p2align 2\n.globl " + stack + "\n" + stack + ":\n"
        text = text + "    sub x0, x0, #160\n    str x1, [x0, #88]\n    ret\n"
        text = text + ".p2align 2\n.globl " + switch + "\n" + switch + ":\n"
        text = text + arm64(prepare)
    else:
        assert target == "amd64_sysv", "unsupported coroutine target"
        text = text + "    mov $1, %eax\n    ret\n"
        text = text + ".p2align 4\n.globl " + stack + "\n" + stack + ":\n"
        # The synthetic return leaves RSP eight bytes below the aligned top,
        # just as a call would. Inherit the creator's floating-point controls.
        text = text + "    lea -72(%rdi), %rax\n    mov %rsi, 56(%rax)\n    stmxcsr 48(%rax)\n    fnstcw 52(%rax)\n    ret\n"
        text = text + ".p2align 4\n.globl " + switch + "\n" + switch + ":\n"
        text = text + amd64(prepare)
    if not target.endswith("_apple"):
        text = text + ".section .note.GNU-stack,\"\",@progbits\n"
    return text

# A switch is a normal call: the ABI makes the caller spill volatile values.
# Keeping the preserved registers on the outgoing stack makes them GC roots.
def arm64(prepare: str) -> str:
    return "\n".join([
        "    sub sp, sp, #160",
        "    stp x19, x20, [sp, #0]",
        "    stp x21, x22, [sp, #16]",
        "    stp x23, x24, [sp, #32]",
        "    stp x25, x26, [sp, #48]",
        "    stp x27, x28, [sp, #64]",
        "    stp x29, x30, [sp, #80]",
        "    stp d8, d9, [sp, #96]",
        "    stp d10, d11, [sp, #112]",
        "    stp d12, d13, [sp, #128]",
        "    stp d14, d15, [sp, #144]",
        "    mov x9, sp",
        "    str x9, [x0, #8]",
        "    mov x19, x1",
        "    bl " + prepare,
        "    ldr x9, [x19, #8]",
        "    mov sp, x9",
        "    ldp x19, x20, [sp, #0]",
        "    ldp x21, x22, [sp, #16]",
        "    ldp x23, x24, [sp, #32]",
        "    ldp x25, x26, [sp, #48]",
        "    ldp x27, x28, [sp, #64]",
        "    ldp x29, x30, [sp, #80]",
        "    ldp d8, d9, [sp, #96]",
        "    ldp d10, d11, [sp, #112]",
        "    ldp d12, d13, [sp, #128]",
        "    ldp d14, d15, [sp, #144]",
        "    add sp, sp, #160",
        "    ret",
        "",
    ])

# SysV preserves RBX, RBP, R12-R15, the x87 control word and MXCSR controls.
# The return PC is already on the stack. Subtracting 56 aligns RSP for prepare.
def amd64(prepare: str) -> str:
    return "\n".join([
        "    sub $56, %rsp",
        "    mov %rbx, 0(%rsp)",
        "    mov %rbp, 8(%rsp)",
        "    mov %r12, 16(%rsp)",
        "    mov %r13, 24(%rsp)",
        "    mov %r14, 32(%rsp)",
        "    mov %r15, 40(%rsp)",
        "    stmxcsr 48(%rsp)",
        "    fnstcw 52(%rsp)",
        "    mov %rsp, 8(%rdi)",
        "    mov %rsi, %rbx",
        "    call " + prepare,
        "    mov 8(%rbx), %rsp",
        "    mov 0(%rsp), %rbx",
        "    mov 8(%rsp), %rbp",
        "    mov 16(%rsp), %r12",
        "    mov 24(%rsp), %r13",
        "    mov 32(%rsp), %r14",
        "    mov 40(%rsp), %r15",
        "    ldmxcsr 48(%rsp)",
        "    fldcw 52(%rsp)",
        "    add $56, %rsp",
        "    ret",
        "",
    ])
