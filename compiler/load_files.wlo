# Loads the program whose entry file is each path named on the command line
# and writes the first error in each to stderr as "ENTRY: DIAGNOSTIC", where
# the diagnostic names files relative to the entry file's directory, as a
# compiler run from that directory would. With --modules first, writes each
# program's modules to stdout instead, in load order. Exits with status 1 if
# any program has an error.

import diagnostic
import fs
import loader
import sys

def main():
    args = sys.args()
    show_modules = len(args) > 0 and args[0] == "--modules"
    if show_modules:
        args = args[1:]
    failed = false
    for path in args:
        result = loader.load(path, fs.read_file(path), loader.file_roots(path), false)
        if result is diagnostic.Diagnostic:
            # Paths in messages, such as a missing module's, start with the
            # directory too.
            root = loader.directory_of(path)
            relative = result.path.removeprefix(root)
            message = result.message
            if root != "":
                message = message.replace(root, "")
            error = diagnostic.Diagnostic(relative, result.line, result.col, message)
            sys.eprint(f"{path}: {error.format()}")
            failed = true
        else if show_modules:
            for source in result:
                print(f"{path}: {source.name} {source.tree.path}")
    if failed:
        sys.exit(1)
