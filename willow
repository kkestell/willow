#!/bin/sh
# Follow symlinks so a link installed elsewhere still finds the checkout.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
root=$(cd "$(dirname "$self")" && pwd -P)
# Programs run by `willow run` and `willow test` can start Willow through this.
WILLOW=$root/willow
export WILLOW
exec "$root/vendor/luajit/src/luajit" "$root/compiler/cli.lua" "$@"
