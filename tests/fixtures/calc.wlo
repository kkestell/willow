# Evaluates arithmetic on floats, one expression per line of input:
# echo "2 * (3 + 4)" | willow run calc.wlo
# On a terminal it shows a prompt.

import io
import terminal

class Number:
    value: float

class Negate:
    operand: Expr

enum Operator:
    ADD
    SUBTRACT
    MULTIPLY
    DIVIDE

class Binary:
    operator: Operator
    left: Expr
    right: Expr

type Expr = Number | Negate | Binary

class ParseError(Exception):
    column: int

class Token:
    text: str
    column: int

# Splits a line into numbers and operators, ending with an empty token.
def tokenize(line: str) -> list[Token]:
    var tokens: list[Token] = []
    var number = ""
    var column = 0
    for ch in line + " ":
        column = column + 1
        if ch in "0123456789.":
            number = number + ch
            continue
        if number != "":
            tokens.append(Token(number, column - len(number)))
            number = ""
        if ch in "+-*/()":
            tokens.append(Token(ch, column))
        else if ch != " ":
            raise ParseError(f"unexpected '{ch}'", column)
    tokens.append(Token("", column))
    return tokens

def operator(text: str) -> Operator:
    if text == "+":
        return Operator.ADD
    else if text == "-":
        return Operator.SUBTRACT
    else if text == "*":
        return Operator.MULTIPLY
    return Operator.DIVIDE

# A recursive-descent parser. Each method parses one level of precedence.
class Parser:
    tokens: list[Token]
    index: int = 0

    def peek() -> str:
        return self.tokens[self.index].text

    def take() -> Token:
        var token = self.tokens[self.index]
        if token.text != "":
            self.index = self.index + 1
        return token

    def sum() -> Expr:
        var left = self.product()
        while self.peek() == "+" or self.peek() == "-":
            left = Binary(operator(self.take().text), left, self.product())
        return left

    def product() -> Expr:
        var left = self.unary()
        while self.peek() == "*" or self.peek() == "/":
            left = Binary(operator(self.take().text), left, self.unary())
        return left

    def unary() -> Expr:
        var token = self.take()
        if token.text == "-":
            return Negate(self.unary())
        if token.text == "(":
            var inner = self.sum()
            var closing = self.take()
            if closing.text != ")":
                raise ParseError("expected ')'", closing.column)
            return inner
        try:
            return Number(float(token.text))
        except ValueError:
            raise ParseError("expected a number", token.column)

def parse(line: str) -> Expr:
    var parser = Parser(tokenize(line))
    var expr = parser.sum()
    if parser.peek() != "":
        raise ParseError(f"unexpected '{parser.peek()}'", parser.take().column)
    return expr

def evaluate(expr: Expr) -> float:
    if expr is Number:
        return expr.value
    if expr is Negate:
        return -evaluate(expr.operand)
    var left = evaluate(expr.left)
    var right = evaluate(expr.right)
    if expr.operator == Operator.ADD:
        return left + right
    else if expr.operator == Operator.SUBTRACT:
        return left - right
    else if expr.operator == Operator.MULTIPLY:
        return left * right
    return left / right

def main():
    var prompt = terminal.isatty(io.stdin())
    var out = io.stdout()
    while true:
        if prompt:
            out.write_text("> ")
            out.flush()
        var line = input()
        if line is none:
            break
        if line.strip() == "":
            continue
        try:
            print(evaluate(parse(line)))
        except ParseError as error:
            print(f"column {error.column}: {error.message}")
        except ZeroDivisionError as failure:
            print(failure.message)
