# Prints a receipt. Run the tests with `willow test tests/fixtures/cart`.

import cart

def cents(amount: int) -> str:
    rest = str(amount % 100)
    if len(rest) == 1:
        rest = "0" + rest
    return f"{amount // 100}.{rest}"

def main():
    order = cart.Cart([])
    order.add("tea", 450, quantity=2)
    order.add("scone", 325)
    order.apply_discount(percent=10)
    for item in order:
        print(f"{item.name:<10}{item.quantity:>3d}{cents(item.price * item.quantity):>9}")
    print(f"{'discount':<13}{str(order.discount) + '%':>9}")
    print(f"{'total':<13}{cents(order.total()):>9}")
