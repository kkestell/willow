# Checks whether TCP ports accept connections.

import aio
import time

class Target:
    host: str
    port: int

class Probe:
    target: Target
    open: bool
    millis: float
    detail: str

# Splits "host:port"; the host may be a bracketed IPv6 address.
def parse_target(text: str) -> Target:
    split = -1
    for i in range(len(text)):
        if text[i] == ":":
            split = i
    if split <= 0 or split == len(text) - 1:
        raise ValueError(f"expected host:port, received '{text}'")
    host = text[:split]
    if host.startswith("[") and host.endswith("]"):
        host = host[1:-1]
    try:
        port = int(text[split + 1:])
    except ValueError:
        raise ValueError(f"invalid port in '{text}'")
    if port < 1 or port > 65535:
        raise ValueError(f"invalid port in '{text}'")
    return Target(host, port)

async def check(target: Target, timeout: float) -> Probe:
    start = time.monotonic()
    try:
        with await aio.connect(target.host, target.port, timeout=timeout):
            return Probe(target, true, _millis(start), "open")
    except OSError as error:
        return Probe(target, false, _millis(start), error.message)
    except TimeoutError:
        return Probe(target, false, _millis(start), "timed out")

def _millis(start: float) -> float:
    return (time.monotonic() - start) * 1000.0
