# Reports which TCP ports accept connections:
# willow run -- [--timeout SECONDS] [--json] host:port...

import aio
import cli
import io
import json
import portcheck.probe
import sys
import textkit.table

async def main():
    var parser = cli.parser("portcheck", description="Check whether TCP ports accept connections.")
    parser.add_float("timeout", 2.0, help="Seconds to wait for each connection", short="t")
    parser.add_flag("json", help="Write one JSON object per target")
    parser.add_rest("target", help="host:port to check")
    var args: cli.Args
    try:
        args = parser.parse(sys.args())
    except cli.HelpRequested as help:
        io.stdout().write_text(help.message)
        sys.exit(0)
    except cli.UsageError as usage:
        sys.eprint(usage.message)
        sys.exit(2)
    var texts = args.get_list("target")
    var targets: list[portcheck.probe.Target] = []
    try:
        for text in texts:
            targets.append(portcheck.probe.parse_target(text))
    except ValueError as error:
        sys.eprint(f"portcheck: error: {error.message}")
        sys.exit(2)
    if len(targets) == 0:
        sys.eprint("portcheck: error: expected at least one host:port")
        sys.exit(2)

    # Every target is probed at once, so the slowest probe bounds the wait.
    var probes: list[aio.Task[portcheck.probe.Probe]] = []
    async with aio.task_group() as group:
        for target in targets:
            probes.append(group.start(portcheck.probe.check(target, args.get_float("timeout"))))

    var all_open = true
    var rows: list[list[str]] = []
    for probe in probes:
        var result = probe.result()
        if not result.open:
            all_open = false
        var name = f"{result.target.host}:{result.target.port}"
        if args.get_bool("json"):
            print(json.dump({"target": name, "open": result.open, "detail": result.detail}))
        else:
            var state = "closed"
            if result.open:
                state = "open"
            rows.append([name, state, f"{result.millis:.1f} ms"])
    if not args.get_bool("json"):
        print(textkit.table.render(["target", "state", "time"], rows))
    if not all_open:
        sys.exit(1)
