# Runs a command with a time limit and reports its status and output:
# willow run wrap.wlo <seconds> <command> [args...]
# The command gets empty input and runs in the C locale.

import subprocess
import sys

def describe(name: str, data: bytes | none):
    if data is none or len(data) == 0:
        print(f"{name}: (empty)")
        return
    try:
        print(f"{name}: {data.decode().strip()}")
    except ValueError:
        print(f"{name}: {len(data)} bytes, not UTF-8")

def main():
    args = sys.args()
    if len(args) < 2:
        sys.eprint("usage: wrap <seconds> <command> [args...]")
        sys.exit(2)
    env = sys.environ()
    env["LC_ALL"] = "C"
    try:
        result = subprocess.run(args[1:], input=bytes([]), capture_output=true, env=env, timeout=float(args[0]))
    except TimeoutError as timeout:
        print(f"timed out: {timeout.message}")
        sys.exit(1)
    except OSError as error:
        print(f"failed: {error.message}")
        sys.exit(1)
    print(f"status {result.returncode}")
    describe("stdout", result.stdout)
    describe("stderr", result.stderr)
    if result.returncode != 0:
        sys.exit(1)
