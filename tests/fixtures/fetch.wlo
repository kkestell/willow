# Downloads a URL to a file without leaving partial output behind. Each
# name=value argument is added to the URL's query string:
# willow run fetch.wlo <url> <path> [name=value...]

import http
import sys

def main():
    args = sys.args()
    if len(args) < 2:
        sys.eprint("usage: fetch <url> <path> [name=value...]")
        sys.exit(2)
    url = args[0]
    query: dict[str, str] = {}
    for pair in args[2:]:
        split = pair.find("=")
        if split is none or split < 1:
            sys.eprint(f"fetch: expected name=value, received '{pair}'")
            sys.exit(2)
        query[pair[:split]] = pair[split + 1:]
    if len(query) > 0:
        separator = "?"
        if "?" in url:
            separator = "&"
        url = url + separator + http.urlencode(query)
    try:
        result = http.download(url, args[1], timeout=10.0)
    except OSError as error:
        sys.eprint(error.message)
        sys.exit(1)
    except TimeoutError as timeout:
        sys.eprint(timeout.message)
        sys.exit(1)
    if result.status < 200 or result.status > 299:
        print(f"HTTP {result.status} from {result.url}; {args[1]} left unchanged")
        sys.exit(1)
    print(f"saved {result.bytes_written} bytes from {result.url} to {args[1]}")
