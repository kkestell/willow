# A key-value server for JSON-lines requests on 127.0.0.1:
# willow run server.wlo <port-file>
# It listens on a free port, writes the port to <port-file>, and serves one
# connection at a time until a client sends {"op": "shutdown"}.

import framing
import fs
import json
import net
import sys

# A JSON value as text when it is a string, otherwise "".
def _text(value: json.Json) -> str:
    if value is str:
        return value
    return ""

def reply(store: dict[str, json.Json], request: json.Json) -> json.Json:
    if request is not dict:
        return {"error": "expected an object"}
    var op = _text(request.get("op"))
    var key = request.get("key")
    if op == "set" and (key is str):
        store[key] = request.get("value")
        return {"ok": true}
    else if op == "get" and (key is str):
        return {"value": store.get(key)}
    else if op == "keys":
        var names: list[json.Json] = []
        for name in sorted(store):
            names.append(name)
        return {"keys": names}
    return {"error": "unknown request"}

# Serves one client; returns true when it asked the server to stop.
def serve(channel: framing.Channel, store: dict[str, json.Json]) -> bool:
    with channel:
        while true:
            var request: json.Json
            try:
                var line = channel.read_line()
                if line is none:
                    return false
                request = json.parse(line)
            except ValueError as invalid:
                channel.send({"error": invalid.message})
                continue
            except json.JsonError as error:
                channel.send({"error": error.message})
                continue
            if request is dict and _text(request.get("op")) == "shutdown":
                channel.send({"ok": true})
                return true
            channel.send(reply(store, request))
    return false

def main():
    var args = sys.args()
    if len(args) != 1:
        sys.eprint("usage: server <port-file>")
        sys.exit(2)
    with net.listen("127.0.0.1", 0) as listener:
        # Publishing by rename means a reader never sees a partial port number.
        fs.write_file(args[0] + ".tmp", str(listener.local_port()))
        fs.rename(args[0] + ".tmp", args[0])
        var store: dict[str, json.Json] = {}
        while true:
            try:
                if serve(framing.channel(listener.accept()), store):
                    break
            except OSError as error:
                sys.eprint(f"client failed: {error.message}")
