# JSON messages over TCP, one per line. Received bytes are buffered and only
# complete lines are decoded, so a code point split across reads is whole by
# the time it is decoded.

import json
import net

class Channel:
    connection: net.Connection
    pending: bytes

    def send(self, value: json.Json):
        self.connection.sendall((json.dump(value) + "\n").encode())

    # The next complete line without its newline, or None when the peer closed.
    def read_line(self, timeout: float | None = None) -> str | None:
        index = _newline(self.pending)
        while index < 0:
            chunk = self.connection.recv(4096, timeout=timeout)
            if len(chunk) == 0:
                return None
            self.pending = self.pending + chunk
            index = _newline(self.pending)
        line = self.pending[:index]
        self.pending = self.pending[index + 1:]
        return line.decode()

    def receive(self, timeout: float | None = None) -> json.Json:
        line = self.read_line(timeout=timeout)
        if line is None:
            return None
        return json.parse(line)

    def close(self):
        self.connection.close()

    def enter(self) -> Channel:
        return self

    def exit(self, error: Exception | None):
        self.close()

def channel(connection: net.Connection) -> Channel:
    return Channel(connection, bytes([]))

# The index of the first newline in `data`, or -1.
def _newline(data: bytes) -> int:
    index = 0
    for octet in data:
        if octet == 10:
            return index
        index = index + 1
    return -1
