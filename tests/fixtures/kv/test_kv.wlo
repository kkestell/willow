# Starts the server in its own process and talks to it over TCP.
# Run with `willow test tests/fixtures/kv` from the repository root, or
# `willow test` from this directory.

import framing
import fs
import json
import net
import subprocess
import sys
import time

# A running server, stopped when its scope ends.
class Server:
    process: subprocess.Process
    port_file: str
    port: int

    def enter(self) -> Server:
        return self

    def exit(self, error: Exception | None) -> None:
        _stop(self)

def _server_path() -> str:
    for path in ["server.wlo", "tests/fixtures/kv/server.wlo"]:
        if fs.exists(path):
            return path
    raise RuntimeError("cannot find server.wlo")

def _start() -> Server:
    willow = sys.getenv("WILLOW")
    assert willow is not None, "WILLOW is not set"
    port_file = fs.join("/tmp", f"kv_port_{int(time.time() * 1000000.0)}")
    process = subprocess.spawn([willow, "run", _server_path(), port_file])
    deadline = time.monotonic() + 10.0
    while not fs.exists(port_file):
        if time.monotonic() > deadline:
            process.terminate()
            process.wait(timeout=5.0)
            raise RuntimeError("server did not start")
        time.sleep(0.05)
    return Server(process, port_file, int(fs.read_file(port_file)))

def _stop(server: Server) -> None:
    server.process.terminate()
    server.process.wait(timeout=5.0)
    fs.remove(server.port_file)

def _ask(channel: framing.Channel, request: json.Json) -> str:
    channel.send(request)
    return json.dump(channel.receive(timeout=5.0))

def test_set_get_and_keys() -> None:
    with _start() as server, framing.channel(net.connect("127.0.0.1", server.port)) as channel:
        assert _ask(channel, {"op": "set", "key": "b", "value": [1, 2]}) == '{"ok":true}'
        assert _ask(channel, {"op": "set", "key": "a", "value": "x"}) == '{"ok":true}'
        assert _ask(channel, {"op": "get", "key": "b"}) == '{"value":[1,2]}'
        assert _ask(channel, {"op": "get", "key": "missing"}) == '{"value":null}'
        assert _ask(channel, {"op": "keys"}) == '{"keys":["a","b"]}'
        assert _ask(channel, {"op": "nope"}) == '{"error":"unknown request"}'

def test_split_code_point_is_reassembled() -> None:
    with _start() as server, framing.channel(net.connect("127.0.0.1", server.port)) as channel:
        message = '{"op": "set", "key": "café", "value": "naïve"}\n'.encode()
        # Split inside the two bytes of "é".
        cut = len('{"op": "set", "key": "caf'.encode()) + 1
        channel.connection.sendall(message[:cut])
        time.sleep(0.1)
        channel.connection.sendall(message[cut:])
        reply = channel.receive(timeout=5.0)
        assert json.dump(reply) == '{"ok":true}', json.dump(reply)
        assert _ask(channel, {"op": "get", "key": "café"}) == '{"value":"naïve"}'

def test_clients_are_served_in_turn() -> None:
    with _start() as server:
        with framing.channel(net.connect("127.0.0.1", server.port)) as first:
            assert _ask(first, {"op": "set", "key": "k", "value": 1}) == '{"ok":true}'
        with framing.channel(net.connect("127.0.0.1", server.port)) as second:
            assert _ask(second, {"op": "get", "key": "k"}) == '{"value":1}'
            assert _ask(second, {"op": "shutdown"}) == '{"ok":true}'
        assert server.process.wait(timeout=5.0) == 0
