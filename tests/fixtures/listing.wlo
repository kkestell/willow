# Lists the directory named by LISTING_DIR (default: the current directory)
# with each entry's kind, size, and modification time, then totals per kind.

import fs
import sys
import time

def main():
    var start = time.monotonic()
    var directory = sys.getenv("LISTING_DIR")
    if directory is none:
        directory = sys.getcwd()
    var counts: dict[str, int] = {}
    var sizes: dict[str, int] = {}
    print(f"{'name':<16}{'kind':<10}{'size':>8}  modified")
    for name in fs.listdir(directory):
        var info = fs.stat(fs.join(directory, name), follow_symlinks=false)
        print(f"{name:<16}{info.kind:<10}{info.size:>8d}  {time.utc(info.modified)}")
        var seen = counts.get(info.kind)
        if seen is none:
            counts[info.kind] = 1
            sizes[info.kind] = info.size
        else:
            counts[info.kind] = seen + 1
            sizes[info.kind] = sizes[info.kind] + info.size
    print("")
    for kind in sorted(counts):
        print(f"{kind:<10}{counts[kind]:>4d} entries{sizes[kind]:>10d} bytes")
    var elapsed = time.monotonic() - start
    print(f"listed {directory} in {elapsed:.3f}s")
