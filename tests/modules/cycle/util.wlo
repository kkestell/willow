import main

def is_odd(n: int) -> bool:
    if n == 0:
        return False
    return main.is_even(n - 1)

def call_back(n: int) -> int:
    helper = n + 1
    return main.helper(helper)

def tagged(label: str) -> main.Tag:
    return main.Tag(_decorate(label))

def _decorate(label: str) -> str:
    return "<" + label + ">"
