# Runs program tests and command cases with the compiler under test.
#
# Usage: runner [--build] COMPILER PATH...
#
# A PATH ending in .wlo is a program, run from its own directory as
# `COMPILER run NAME.wlo`, or with --build, for willow0, which has no run
# command, built with `COMPILER build NAME.wlo -o PROGRAM` and then run; a
# failed build counts as the program's output and status. Stdin is NAME.in
# when it exists and empty otherwise. Optional NAME.out and NAME.err hold the
# expected stdout and stderr; a missing file means no output. The expected
# exit status is 1 when NAME.err exists and 0 otherwise. Without --build,
# NAME.stage1.err replaces NAME.err when it exists, for the failures that
# stage 0 reports without a location; an empty one means the program passes.
#
# Any other PATH is a command case, a directory whose script `command` runs
# with sh in a copy of the directory, of the same name and without its
# `expected`, with WILLOW
# naming the compiler and ROOT the current directory. The script must exit
# with status 0, and its stdout and stderr together must equal `expected`.
#
# Run from the repository's root. Exits with status 1 if any test fails.

import fs
import io
import subprocess
import sys

def main():
    args = sys.args()
    build = len(args) > 0 and args[0] == "--build"
    if build:
        args = args[1:]
    if len(args) < 1:
        sys.eprint("usage: runner [--build] COMPILER PATH...")
        sys.exit(2)
    compiler = fs.abspath(args[0])
    work = fs.temp_dir()
    fs.mkdir(work + "/cases")
    passed = 0
    failed = 0
    for path in args[1:]:
        if path.endswith(".wlo"):
            failures = program_case(compiler, path, build, work)
        else:
            failures = command_case(compiler, path.removesuffix("/"), work)
        if len(failures) == 0:
            passed = passed + 1
        else:
            failed = failed + 1
            for line in failures:
                print(line)
    subprocess.run(["rm", "-rf", work])
    print(f"{passed} passed, {failed} failed")
    if failed > 0:
        sys.exit(1)

# The failure lines of the program at `path`, or none when it passes.
def program_case(compiler: str, path: str, build: bool, work: str) -> list[str]:
    directory = fs.dirname(path)
    if directory == "":
        directory = "."
    name = fs.basename(path)
    base = path.removesuffix(".wlo")
    stdin = "/dev/null"
    if fs.exists(base + ".in"):
        stdin = fs.abspath(base + ".in")
    out = work + "/out"
    err = work + "/err"
    if build:
        program = work + "/program"
        status = execute([compiler, "build", name, "-o", program], directory, None, stdin, out, err)
        if status == 0:
            status = execute([program], directory, None, stdin, out, err)
    else:
        status = execute([compiler, "run", name], directory, None, stdin, out, err)
    expected_err = base + ".err"
    expected_status = 0
    if fs.exists(expected_err):
        expected_status = 1
    if not build and fs.exists(base + ".stage1.err"):
        expected_err = base + ".stage1.err"
        expected_status = 0
        if fs.stat(expected_err).size > 0:
            expected_status = 1
    failures: list[str] = []
    if status != expected_status:
        failures.append(f"FAIL {path}: exit status {status}, expected {expected_status}")
    failures.extend(compare(path, "stdout", base + ".out", out))
    failures.extend(compare(path, "stderr", expected_err, err))
    return failures

# The failure lines of the command case in `directory`, or none when it
# passes.
def command_case(compiler: str, directory: str, work: str) -> list[str]:
    copy = work + "/cases/" + fs.basename(directory)
    subprocess.run(["rm", "-rf", copy])
    subprocess.run(["cp", "-R", directory, copy])
    fs.remove(copy + "/expected")
    env = sys.environ()
    env["WILLOW"] = compiler
    env["ROOT"] = sys.getcwd()
    output = work + "/output"
    status = execute(["sh", "command"], copy, env, "/dev/null", output, output)
    if status != 0:
        return [f"FAIL {directory}: exit status {status}"]
    return compare(directory, "output", directory + "/expected", output)

# The failure lines when the file at `actual` differs from the file at
# `expected`, which may be missing to mean empty: a line naming `stream` and
# the diff, indented.
def compare(path: str, stream: str, expected: str, actual: str) -> list[str]:
    if not fs.exists(expected):
        expected = "/dev/null"
    if fs.read_bytes(expected) == fs.read_bytes(actual):
        return []
    result = subprocess.run(["diff", expected, actual], capture_output=True)
    lines = [f"FAIL {path}: {stream} differs"]
    stdout = result.stdout
    assert stdout is not None
    for line in stdout.decode().split("\n"):
        if line != "":
            lines.append("    " + line)
    return lines

# Runs `args` in `cwd` with stdin, stdout, and stderr from and to the files
# at those paths, which may be the same for stdout and stderr, and returns
# its exit status. `env` replaces the environment unless it is None.
def execute(args: list[str], cwd: str, env: dict[str, str] | None, stdin: str, stdout: str, stderr: str) -> int:
    input = io.open(stdin)
    output = io.open(stdout, "w")
    error = output
    if stderr != stdout:
        error = io.open(stderr, "w")
    process = subprocess.spawn(args, cwd=cwd, env=env, stdin=input, stdout=output, stderr=error)
    status = process.wait()
    input.close()
    output.close()
    if stderr != stdout:
        error.close()
    return status
