import http
import sys

def rejected(url: str, ca_file: str | none):
    try:
        http.request("GET", url, ca_file=ca_file, timeout=2.0)
        assert false, "untrusted certificate accepted"
    except OSError as error:
        assert error.message.startswith("cannot fetch " + url + ": ")

def main():
    port = sys.args()[0]
    directory = sys.args()[1]
    url = "https://localhost:" + port + "/hello.txt"
    response = http.request("GET", url, ca_file=directory + "/cert.pem", timeout=2.0)
    assert response.status == 200 and response.body.decode() == "secure hello\n"
    rejected(url, none)
    rejected("https://127.0.0.1:" + port + "/hello.txt", directory + "/cert.pem")
    rejected(url, directory + "/empty.pem")
    print("http TLS passed")
