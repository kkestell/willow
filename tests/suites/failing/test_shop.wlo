import shop
import sys

def test_known_price():
    assert shop.price("tea") == 450

def test_wrong_price():
    print("checking tea")
    assert shop.price("tea") == 400, "tea should cost 400"

def test_unknown_item():
    shop.price("cake")

def test_exit_is_a_failure():
    sys.exit(0)

def test_output_of_passing_tests_is_hidden():
    print("hidden")

def test_isolated_process():
    assert input() is none
    assert len(sys.args()) == 0

async def priced(item: str) -> int:
    return shop.price(item)

async def test_async_known_price():
    assert await priced("tea") == 450

async def test_async_unknown_item():
    await priced("cake")
