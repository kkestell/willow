def number() -> int:
    print("number")
    return -42

def main():
    print(f"{0:x} {255:x} {255:X} {-255:x}")
    print(f"{9223372036854775807:X} {-9223372036854775807:x}")
    print(f"[{42:05d}][{-42:05}][{42:02}][{42:0d}][{42:0}]")
    print(f"[{255:06x}][{-255:06X}][{255:^6x}]")
    print(f"[{2.5:08.2f}][{-2.5:08.2f}][{-0.0:08.2f}]")
    print(f"[{2.5:08}][{-2.5:08}][{2.5:09f}]")
    print(f"[{float('inf'):08f}][{float('-inf'):08}][{float('nan'):08f}]")
    print(f"{number():07X}")
