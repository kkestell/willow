import typing

def first[T](items: list[T]) -> T:
    return items[0]

def repeat[T](x: T, n: int) -> list[T]:
    result: list[T] = []
    for i in range(n):
        result.append(x)
    return result

def pick[T](x: T | None = None, fallback: T | None = None) -> T | None:
    if x is not None:
        return x
    return fallback

def pair[A, B](a: A, b: B) -> tuple[A, B]:
    return (a, b)

def pair_same[T](a: T, b: T) -> list[T]:
    return [a, b]

def empty[T]() -> list[T]:
    return []

def map_list[T, U](f: typing.Callable[[T], U], xs: list[T]) -> list[U]:
    result: list[U] = []
    for x in xs:
        result.append(f(x))
    return result

def count[T](xs: list[T] | None) -> int:
    if xs is None:
        return 0
    return len(xs)

def apply_maybe[T](f: typing.Callable[[T], list[int | None]], x: T) -> list[int | None]:
    return f(x)

def maybe() -> int | None:
    return None

# Calls without type arguments infer them.
def inferred() -> None:
    print(first([3, 4]))
    print(first(["a"]))
    # int and int | None infer int | None.
    both = pair_same(1, maybe())
    print(len(both))
    print(pick(None, 5))
    # The expected result decides what the arguments leave open.
    xs: list[int] = empty()
    print(len(xs))
    y: int | None = first([1])
    print(y)
    # A lambda's parameter types come from the other arguments; its result infers U.
    doubled = map_list(lambda x: x * 2, [1, 2])
    print(doubled[1])
    words = map_list(lambda x: str(x) + "!", [7])
    print(words[0])
    print(count([1, 2]))
    # A result the callee fixes is checked against it.
    print(len(apply_maybe(lambda v: [v, 1], 2)))

    def wrap[V](v: V) -> list[V]:
        return [v]

    print(len(wrap("s")))

def main() -> None:
    print(first[int]([3, 4]))
    print(first[str](["a", "b"]))
    print(len(repeat[str]("x", 3)))
    print(pick[int](None, fallback=5))
    print(pick[int]())
    # A float in an int | float type argument passes through unconverted.
    v = first[int | float]([2.5, 1])
    print(isinstance(v, float))
    print(v)
    # T | None with T = int | None is int | None.
    w: int | None = pick[int | None](None, 7)
    print(w)
    p = pair[int, str](1, "a")
    print(p[1])

    def wrap[U](u: U) -> list[U]:
        return [u]

    print(len(wrap[int](1)))
    inferred()
