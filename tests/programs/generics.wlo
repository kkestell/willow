import io

def first[T](items: list[T]) -> T:
    return items[0]

def repeat[T](x: T, n: int) -> list[T]:
    result: list[T] = []
    for i in range(n):
        result.append(x)
    return result

def pick[T](x: T | none = none, fallback: T | none = none) -> T | none:
    if x is not none:
        return x
    return fallback

def pair[A, B](a: A, b: B) -> tuple[A, B]:
    return (a, b)

def pair_same[T](a: T, b: T) -> list[T]:
    return [a, b]

def empty[T]() -> list[T]:
    return []

def map_list[T, U](f: (T) -> U, xs: list[T]) -> list[U]:
    result: list[U] = []
    for x in xs:
        result.append(f(x))
    return result

def count[T](xs: list[T] | none) -> int:
    if xs is none:
        return 0
    return len(xs)

def apply_maybe[T](f: (T) -> list[int | none], x: T) -> list[int | none]:
    return f(x)

def maybe() -> int | none:
    return none

# Calls without type arguments infer them.
def inferred():
    print(first([3, 4]))
    print(first(["a"]))
    # int and int | none infer int | none.
    both = pair_same(1, maybe())
    print(len(both))
    print(pick(none, 5))
    # The expected result decides what the arguments leave open.
    xs: list[int] = empty()
    print(len(xs))
    y: int | none = first([1])
    print(y)
    # A lambda's parameter types come from the other arguments; its result infers U.
    doubled = map_list(lambda x: x * 2, [1, 2])
    print(doubled[1])
    words = map_list(lambda x: str(x) + "!", [7])
    print(words[0])
    print(count([1, 2]))
    # A result the callee fixes is checked against it.
    print(len(apply_maybe(lambda v: [v, 1], 2)))

    def wrap[V](v: V) -> list[V]:
        return [v]

    print(len(wrap("s")))

type Pair[K, V] = tuple[K, V]
# A generic alias may recurse through list or dict.
type Nested[T] = list[Nested[T]] | none
type Tree[T] = dict[str, Tree[T]] | list[T]

def swap(p: Pair[int, str]) -> Pair[str, int]:
    return (p[1], p[0])

def depth(n: Nested[int]) -> int:
    if n is none:
        return 0
    best = 0
    for child in n:
        d = depth(child)
        if d > best:
            best = d
    return best + 1

# A recursive alias may be applied to the function's own type parameter.
def generic_depth[T](n: Nested[T]) -> int:
    if n is none:
        return 0
    best = 0
    for child in n:
        d = generic_depth[T](child)
        if d > best:
            best = d
    return best + 1

def leaves[T](t: Tree[T]) -> list[T]:
    if isinstance(t, list):
        return t
    found: list[T] = []
    for k in t:
        found.extend(leaves(t[k]))
    return found

class Named:
    name: str

    def greet(self) -> str:
        return "hi " + self.name

# A bounded type parameter has its bound's fields and methods.
def label[T: Named](x: T) -> str:
    return x.name + "/" + x.greet()

def send[F: io.File](f: F, text: str) -> F:
    f.write_text(text)
    return f

def identity[T](x: T) -> T:
    return x

def apply(f: (str) -> str, s: str) -> str:
    return f(s)

def aliases_bounds_values():
    print(swap((1, "a"))[0])
    print(depth([[none], [[none]]]))
    print(generic_depth[str]([[none], [[none]]]))
    tree: Tree[int] = {"a": [1, 2], "b": {"c": [3]}}
    print(len(leaves(tree)))
    print(label(Named("a")))
    send(io.stdout(), "sent\n")
    # Explicit type arguments or an expected callable make generic values.
    f = first[int]
    print(f([7]))
    print(apply(identity, "same"))

def main():
    print(first[int]([3, 4]))
    print(first[str](["a", "b"]))
    print(len(repeat[str]("x", 3)))
    print(pick[int](none, fallback=5))
    print(pick[int]())
    # A float in an int | float type argument passes through unconverted.
    v = first[int | float]([2.5, 1])
    print(isinstance(v, float))
    print(v)
    # T | none with T = int | none is int | none.
    w: int | none = pick[int | none](none, 7)
    print(w)
    p = pair[int, str](1, "a")
    print(p[1])

    def wrap[U](u: U) -> list[U]:
        return [u]

    print(len(wrap[int](1)))
    inferred()
    aliases_bounds_values()
