import fs

def main():
    print(input())
    try:
        input()
    except ValueError as error:
        print(error.message)
    try:
        fs.read_file("invalid_utf8.in")
    except ValueError as error:
        print(error.message)
    try:
        fs.read_file("missing.txt")
    except OSError as failure:
        print(failure.message)
    fs.read_file("missing.txt")
