def show_int_division(a: int, b: int):
    print(a // b)
    print(a % b)
    print(a / b)

def show_float_division(a: float, b: float):
    print(a // b)
    print(a % b)
    print(a / b)

def show_product(a: float, b: float):
    print(a * b)

def main():
    print(7 / 2)
    print(7 // 2)
    print(-7 % 3)
    print(0.1 + 0.2)
    print(1e16)
    print(float(3))
    print(int(-2.7))

    show_int_division(7, 2)
    show_int_division(-7, 2)
    show_int_division(7, -2)
    show_int_division(-7, -2)
    show_int_division(0, -5)
    show_int_division(9007199254740991, -1)
    show_int_division(-9007199254740991, 2)
    show_float_division(7.5, 2.0)
    show_float_division(-7.5, 2.0)
    show_float_division(7.5, -2.0)
    show_float_division(-7.5, -2.0)
    show_float_division(-0.0, 5.0)
    show_float_division(0.0, -5.0)
    show_float_division(1e308, 1e-308)

    print(int(2.9))
    print(int(-0.5))
    print(int(9007199254740991.0))
    print(int(-9007199254740991.0))
    print(float(-9007199254740991))

    inf = 1e308 * 10.0
    nan = inf - inf
    print(inf)
    print(-inf)
    print(nan)
    print(-0.0)
    print(0.0 * -1.0)
    print(-0.0 == 0.0)
    print(nan == nan)
    print(nan != nan)
    print(nan < 1.0)
    print(nan >= 1.0)
    print(1.5 < 2.5)
    print(-(-1.5))
    print(2.5 - -1.0)

    print(0.0001)
    print(0.00001)
    print(1e15)
    print(123456789012345.6)
    print(1.5e16)
    print(5e-324)
    print(1.7976931348623157e308)
    print(2.5e-3)
    print(1E+5)
    print(0.30000000000000004)

    show_product(0.0, -5.0)
    show_product(-5.0, 0.0)
    show_product(0.0, -5.5)
    show_product(-0.0, 3.0)
    show_product(-0.0, -3.0)
    show_product(0.0, -3e10)
    show_product(0.0, 5.0)
    show_product(-0.0, 0.0)
    show_product(2147483648.0, 2147483648.0)
    show_product(1e200, 1e200)
    show_product(-1e200, 1e200)
