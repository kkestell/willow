import json

class Options:
    name: str
    width: int = 10
    ratio: float = 0.5
    label: str | none = none
    zero: float = -0.0

class Problem(Exception):
    code: int = 2

def greet(name: str, prefix: str = "Hello", times: int = 1) -> str:
    var result = ""
    for i in range(times):
        result = result + prefix + ", " + name + "! "
    return result.strip()

def scale(x: float | int = 2.5) -> str:
    return str(x)

def zero(x: float = -0.0) -> float:
    return x

def show(label: str, value: int) -> int:
    print(label)
    return value

def fail(message: str) -> int:
    raise Problem(message, code=7)

def triple(a: int, b: int = 0, c: int = 0) -> str:
    return f"{a} {b} {c}"

# Keyword-only parameters may be required or defaulted in any order.
def report(path: str, *, limit: int = 100, verbose: bool, tag: str = "x") -> str:
    return f"{path} {limit} {verbose} {tag}"

class Counter:
    n: int

    def scaled(*, by: int = 2) -> int:
        return self.n * by

def main():
    assert str(zero()) == "-0.0"
    assert str(Options("report").zero) == "-0.0"
    print(greet("Ada"))
    print(greet("Ada", "Hi"))
    print(greet(prefix="Welcome", name="Ada"))
    print(greet("Ada", times=2))
    print(scale() + " " + scale(3) + " " + scale(x=1.0))

    var options = Options("report")
    print(f"{options.name} {options.width} {options.ratio} {options.label}")
    options = Options(label="x", name="other", ratio=-0.0)
    print(f"{options.name} {options.width} {options.ratio} {options.label}")

    try:
        raise Problem("plain")
    except Problem as e:
        print(f"{e.message} {e.code}")
    try:
        raise Problem(code=3, message="named")
    except Problem as e:
        print(f"{e.message} {e.code}")

    # Arguments run in written order, whatever their parameter order.
    print(triple(c=show("c", 3), a=show("a", 1), b=show("b", 2)))
    try:
        print(triple(b=show("b", 2), a=fail("stopped"), c=show("c", 3)))
    except Problem as e:
        print(f"{e.message} {e.code}")

    print(json.dump(value=[3, 1]) + " " + str(len(sorted(items=[3, 1], reverse=true))))
    var xs = [2, 3, 1]
    xs.sort(reverse=true)
    print(f"{xs[0]} {xs[1]} {xs[2]}")

    print(report("a", verbose=true))
    print(report(tag="t", verbose=false, path="b", limit=5))
    var counter = Counter(3)
    print(f"{counter.scaled()} {counter.scaled(by=4)}")
    # Library methods take keywords by their documented names.
    var text = "a-b"
    print(text.startswith(prefix="a"))
    print(text.replace(new="+", old="-"))
    print("/".join(items=["x", "y"]) + " " + text.ljust(width=5) + "|")
    var ys = [1]
    ys.append(v=2)
    var counts = {"k": 1}
    print(f"{len(ys)} {counts.get(k='k')} {counts.pop(k='k')}")
