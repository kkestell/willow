enum ColorMode:
    AUTO
    ALWAYS
    NEVER

# Members named like Lua keywords or like a string still stay distinct values.
enum Keyword:
    end
    AUTO

class Settings:
    name: str
    mode: ColorMode = ColorMode.NEVER

def use_color(mode: ColorMode = ColorMode.AUTO) -> bool:
    return mode == ColorMode.ALWAYS

def describe(value: ColorMode | Keyword | str | none) -> str:
    if value is none:
        return "nothing"
    if value is ColorMode:
        return "mode " + str(value)
    if value is Keyword:
        return "keyword " + str(value)
    return "text " + value

def same(a: ColorMode | Keyword | str, b: ColorMode | Keyword | str) -> bool:
    return a == b

def same_number(a: int | float | ColorMode, b: int | float | ColorMode) -> bool:
    return a == b

def main():
    var mode = ColorMode.AUTO
    print(mode)
    print(f"{mode} {ColorMode.NEVER:>18}|")
    print(use_color(mode))
    print(use_color(ColorMode.ALWAYS))
    print(mode != ColorMode.NEVER)
    print(describe(ColorMode.NEVER))
    print(describe(Keyword.end))
    print(describe("AUTO"))
    print(describe(none))
    print(same(Keyword.AUTO, ColorMode.AUTO))
    print(same(Keyword.AUTO, "Keyword.AUTO"))
    print(same(Keyword.AUTO, Keyword.AUTO))
    print(same_number(ColorMode.AUTO, ColorMode.AUTO))
    print(same_number(ColorMode.AUTO, ColorMode.NEVER))
    print(same_number(1.5, ColorMode.AUTO))
    var modes = [ColorMode.AUTO, ColorMode.NEVER]
    print(ColorMode.NEVER in modes)
    print(ColorMode.ALWAYS in modes)
    print(use_color())
    print(Settings("plain").mode)
    print(Settings("bright", ColorMode.ALWAYS).mode)
    var labels: dict[ColorMode, str] = {ColorMode.NEVER: "off", ColorMode.AUTO: "auto"}
    labels[ColorMode.ALWAYS] = "on"
    for key in labels:
        print(f"{key} {labels[key]}")
    print(ColorMode.AUTO in labels)
    var counts = {Keyword.AUTO: 1}
    print(counts.get(Keyword.end))
    print(counts[Keyword.AUTO])
