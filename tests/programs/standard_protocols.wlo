protocol Shape:
    def area() -> float

class Countdown:
    n: int

    def iter() -> Countdown:
        return self

    def next() -> int:
        self.n = self.n - 1
        return self.n

class Session:
    name: str

    def enter() -> str:
        print("enter " + self.name)
        return self.name

    def exit(error: Exception | none):
        print(error is none)

class Rect:
    width: float
    height: float

    def area() -> float:
        return self.width * self.height

class Circle:
    radius: float

    def area() -> float:
        return 3.0 * self.radius * self.radius

def total[T: Shape](shapes: list[T]) -> float:
    var sum = 0.0
    for shape in shapes:
        sum = sum + shape.area()
    return sum

def first(items: Iterable[int]) -> int:
    return items.iter().next()

def main():
    var it: Iterator[int] = Countdown(3)
    print(it.next())
    print(it.iter().next())
    print(first(Countdown(10)))

    var manager: ContextManager[str] = Session("db")
    print(manager.enter())
    manager.exit(none)

    print(total([Rect(2.0, 3.0), Rect(1.0, 1.0)]))
    print(total([Circle(1.0)]))
