def describe(name: str | none) -> str:
    if name is none:
        return "anonymous"
    return "user " + name

def find(limit: int) -> int | none:
    if limit > 3:
        return limit * 2
    return none

def show(i: int | none, f: float | none, s: str | none, b: bool | none):
    print(i)
    print(f)
    print(s)
    print(b)

def main():
    count: int | none = none
    print(describe(none))           # anonymous
    print(describe("ada"))          # user ada
    if count is not none and count > 0:
        print(count)
    print(count)                    # none

    show(1, 2.5, "s", true)
    show(none, none, none, none)
    show(-3, -0.0, "", false)

    found = find(5)
    print(found)
    print(find(1))
    print(found == 10)
    print(found != none)
    print(find(1) == none)
    print(none == find(2))
    print(found is none)
    print(found is not none)
    print(find(1) is none)
    print(not found is none)

    total = 0
    limit = 0
    next: int | none = find(limit)
    while next is none:
        limit = limit + 1
        next = find(limit)
    if next is not none:
        total = total + next
    print(total)

    best: str | none = none
    if best is none or best == "x":
        best = "chosen"
    print(best + "!")
