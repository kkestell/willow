import math

def main():
    print(math.pi)
    print(math.e)
    print(math.tau == 2.0 * math.pi)

    print(math.floor(-0.5))
    print(math.ceil(-0.5))
    print(math.floor(2.7))
    print(math.ceil(2.1))
    print(math.floor(x=-2.5))

    print(math.isfinite(1.0))
    print(math.isfinite(math.exp(1000.0)))
    print(math.isinf(math.exp(1000.0)))
    print(math.isnan(math.log(-1.0)))
    print(math.isnan(math.sqrt(-1.0)))

    print(math.pow(2.0, 10.0))
    print(math.pow(y=2.0, x=3.0))
    print(math.pow(-0.0, 3.0))
    print(math.log(math.e))
    print(math.log10(1000.0))
    print(math.exp(0.0))
    print(math.sin(0.0))
    print(math.cos(0.0))
    print(math.tan(0.0))
    print(math.asin(1.0) * 2.0 == math.pi)
    print(math.acos(1.0))
    print(math.atan(0.0))
    print(math.atan2(1.0, 1.0) * 4.0 == math.pi)
    print(math.atan2(y=-0.0, x=-1.0))

    radius: float = 2.0
    print(math.pi * radius * radius)

    try:
        math.floor(math.log(0.0))
    except ValueError as e:
        print(e.message)
    try:
        math.ceil(1e300)
    except ValueError as e:
        print(e.message)
    try:
        math.floor(math.sqrt(-1.0))
    except ValueError as e:
        print(e.message)
