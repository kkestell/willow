def show(data: bytes) -> str:
    parts: list[str] = []
    for octet in data:
        parts.append(str(octet))
    return "[" + ", ".join(parts) + "]"

def matches(value: bytes | str, text: str) -> bool:
    return value == text

def contains(value: bytes | str, items: list[bytes | str]) -> bool:
    return value in items

def main():
    assert bytes([1]) in [bytes([1])]
    assert bytes([2]) not in [bytes([1])]
    assert contains("a".encode(), ["a", "a".encode()])
    assert not contains("a".encode(), ["a"])
    empty = bytes([])
    data = bytes([0, 127, 128, 255])
    print(f"{len(empty)} {len(data)} {show(data)}")
    try:
        bytes([1, 256])
    except ValueError as e:
        print(e.message)
    joined = data + "é→".encode()
    print(show(joined))
    print(f"{joined[0]} {joined[-1]} {show(joined[1:3])} {show(joined[-2:])} {show(joined[9:])}")
    try:
        print(joined[9])
    except IndexError as error:
        print(error.message)
    print(f"{data == bytes([0, 127, 128, 255])} {data != data[:2]} {empty == bytes([])}")
    print(f"{matches('hi', 'hi')} {matches('hi'.encode(), 'hi')}")
    text = "héllo→".encode()
    print(f"{len(text)} {text.decode()} {text[:3].decode()}")
    try:
        text[:2].decode()
    except ValueError as e:
        print(e.message)
    value: bytes | str = text
    if value is bytes:
        print(f"bytes of length {len(value)}")
