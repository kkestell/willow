import io

protocol Shape:
    def area() -> float
    def scaled(factor: float) -> Shape

protocol Area:
    def area() -> float

protocol Writer:
    def write_text(text: str)

protocol Source[T]:
    def get() -> T

protocol Greeter:
    def greet(name: str | none = "you", *, loud: bool = false) -> str

protocol Number:
    def value() -> int | float

protocol Scaler:
    def scale(by: float = 1.0) -> float

protocol Pair:
    def pair() -> tuple[int]

protocol Described:
    def describe() -> str

class Rect:
    width: float
    height: float

    def area() -> float:
        return self.width * self.height

    def scaled(factor: float, *, square: bool = false) -> Rect:
        if square:
            return Rect(self.width * factor, self.width * factor)
        return Rect(self.width * factor, self.height * factor)

class Circle:
    radius: float

    def area() -> float:
        return 3.0 * self.radius * self.radius

    def scaled(factor: float) -> Circle:
        return Circle(self.radius * factor)

    def get() -> float:
        return self.radius

class Box[T]:
    item: T

    def get() -> T:
        return self.item

# The protocol's keyword-only `loud` comes after an extra `polite`, and the
# defaults differ from the protocol's.
class Host:
    tag: str

    def greet(name: str | none = "friend", *, polite: bool = true, loud: bool = true) -> str:
        var who = "nobody"
        if name is not none:
            who = name
        var text = self.tag + " greets " + who
        if polite:
            text = text + " politely"
        if loud:
            text = text + "!"
        return text

class Half:
    n: int

    def value() -> float:
        return 2.5

class Three:
    n: int

    def value() -> int:
        return 3

class Doubler:
    n: int

    def scale(by: int | float = 3) -> float:
        if by is float:
            return by * 2.0
        return -1.0

class One:
    n: int

    def pair() -> tuple[int]:
        return (self.n,)

# Not a Pair: its tuple is longer.
class Two:
    n: int

    def pair() -> tuple[int, float]:
        return (self.n, 1.0)

class Oops(Exception):
    code: int

    def describe() -> str:
        return self.message + " " + str(self.code)

def take[T](source: Source[T]) -> T:
    return source.get()

def show(number: Number):
    var r = number.value()
    print((r is float))
    print(r)

def main():
    var shapes: list[Shape] = [Rect(2.0, 3.0), Circle(1.0)]
    for shape in shapes:
        print(shape.area())
        print(shape.scaled(2.0).area())
    var area: Area = shapes[0]
    print(area.area())
    var later = () => area.area()
    print(later())

    def nested() -> float:
        return area.area()

    print(nested())

    var out: Writer = io.stdout()
    out.write_text(text="written\n")

    print(take(Box(4)))
    print(take(Circle(4.0)))

    var greeter: Greeter = Host("Ann")
    print(greeter.greet())
    print(greeter.greet(none, loud=false))
    print(greeter.greet("Bo"))

    show(Half(0))
    show(Three(0))

    var scaler: Scaler = Doubler(0)
    print(scaler.scale(1.5))
    print(scaler.scale())

    var pair: Pair = One(1)
    print(pair.pair()[0])
    print(Two(2).pair()[1])

    var described: Described = Oops("bad", 7)
    print(described.describe())
