import io

protocol Shape:
    def area(self) -> float
    def scaled(self, factor: float) -> Shape

protocol Area:
    def area(self) -> float

protocol Writer:
    def write_text(self, text: str)

protocol Source[T]:
    def get(self) -> T

protocol Greeter:
    def greet(self, name: str | none = "you", *, loud: bool = false) -> str

protocol Number:
    def value(self) -> int | float

protocol Scaler:
    def scale(self, by: float = 1.0) -> float

protocol Pair:
    def pair(self) -> tuple[int]

protocol Described:
    def describe(self) -> str

class Rect:
    width: float
    height: float

    def area(self) -> float:
        return self.width * self.height

    def scaled(self, factor: float, *, square: bool = false) -> Rect:
        if square:
            return Rect(self.width * factor, self.width * factor)
        return Rect(self.width * factor, self.height * factor)

class Circle:
    radius: float

    def area(self) -> float:
        return 3.0 * self.radius * self.radius

    def scaled(self, factor: float) -> Circle:
        return Circle(self.radius * factor)

    def get(self) -> float:
        return self.radius

class Box[T]:
    item: T

    def get(self) -> T:
        return self.item

# The protocol's keyword-only `loud` comes after an extra `polite`, and the
# defaults differ from the protocol's.
class Host:
    tag: str

    def greet(self, name: str | none = "friend", *, polite: bool = true, loud: bool = true) -> str:
        who = "nobody"
        if name is not none:
            who = name
        text = self.tag + " greets " + who
        if polite:
            text = text + " politely"
        if loud:
            text = text + "!"
        return text

class Half:
    n: int

    def value(self) -> float:
        return 2.5

class Three:
    n: int

    def value(self) -> int:
        return 3

class Doubler:
    n: int

    def scale(self, by: int | float = 3) -> float:
        if isinstance(by, float):
            return by * 2.0
        return -1.0

class One:
    n: int

    def pair(self) -> tuple[int]:
        return (self.n,)

# Not a Pair: its tuple is longer.
class Two:
    n: int

    def pair(self) -> tuple[int, float]:
        return (self.n, 1.0)

class Oops(Exception):
    code: int

    def describe(self) -> str:
        return self.message + " " + str(self.code)

def take[T](source: Source[T]) -> T:
    return source.get()

def show(number: Number):
    r = number.value()
    print(isinstance(r, float))
    print(r)

def main():
    shapes: list[Shape] = [Rect(2.0, 3.0), Circle(1.0)]
    for shape in shapes:
        print(shape.area())
        print(shape.scaled(2.0).area())
    area: Area = shapes[0]
    print(area.area())
    later = () => area.area()
    print(later())

    def nested() -> float:
        return area.area()

    print(nested())

    out: Writer = io.stdout()
    out.write_text(text="written\n")

    print(take(Box(4)))
    print(take(Circle(4.0)))

    greeter: Greeter = Host("Ann")
    print(greeter.greet())
    print(greeter.greet(none, loud=false))
    print(greeter.greet("Bo"))

    show(Half(0))
    show(Three(0))

    scaler: Scaler = Doubler(0)
    print(scaler.scale(1.5))
    print(scaler.scale())

    pair: Pair = One(1)
    print(pair.pair()[0])
    print(Two(2).pair()[1])

    described: Described = Oops("bad", 7)
    print(described.describe())
