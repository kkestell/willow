type Json = none | bool | int | float | str | list[Json] | dict[str, Json]
type Number = int | float

class Cat:
    name: str

class Dog:
    name: str
    tricks: int

def describe(value: int | str | none) -> str:
    if value is none:
        return "nothing"
    if value is int:
        return f"number {value + 1}"
    return "text " + value

def render(value: Json) -> str:
    var parts: list[str]
    if value is none:
        return "null"
    else if value is bool:
        if value:
            return "true"
        return "false"
    else if value is int:
        return str(value)
    else if value is float:
        return f"{value}"
    else if value is str:
        return value
    else if value is list:
        parts = []
        for item in value:
            parts.append(render(item))
        return "[" + ", ".join(parts) + "]"
    parts = []
    for key in value:
        parts.append(key + ": " + render(value[key]))
    return "{" + ", ".join(parts) + "}"

def greet(pet: Cat | Dog) -> str:
    if pet is Dog:
        return f"{pet.name} knows {pet.tricks} tricks"
    return pet.name + " ignores you"

def same(a: Number, b: Number) -> bool:
    return a == b

def contains(value: Number, items: list[float]) -> bool:
    return value in items

def main():
    print(describe(41))
    print(describe("x"))
    print(describe(none))

    var one: Number = 1
    var one_float: Number = 1.0
    var numbers: list[Number] = [one, one_float, -0.0, 2.5, float("nan")]
    for n in numbers:
        print(n)
        print(f"{n} {str(n)}")
    print(same(one, one_float))
    print(same(one, 1))
    print(same(one_float, 1.0))
    print(same(numbers[4], numbers[4]))
    print(one_float == 1.0)
    print(1.0 in numbers)
    print(3 in numbers)
    var floats = [1.0, 2.0]
    print(contains(1, floats))
    print(contains(2.0, floats))

    var pets: list[Cat | Dog] = [Cat("Tom"), Dog("Rex", 3)]
    for pet in pets:
        print(greet(pet))

    var data: Json = {"name": "willow", "tags": ["small", "typed"], "version": 1, "ratio": 0.5,
                  "nested": {"ok": true, "none": none, "empty": []}}
    print(render(data))
    if data is dict:
        data["version"] = 2.0
    print(render(data))

    var maybe: int | str | none = none
    if maybe is not none:
        print("unreachable")
    maybe = "text"
    print(maybe + "!")
    if maybe is not str:
        return
    print(len(maybe))
