def is_even(n: int) -> bool:
    if n == 0:
        return true
    return is_odd(n - 1)

def is_odd(n: int) -> bool:
    if n == 0:
        return false
    return is_even(n - 1)

def factorial(n: int) -> int:
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def describe(n: int) -> str:
    if n < 0:
        return "negative"
    else if n == 0:
        return "zero"
    else if n < 10:
        return "small"
    else:
        return "large"

def next_value(n: int) -> int:
    return n + 1

def find(target: int) -> int:
    var n = 0
    while true:
        n = n + 1
        if n < target:
            continue
        return n
    return -1

def main():
    var i = 0
    var total = 0
    while next_value(i) <= 10:
        i = i + 1
        if i == 3:
            continue
        if i == 8:
            break
        total = total + i
    print(total)
    var row = 0
    while row < 3:
        var col = 0
        while true:
            if col == row:
                break
            col = col + 1
        print(col)
        row = row + 1
    print(describe(-5))
    print(describe(0))
    print(describe(7))
    print(describe(70))
    print(factorial(10))
    print(is_even(10))
    print(is_odd(7))
    print(find(5))
