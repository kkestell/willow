import fs
import io
import sys
import time

def main():
    # input() and stdin handles share one buffer.
    var stdin = io.stdin()
    print(input())
    print(stdin.readline())
    print(f"[{input()}]")
    print(stdin.readline())
    print(stdin.read(4).decode())
    print(stdin.readline())
    print(stdin.readline())
    print(f"{stdin.readline()} {len(stdin.read(10))} {input()}")

    # print and stdout handles keep their order.
    var out = io.stdout()
    out.write_text("a")
    print("b")
    out.write("c\n".encode())
    out.flush()

    var path = fs.join("/tmp", "wlo_streams_" + str(int(time.time() * 1000000.0)))
    var f = io.open(path, mode="w")
    f.write_text("one\n")
    f.close()
    f.close()
    var g = io.open(path, "a")
    g.write(bytes([116, 119, 111]))
    g.close()
    var r = io.open(path)
    var alias = r
    print(r.readline())
    print(alias.read(100).decode())
    print(len(r.read(100)))
    print(r.readline())
    r.close()
    for check in ["closed", "mode", "size", "borrowed", "write", "flush"]:
        try:
            if check == "closed":
                alias.readline()
            else if check == "mode":
                out.read(1)
            else if check == "size":
                stdin.read(0)
            else if check == "borrowed":
                stdin.close()
            else if check == "write":
                stdin.write_text("x")
            else:
                r.flush()
        except ValueError as e:
            print(f"{check}: {e.message}")
    try:
        io.open(path, "x")
    except ValueError as e:
        print(e.message)
    fs.remove(path)
    try:
        io.open(path)
    except OSError as error:
        print(error.message.replace(path, "PATH"))
    # Buffered output is flushed when the program exits.
    out.write_text("end")
    sys.exit(0)
