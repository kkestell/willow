# Branch chains with `else if`, including narrowing through union branches.

def classify(n: int) -> str:
    if n < 0:
        return "negative"
    else if n == 0:
        return "zero"
    else if n < 10:
        return "small"
    else:
        return "large"

def sign(n: int) -> str:
    if n > 0:
        return "positive"
    else if n < 0:
        return "negative"
    return "zero"

def describe(value: int | str | none) -> str:
    if value is none:
        return "nothing"
    else if value is int:
        return f"int {value + 1}"
    else:
        return "str " + value

def first(a: int | none, b: int | none) -> int:
    var result = 0
    if a is not none:
        result = a
    else if b is not none:
        result = b
    else:
        result = -1
    return result

def main():
    print(classify(-5))
    print(classify(0))
    print(classify(7))
    print(classify(70))
    print(sign(3))
    print(sign(-2))
    print(sign(0))
    print(describe(none))
    print(describe(41))
    print(describe("hi"))
    print(first(5, 7))
    print(first(none, 7))
    print(first(none, none))
    var elif = 42
    print(elif)
