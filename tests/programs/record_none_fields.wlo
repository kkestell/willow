class Node:
    value: int
    left: Node | none
    right: Node | none = none

def note(label: str) -> int:
    print(label)
    return 1

def nothing() -> Node | none:
    print("nothing")
    return none

def main():
    # none fields, passed explicitly or taken from a default, read as none.
    var a = Node(1, none, none)
    var b = Node(2, none)
    print(a.left is none and a.right is none and b.left is none and b.right is none)
    # Assigning an omitted field stores it; the other stays none.
    b.left = a
    b.right = Node(3, none)
    var left = b.left
    var right = b.right
    if left is not none and right is not none:
        print(left.value + right.value)
    print(a.left is none)
    # Only a literal none is omitted; other arguments are still evaluated in order.
    var c = Node(note("value"), nothing())
    print(c.left is none)
