def main():
    var top = 9007199254740990 + 1
    var bottom = -9007199254740990 - 1
    print(top)
    print(bottom)
    print(-top)
    print(-bottom)
    print(top + bottom)
    print(94906265 * 94906265)
    # Floor division and modulo near the limits where float arithmetic could
    # round a quotient up to the next integer.
    print(top // 2)
    print(top % 2)
    print(top // 4)
    print(top % 4)
    print(top // 8)
    print(top % 8)
    print(top // -9)
    print(top % -9)
    print(bottom // 9)
    print(bottom % 9)
    print(top // 1000003)
    print(top % 1000003)
    print((top - 1) // 2)
    print((top - 1) % 2)
    print((top - 1) // -4)
    print((top - 1) % -4)
    print(4503599627370494 // -4)
    print(4503599627370494 % -4)
    # Powers of two divide with a shift and mod with a mask, negative
    # operands included.
    for x in [1, -1, 7, -7, 8, -8, 1023, 1024, -1024, 9223372036854775807, -9223372036854775807]:
        print(x // 4)
        print(x % 4)
        print(x // 1024)
        print(x % 1024)
