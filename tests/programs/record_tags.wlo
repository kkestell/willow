class Node:
    n: int

type Value = Node | list[str] | tuple[str, int] | dict[str, int]

def describe(value: Value) -> str:
    if isinstance(value, Node):
        return f"node {value.n}"
    else if isinstance(value, list):
        return f"list {len(value)}"
    else if isinstance(value, tuple):
        return "tuple"
    return "dict"

def main():
    print(describe(Node(1)))
    print(describe(["Node"]))
    print(describe(("Node", 2)))
    print(describe({"Node": 3}))
