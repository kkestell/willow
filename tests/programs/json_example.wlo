import json

def main():
    var doc = json.parse('{"name": "Willow", "ports": [80, 443]}')
    if doc is dict:
        var ports = doc["ports"]
        if ports is list:
            print(len(ports))       # 2
    var reply: json.Json = {"ok": true, "items": [1, 2.5, none]}
    print(json.dump(reply))         # {"ok":true,"items":[1,2.5,null]}
