class Box[T]:
    value: T

    def get() -> T:
        return self.value

    def set(value: T):
        self.value = value

    # A method's own type parameter is inferred at each call.
    def map[U](f: (T) -> U) -> Box[U]:
        return Box(f(self.value))

# A generic class may refer to its own specialization.
class Node[T]:
    value: T
    next: Node[T] | none = none

def length[T](node: Node[T] | none) -> int:
    count = 0
    while node is not none:
        count = count + 1
        node = node.next
    return count

def describe(x: Box[int] | none) -> str:
    if x is Box:
        return "box " + str(x.get())
    return "none"

def main():
    # The constructor infers T, or takes it explicitly.
    b = Box(1)
    print(b.get())
    b.set(5)
    print(b.value)
    s = Box[str]("a")
    print(s.get())
    lengths = s.map((x) => len(x) + 10)
    print(lengths.get())
    chain = Node(1, Node(2, Node(3)))
    print(length(chain))
    print(describe(b))
    print(describe(none))
    # A float in an int | float specialization stays a float.
    f = Box[int | float](2.5)
    v = f.get()
    print((v is float))
