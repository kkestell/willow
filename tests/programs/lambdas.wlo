# Each counter rebinds its own `count`.
def counter() -> () -> int:
    var count = 0

    def increment() -> int:

        count = count + 1
        return count

    return increment

# The outer function reads what the nested function rebinds.
def total() -> int:
    var sum = 0

    def add(n: int):

        sum = sum + n

    add(3)
    add(4)
    return sum

def apply(f: (int) -> int, x: int) -> int:
    return f(x)

def threshold(minimum: int) -> (int) -> bool:
    return (score) => score >= minimum

def main():
    var a = counter()
    var b = counter()
    print(a())
    print(a())
    print(b())
    print(total())
    print(apply((x) => x * 10, 4))
    var ok = threshold(5)
    print(ok(3))
    print(ok(7))
    var fs: list[(int) -> int] = [(x) => x + 1, (x) => x * x]
    for f in fs:
        print(f(5))
    # A parameterless lambda needs no expected type.
    var answer = () => 42
    print(answer())
    # The lambda's float result is boxed for the callable's result type.
    var half: () -> int | float = () => 1.5
    var r = half()
    print((r is float))
    # Each lambda captures its own iteration binding.
    var getters: list[() -> int] = []
    for i in range(3):
        getters.append(() => i)
    print(getters[0]())
    var add = () => () => 7
    print(add()())
