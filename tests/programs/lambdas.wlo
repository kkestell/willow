# Each counter rebinds its own `count`.
def counter() -> () -> int:
    count = 0

    def increment() -> int:
        nonlocal count
        count = count + 1
        return count

    return increment

# The outer function reads what the nested function rebinds.
def total() -> int:
    sum = 0

    def add(n: int):
        nonlocal sum
        sum = sum + n

    add(3)
    add(4)
    return sum

def apply(f: (int) -> int, x: int) -> int:
    return f(x)

def threshold(minimum: int) -> (int) -> bool:
    return (score) => score >= minimum

def main():
    a = counter()
    b = counter()
    print(a())
    print(a())
    print(b())
    print(total())
    print(apply((x) => x * 10, 4))
    ok = threshold(5)
    print(ok(3))
    print(ok(7))
    fs: list[(int) -> int] = [(x) => x + 1, (x) => x * x]
    for f in fs:
        print(f(5))
    # A parameterless lambda needs no expected type.
    answer = () => 42
    print(answer())
    # The lambda's float result is boxed for the callable's result type.
    half: () -> int | float = () => 1.5
    r = half()
    print((r is float))
    # A lambda in a loop shares the loop variable's binding.
    getters: list[() -> int] = []
    for i in range(3):
        getters.append(() => i)
    print(getters[0]())
    add = () => () => 7
    print(add()())
