class Bag:
    size: int

    def iter(self) -> Iterator[int]:
        return range(self.size).iter()

# A class may share a name with the run-time type of built-in iterators.
class iterator:
    n: int

    def iter(self) -> Iterator[int]:
        return [self.n].iter()

def floats(xs: Iterable[int | float]):
    for x in xs:
        print(isinstance(x, float))

def sum_all(xs: Iterable[int]) -> int:
    sum = 0
    for x in xs:
        sum = sum + x
    return sum

def first[T](xs: Iterable[T]) -> T:
    return next(iter(xs))

def main():
    print(next(iter([7, 8])))
    print(next({"k": 1}.iter()))
    letters = iter("aé")
    print(next(letters))
    print(next(letters))
    print(next(iter(bytes([65, 66]))))
    mixed = iter((1, 2.5))
    print(next(mixed))
    r = next(mixed)
    print(isinstance(r, float))
    print(r)

    countdown = range(3, 0, -1)
    for n in countdown:
        print(n)
    print(sum_all(countdown))
    print(sum_all(range(0)))
    try:
        bad = range(1, 2, 0)
    except ValueError as error:
        print(error.message)

    # A list iterator sees appended elements until it is exhausted.
    xs = [1]
    it = iter(xs)
    print(next(it))
    xs.append(2)
    print(next(it))
    try:
        next(it)
    except StopIteration:
        print("exhausted")
    xs.append(3)
    try:
        next(it)
    except StopIteration as stop:
        print(f"still exhausted '{stop.message}'")

    d = {"a": 1}
    keys = iter(d)
    d["b"] = 2
    try:
        next(keys)
    except RuntimeError as failure:
        print(failure.message)

    print(sum_all([1, 2, 3]))
    print(sum_all((4, 5)))
    print(sum_all(Bag(4)))
    print(sum_all(iterator(5)))
    print(sum_all([6].iter()))
    floats((1, 2.5))
    print(first(["x", "y"]))
    words: Iterable[str] = {"one": 1, "two": 2}
    for word in words:
        print(word)

    numbers = iter([1, 2, 3, 4])
    for n in numbers:
        if n == 2:
            break
    for n in numbers:
        print(n)
