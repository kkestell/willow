def trace(label: str) -> int:
    print(label)
    return 1

def pair() -> tuple[int, str]:
    print("pair")
    return (1, "Ada")

# A tuple of floats passed where a position also holds ints is converted.
def widen(t: tuple[int | float, float]) -> str:
    first = t[0]
    if first is float:
        return f"float {first} {t[1]}"
    return "int"

def maybe(t: tuple[float] | none) -> tuple[int | float] | none:
    return t

def kind(v: tuple[int, str] | list[int] | none) -> str:
    if v is tuple:
        return "tuple " + v[1]
    if v is list:
        return "list"
    return "none"

enum Side:
    LEFT
    RIGHT

class Box:
    size: tuple[int, int] = (1, 2)

def greet(pair: tuple[Side, int | float] = (Side.RIGHT, 1.5)) -> str:
    second = pair[1]
    return f"{pair[0]} {second} {(second is float)}"

def found(flag: bool) -> tuple[int, str] | none:
    if flag:
        return (1, "a")
    return none

def comparisons():
    print((1, "a") == (1, "a"))
    print((1, "a") != (1, "b"))
    print(((1, 2), none) == ((1, 2), none))
    print(() == ())
    print(found(true) == (1, "a"))
    print(found(false) is none)
    print(found(true) is none)
    one: tuple[int | float] = (1,)
    floats: tuple[float] = (1.0,)
    print(one == floats)
    widened: tuple[int | float] = (1.0,)
    print(widened == floats)
    print((1, 2) < (1, 3))
    print((2, 0) < (1, 9))
    print((1, 2) <= (1, 2))
    print((1, 2) < (1, 2))
    print(((1, "b"),) > ((1, "a"),))
    print(("a", 1) >= ("b", 0))
    nan = float("nan")
    print((nan, 1) < (1.0, 2))
    print((nan, 1) > (1.0, 2))
    print((1, 2) in [(0, 0), (1, 2)])
    print(widened in [(1.0,)])
    print(one in [(1.0,)])

def iteration():
    for item in (1, 2.5, none):
        print(f"{item} {(item is float)}")
    for nothing in ():
        print(nothing)

def defaults():
    print(greet())
    print(greet((Side.LEFT, 3)))
    print(Box().size[1])
    print(Box((3, 4)).size[0])

def main():
    t = (1, "Ada")
    print(t[0])
    print(t[-1])
    nested = ((1, 2), none, (3,))
    print(nested[0][1])
    print(nested[1])
    print(nested[-1][0])
    print(len(nested))
    print(len(()))
    print(len(pair()))
    order = (trace("a"), trace("b"))
    print(order[1])
    floats = (1.5, 2.5)
    print(widen(floats))
    print(widen((2, 3.5)))
    m = maybe((4.5,))
    if m is not none:
        x = m[0]
        print((x is float))
        print(x)
    print(maybe(none) is none)
    print(kind(t))
    print(kind([1]))
    print(kind(none))
    grouped = (5)
    print(grouped)
    comparisons()
    iteration()
    defaults()
