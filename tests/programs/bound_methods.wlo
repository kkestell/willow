import fs
import time

class Counter:
    n: int

    def add(by: int = 1, *, times: int = 1) -> int:
        self.n = self.n + by * times
        return self.n

def make() -> Counter:
    print("make")
    return Counter(0)

def apply(f: (int) -> int, x: int) -> int:
    return f(x)

def main():
    # The receiver is evaluated once, when the method is read.
    var add = make().add
    print(add())
    print(add(5))
    print(add(times=2, by=3))
    # A bound method sees its receiver's current fields.
    var c = Counter(100)
    var g = c.add
    c.n = 200
    print(g())
    print(apply(c.add, 10))
    # Built-in and library functions become values of an expected callable type.
    var size: (str) -> int = len
    print(size("hello"))
    var text: (float) -> str = str
    print(text(2.5))
    var say: (str) -> none = print
    say("hi")
    var now: () -> float = time.time
    print(now() > 0.0)
    var exists: (str) -> bool = fs.exists
    print(exists("/no/such/path"))
    var parse: (str) -> int = int
    print(parse("42"))
    try:
        parse("x")
    except ValueError as e:
        print(e.message)
