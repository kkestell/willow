import aio

# Listeners can be opened and closed by synchronous code, before any event
# loop runs.
def main():
    var listener = aio.listen("127.0.0.1", 0)
    print(listener.local_port() > 0)
    listener.close()
    with aio.listen("127.0.0.1", 0) as scoped:
        print(scoped.local_port() > 0)
    print("closed")
