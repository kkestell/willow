import aio

protocol Named:
    def name() -> str

protocol Greeter:
    async def greet(who: str) -> str

class Host:
    def name() -> str:
        return "host"

    async def greet(who: str) -> str:
        await aio.sleep(0.0)
        return "hello, " + who

def show(named: Named):
    print(named.name())

async def welcome(greeter: Greeter):
    print(await greeter.greet("guest"))

async def main():
    var host = Host()
    show(host)
    await welcome(host)
