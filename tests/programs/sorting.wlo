def letters() -> Iterator[str]:
    yield "c"
    yield "a"
    yield "b"

def numbers(xs: Iterable[int]) -> list[int]:
    return sorted(xs, reverse=True)

def words(xs: list[str]) -> str:
    return " ".join(xs)

def ints(xs: list[int]) -> str:
    texts: list[str] = []
    for x in xs:
        texts.append(str(x))
    return " ".join(texts)

def main():
    print(words(sorted({"b": 1, "a": 2, "c": 3})))
    print(words(sorted("cab")))
    print(ints(sorted(bytes([3, 1, 2]))))
    print(ints(sorted((3, 1, 2))))
    print(ints(sorted(range(5, 0, -2))))
    print(words(sorted(letters())))
    print(ints(numbers([1, 3, 2])))
    print(words(sorted(["b", "a"], reverse=True)))

    pairs = [("b", 2), ("a", 9), ("b", 1), ("a", 1)]
    for name, n in sorted(pairs):
        print(f"{name} {n}")
    nested = [((2, "x"), 1), ((1, "z"), 2), ((1, "y"), 3)]
    for key, n in sorted(nested, reverse=True):
        print(f"{key[0]} {key[1]} {n}")
    pairs.sort(reverse=True)
    print(f"{pairs[0][0]} {pairs[0][1]}")

    nan = float("nan")
    try:
        sorted([1.0, nan])
    except ValueError as error:
        print(error.message)
    with_nan = [(2, 1.0), (1, nan)]
    try:
        with_nan.sort()
    except ValueError as again:
        print(again.message)
    print(with_nan[0][0])
