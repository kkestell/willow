# Names such as `end`, `nil`, `number`, `string`, `x_`, and `__wlo_t1` are
# ordinary identifiers.
enum number:
    A

enum E_:
    A

class string:
    x: int

class C_:
    x: int

    def get() -> int:
        return self.x

def end(local: int) -> int:
    var nil = local + 1
    var then = nil * 2
    return then

def is_number(value: number | int) -> bool:
    return value is number

def is_string(value: string | str) -> bool:
    return value is string

def main():
    var repeat = end(4)
    print(repeat)
    var x_ = 1
    var x = 2
    print(x_ + x)
    print(end(1))
    var __wlo_t1 = 7
    print(__wlo_t1 + end(0))
    print(is_number(1))
    print(is_number(number.A))
    print(is_string("s"))
    print(is_string(string(1)))
    var __wlo_enum_E_ = 1
    var __wlo_class_C_ = 1
    print(E_.A)
    print(C_(2).get())
