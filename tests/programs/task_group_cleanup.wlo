import aio

# Awaiting a task that the same stop cancelled raises in cleanup.
async def flusher():
    while true:
        await aio.sleep(1.0)

async def serve(group: aio.TaskGroup):
    await aio.sleep(0.01)
    group.cancel()

async def main():
    async with aio.task_group() as group:
        var background = group.start(flusher())
        try:
            await serve(group)
            await aio.sleep(10.0)
        finally:
            print("cleanup")
            await background
    print("clean shutdown")
