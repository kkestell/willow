import function_values

def add(a: int, b: int = 10, *, scale: int = 1) -> int:
    return (a + b) * scale

def double(x: int) -> int:
    return x * 2

def trace(label: str, value: int) -> int:
    print(label)
    return value

# Recursion through an alias of the function itself.
def fact(n: int) -> int:
    var f = fact
    if n < 2:
        return 1
    return n * f(n - 1)

# A local hides the declaration of the same name throughout the function.
def hidden():
    var double = add
    print(double(1))
    # A qualified name still reaches the hidden declaration.
    var g = function_values.double
    print(g(3))

def main():
    hidden()
    var f = add
    print(f(1))
    print(f(1, 2, scale=3))
    print(f(b=5, a=1))
    print((double)(4))
    var fs = [double, double]
    print(fs[1](5))
    print({"d": double}["d"](6))
    print((double, 1)[0](7))
    # The callee is evaluated before its arguments.
    print(fs[trace("callee", 0)](trace("arg", 8)))
    print(fact(5))
