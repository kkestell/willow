def show(text: str, base: int):
    try:
        print(int(text, base))
    except ValueError as e:
        print(e.message)

def text() -> str:
    print("text")
    return "ff"

def base() -> int:
    print("base")
    return 16

def main():
    show("+00101", 2)
    show("-17", 8)
    show("aBcDeF", 16)
    show("Zz", 36)
    show("-0", 10)
    show("7fffffffffffffff", 16)
    show("-7fffffffffffffff", 16)
    show("1y2p0ij32e8e7", 36)
    for invalid in ["8000000000000000", "-8000000000000000", "ffffffffffffffff", "", "+", "-", "0xff", "1_0", " 1", "1 ", "é", "g", "\x001"]:
        show(invalid, 16)
    show("2", 2)
    show("z", 35)
    show("", 1)
    show("1", 37)
    show("1", -1)
    print(int(text(), base()))
