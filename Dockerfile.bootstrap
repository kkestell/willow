FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl xz-utils \
        libgc-dev pkg-config libcurl4 libpcre2-8-0 openssl git procps \
    && rm -rf /var/lib/apt/lists/*

# Debian's QBE package is older than the release Willow requires.
RUN curl -fsSL https://c9x.me/compile/release/qbe-1.3.tar.xz -o /tmp/qbe.tar.xz \
    && tar -xJf /tmp/qbe.tar.xz -C /tmp \
    && make -C /tmp/qbe-1.3 -j2 PREFIX=/usr/local install \
    && rm -rf /tmp/qbe-1.3 /tmp/qbe.tar.xz

RUN useradd --create-home willow \
    && mkdir /willow \
    && chown willow:willow /willow
WORKDIR /willow
COPY --chown=willow:willow . .
USER willow
CMD ["make", "bootstrap-test"]
