# matrix: multiply two 30-by-30 integer matrices many times, from the Computer
# Language Benchmarks Game.

import sys

def make_matrix(rows: int, columns: int) -> list[list[int]]:
    var matrix: list[list[int]] = []
    var count = 1
    for row_index in range(rows):
        var row: list[int] = []
        for column_index in range(columns):
            row.append(count)
            count = count + 1
        matrix.append(row)
    return matrix

def multiply(rows: int, columns: int, a: list[list[int]], b: list[list[int]]) -> list[list[int]]:
    var product: list[list[int]] = []
    for i in range(rows):
        var a_row = a[i]
        var row: list[int] = []
        for j in range(columns):
            var total = 0
            for k in range(columns):
                total = total + a_row[k] * b[k][j]
            row.append(total)
        product.append(row)
    return product

def main():
    var n = int(sys.args()[0])
    var size = 30
    var a = make_matrix(size, size)
    var b = make_matrix(size, size)
    var product = multiply(size, size, a, b)
    for _ in range(n - 1):
        product = multiply(size, size, a, b)
    print(f"{product[0][0]} {product[2][3]} {product[3][2]} {product[4][4]}")
