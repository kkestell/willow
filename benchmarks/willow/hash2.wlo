# hash2: add the values of one dictionary into another many times, from the
# Computer Language Benchmarks Game.

import sys

def main() -> None:
    n = int(sys.args()[0])
    first: dict[str, int] = {}
    for i in range(10000):
        first[f"foo_{i}"] = i
    second: dict[str, int] = {}
    for _ in range(n):
        for key in first:
            current = second.get(key)
            if current is None:
                second[key] = first[key]
            else:
                second[key] = current + first[key]
    print(f"{first['foo_1']} {first['foo_9999']} {second['foo_1']} {second['foo_9999']}")
