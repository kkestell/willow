# fannkuch-redux: for every permutation of 1..n, count the prefix reversals
# ("pancake flips") needed to bring 1 to the front, from the Computer Language
# Benchmarks Game. Prints a checksum of the counts and the largest count.

import sys

def main():
    n = int(sys.args()[0])
    perm1: list[int] = []
    perm: list[int] = []
    count: list[int] = []
    for i in range(n):
        perm1.append(i)
        perm.append(0)
        count.append(0)
    max_flips = 0
    checksum = 0
    permutations = 0
    r = n
    while True:
        while r != 1:
            count[r - 1] = r
            r = r - 1

        for i in range(n):
            perm[i] = perm1[i]
        flips = 0
        k = perm[0]
        while k != 0:
            low = 0
            high = k
            while low < high:
                t = perm[low]
                perm[low] = perm[high]
                perm[high] = t
                low = low + 1
                high = high - 1
            flips = flips + 1
            k = perm[0]
        if flips > max_flips:
            max_flips = flips
        if permutations % 2 == 0:
            checksum = checksum + flips
        else:
            checksum = checksum - flips

        # Advance to the next permutation in the order the benchmark requires.
        while True:
            if r == n:
                print(checksum)
                print(f"Pfannkuchen({n}) = {max_flips}")
                return
            first = perm1[0]
            for i in range(r):
                perm1[i] = perm1[i + 1]
            perm1[r] = first
            count[r] = count[r] - 1
            if count[r] > 0:
                break
            r = r + 1
        permutations = permutations + 1
