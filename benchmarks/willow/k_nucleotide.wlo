# k-nucleotide: count the k-mers of a DNA sequence with dictionaries, from the
# Computer Language Benchmarks Game. Instead of reading the sequence from a
# file, it generates one the way fasta generates its third sequence.

import sys

def generate(n: int) -> list[str]:
    var symbols = ["A", "C", "G", "T"]
    var probabilities = [0.3029549426680, 0.1979883004921, 0.1975473066391, 0.3015094502008]
    var cumulative: list[float] = []
    var total = 0.0
    for probability in probabilities:
        total = total + probability
        cumulative.append(total)
    var sequence: list[str] = []
    var last = 42
    for _ in range(n):
        last = (last * 3877 + 29573) % 139968
        var r = float(last) / 139968.0
        var choice = 3
        for i in range(4):
            if r < cumulative[i]:
                choice = i
                break
        sequence.append(symbols[choice])
    return sequence

def count(sequence: list[str], k: int) -> dict[str, int]:
    var counts: dict[str, int] = {}
    for i in range(len(sequence) - k + 1):
        var kmer = "".join(sequence[i:i + k])
        counts[kmer] = counts.get(kmer, 0) + 1
    return counts

def print_frequencies(sequence: list[str], k: int):
    var counts = count(sequence, k)
    var total = float(len(sequence) - k + 1)
    for kmer in sorted(counts, key=(kmer) => (-counts[kmer], kmer)):
        print(f"{kmer} {100.0 * float(counts[kmer]) / total:.3f}")
    print("")

def print_count(sequence: list[str], kmer: str):
    print(f"{count(sequence, len(kmer)).get(kmer, 0)}\t{kmer}")

def main():
    var n = int(sys.args()[0])
    var sequence = generate(n)
    print_frequencies(sequence, 1)
    print_frequencies(sequence, 2)
    for kmer in ["GGT", "GGTA", "GGTATT", "GGTATTTTAATT", "GGTATTTTAATTTATAGT"]:
        print_count(sequence, kmer)
