# k-nucleotide: count the k-mers of a DNA sequence with dictionaries, from the
# Computer Language Benchmarks Game. Instead of reading the sequence from a
# file, it generates one the way fasta generates its third sequence.

import sys

def generate(n: int) -> list[str]:
    symbols = ["A", "C", "G", "T"]
    probabilities = [0.3029549426680, 0.1979883004921, 0.1975473066391, 0.3015094502008]
    cumulative: list[float] = []
    total = 0.0
    for probability in probabilities:
        total = total + probability
        cumulative.append(total)
    sequence: list[str] = []
    last = 42
    for _ in range(n):
        last = (last * 3877 + 29573) % 139968
        r = float(last) / 139968.0
        choice = 3
        for i in range(4):
            if r < cumulative[i]:
                choice = i
                break
        sequence.append(symbols[choice])
    return sequence

def count(sequence: list[str], k: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for i in range(len(sequence) - k + 1):
        kmer = "".join(sequence[i:i + k])
        current = counts.get(kmer)
        if current is None:
            counts[kmer] = 1
        else:
            counts[kmer] = current + 1
    return counts

def print_frequencies(sequence: list[str], k: int) -> None:
    counts = count(sequence, k)
    total = float(len(sequence) - k + 1)
    for kmer in sorted(counts, key=lambda kmer: (-counts[kmer], kmer)):
        print(f"{kmer} {100.0 * float(counts[kmer]) / total:.3f}")
    print("")

def print_count(sequence: list[str], kmer: str) -> None:
    found = count(sequence, len(kmer)).get(kmer)
    if found is None:
        found = 0
    print(f"{found}\t{kmer}")

def main() -> None:
    n = int(sys.args()[0])
    sequence = generate(n)
    print_frequencies(sequence, 1)
    print_frequencies(sequence, 2)
    for kmer in ["GGT", "GGTA", "GGTATT", "GGTATTTTAATT", "GGTATTTTAATTTATAGT"]:
        print_count(sequence, kmer)
