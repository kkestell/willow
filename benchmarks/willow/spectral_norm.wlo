# spectral-norm: approximate the spectral norm of an infinite matrix by power
# iteration, from the Computer Language Benchmarks Game.

import math
import sys

# Entry (i, j) of the matrix A, with indexes from zero.
def a(i: int, j: int) -> float:
    return 1.0 / float((i + j) * (i + j + 1) // 2 + i + 1)

def times(v: list[float], out: list[float]):
    n = len(v)
    for i in range(n):
        total = 0.0
        for j in range(n):
            total = total + a(i, j) * v[j]
        out[i] = total

def times_transposed(v: list[float], out: list[float]):
    n = len(v)
    for i in range(n):
        total = 0.0
        for j in range(n):
            total = total + a(j, i) * v[j]
        out[i] = total

# Sets `out` to A transposed times A times `v`.
def times_a_transposed_a(v: list[float], out: list[float], scratch: list[float]):
    times(v, scratch)
    times_transposed(scratch, out)

def main():
    n = int(sys.args()[0])
    u: list[float] = []
    v: list[float] = []
    scratch: list[float] = []
    for _ in range(n):
        u.append(1.0)
        v.append(0.0)
        scratch.append(0.0)
    for _ in range(10):
        times_a_transposed_a(u, v, scratch)
        times_a_transposed_a(v, u, scratch)
    vbv = 0.0
    vv = 0.0
    for i in range(n):
        vbv = vbv + u[i] * v[i]
        vv = vv + v[i] * v[i]
    print(f"{math.sqrt(vbv / vv):.9f}")
